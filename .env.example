# Environment configuration
NODE_ENV=local
TZ=Asia/Jakarta

# Application configuration
APP_NAME="IMS ERP"
APP_ID=erp
APP_SECRET=
APP_HOST=localhost
APP_PORT=3000
APP_URL="http://${APP_HOST}:${APP_PORT}"
APP_LOG_LEVEL=debug

# PostgreSQL database configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB="ims_${APP_ID}_${NODE_ENV}"
POSTGRES_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=1

# S3 configuration
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_USE_PATH_STYLE=

