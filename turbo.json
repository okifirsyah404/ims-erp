{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
		"test": { "dependsOn": ["^build"], "cache": false },
		"lint": {
			"dependsOn": ["^lint"]
		},
		"format": {
			"dependsOn": ["^format"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start:dev": { "cache": false, "persistent": true }
	}
}
