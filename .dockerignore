**/dist
**/.turbo
**/.tmp
**/.tanstack
**/coverage
**/tsconfig.build.tsbuildinfo
.git
.github
.husky
.agents
.claude
.opencode
.graphify
graphify-out
.vscode
.idea
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.log
.DS_Store
*.md
