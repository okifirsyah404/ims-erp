---
import Cpu from "@lucide/astro/icons/cpu";
import Check from "@lucide/astro/icons/check";
import Media from "../ui/Media.astro";
import { hardwareLayer, integrationBenefits, platforms } from "../../data/solutions";
import { icons } from "../../lib/icons";

/** Integration Band (02.04): hardware layer → Entragate Core → software layer, plus benefits. */
const mobileHardware = hardwareLayer.filter((h) => h.mobileLabel);
---

<section class="bg-navy-950" aria-labelledby="integration-title">
  <div class="container-page flex flex-col gap-7 py-14 xl:gap-16 xl:py-28">
    <div class="flex flex-col gap-3 xl:items-center xl:gap-4 xl:text-center">
      <p class="text-[12px] font-bold tracking-[1.4px] text-cyan-400 uppercase xl:text-[13px] xl:tracking-[1.6px]">Integration</p>
      <h2
        id="integration-title"
        class="font-heading text-[28px] leading-8 font-bold tracking-[-0.7px] text-white xl:w-[760px] xl:text-[44px] xl:leading-[48px] xl:tracking-[-1.2px]"
      >
        Hardware and software that speak the same language
      </h2>
      <p class="text-[15px] leading-6 text-fg-on-dark-muted xl:w-[640px] xl:text-[17px] xl:leading-[27px]">
        <span class="xl:hidden">Entragate Core links every gate, reader and terminal to your software in real time.</span>
        <span class="hidden xl:inline">
          Entragate Core connects every gate, reader and terminal to your business software in real time — no middleware,
          no third-party integrators.
        </span>
      </p>
    </div>

    <!-- Desktop flow -->
    <div class="hidden items-center xl:flex">
      <div class="flex flex-1 flex-col gap-2.5">
        <p class="text-[12px] font-bold tracking-[1.2px] text-fg-on-dark-muted uppercase">Hardware layer</p>
        <ul class="flex flex-col gap-2.5">
          {
            hardwareLayer.map((item) => (
              <li class="flex items-center gap-3.5 rounded-md bg-white/4 p-2.5 text-[14px] font-semibold text-white ring-1 ring-white/8 ring-inset">
                <Media src={item.image} alt="" class="size-11 shrink-0 rounded-md bg-white" />
                {item.label}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex w-24 items-center" aria-hidden="true">
        <span class="h-0.5 flex-1 bg-[linear-gradient(90deg,#22D3EEFF_0%,#22D3EE00_100%)]"></span>
        <span class="size-2.5 rounded-pill bg-cyan-400"></span>
      </div>
      <div class="flex w-[340px] flex-col items-center gap-5 rounded-xl bg-navy-900 p-8 text-center shadow-[0_0_80px_#1F5BFF40] ring-1 ring-[#22D3EE55] ring-inset">
        <span class="flex size-[72px] items-center justify-center rounded-lg bg-blue-600 text-white">
          <Cpu size={34} aria-hidden="true" />
        </span>
        <h3 class="font-heading text-[24px] font-bold text-white">Entragate Core</h3>
        <p class="text-[14px] leading-[22px] text-fg-on-dark-muted">Unified device engine, identity database and event bus.</p>
        <dl class="flex w-full gap-2">
          <div class="flex flex-1 flex-col-reverse gap-0.5 rounded-md bg-white/5 p-3">
            <dt class="text-[11px] text-fg-on-dark-muted">Gate response</dt>
            <dd class="font-heading text-[20px] font-bold text-cyan-400">&lt;300ms</dd>
          </div>
          <div class="flex flex-1 flex-col-reverse gap-0.5 rounded-md bg-white/5 p-3">
            <dt class="text-[11px] text-fg-on-dark-muted">Uptime SLA</dt>
            <dd class="font-heading text-[20px] font-bold text-cyan-400">99.95%</dd>
          </div>
        </dl>
      </div>
      <div class="flex w-24 items-center" aria-hidden="true">
        <span class="h-0.5 flex-1 bg-[linear-gradient(90deg,#22D3EE00_0%,#22D3EEFF_100%)]"></span>
        <span class="size-2.5 rounded-pill bg-cyan-400"></span>
      </div>
      <div class="flex flex-1 flex-col gap-2.5">
        <p class="text-[12px] font-bold tracking-[1.2px] text-fg-on-dark-muted uppercase">Software layer</p>
        <ul class="flex flex-col gap-2.5">
          {
            platforms.map((platform) => {
              const Icon = icons[platform.icon];
              return (
                <li class="flex items-center gap-3 rounded-md bg-white/4 px-3.5 py-3 text-[14px] font-semibold text-white ring-1 ring-white/8 ring-inset">
                  <span class="flex size-8 items-center justify-center rounded-sm bg-blue-600/20 text-cyan-400">
                    <Icon size={16} aria-hidden="true" />
                  </span>
                  <span class="flex-1">{platform.layerLabel}</span>
                  <Check size={14} class="text-cyan-400" aria-label="Integrated" />
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>

    <!-- Mobile flow -->
    <div class="flex flex-col xl:hidden">
      <ul class="grid grid-cols-2 gap-2">
        {
          mobileHardware.map((item) => (
            <li class="flex items-center gap-2.5 rounded-md bg-white/4 p-2 text-[13px] font-semibold text-white ring-1 ring-white/8 ring-inset">
              <Media src={item.image} alt="" class="size-[34px] shrink-0 rounded-sm bg-white" />
              {item.mobileLabel}
            </li>
          ))
        }
      </ul>
      <span class="mx-auto h-7 w-0.5 bg-[linear-gradient(180deg,#22D3EE00_0%,#22D3EEFF_100%)]" aria-hidden="true"></span>
      <div class="flex items-center gap-4 rounded-lg bg-navy-900 p-5 shadow-[0_0_50px_#1F5BFF40] ring-1 ring-[#22D3EE55] ring-inset">
        <span class="flex size-[52px] shrink-0 items-center justify-center rounded-md bg-blue-600 text-white">
          <Cpu size={26} aria-hidden="true" />
        </span>
        <span class="flex flex-1 flex-col gap-1">
          <span class="font-heading text-[18px] font-bold text-white">Entragate Core</span>
          <span class="text-[12px] font-semibold text-cyan-400">&lt;300 ms gate response · 99.95% uptime</span>
        </span>
      </div>
      <span class="mx-auto h-7 w-0.5 bg-[linear-gradient(180deg,#22D3EEFF_0%,#22D3EE00_100%)]" aria-hidden="true"></span>
      <ul class="grid grid-cols-2 gap-2">
        {
          platforms.map((platform) => {
            const Icon = icons[platform.icon];
            return (
              <li class="flex items-center gap-2.5 rounded-md bg-white/4 px-3 py-[11px] text-[13px] font-semibold text-white ring-1 ring-white/8 ring-inset">
                <span class="flex size-7 items-center justify-center rounded-sm bg-blue-600/20 text-cyan-400">
                  <Icon size={14} aria-hidden="true" />
                </span>
                {platform.mobileLayerLabel}
              </li>
            );
          })
        }
      </ul>
    </div>

    <ul class="flex flex-col gap-5 border-t border-white/10 pt-6 xl:flex-row xl:gap-0 xl:pt-10">
      {
        integrationBenefits.map((benefit, index) => {
          const Icon = icons[benefit.icon];
          return (
            <li
              class:list={[
                "flex gap-3.5 xl:flex-1 xl:flex-col xl:gap-3",
                index === 0 ? "xl:pr-7" : "xl:border-l xl:border-white/10 xl:px-7",
              ]}
            >
              <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-white/6 text-cyan-400 xl:size-auto xl:justify-start xl:bg-transparent">
                <Icon size={22} class="size-[18px] xl:size-[22px]" aria-hidden="true" />
              </span>
              <span class="flex flex-1 flex-col gap-[3px] xl:gap-3">
                <span class="text-[15px] font-bold text-white xl:font-heading xl:text-[18px]">{benefit.title}</span>
                <span class="text-[13px] leading-5 text-fg-on-dark-muted xl:text-[14px] xl:leading-[22px]">
                  <span class="xl:hidden">{benefit.mobileDescription}</span>
                  <span class="hidden xl:inline">{benefit.description}</span>
                </span>
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
