ERP_API_BASE_URL=https://api.entragate.com
# Service token for server-to-server ERP calls (never exposed to the browser)
# ERP_API_TOKEN=
# demo = local sample data & accepted form submissions; erp = live ERP (default in production)
WEB_DATA_SOURCE=erp
# ERP_API_TIMEOUT_MS=15000
# ERP_RESPONSE_ENVELOPE=data
# Relative path of the ERP RFQ endpoint (other routes: src/lib/server/website/erp-routes.ts)
# ERP_RFQ_PATH=
# Production origins. Leave unset in development: the site then uses
# http://localhost:4321 (web) and http://localhost:4322 (Customer Portal).
PUBLIC_WEB_URL=https://entragate.com
PUBLIC_CUSTOMER_URL=https://customer.entragate.com
# Portal URL for the server-to-server sign-in exchange (internal network), defaults to PUBLIC_CUSTOMER_URL
# CUSTOMER_INTERNAL_URL=
# Shared secret for the checkout sign-in hand-off; same value as the portal's WEB_HANDOFF_SECRET (required in production)
WEB_HANDOFF_SECRET=
PUBLIC_WHATSAPP_NUMBER=6281280002020
