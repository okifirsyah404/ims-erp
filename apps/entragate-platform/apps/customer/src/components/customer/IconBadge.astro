---
/** Concentric icon badge used on auth screens (88/72px) and success sheets (80/64px). */
interface Props {
  tone?: "info" | "success";
  size?: "lg" | "md";
  class?: string;
}

const { tone = "info", size = "lg", class: className } = Astro.props;
const outer = size === "lg" ? "size-[88px]" : "size-20";
const inner = size === "lg" ? "size-[72px]" : "size-16";
const tones = tone === "info" ? ["bg-blue-100/50", "bg-blue-100 text-blue-600"] : ["bg-success-bg/60", "bg-success-bg text-success"];
---

<span class:list={["flex shrink-0 items-center justify-center rounded-pill", outer, tones[0], className]} aria-hidden="true">
  <span class:list={["flex items-center justify-center rounded-pill [&>svg]:size-[30px]", inner, tones[1]]}><slot /></span>
</span>
