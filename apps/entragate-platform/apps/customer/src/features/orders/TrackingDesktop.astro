---
import ChevronLeft from "@lucide/astro/icons/chevron-left";
import Share2 from "@lucide/astro/icons/share-2";
import Headset from "@lucide/astro/icons/headset";
import FileText from "@lucide/astro/icons/file-text";
import Plus from "@lucide/astro/icons/plus";
import Minus from "@lucide/astro/icons/minus";
import LocateFixed from "@lucide/astro/icons/locate-fixed";
import Truck from "@lucide/astro/icons/truck";
import MessageCircle from "@lucide/astro/icons/message-circle";
import Phone from "@lucide/astro/icons/phone";
import CalendarDays from "@lucide/astro/icons/calendar-days";
import MapPin from "@lucide/astro/icons/map-pin";
import Wrench from "@lucide/astro/icons/wrench";
import type { OrderDetail, OrderSummary } from "@entragate/api-client";
import AppButton from "../../components/customer/AppButton.astro";
import StatusChip from "../../components/customer/StatusChip.astro";
import Timeline from "../../components/customer/Timeline.astro";
import DocumentRow from "../../components/customer/DocumentRow.astro";
import Media from "../../components/customer/Media.astro";
import { orderChip } from "../../lib/status";

/** 06.03 Order Tracking — Desktop 1440: live map + ETA tiles, journey and documents. */
interface Props {
  order: OrderDetail;
  orders: OrderSummary[];
}

const { order, orders } = Astro.props;
const user = Astro.locals.user!;
const chip = orderChip(order.status, order.statusLabel);
const placed = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short" }).format(new Date(order.placedAt));
const shortNumber = (number: string) => number.replace("-2026-", "-");
const shortTitle = (title: string) => title.replace(/ × \d+.*$/, "").replace(/^Barrier Gate /, "");
const etaWindow = order.arrivalWindow.match(/\d{2}:\d{2} – \d{2}:\d{2}/)?.[0];
const [deliveryPlace] = order.delivery.address.split(" · ");
const live = Boolean(order.courier);
const tile = "flex flex-1 flex-col gap-2 rounded-card bg-white p-5 ring-1 ring-border ring-inset";
---

<div class="flex flex-col gap-6">
  <a href="/orders" class="flex items-center gap-1.5 self-start text-[14px] font-semibold text-fg-muted hover:text-fg">
    <ChevronLeft size={16} aria-hidden="true" />Orders
  </a>

  <div class="flex items-end justify-between gap-2.5">
    <div class="flex flex-col gap-2">
      <div class="flex gap-2">
        <StatusChip label={`${chip.label} · ${order.stepLabel}`} tone={chip.tone} />
        {live && <StatusChip label="Live" tone="success" />}
      </div>
      <h1 class="font-heading text-[32px] font-extrabold tracking-[-0.8px] text-fg">{order.title}</h1>
      <p class="text-[14px] text-fg-muted">Order {order.number} · placed {placed}{user.company ? ` · ${user.company.name}` : ""}</p>
    </div>
    <div class="flex gap-2.5">
      <AppButton variant="outline" data-share={`/track?order=${encodeURIComponent(order.number.replace("#", ""))}`}><Share2 slot="icon" size={18} aria-hidden="true" />Share tracking</AppButton>
      <AppButton variant="outline" href={`/support/new?order=${order.id}`}><Headset slot="icon" size={18} aria-hidden="true" />Contact support</AppButton>
      <AppButton href={`/orders/${order.id}`}><FileText slot="icon" size={18} aria-hidden="true" />Order details</AppButton>
    </div>
  </div>

  <nav aria-label="Shipments" class="flex flex-wrap gap-2">
    {
      orders.map((o) => {
        const active = o.id === order.id;
        return (
          <a
            href={`/tracking?order=${o.id}`}
            aria-current={active ? "page" : undefined}
            class:list={[
              "flex items-center gap-1.5 rounded-pill px-4 py-[9px] text-[13px] font-semibold",
              active ? "bg-navy-900 text-white" : "bg-white text-fg-secondary ring-1 ring-border ring-inset hover:text-fg",
            ]}
          >
            {active && <span class="size-[7px] rounded-full bg-cyan-400" aria-hidden="true" />}
            {shortNumber(o.number)} · {shortTitle(o.title)}
          </a>
        );
      })
    }
  </nav>

  <div class="flex items-start gap-6">
    <div class="flex min-w-0 flex-1 flex-col gap-6">
      <section aria-label="Live location" class="relative isolate flex h-[460px] flex-col justify-between overflow-hidden rounded-xl p-5">
        <Media alt="Map showing the shipment's current position" class="absolute inset-0 -z-10 size-full" />
        <div class="flex items-start justify-between gap-2.5">
          {live ? <StatusChip tone="success" label={order.courier!.updatedLabel} class="!bg-white" /> : <StatusChip tone="neutral" label={order.stepLabel} class="!bg-white" />}
          <div class="flex gap-2" aria-hidden="true">
            {[Plus, Minus, LocateFixed].map((Icon) => (
              <span class="flex size-10 items-center justify-center rounded-pill bg-white text-fg shadow-[0_2px_8px_#0A1A3F14]"><Icon size={20} /></span>
            ))}
          </div>
        </div>
        {
          order.courier ? (
            <div class="flex w-[460px] items-center gap-3 rounded-lg bg-white/95 p-3.5 shadow-[0_8px_24px_#0A1A3F26] backdrop-blur-[8px]">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-md bg-navy-900 text-white" aria-hidden="true"><Truck size={22} /></span>
              <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="text-[15px] font-bold text-fg">{order.courier.name} · {order.courier.vehicle}</span>
                <span class="text-[12.5px] text-fg-muted">{order.courier.distanceLabel} from site · AWB {order.delivery.awb}</span>
              </span>
              <a href={`/support/new?order=${order.id}`} class="flex size-10 items-center justify-center rounded-pill bg-blue-50 text-blue-600" aria-label="Message about this delivery">
                <MessageCircle size={20} aria-hidden="true" />
              </a>
              <a href={`tel:${order.courier.phone ?? "+622188992020"}`} class="flex size-10 items-center justify-center rounded-pill bg-blue-600 text-white" aria-label="Call courier">
                <Phone size={20} aria-hidden="true" />
              </a>
            </div>
          ) : (
            <p class="w-[460px] rounded-lg bg-white/95 p-3.5 text-[13px] text-fg-secondary">Live courier location appears once the order ships.</p>
          )
        }
      </section>

      <dl class="flex gap-4">
        <div class={tile}>
          <dt class="flex items-center gap-1.5 text-[12.5px] font-semibold text-fg-muted"><CalendarDays size={15} aria-hidden="true" />Estimated arrival</dt>
          <dd class="font-heading text-[17px] font-extrabold text-fg">{order.arrivalLabel.replace(/^Arriving /, "")}</dd>
          <dd class="text-[13px] text-fg-secondary">{etaWindow ? `${etaWindow} window` : order.arrivalWindow}</dd>
        </div>
        <div class={tile}>
          <dt class="flex items-center gap-1.5 text-[12.5px] font-semibold text-fg-muted"><MapPin size={15} aria-hidden="true" />Delivery to</dt>
          <dd class="font-heading text-[17px] font-extrabold text-fg">{order.delivery.site}</dd>
          <dd class="text-[13px] text-fg-secondary">{[deliveryPlace, order.delivery.pic].filter(Boolean).join(" · ")}</dd>
        </div>
        {
          order.installation && (
            <div class={tile}>
              <dt class="flex items-center gap-1.5 text-[12.5px] font-semibold text-fg-muted"><Wrench size={15} aria-hidden="true" />Installation</dt>
              <dd class="font-heading text-[17px] font-extrabold text-fg">{order.installation.label}</dd>
              <dd class="text-[13px] text-fg-secondary">{order.installation.detail}</dd>
            </div>
          )
        }
      </dl>
    </div>

    <aside class="flex w-[420px] shrink-0 flex-col gap-6">
      <section class="flex flex-col gap-4 rounded-card bg-white p-[22px] shadow-[0_6px_18px_#0A1A3F0A] ring-1 ring-border ring-inset" aria-labelledby="journey-title">
        <h2 id="journey-title" class="font-heading text-[17px] font-bold text-fg">Shipment journey</h2>
        <div class="flex flex-col gap-2">
          <div class="flex justify-between text-[13px]">
            <span class="font-semibold text-fg-secondary">Step {order.step} of {order.stepCount}</span>
            <span class="font-bold text-fg">{Math.round(order.progress * 100)}%</span>
          </div>
          <span class="h-2 overflow-hidden rounded-pill bg-surface-2">
            <span class="block h-full rounded-pill bg-[linear-gradient(90deg,var(--eg-blue-600),var(--eg-cyan-400))]" style={`width:${order.progress * 100}%`} />
          </span>
        </div>
        <Timeline steps={order.timeline} />
      </section>
      {
        order.documents.length > 0 && (
          <section class="flex flex-col rounded-card bg-white py-1.5 ring-1 ring-border ring-inset" aria-label="Documents">
            {order.documents.slice(0, 2).map((document, index) => (
              <>
                {index > 0 && <span class="h-px bg-border" />}
                <DocumentRow document={document} />
              </>
            ))}
          </section>
        )
      }
    </aside>
  </div>
</div>
