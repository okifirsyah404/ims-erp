---
import { actions, isInputError } from "astro:actions";
import KeyRound from "@lucide/astro/icons/key-round";
import Mail from "@lucide/astro/icons/mail";
import Phone from "@lucide/astro/icons/phone";
import Headset from "@lucide/astro/icons/headset";
import AuthLayout from "../layouts/AuthLayout.astro";
import { authBrands } from "../layouts/auth-brand";
import TopBar from "../components/customer/TopBar.astro";
import IconBadge from "../components/customer/IconBadge.astro";
import AppField from "../components/customer/AppField.astro";
import ResetSentSheet from "../features/auth/ResetSentSheet";

/** 04.04 Forgot password (+ 04.04b sheet). Method switches between email and WhatsApp/SMS. */
const result = Astro.getActionResult(actions.auth.forgotPassword);
const method = Astro.url.searchParams.get("via") === "phone" ? "phone" : "email";
const errors = result?.error && isInputError(result.error) ? result.error.fields : {};
const formError = result?.error && !isInputError(result.error) ? result.error.message : undefined;
---

<AuthLayout title="Forgot password" brand={authBrands.forgot}>
  <TopBar back="/login" />
  <div class="flex flex-1 flex-col gap-6 px-6 pt-4 pb-[max(24px,env(safe-area-inset-bottom))]">
    <IconBadge><KeyRound /></IconBadge>
    <div class="flex flex-col gap-2">
      <h1 class="font-heading text-[26px] leading-[31px] font-extrabold tracking-[-0.6px] text-fg">Forgot your password?</h1>
      <p class="text-[15px] leading-[22px] text-fg-secondary">
        Enter the {method === "email" ? "email" : "phone number"} linked to your account. We’ll send a secure link to reset it.
      </p>
    </div>

    <nav aria-label="Reset method" class="flex h-11 gap-1 rounded-md bg-surface-2 p-1">
      <a href="/forgot-password" aria-current={method === "email" ? "true" : undefined} class:list={["flex flex-1 items-center justify-center rounded-md text-[14px]", method === "email" ? "bg-white font-semibold text-fg shadow-[0_2px_6px_#0A1A3F14]" : "font-medium text-fg-muted"]}>Email</a>
      <a href="/forgot-password?via=phone" aria-current={method === "phone" ? "true" : undefined} class:list={["flex flex-1 items-center justify-center rounded-md text-[14px]", method === "phone" ? "bg-white font-semibold text-fg shadow-[0_2px_6px_#0A1A3F14]" : "font-medium text-fg-muted"]}>WhatsApp / SMS</a>
    </nav>

    <form method="POST" action={actions.auth.forgotPassword} id="forgot-form" class="flex flex-col gap-6" novalidate>
      <input type="hidden" name="method" value={method} />
      {
        method === "email" ? (
          <AppField label="Email address" name="email" type="email" autocomplete="email" inputmode="email" required autofocus placeholder="you@company.co.id" error={errors.email?.[0] ?? formError}>
            <Mail slot="icon" />
          </AppField>
        ) : (
          <AppField label="Phone number" name="phone" type="tel" autocomplete="tel" inputmode="tel" required autofocus placeholder="+62 812 3456 7890" error={errors.phone?.[0] ?? formError}>
            <Phone slot="icon" />
          </AppField>
        )
      }
      <button type="submit" class="flex h-[54px] items-center justify-center rounded-control bg-blue-600 text-[16px] font-semibold text-white hover:bg-blue-700">
        Send reset link
      </button>
    </form>
    <a href="mailto:support@entragate.co.id" class="flex items-center justify-center gap-1.5 text-[13.5px] font-medium text-fg-muted">
      <Headset size={16} aria-hidden="true" />
      Can’t access your {method === "email" ? "email" : "phone"}? Contact support
    </a>
  </div>
  {result?.data && <ResetSentSheet client:load masked={result.data.masked} method={result.data.method} resendFormId="forgot-form" />}
</AuthLayout>
