---
import ChevronLeft from "@lucide/astro/icons/chevron-left";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Phone from "@lucide/astro/icons/phone";
import { PUBLIC_SUPPORT_PHONE, PUBLIC_SUPPORT_WHATSAPP } from "astro:env/client";
import CustomerLayout from "../../layouts/CustomerLayout.astro";
import IconButton from "../../components/customer/IconButton.astro";
import Avatar from "../../components/customer/Avatar.astro";
import StatusChip from "../../components/customer/StatusChip.astro";
import ChatComposer from "../../features/support/ChatComposer";
import Conversation from "../../features/support/Conversation.astro";
import SupportDesktop from "../../features/support/SupportDesktop.astro";
import ConfirmFix from "../../features/support/ConfirmFix.astro";
import { supportService } from "../../services";
import { filterTickets, priorityLabel } from "../../lib/support";
import { ticketChip } from "../../lib/status";

/** 08.03 Ticket Conversation. */
const tokens = Astro.locals.tokens!;
const [ticket, all] = await Promise.all([supportService.get(tokens, Astro.params.id ?? ""), supportService.list(tokens)]);
if (!ticket) return Astro.rewrite("/404");
const filtered = filterTickets(all, Astro.url);
const whatsapp = PUBLIC_SUPPORT_WHATSAPP ? `https://wa.me/${PUBLIC_SUPPORT_WHATSAPP.replace(/\D/g, "")}` : undefined;

const chip = ticketChip[ticket.status];
const stages = ["Created", "Assigned", "Diagnosed", "Visit", "Resolved"];
const open = ticket.status !== "resolved";
const lastSpoken = ticket.messages.findLast((m) => "from" in m);
const quickReplies = open && lastSpoken && "from" in lastSpoken && lastSpoken.from === "agent" ? ticket.quickReplies : [];
const agentFirstName = ticket.agent.name.split(" ")[0];
---

<CustomerLayout title={`${ticket.number} · Support`} section="support" mainClass={open ? "max-xl:!pb-[110px]" : undefined} desktop="full">
  {/* ERP-0092: the thread checks for new replies every 15 s (see scripts/ticket-poll.ts). */}
  <span hidden data-ticket-poll={ticket.id} data-messages={ticket.messages.length} data-status={ticket.status} data-can-confirm={String(Boolean(ticket.canConfirm))}></span>
  <button
    type="button"
    hidden
    data-ticket-news
    class="fixed top-3 left-1/2 z-40 -translate-x-1/2 rounded-pill bg-blue-600 px-4 py-2 text-[13px] font-semibold text-white shadow-[0_8px_24px_#0A1A3F33]"
  >
    New messages · Refresh
  </button>
  <div class="hidden xl:block">
    <SupportDesktop list={filtered.list} openCount={filtered.open.length} tab={filtered.tab} query={filtered.query} ticket={ticket} whatsapp={whatsapp} />
  </div>
  <div class="xl:hidden">
  <header class="sticky top-0 z-20 bg-white">
    <div class="flex items-center gap-3 px-4 pt-1.5 pb-2.5">
      <IconButton label="Back" href="/support" data-back><ChevronLeft size={20} aria-hidden="true" /></IconButton>
      <span class="relative">
        <Avatar initials={ticket.agent.initials} size={42} class="!text-[15px]" />
        {ticket.agent.online && <span class="absolute top-[30px] left-[30px] size-3 rounded-full bg-success ring-2 ring-white" />}
      </span>
      <span class="flex min-w-0 flex-1 flex-col gap-px">
        <span class="truncate text-[15px] font-bold text-fg">{ticket.agent.name}</span>
        <span class:list={["truncate text-[12px] font-medium", ticket.agent.online ? "text-success" : "text-fg-muted"]}>{ticket.agent.replyLabel}</span>
      </span>
      {
        PUBLIC_SUPPORT_PHONE ? (
          <IconButton label="Call support" href={`tel:${PUBLIC_SUPPORT_PHONE.replace(/[^\d+]/g, "")}`}><Phone size={20} aria-hidden="true" /></IconButton>
        ) : (
          <IconButton label="Call support" disabled title="Support hotline is not configured"><Phone size={20} aria-hidden="true" /></IconButton>
        )
      }
    </div>

    <div class="flex flex-col gap-3 border-y border-border bg-surface px-4 py-3">
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center gap-2.5 [&::-webkit-details-marker]:hidden">
          <StatusChip label={chip.label} tone={chip.tone} class="!bg-white" />
          <span class="min-w-0 flex-1 truncate text-[13px] leading-[19px] font-semibold text-fg">{ticket.number} · {ticket.shortSubject ?? ticket.subject}</span>
          <ChevronDown size={16} class="text-fg-muted transition-transform group-open:rotate-180" aria-hidden="true" />
          <span class="sr-only">Show ticket details</span>
        </summary>
        <dl class="mt-3 flex flex-col gap-1.5 text-[13px]">
          <div class="flex gap-2"><dt class="w-16 shrink-0 text-fg-muted">Subject</dt><dd class="font-medium text-fg">{ticket.subject}</dd></div>
          <div class="flex gap-2"><dt class="w-16 shrink-0 text-fg-muted">Priority</dt><dd class:list={["font-medium", ticket.priority === "urgent" ? "text-danger" : "text-fg"]}>{priorityLabel[ticket.priority]}</dd></div>
        </dl>
      </details>
      <ol class="flex" aria-label="Ticket progress">
        {
          stages.map((stage, index) => {
            const done = index <= ticket.stage;
            const current = index === ticket.stage;
            return (
              <li class="flex flex-1 flex-col items-center gap-1.5" aria-current={current ? "step" : undefined}>
                <span class="flex w-full items-center">
                  <span class:list={["h-0.5 flex-1", index === 0 ? "bg-transparent" : done ? "bg-blue-600" : "bg-border-strong"]} />
                  <span class:list={["size-2.5 rounded-full", done ? "bg-blue-600" : "bg-border-strong", current && "ring-3 ring-[#DCE6FF]"]} />
                  <span class:list={["h-0.5 flex-1", index === stages.length - 1 ? "bg-transparent" : index < ticket.stage ? "bg-blue-600" : "bg-border-strong"]} />
                </span>
                <span class:list={["text-[10.5px]", current ? "font-bold text-blue-600" : done ? "font-medium text-fg-secondary" : "font-medium text-fg-muted"]}>{stage}</span>
              </li>
            );
          })
        }
      </ol>
    </div>
  </header>

  <Conversation messages={ticket.messages} class="p-4" />
  {ticket.canConfirm && <ConfirmFix ticketId={ticket.id} class="mx-4 mb-4" />}

  {
    open ? (
      <div class="px-4 pb-4">
        <ChatComposer client:load ticketId={ticket.id} agentFirstName={agentFirstName} quickReplies={quickReplies} />
      </div>
    ) : (
      <p class="mx-4 mb-6 rounded-md bg-surface p-3.5 text-center text-[13px] text-fg-secondary">
        This ticket is resolved. <a href="/support/new" class="font-semibold text-blue-600">Open a new ticket</a> if the issue comes back.
      </p>
    )
  }
  </div>
</CustomerLayout>

<script>
  import "../../scripts/back";
  import "../../scripts/ticket-poll";

  // Land at the newest message, like a native chat.
  const latest = document.getElementById("latest");
  if (latest) requestAnimationFrame(() => latest.scrollIntoView({ block: "end" }));
</script>
