---
import { actions } from "astro:actions";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import AuthLayout from "../../layouts/AuthLayout.astro";
import { authBrands } from "../../layouts/auth-brand";
import TopBar from "../../components/customer/TopBar.astro";
import IconBadge from "../../components/customer/IconBadge.astro";
import OtpField from "../../features/auth/OtpField";
import { safeNext } from "../../services/auth";
import { portalMode } from "../../services/portal";
import { DEMO_OTP_CODE } from "../../services/portal/demo";

/** Two-step sign-in (ERP-0081): the 6-digit code emailed after the password. */
const verified = Astro.getActionResult(actions.auth.verifyLoginCode);
if (verified?.data) {
  const returnTo = await Astro.session?.get("returnTo");
  Astro.session?.delete("returnTo");
  return Astro.redirect(safeNext(returnTo), 303);
}
const resent = Astro.getActionResult(actions.auth.resendLoginCode);

const pending = await Astro.session?.get("pendingSignIn");
if (!pending) return Astro.redirect("/login", 303);
const error = verified?.error?.message ?? resent?.error?.message;
---

<AuthLayout title="Enter your sign-in code" brand={authBrands.verify}>
  <TopBar back="/login" />
  <div class="flex flex-1 flex-col gap-6 px-6 pt-4 pb-[max(24px,env(safe-area-inset-bottom))]">
    <IconBadge><ShieldCheck /></IconBadge>
    <div class="flex flex-col gap-2">
      <h1 class="font-heading text-[26px] leading-[38px] font-extrabold tracking-[-0.6px] text-fg">Check your email</h1>
      <p class="text-[15px] leading-[22px] text-fg-secondary">
        2-step verification is on. Enter the 6-digit code we sent to <span class="break-all font-semibold text-fg">{pending.email}</span>.
      </p>
    </div>

    <form method="POST" action={actions.auth.verifyLoginCode} class="flex flex-col gap-6" id="otp-form">
      <OtpField client:load name="code" invalid={Boolean(verified?.error)} />
      {error && <p role="alert" class="-mt-3 text-[13px] font-semibold text-danger">{error}</p>}
      {resent?.data && <p role="status" class="-mt-3 text-[13px] font-semibold text-success">A new code is on its way.</p>}
    </form>

    <form method="POST" action={actions.auth.resendLoginCode} class="flex items-center justify-between gap-2.5 text-[14px]">
      <span class="text-fg-muted">Didn’t get it?</span>
      <button type="submit" class="font-semibold text-fg-muted enabled:text-blue-600" disabled data-resend data-seconds="30">
        Resend code in 0:30
      </button>
    </form>

    <button type="submit" form="otp-form" class="flex h-[54px] items-center justify-center rounded-control bg-blue-600 text-[16px] font-semibold text-white hover:bg-blue-700">
      Verify &amp; sign in
    </button>
    <p class="text-center text-[13px] text-fg-muted">The code expires in 10 minutes. After 5 wrong tries, sign in again.</p>
    {portalMode === "demo" && <p class="rounded-md bg-surface p-3 text-center text-[12px] text-fg-muted">Demo mode · code <strong class="text-fg">{DEMO_OTP_CODE}</strong></p>}
  </div>
</AuthLayout>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-resend]");
  if (button) {
    let seconds = Number(button.dataset.seconds ?? 30);
    const tick = () => {
      if (seconds <= 0) {
        button.disabled = false;
        button.textContent = "Resend code";
        return;
      }
      button.textContent = `Resend code in 0:${String(seconds).padStart(2, "0")}`;
      seconds -= 1;
      setTimeout(tick, 1000);
    };
    tick();
  }
</script>
