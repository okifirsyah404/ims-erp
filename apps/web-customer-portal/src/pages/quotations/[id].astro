---
import Download from "@lucide/astro/icons/download";
import Calendar from "@lucide/astro/icons/calendar";
import Hourglass from "@lucide/astro/icons/hourglass";
import Truck from "@lucide/astro/icons/truck";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Wallet from "@lucide/astro/icons/wallet";
import FileDown from "@lucide/astro/icons/file-down";
import PenLine from "@lucide/astro/icons/pen-line";
import MessageCircle from "@lucide/astro/icons/message-circle";
import UserRound from "@lucide/astro/icons/user-round";
import CustomerLayout from "../../layouts/CustomerLayout.astro";
import TopBar from "../../components/customer/TopBar.astro";
import IconButton from "../../components/customer/IconButton.astro";
import StatusChip from "../../components/customer/StatusChip.astro";
import SectionHeader from "../../components/customer/SectionHeader.astro";
import ListRow from "../../components/customer/ListRow.astro";
import IconTile from "../../components/customer/IconTile.astro";
import BottomActionBar from "../../components/customer/BottomActionBar.astro";
import QuotationSheets from "../../features/quotations/QuotationSheets";
import QuotationDesktop from "../../features/quotations/QuotationDesktop.astro";
import { quotationsService } from "../../services";
import { revisionTopics } from "../../lib/quotations";
import { formatRupiah } from "../../lib/format";
import { quotationChip } from "../../lib/status";

/** 05.06 Quotation Details & Approval (+ 05.06b/c sheets). */
const quote = await quotationsService.get(Astro.locals.tokens!, Astro.params.id ?? "");
if (!quote) return Astro.rewrite("/404");

const actionable = quote.status === "needs_approval" || quote.status === "revised";
const chip = quote.status === "needs_approval" ? { label: "Awaiting your approval", tone: "warning" as const } : quotationChip[quote.status];
const VISIBLE_LINES = 4;
const grandTotal = quote.total;
const shortTitle = (quote.shortTitle ?? quote.title).replace(" · ", " ");
const meta = [
  { icon: Calendar, label: "Issued", value: quote.issuedLabel, tone: "text-fg" },
  { icon: Hourglass, label: "Valid until", value: quote.validUntilLabel, tone: actionable ? "text-warning" : "text-fg" },
  { icon: Truck, label: "Delivery", value: quote.deliveryLabel, tone: "text-fg" },
];
---

<CustomerLayout title={quote.number} actionBar={actionable} section="orders" desktop="full">
  <div class="hidden xl:block"><QuotationDesktop quote={quote} /></div>
  <div class="xl:hidden">
  <TopBar title={quote.number} back="/quotations">
    <IconButton slot="action" label="Download PDF" disabled title="PDF will be available once connected to the ERP"><Download size={20} aria-hidden="true" /></IconButton>
  </TopBar>

  <div class="flex flex-col gap-5 px-5 pt-2 pb-6">
    <section class="flex flex-col gap-4 rounded-card bg-surface p-5">
      <div class="flex items-center justify-between gap-2.5">
        <StatusChip label={chip.label} tone={chip.tone} />
        <StatusChip label={`v${quote.version}`} tone="neutral" class="!text-fg-secondary" />
      </div>
      <h1 class="font-heading text-[20px] leading-[25px] font-extrabold tracking-[-0.4px] text-fg">{quote.heading}</h1>
      <div class="flex flex-col gap-0.5">
        <span class="text-[12.5px] font-medium text-fg-muted">Total incl. PPN 11%</span>
        <span class="font-heading text-[30px] font-extrabold tracking-[-0.8px] text-navy-900">{formatRupiah(grandTotal)}</span>
      </div>
      <dl class="flex gap-2">
        {
          meta.map(({ icon: Icon, label, value, tone }) => (
            <div class="flex flex-1 flex-col gap-1 rounded-md bg-white p-3">
              <dt class="flex items-center gap-[5px] text-[11px] font-semibold text-fg-muted"><Icon size={12} aria-hidden="true" />{label}</dt>
              <dd class:list={["text-[14px] font-bold", tone]}>{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      quote.lines.length > 0 && (
        <>
          <SectionHeader title="Itemized pricing" linkLabel={`${quote.lineCount} items`} />
          <ul class="flex flex-col gap-5" data-lines>
            {quote.lines.map((line, index) => (
              <li class="flex flex-col gap-2.5 rounded-card bg-white p-4 ring-1 ring-border ring-inset" hidden={index >= VISIBLE_LINES} data-extra={index >= VISIBLE_LINES ? "" : undefined}>
                <div class="flex justify-between gap-3">
                  <div class="flex flex-col gap-[3px]">
                    <span class="text-[14.5px] leading-[21px] font-bold text-fg">{line.name}</span>
                    <span class="text-[12.5px] text-fg-muted">{line.detail}</span>
                  </div>
                  <span class="text-[14.5px] font-bold whitespace-nowrap text-fg">{formatRupiah(line.amount)}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="rounded-sm bg-surface px-2 py-[3px] text-[12px] font-bold text-fg-secondary">× {line.quantity}</span>
                  <span class="text-[12.5px] text-fg-muted">@ {formatRupiah(line.unitPrice)}</span>
                </div>
              </li>
            ))}
          </ul>
          {quote.lines.length > VISIBLE_LINES && (
            <button type="button" class="-mt-1 flex items-center justify-center gap-1.5 py-1 text-[14px] font-semibold text-blue-600" data-show-lines aria-expanded="false">
              Show {quote.lines.length - VISIBLE_LINES} more items
              <ChevronDown size={16} aria-hidden="true" />
            </button>
          )}
        </>
      )
    }

    <SectionHeader title="Price breakdown" />
    <dl class="flex flex-col gap-3 rounded-card bg-white p-[18px] text-[14px] ring-1 ring-border ring-inset">
      {
        quote.breakdown.map((row) => (
          <div class="flex justify-between gap-2.5">
            <dt class="text-fg-muted">{row.label}</dt>
            <dd class:list={["font-semibold", row.tone === "success" ? "text-success" : "text-fg"]}>
              {row.amount < 0 ? `– ${formatRupiah(-row.amount)}` : formatRupiah(row.amount)}
            </dd>
          </div>
        ))
      }
      <span class="h-px bg-border" aria-hidden="true"></span>
      <div class="flex items-center justify-between gap-2.5">
        <dt class="text-[15px] font-bold text-fg">Grand total</dt>
        <dd class="font-heading text-[19px] font-extrabold text-navy-900">{formatRupiah(grandTotal)}</dd>
      </div>
    </dl>

    {
      quote.milestones.length > 0 && (
        <>
          <SectionHeader title="Payment milestones" />
          <ol class="flex flex-col rounded-card bg-white px-[18px] pt-[18px] ring-1 ring-border ring-inset">
            {quote.milestones.map((m, index) => (
              <li class="flex gap-3.5">
                <span class="flex w-6 flex-col items-center">
                  <span class="flex size-6 items-center justify-center rounded-pill bg-blue-50 text-blue-600"><Wallet size={13} aria-hidden="true" /></span>
                  {index < quote.milestones.length - 1 && <span class="w-0.5 flex-1 bg-blue-100" />}
                </span>
                <span class="flex flex-1 flex-col gap-1 pt-0.5 pb-[22px]">
                  <span class="flex justify-between gap-3">
                    <span class="text-[15px] font-semibold text-fg">{m.label}</span>
                    <span class="text-[13.5px] font-bold whitespace-nowrap text-fg">{formatRupiah(m.amount)}</span>
                  </span>
                  <span class="text-[13px] leading-[19px] text-fg-secondary">{m.note}</span>
                </span>
              </li>
            ))}
          </ol>
        </>
      )
    }

    <div class="flex gap-2.5">
      <span class="flex flex-1 flex-col items-center gap-2 rounded-lg bg-surface px-2 py-3.5 text-[12px] font-semibold text-fg-secondary/60" title="Available once connected to the ERP">
        <FileDown size={20} class="text-blue-600/60" aria-hidden="true" />
        Download PDF
      </span>
      {
        actionable ? (
          <a href="#revise" class="flex flex-1 flex-col items-center gap-2 rounded-lg bg-surface px-2 py-3.5 text-[12px] font-semibold text-fg-secondary">
            <PenLine size={20} class="text-blue-600" aria-hidden="true" />
            Request revision
          </a>
        ) : (
          <span class="flex flex-1 flex-col items-center gap-2 rounded-lg bg-surface px-2 py-3.5 text-[12px] font-semibold text-fg-secondary/60">
            <PenLine size={20} class="text-blue-600/60" aria-hidden="true" />
            Request revision
          </span>
        )
      }
      <a href={`/support/new?quotation=${quote.id}`} class="flex flex-1 flex-col items-center gap-2 rounded-lg bg-surface px-2 py-3.5 text-[12px] font-semibold text-fg-secondary">
        <MessageCircle size={20} class="text-blue-600" aria-hidden="true" />
        Contact sales
      </a>
    </div>

    <div class="flex flex-col rounded-card bg-white py-1 ring-1 ring-border ring-inset">
      <ListRow title={quote.accountManager.name} subtitle={`${quote.accountManager.role} · ${quote.accountManager.replyLabel}`} trailing="Chat" trailingClass="text-blue-600" href={`/support/new?quotation=${quote.id}`}>
        <IconTile slot="icon" tone="navy" radius="full"><UserRound size={20} /></IconTile>
      </ListRow>
    </div>
  </div>
  </div>

  {
    actionable && (
      <>
        <BottomActionBar slot="overlay" class="xl:hidden" summaryLabel="Total incl. PPN 11%" summaryValue={formatRupiah(grandTotal)}>
          <a href="#revise" class="flex h-[54px] flex-1 items-center justify-center rounded-control bg-white text-[16px] font-semibold text-fg ring-1 ring-border ring-inset">Revise</a>
          <a href="#accept" class="flex h-[54px] flex-1 items-center justify-center rounded-control bg-blue-600 text-[16px] font-semibold text-white">Accept quotation</a>
        </BottomActionBar>
        <QuotationSheets
          slot="overlay"
          client:idle
          id={quote.id}
          number={quote.number}
          shortTitle={shortTitle}
          version={quote.version}
          total={grandTotal}
          downPaymentRate={quote.downPaymentRate}
          downPaymentDue={quote.downPaymentDue}
          approvers={quote.approvers}
          companyName={quote.companyName}
          managerName={quote.accountManager.name}
          topics={revisionTopics}
        />
      </>
    )
  }
</CustomerLayout>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-show-lines]");
  button?.addEventListener("click", () => {
    document.querySelectorAll<HTMLElement>("[data-extra]").forEach((el) => (el.hidden = false));
    button.remove();
  });
</script>
