---
import Plus from "@lucide/astro/icons/plus";
import MapPin from "@lucide/astro/icons/map-pin";
import UserRound from "@lucide/astro/icons/user-round";
import PenLine from "@lucide/astro/icons/pen-line";
import CustomerLayout from "../../layouts/CustomerLayout.astro";
import TopBar from "../../components/customer/TopBar.astro";
import IconButton from "../../components/customer/IconButton.astro";
import StatusChip from "../../components/customer/StatusChip.astro";
import AppButton from "../../components/customer/AppButton.astro";
import ConfirmAction from "../../features/account/ConfirmAction";
import { customerService } from "../../services";

/** Sites & addresses — delivery/installation sites with on-site PIC. */
const { sites } = await customerService.account(Astro.locals.tokens!);
---

<CustomerLayout title="Sites & addresses" tab="profile">
  <TopBar title="Sites & addresses" back="/profile">
    <IconButton slot="action" label="Add a site" href="/sites/new"><Plus size={20} aria-hidden="true" /></IconButton>
  </TopBar>
  <div class="flex flex-col gap-4 px-5 pt-1 pb-6">
    <p class="text-[13.5px] text-fg-secondary">Deliveries, installations and service visits are scheduled to these sites. The PIC is contacted on arrival.</p>
    {
      sites.length === 0 ? (
        <div class="flex flex-col items-center gap-3 rounded-card bg-surface px-6 py-10 text-center">
          <MapPin size={28} class="text-blue-600" aria-hidden="true" />
          <p class="font-heading text-[17px] font-bold text-fg">No sites yet</p>
          <p class="text-[14px] text-fg-secondary">Add your office, warehouse or project locations.</p>
        </div>
      ) : (
        <ul class="flex flex-col gap-3.5">
          {sites.map((site) => (
            <li class="app-card flex flex-col gap-3 p-4">
              <div class="flex items-start justify-between gap-3">
                <div class="flex min-w-0 flex-col gap-1">
                  <h2 class="text-[15.5px] font-bold text-fg">{site.name}</h2>
                  <p class="flex gap-1.5 text-[13px] leading-[19px] text-fg-secondary">
                    <MapPin size={14} class="mt-0.5 shrink-0 text-fg-muted" aria-hidden="true" />
                    {site.address}
                  </p>
                </div>
                {site.primary && <StatusChip label="Primary" tone="info" />}
              </div>
              <p class="flex items-center gap-1.5 rounded-md bg-surface px-3 py-2 text-[12.5px] font-medium text-fg-secondary">
                <UserRound size={14} aria-hidden="true" />PIC {site.picName} · {site.picPhone}
              </p>
              <div class="flex items-center justify-between gap-3">
                <a href={`/sites/${site.id}`} class="flex items-center gap-1.5 text-[13.5px] font-semibold text-blue-600"><PenLine size={14} aria-hidden="true" />Edit</a>
                {!site.primary && (
                  <ConfirmAction
                    client:visible
                    operation="deleteSite"
                    id={site.id}
                    triggerLabel="Remove"
                    title={`Remove ${site.name}?`}
                    description="Devices registered at this site stay registered. Future deliveries need another site."
                    confirmLabel="Remove site"
                  />
                )}
              </div>
            </li>
          ))}
        </ul>
      )
    }
    <AppButton variant="soft" href="/sites/new" block><Plus slot="icon" size={18} aria-hidden="true" />Add a site</AppButton>
  </div>
</CustomerLayout>
