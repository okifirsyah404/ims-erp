---
import { webUrl } from "../../lib/urls";
import Share2 from "@lucide/astro/icons/share-2";
import Route from "@lucide/astro/icons/route";
import Phone from "@lucide/astro/icons/phone";
import MapPin from "@lucide/astro/icons/map-pin";
import Truck from "@lucide/astro/icons/truck";
import Headset from "@lucide/astro/icons/headset";
import RotateCcw from "@lucide/astro/icons/rotate-ccw";
import CustomerLayout from "../../layouts/CustomerLayout.astro";
import TopBar from "../../components/customer/TopBar.astro";
import IconButton from "../../components/customer/IconButton.astro";
import StatusChip from "../../components/customer/StatusChip.astro";
import SectionHeader from "../../components/customer/SectionHeader.astro";
import ListRow from "../../components/customer/ListRow.astro";
import IconTile from "../../components/customer/IconTile.astro";
import Media from "../../components/customer/Media.astro";
import DocumentRow from "../../components/customer/DocumentRow.astro";
import BottomActionBar from "../../components/customer/BottomActionBar.astro";
import CopyButton from "../../components/customer/CopyButton";
import { portal } from "../../services/portal";
import { formatRupiah } from "../../lib/format";
import { orderChip } from "../../lib/status";

/** 05.04 Order Details. */
const order = await portal.getOrder(Astro.locals.tokens!, Astro.params.id ?? "");
if (!order) return Astro.rewrite("/404");

const chip = orderChip(order.status, order.status === "shipped" ? `${order.statusLabel} · In transit` : order.statusLabel);
const placed = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short" }).format(new Date(order.placedAt));
const delivered = order.status === "delivered";
---

<CustomerLayout title={order.number} actionBar section="orders">
  <TopBar title={order.number} back="/orders">
    <IconButton slot="action" label="Share order" data-share><Share2 size={20} aria-hidden="true" /></IconButton>
  </TopBar>

  <div class="flex flex-col gap-5 px-5 pt-2 pb-6">
    <section class="flex flex-col gap-4 rounded-card bg-[linear-gradient(150deg,var(--eg-blue-50)_17.5%,var(--eg-cyan-50)_82.5%)] p-5">
      <div class="flex items-center justify-between gap-2.5">
        <StatusChip label={chip.label} tone={chip.tone} class="!bg-white" />
        <span class="text-[12.5px] font-medium text-fg-muted">Placed {placed}</span>
      </div>
      <div class="flex flex-col gap-1">
        <h1 class="font-heading text-[24px] font-extrabold tracking-[-0.5px] text-fg">{order.arrivalLabel}</h1>
        <p class="text-[13.5px] text-fg-secondary">{order.arrivalWindow}</p>
      </div>
      <div class="h-2 overflow-hidden rounded-pill bg-white/70" role="progressbar" aria-valuenow={Math.round(order.progress * 100)} aria-valuemin="0" aria-valuemax="100" aria-label="Order progress">
        <div class:list={["h-full rounded-pill", delivered ? "bg-success" : "bg-[linear-gradient(90deg,var(--eg-blue-600),var(--eg-cyan-400))]"]} style={`width:${order.progress * 100}%`}></div>
      </div>
      {
        !delivered && (
          <div class="flex gap-2.5">
            <a href={`/tracking?order=${order.id}`} class="flex h-[46px] flex-1 items-center justify-center gap-2 rounded-control bg-blue-600 text-[16px] font-semibold text-white">
              <Route size={18} aria-hidden="true" />
              Track shipment
            </a>
            <a href="tel:+622188992020" class="flex size-[46px] items-center justify-center rounded-pill bg-white text-fg" aria-label="Call Entragate logistics">
              <Phone size={20} aria-hidden="true" />
            </a>
          </div>
        )
      }
    </section>

    <SectionHeader title={`Items · ${order.lines.length}`} />
    <ul class="app-card flex flex-col px-4 py-1.5">
      {
        order.lines.map((line, index) => (
          <li class:list={["flex items-center gap-3.5 py-3", index > 0 && "border-t border-border"]}>
            <Media src={line.image} alt="" class="size-14 shrink-0 rounded-md bg-surface" />
            <span class="flex min-w-0 flex-1 flex-col gap-[3px]">
              <span class="text-[14.5px] leading-[21px] font-semibold text-fg">{line.name}</span>
              <span class="text-[12.5px] text-fg-muted">{line.detail}</span>
            </span>
            <span class="flex flex-col items-end gap-[3px]">
              <span class="text-[14px] font-bold whitespace-nowrap text-fg">{formatRupiah(line.amount)}</span>
              <span class="text-[12.5px] text-fg-muted">× {line.quantity}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <SectionHeader title="Delivery" />
    <div class="app-card flex flex-col py-1">
      <ListRow title={order.delivery.site} subtitle={order.delivery.address}>
        <IconTile slot="icon"><MapPin size={20} /></IconTile>
      </ListRow>
      <span class="mx-4 h-px bg-border" aria-hidden="true"></span>
      <ListRow title={order.delivery.courier} subtitle={`AWB ${order.delivery.awb}`}>
        <IconTile slot="icon"><Truck size={20} /></IconTile>
        {order.delivery.awb !== "—" && <CopyButton slot="trailing" client:visible value={order.delivery.awb.replace(/\s/g, "")} />}
      </ListRow>
    </div>

    <SectionHeader title="Payment summary" />
    <dl class="app-card flex flex-col gap-3 p-[18px] text-[14px]">
      <div class="flex justify-between gap-2.5"><dt class="text-fg-muted">Subtotal</dt><dd class="font-semibold text-fg">{formatRupiah(order.payment.subtotal)}</dd></div>
      {order.payment.discount && <div class="flex justify-between gap-2.5"><dt class="text-fg-muted">{order.payment.discountLabel}</dt><dd class="font-semibold text-success">– {formatRupiah(order.payment.discount)}</dd></div>}
      <div class="flex justify-between gap-2.5"><dt class="text-fg-muted">PPN 11%</dt><dd class="font-semibold text-fg">{formatRupiah(order.payment.tax)}</dd></div>
      <span class="h-px bg-border" aria-hidden="true"></span>
      <div class="flex items-center justify-between gap-2.5">
        <dt class="text-[15px] font-bold text-fg">{order.payment.paidLabel ? "Total paid" : "Total"}</dt>
        <dd class="font-heading text-[19px] font-extrabold text-navy-900">{formatRupiah(order.payment.total)}</dd>
      </div>
      {order.payment.paidLabel && <StatusChip tone="success" label={order.payment.paidLabel} class="w-fit" />}
    </dl>

    {
      order.documents.length > 0 && (
        <>
          <SectionHeader title="Documents" />
          <div class="app-card flex flex-col py-1">
            {order.documents.map((doc, index) => (
              <>
                {index > 0 && <span class="mx-4 h-px bg-border" />}
                <DocumentRow document={doc} />
              </>
            ))}
          </div>
        </>
      )
    }
  </div>

  <BottomActionBar slot="overlay">
    <a href={`/support/new?order=${order.id}`} class="flex h-[54px] flex-1 items-center justify-center gap-2 rounded-control bg-white text-[16px] font-semibold text-fg ring-1 ring-border ring-inset">
      <Headset size={18} aria-hidden="true" />
      Get help
    </a>
    <a href={`${webUrl}/quote?reorder=${order.id}`} class="flex h-[54px] flex-1 items-center justify-center gap-2 rounded-control bg-blue-600 text-[16px] font-semibold text-white">
      <RotateCcw size={18} aria-hidden="true" />
      Reorder
    </a>
  </BottomActionBar>
</CustomerLayout>

<script>
  document.querySelector("[data-share]")?.addEventListener("click", async () => {
    const data = { title: document.title, url: location.href };
    if (navigator.share) await navigator.share(data).catch(() => {});
    else await navigator.clipboard?.writeText(location.href);
  });
</script>
