---
import { actions, isInputError } from "astro:actions";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Lock from "@lucide/astro/icons/lock";
import CircleCheck from "@lucide/astro/icons/circle-check";
import Circle from "@lucide/astro/icons/circle";
import AuthLayout from "../layouts/AuthLayout.astro";
import { authBrands } from "../layouts/auth-brand";
import TopBar from "../components/customer/TopBar.astro";
import IconBadge from "../components/customer/IconBadge.astro";
import AppField from "../components/customer/AppField.astro";

/** 04.05 Set new password — reached from the emailed link (?token=…). */
const result = Astro.getActionResult(actions.auth.resetPassword);
if (result?.data) {
  Astro.session?.set("flash", { tone: "success", title: "Password updated", description: "Sign in with your new password." });
  return Astro.redirect("/login", 303);
}
const token = Astro.url.searchParams.get("token") ?? "";
const errors = result?.error && isInputError(result.error) ? result.error.fields : {};
const formError = result?.error && !isInputError(result.error) ? result.error.message : undefined;
const rules = [
  { key: "length", label: "12+ characters" },
  { key: "case", label: "Upper & lowercase letters" },
  { key: "number", label: "At least one number" },
  { key: "symbol", label: "One symbol (!@#$)" },
];
---

<AuthLayout title="New password" brand={authBrands.reset}>
  <TopBar back="/login" />
  <div class="flex flex-1 flex-col gap-6 px-6 pt-4 pb-[max(24px,env(safe-area-inset-bottom))]">
    <IconBadge><ShieldCheck /></IconBadge>
    <div class="flex flex-col gap-2">
      <h1 class="font-heading text-[26px] leading-[31px] font-extrabold tracking-[-0.6px] text-fg">Create a new password</h1>
      <p class="text-[15px] leading-[22px] text-fg-secondary">Use at least 12 characters. Avoid passwords you use elsewhere.</p>
    </div>
    {
      !token ? (
        <p role="alert" class="rounded-md bg-danger-bg p-4 text-[14px] font-semibold text-danger ring-1 ring-danger-border ring-inset">
          This reset link is missing or invalid. <a href="/forgot-password" class="underline">Request a new one</a>.
        </p>
      ) : (
        <form method="POST" action={actions.auth.resetPassword} class="flex flex-col gap-6" novalidate data-reset-form>
          <input type="hidden" name="token" value={token} />
          {formError && <p role="alert" class="text-[13px] font-semibold text-danger">{formError}</p>}
          <AppField label="New password" name="password" type="password" autocomplete="new-password" required minlength={12} autofocus error={errors.password?.[0]}>
            <Lock slot="icon" />
          </AppField>
          <AppField label="Confirm password" name="confirm" type="password" autocomplete="new-password" required error={errors.confirm?.[0]}>
            <Lock slot="icon" />
          </AppField>
          <ul class="flex flex-col gap-2.5 rounded-lg bg-surface p-4" aria-label="Password requirements">
            {rules.map((rule) => (
              <li class="group flex items-center gap-2.5 text-[13.5px] font-medium text-fg-muted data-[met]:text-fg" data-rule={rule.key}>
                <CircleCheck size={16} class="hidden text-success group-data-[met]:block" aria-hidden="true" />
                <Circle size={16} class="text-fg-muted group-data-[met]:hidden" aria-hidden="true" />
                {rule.label}
              </li>
            ))}
          </ul>
          <button type="submit" class="flex h-[54px] items-center justify-center rounded-control bg-blue-600 text-[16px] font-semibold text-white hover:bg-blue-700">
            Update password
          </button>
        </form>
      )
    }
  </div>
</AuthLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-reset-form]");
  const input = form?.querySelector<HTMLInputElement>("input[name=password]");
  const checks: Record<string, (v: string) => boolean> = {
    length: (v) => v.length >= 12,
    case: (v) => /[a-z]/.test(v) && /[A-Z]/.test(v),
    number: (v) => /\d/.test(v),
    symbol: (v) => /[^A-Za-z0-9]/.test(v),
  };
  input?.addEventListener("input", () => {
    form!.querySelectorAll<HTMLElement>("[data-rule]").forEach((row) => {
      row.toggleAttribute("data-met", checks[row.dataset.rule!](input.value));
    });
  });
</script>
