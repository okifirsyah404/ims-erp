---
/**
 * Live password strength meter (04.03): 4 segments + label. Attaches to the input
 * named `for` inside the same form.
 */
interface Props {
  for: string;
}

const { for: target } = Astro.props;
---

<div class="flex flex-col gap-2.5" data-strength={target} aria-live="polite">
  <div class="flex gap-1.5" aria-hidden="true">
    {Array.from({ length: 4 }, () => <span class="h-1 flex-1 rounded-pill bg-surface-2" data-seg />)}
  </div>
  <p class="text-[12.5px] font-semibold text-fg-muted" data-label>12+ characters, number & symbol</p>
</div>

<script>
  const levels = [
    { label: "Too short · use 12+ characters", color: "bg-danger", text: "text-danger" },
    { label: "Weak · add numbers and symbols", color: "bg-danger", text: "text-danger" },
    { label: "Fair · add a number or symbol", color: "bg-warning", text: "text-warning" },
    { label: "Strong · 12+ characters, number & symbol", color: "bg-success", text: "text-success" },
    { label: "Very strong", color: "bg-success", text: "text-success" },
  ];

  for (const meter of document.querySelectorAll<HTMLElement>("[data-strength]")) {
    const input = meter.closest("form")?.querySelector<HTMLInputElement>(`input[name="${meter.dataset.strength}"]`);
    const segments = [...meter.querySelectorAll<HTMLElement>("[data-seg]")];
    const label = meter.querySelector<HTMLElement>("[data-label]")!;
    input?.addEventListener("input", () => {
      const v = input.value;
      if (!v) {
        segments.forEach((s) => (s.className = "h-1 flex-1 rounded-pill bg-surface-2"));
        label.className = "text-[12.5px] font-semibold text-fg-muted";
        label.textContent = "12+ characters, number & symbol";
        return;
      }
      let score = 0;
      if (v.length >= 12) score++;
      if (/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
      if (/\d/.test(v)) score++;
      if (/[^A-Za-z0-9]/.test(v)) score++;
      const level = v.length < 12 ? 0 : score;
      const filled = Math.max(1, Math.min(4, level));
      segments.forEach((s, i) => (s.className = `h-1 flex-1 rounded-pill ${i < filled ? levels[level].color : "bg-surface-2"}`));
      label.className = `text-[12.5px] font-semibold ${levels[level].text}`;
      label.textContent = levels[level].label;
    });
  }
</script>
