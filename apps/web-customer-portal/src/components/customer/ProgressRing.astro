---
/** App / Progress Ring (uKwvd): 72px arc, 18% stroke, centre value. */
interface Props {
  value: number; // 0..1
  size?: number;
  label?: string;
  tone?: "blue" | "success";
  class?: string;
}

const { value, size = 72, label, tone = "blue", class: className } = Astro.props;
const stroke = size * 0.09;
const r = size / 2 - stroke / 2;
const c = 2 * Math.PI * r;
const pct = Math.max(0, Math.min(1, value));
---

<div class:list={["relative shrink-0", className]} style={`width:${size}px;height:${size}px`}>
  <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`} class="-rotate-90" aria-hidden="true">
    <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke="var(--eg-surface-2)" stroke-width={stroke}></circle>
    <circle
      cx={size / 2}
      cy={size / 2}
      r={r}
      fill="none"
      stroke={tone === "blue" ? "var(--eg-blue-600)" : "var(--eg-success)"}
      stroke-width={stroke}
      stroke-linecap="round"
      stroke-dasharray={`${c * pct} ${c}`}></circle>
  </svg>
  <span class="absolute inset-0 flex items-center justify-center font-heading text-[17px] font-extrabold text-fg">
    {label ?? `${Math.round(pct * 100)}%`}
  </span>
</div>
