---
import CircleCheck from "@lucide/astro/icons/circle-check";
import CircleAlert from "@lucide/astro/icons/circle-alert";
import Info from "@lucide/astro/icons/info";
import { portalMode } from "../../services/portal";

/** One-shot confirmation banner (Alert kABOQ tones), fed from the session flash. */
interface Props {
  tone: "success" | "info" | "danger";
  title: string;
  description?: string;
}

const { tone, title, description } = Astro.props;
const styles = {
  success: { box: "bg-success-bg ring-success-border", icon: CircleCheck, color: "text-success" },
  info: { box: "bg-blue-50 ring-blue-100", icon: Info, color: "text-blue-600" },
  danger: { box: "bg-danger-bg ring-danger-border", icon: CircleAlert, color: "text-danger" },
}[tone];
const Icon = styles.icon;
---

<div class="px-5 pt-3">
  <div role={tone === "danger" ? "alert" : "status"} class:list={["flex gap-3 rounded-md p-4 ring-1 ring-inset", styles.box]}>
    <Icon size={20} class:list={["shrink-0", styles.color]} aria-hidden="true" />
    <div class="flex flex-col gap-[3px]">
      <p class="text-[14px] font-bold text-fg">{title}</p>
      {description && <p class="text-[13px] leading-[1.5] text-fg-secondary">{description}</p>}
      {portalMode === "demo" && tone !== "danger" && <p class="text-[12px] font-semibold text-fg-muted">Demo mode — simulated, nothing was sent to the ERP.</p>}
    </div>
  </div>
</div>
