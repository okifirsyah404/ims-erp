---
/** Multi-step progress (04.02 / 04.03 / 04.07): bars + "Step n of N · Label". */
interface Props {
  step: number;
  total: number;
  label: string;
  class?: string;
}

const { step, total, label, class: className } = Astro.props;
---

<div class:list={["flex flex-col gap-2.5", className]}>
  <div class="flex gap-1.5" aria-hidden="true">
    {Array.from({ length: total }, (_, i) => <span class:list={["h-1 flex-1 rounded-pill", i < step ? "bg-blue-600" : "bg-surface-2"]} />)}
  </div>
  <p class="text-[12.5px] font-semibold text-fg-muted">Step {step} of {total} · {label}</p>
</div>
