---
/** App / Large Header (CjHax): eyebrow + 28px title, optional actions (slot "action"). */
interface Props {
  eyebrow?: string;
  title: string;
  class?: string;
}

const { eyebrow, title, class: className } = Astro.props;
---

<header class:list={["flex items-center justify-between gap-3 px-5 pt-2 pb-1", className]}>
  <div class="flex min-w-0 flex-col gap-0.5">
    {eyebrow && <p class="text-[13px] font-medium text-fg-muted">{eyebrow}</p>}
    <h1 class="font-heading text-[28px] font-extrabold tracking-[-0.6px] text-fg">{title}</h1>
  </div>
  <div class="flex items-center gap-2.5"><slot name="action" /></div>
</header>
