---
import LogoMark from "./LogoMark.astro";

/** Logo (njODZ) as used in the app brand bar and welcome screen. */
interface Props {
  tone?: "dark" | "light";
  showSub?: boolean;
  class?: string;
}

const { tone = "dark", showSub = true, class: className } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <LogoMark />
  <span class="flex flex-col gap-px">
    <span class:list={["font-heading text-[19px] font-extrabold tracking-[1.6px]", tone === "dark" ? "text-navy-900" : "text-white"]}>
      ENTRAGATE
    </span>
    {
      showSub && (
        <span class:list={["text-[10.5px] font-medium tracking-[0.2px]", tone === "dark" ? "text-fg-muted" : "text-fg-on-dark-muted"]}>
          by CV. Inti Multi Solusi
        </span>
      )
    }
  </span>
</span>
