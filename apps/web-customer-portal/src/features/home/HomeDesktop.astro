---
import MessageSquarePlus from "@lucide/astro/icons/message-square-plus";
import CalendarClock from "@lucide/astro/icons/calendar-clock";
import FileText from "@lucide/astro/icons/file-text";
import CreditCard from "@lucide/astro/icons/credit-card";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import FolderOpen from "@lucide/astro/icons/folder-open";
import Cpu from "@lucide/astro/icons/cpu";
import FolderKanban from "@lucide/astro/icons/folder-kanban";
import MessageCircle from "@lucide/astro/icons/message-circle";
import Wrench from "@lucide/astro/icons/wrench";
import BadgeCheck from "@lucide/astro/icons/badge-check";
import Truck from "@lucide/astro/icons/truck";
import Phone from "@lucide/astro/icons/phone";
import Mail from "@lucide/astro/icons/mail";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import type { HomeSummary, InvoiceSummary, OrderSummary, QuotationSummary } from "@ims-erp/api-client";
import AppButton from "../../components/customer/AppButton.astro";
import StatusChip from "../../components/customer/StatusChip.astro";
import SectionHeader from "../../components/customer/SectionHeader.astro";
import IconTile from "../../components/customer/IconTile.astro";
import Media from "../../components/customer/Media.astro";
import { formatRupiah } from "../../lib/format";
import { greeting, orderChip, quotationChip } from "../../lib/status";

/** 06.01 Customer Home — Desktop 1440 (two-column workspace). Rendered from `xl`. */
interface Props {
  home: HomeSummary;
  orders: OrderSummary[];
  invoice?: InvoiceSummary;
  quotations: QuotationSummary[];
}

const { home, orders, invoice, quotations } = Astro.props;
const user = Astro.locals.user!;
const project = home.activeProject;
const dateParts = (options: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat("en-GB", { ...options, timeZone: "Asia/Jakarta" }).format(new Date());
const today = `${dateParts({ weekday: "long" })}, ${dateParts({ day: "numeric", month: "long" })}`;
const quickActions = [
  { label: "Quotations", href: "/quotations", icon: FileText },
  { label: "Payments", href: "/payments", icon: CreditCard },
  { label: "Warranty", href: "/products", icon: ShieldCheck },
  { label: "Documents", href: "/documents", icon: FolderOpen },
  { label: "Book Service", href: "/support/book", icon: CalendarClock },
  { label: "My Products", href: "/products", icon: Cpu },
  { label: "New Ticket", href: "/support/new", icon: MessageSquarePlus },
  { label: "Projects", href: "/projects", icon: FolderKanban },
];
const activityIcon = { payment: { icon: BadgeCheck, tone: "success" }, shipment: { icon: Truck, tone: "info" }, quotation: { icon: FileText, tone: "warning" } } as const;
const manager = home.accountManager;
const card = "rounded-card bg-white shadow-[0_6px_18px_#0A1A3F0A] ring-1 ring-border ring-inset";
---

<div class="flex flex-col gap-7">
  <div class="flex items-end justify-between gap-2.5">
    <div class="flex flex-col gap-1">
      <p class="text-[14px] font-medium text-fg-muted">{today}</p>
      <h1 class="font-heading text-[34px] font-extrabold tracking-[-1px] text-fg">{greeting().replace(",", "")}, {user.name.split(" ")[0]}</h1>
    </div>
    <div class="flex gap-2.5">
      <AppButton variant="outline" href="/support/new"><MessageSquarePlus slot="icon" size={18} aria-hidden="true" />New ticket</AppButton>
      <AppButton href="/support/book"><CalendarClock slot="icon" size={18} aria-hidden="true" />Book service</AppButton>
    </div>
  </div>

  <div class="flex items-start gap-6">
    <div class="flex min-w-0 flex-1 flex-col gap-6">
      {
        project && (
          <a
            href={`/projects/${project.id}`}
            class="flex h-[260px] overflow-hidden rounded-xl bg-[linear-gradient(100.7deg,var(--eg-navy-950)_7.8%,#132A5C_58.4%,var(--eg-blue-700)_92.2%)] shadow-[0_16px_32px_#0A1A3F33]"
          >
            <div class="flex flex-1 flex-col justify-between p-7">
              <div class="flex flex-col items-start gap-2.5">
                <StatusChip tone="cyan" label={`Active project · ${project.index} of ${project.total}`} />
                <h2 class="font-heading text-[28px] font-extrabold tracking-[-0.6px] text-white">{project.name}</h2>
                <p class="text-[14px] text-fg-on-dark-muted">{project.site} · {project.id}</p>
              </div>
              <div class="flex flex-col gap-2.5">
                <div class="flex items-end justify-between gap-2.5">
                  <span class="text-[13.5px] font-medium text-fg-on-dark-muted">
                    Stage {project.stage} of {project.stageCount} · {project.stageLabel} · {project.completionLabel}
                  </span>
                  <span class="font-heading text-[22px] font-extrabold text-white">{Math.round(project.progress * 100)}%</span>
                </div>
                <div class="h-2 overflow-hidden rounded-pill bg-white/15" role="progressbar" aria-valuenow={Math.round(project.progress * 100)} aria-valuemin="0" aria-valuemax="100" aria-label="Project progress">
                  <div class="h-full rounded-pill bg-[linear-gradient(90deg,var(--eg-blue-600),var(--eg-cyan-400))]" style={`width:${project.progress * 100}%`} />
                </div>
              </div>
            </div>
            <div class="relative w-[300px] shrink-0">
              <Media alt="" tone="dark" class="size-full" />
              <span class="absolute inset-0 bg-[linear-gradient(90deg,var(--eg-navy-950),transparent_50%)]" aria-hidden="true" />
            </div>
          </a>
        )
      }

      <section class:list={[card, "flex flex-col gap-4 px-6 py-5"]} aria-labelledby="qa-desk">
        <div class="flex items-center justify-between">
          <h2 id="qa-desk" class="font-heading text-[17px] font-bold text-fg">Quick actions</h2>
          <span class="text-[14px] font-semibold text-blue-600/50" title="Customising quick actions is coming soon">Customize</span>
        </div>
        <ul class="flex justify-between gap-2.5">
          {
            quickActions.map(({ label, href, icon: Icon }) => (
              <li>
                <a href={href} class="group flex w-[84px] flex-col items-center gap-2">
                  <span class="flex size-14 items-center justify-center rounded-lg bg-blue-50 text-blue-600 transition-colors group-hover:bg-blue-100">
                    <Icon size={24} aria-hidden="true" />
                  </span>
                  <span class="text-[12px] font-medium text-fg-secondary">{label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {
        orders.length > 0 && (
          <section class="flex flex-col gap-6">
            <SectionHeader title="Orders in progress" linkLabel="View all orders" href="/orders" />
            <ul class="grid grid-cols-2 gap-4">
              {orders.map((order) => {
                const chip = orderChip(order.status, order.statusLabel);
                return (
                  <li>
                    <a href={`/orders/${order.id}`} class:list={[card, "flex flex-col gap-3.5 p-[18px] transition-shadow hover:shadow-[0_10px_28px_#0A1A3F14]"]}>
                      <span class="flex items-center gap-3.5">
                        <Media src={order.image} alt="" class="size-14 shrink-0 rounded-md" />
                        <span class="flex min-w-0 flex-1 flex-col gap-[3px]">
                          <span class="text-[12px] font-semibold text-fg-muted">{order.number.startsWith("#") ? order.number : `#${order.number}`}</span>
                          <span class="text-[15px] font-bold text-fg">{order.title}</span>
                        </span>
                        <StatusChip label={chip.label} tone={chip.tone} />
                      </span>
                      <span class="h-2 overflow-hidden rounded-pill bg-surface-2">
                        <span class="block h-full rounded-pill bg-[linear-gradient(90deg,var(--eg-blue-600),var(--eg-cyan-400))]" style={`width:${order.progress * 100}%`} />
                      </span>
                      <span class="flex justify-between gap-2.5 text-[13px]">
                        <span class="font-medium text-fg-secondary">Step {order.step} of {order.stepCount} · {order.stepLabel}</span>
                        <span class="font-semibold text-blue-600">{order.etaLabel}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        quotations.length > 0 && (
          <section class="flex flex-col gap-6">
            <SectionHeader title="Recent quotations" linkLabel="View all" href="/quotations" />
            <ul class="grid grid-cols-3 gap-4">
              {quotations.slice(0, 3).map((quote) => {
                const chip = quotationChip[quote.status];
                return (
                  <li>
                    <a href={`/quotations/${quote.id}`} class:list={[card, "flex h-full flex-col gap-3.5 p-[18px] transition-shadow hover:shadow-[0_10px_28px_#0A1A3F14]"]}>
                      <span class="flex items-center justify-between gap-2.5">
                        <span class="text-[12px] font-semibold text-fg-muted">{quote.number}</span>
                        <StatusChip label={quote.status === "revised" ? `Revised v${quote.version}` : chip.label} tone={chip.tone} />
                      </span>
                      <span class="text-[15px] font-bold text-fg">{quote.shortTitle ?? quote.title}</span>
                      <span class="mt-auto font-heading text-[20px] font-extrabold text-navy-900">{formatRupiah(quote.total)}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="flex w-[380px] shrink-0 flex-col gap-6" aria-label="Account summary">
      {
        invoice && (
          <section class="flex flex-col gap-3.5 rounded-card bg-white p-[22px] ring-1 ring-border ring-inset">
            <div class="flex items-center justify-between gap-2.5">
              <h2 class="text-[13px] font-semibold text-fg-muted">Outstanding balance</h2>
              {invoice.dueLabel && <StatusChip tone={invoice.status === "overdue" ? "danger" : "warning"} label={invoice.dueLabel} />}
            </div>
            <p class="font-heading text-[26px] font-extrabold tracking-[-0.6px] text-fg">{formatRupiah(invoice.amount)}</p>
            <p class="text-[12.5px] text-fg-muted">{invoice.number} · {invoice.description}</p>
            <div class="flex gap-2.5">
              <AppButton href={`/payments/${invoice.id}#pay-${invoice.id}`} class="h-[46px] flex-1">Pay now</AppButton>
              <AppButton variant="outline" href="/payments" class="h-[46px] flex-1">Invoices</AppButton>
            </div>
          </section>
        )
      }

      {
        home.openTickets.length > 0 && (
          <section class="flex flex-col rounded-card bg-white pt-[18px] pb-1.5 ring-1 ring-border ring-inset">
            <SectionHeader title="Open tickets" linkLabel={`${home.openTickets.length} open`} href="/support" class="px-[18px] pb-2" />
            {home.openTickets.map((ticket, index) => (
              <>
                {index > 0 && <span class="h-px bg-border" />}
                <a href={`/support/${ticket.id}`} class="flex items-center gap-3.5 px-4 py-3.5 transition-colors hover:bg-surface">
                  <IconTile tone={ticket.status === "awaiting_you" ? "warning" : "success"}>
                    {ticket.status === "awaiting_you" ? <MessageCircle size={20} /> : <Wrench size={20} />}
                  </IconTile>
                  <span class="flex min-w-0 flex-1 flex-col gap-[3px]">
                    <span class="truncate text-[15px] font-semibold text-fg">{ticket.shortSubject ?? ticket.subject}</span>
                    <span class="text-[13px] text-fg-muted">
                      {ticket.status === "awaiting_you" ? `Support replied · ${ticket.lastMessage?.ago} ago` : ticket.status === "in_progress" ? "Technician assigned" : "Awaiting assignment"}
                    </span>
                  </span>
                  {ticket.lastMessage?.unread ? <span class="text-[12px] font-semibold text-danger">New</span> : null}
                  <ChevronRight size={18} class="text-fg-muted" aria-hidden="true" />
                </a>
              </>
            ))}
          </section>
        )
      }

      <section class:list={[card, "flex flex-col gap-1.5 p-[18px]"]}>
        <SectionHeader title="Recent activity" linkLabel="See all" href="/notifications" />
        <ul>
          {
            home.activity.map((item) => {
              const { icon: Icon, tone } = activityIcon[item.kind];
              return (
                <li class="flex items-center gap-3.5 py-2.5">
                  <IconTile tone={tone} radius="full"><Icon size={20} /></IconTile>
                  <span class="flex min-w-0 flex-col gap-[3px]">
                    <span class="text-[15px] font-semibold text-fg">{item.title}</span>
                    <span class="text-[13px] text-fg-muted">{item.detail}</span>
                  </span>
                </li>
              );
            })
          }
        </ul>
      </section>

      {
        manager && (
          <section class="flex flex-col gap-3.5 rounded-card bg-navy-900 p-5" aria-label="Account manager">
            <div class="flex items-center gap-3">
              <span class="flex size-11 items-center justify-center rounded-pill bg-[linear-gradient(135deg,var(--eg-blue-600)_14.6%,var(--eg-cyan-400)_85.4%)] font-heading text-[15px] font-extrabold text-white">{manager.initials}</span>
              <span class="flex flex-col gap-0.5">
                <span class="text-[15px] font-bold text-white">{manager.name}</span>
                <span class="text-[12.5px] text-fg-on-dark-muted">{manager.statusLabel}</span>
              </span>
            </div>
            <div class="flex gap-2">
              <a href="/support/new?category=other" class="flex h-[42px] flex-1 items-center justify-center gap-1.5 rounded-md bg-white/14 text-[13px] font-semibold text-white hover:bg-white/20"><MessageCircle size={15} aria-hidden="true" />Chat</a>
              {manager.phone && <a href={`tel:${manager.phone}`} class="flex h-[42px] flex-1 items-center justify-center gap-1.5 rounded-md bg-white/14 text-[13px] font-semibold text-white hover:bg-white/20"><Phone size={15} aria-hidden="true" />Call</a>}
              {manager.email && <a href={`mailto:${manager.email}`} class="flex h-[42px] flex-1 items-center justify-center gap-1.5 rounded-md bg-white/14 text-[13px] font-semibold text-white hover:bg-white/20"><Mail size={15} aria-hidden="true" />Email</a>}
            </div>
          </section>
        )
      }
    </aside>
  </div>
</div>
