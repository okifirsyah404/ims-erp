ERP_API_BASE_URL=https://api.entragate.com
# The ERP answers { requestId, status, message, timestamp, data }; unwrap `data` (routes: src/services/portal/erp-routes.ts)
ERP_RESPONSE_ENVELOPE=data
# Public website origin (unset in development = http://localhost:4321)
PUBLIC_WEB_URL=https://entragate.com
# Shared secret for the website checkout/RFQ sign-in hand-off; same value as the website's (required in production)
WEB_HANDOFF_SECRET=
PUBLIC_CUSTOMER_URL=https://customer.entragate.com
PORTAL_DATA_SOURCE=erp
PUBLIC_SUPPORT_WHATSAPP=
PUBLIC_SUPPORT_PHONE=
