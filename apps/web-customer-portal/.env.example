# Customer portal (apps/web-customer-portal). Copy to `.env` for local runs;
# never commit `.env`.
#
# Two kinds of variables:
#   - PUBLIC_*  (context: client) are inlined into the bundle at BUILD time. In Docker
#               they are build args (see the Dockerfile), not runtime env.
#   - the rest  (context: server) are read at RUNTIME on the server.

# ---- Build-time (client) ----
# Public website origin. Unset in development: http://localhost:4321.
PUBLIC_WEB_URL=https://entragate.com
PUBLIC_CUSTOMER_URL=https://customer.entragate.com
# Support contacts for the ticket pages. Empty = that channel is hidden.
# PUBLIC_SUPPORT_WHATSAPP: international format without "+", e.g. 6281234567890.
PUBLIC_SUPPORT_WHATSAPP=
# Support hotline, e.g. +622150001234.
PUBLIC_SUPPORT_PHONE=

# ---- Runtime (server) ----
# ERP backend ROOT (no path): the portal appends /customers/portal/v1/... itself
# (src/services/portal/erp-routes.ts). Server-to-server only; the browser never calls
# the ERP. https is required except for localhost/127.0.0.1. Only read in "erp" mode.
ERP_API_BASE_URL=http://localhost:3001
# Not used: the portal authenticates each customer with their own session token (the
# bearer token returned by /customers/portal/v1/auth/login, kept in the server-side
# session), not a service key. Kept only because docker-compose still passes it through.
# ERP_API_TOKEN=
# Data source switch. "demo" = the design's fixture data, nothing leaves the process;
# "erp" = the live ERP (set ERP_API_BASE_URL). Defaults to demo in `astro dev`, erp in
# production builds. Backend PORTAL_URL must point at this portal for invitation and
# password-reset emails (<PORTAL_URL>/reset-password?token=...).
PORTAL_DATA_SOURCE=demo
# Request timeout to the ERP, in ms (1000-60000).
ERP_API_TIMEOUT_MS=15000
# The ERP wraps every success body as { requestId, status, message, timestamp, data }, and
# the portal unwraps it by default. Set "none" only for a backend that does not.
ERP_RESPONSE_ENVELOPE=data
# Extra origins allowed to serve images (CSP img-src), comma separated.
ERP_ASSET_ORIGINS=
# Shared secret for the website sign-in hand-off (/api/connect/token). Must equal
# the website's WEB_HANDOFF_SECRET. Secret: required in production.
WEB_HANDOFF_SECRET=
