# =====================================================================
# IMS ERP backend — environment template
# Copy to `.env` in this directory and fill in secrets.
# =====================================================================

# -------------------------------------------------------
# ENVIRONMENT
# -------------------------------------------------------
# Runtime environment tag: local, dev, staging, test, or production.
# Feeds the app's reported environment and resource names below
# (database name, S3 bucket).
NODE_ENV = local
# Timezone for the instance.
TZ = Asia/Jakarta

# -------------------------------------------------------
# APPLICATION
# -------------------------------------------------------
# Human-readable application name.
APP_NAME = "IMS ERP"
# Short app identifier, used in resource names.
APP_ID = erp
# App secret — also used as BETTER_AUTH_SECRET (required).
# Generate with: openssl rand -base64 48
APP_SECRET =
# Network interface to bind (0.0.0.0 inside containers).
APP_HOST = localhost
# Port the API listens on. Keep in sync with VITE_API_URL in apps/web-admin/.env.
APP_PORT = 3001
# Public base URL of the API (used by better-auth).
APP_URL = "http://${APP_HOST}:${APP_PORT}"
# Public base URL of the admin web app (where invitation claim links point).
# Falls back to APP_URL for single-origin deployments.
APP_WEB_URL = "http://localhost:5173"
# Log verbosity: debug | info | warn | error.
APP_LOG_LEVEL = debug
# Base URL of the DiceBear HTTP API used to render generated user avatars.
# Defaults to the API's own local port; inside compose this is the internal
# `dicebear` service (http://dicebear:3000). Use https://api.dicebear.com to
# rely on the public API instead.
AVATAR_API_URL = "http://localhost:${APP_PORT}"

# -------------------------------------------------------
# DATABASE (PostgreSQL)
# -------------------------------------------------------
# Database host (db container name inside containers).
POSTGRES_HOST = localhost
# Database port
POSTGRES_PORT = 5432
# Database username and password (required).
POSTGRES_USER =
# Database password (required).
POSTGRES_PASSWORD =
# Defaults to a name built from APP_ID + NODE_ENV.
POSTGRES_DB = "ims_${APP_ID}_${NODE_ENV}"
# Full connection string used by the Drizzle client.
POSTGRES_URL = "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# -------------------------------------------------------
# REDIS
# -------------------------------------------------------
# Redis host (redis container name inside containers).
REDIS_HOST = localhost
# Redis port
REDIS_PORT = 6379
# Redis password (optional).
REDIS_PASSWORD =
# Defaults redis database index for app data (0 is default).
REDIS_DB = 0
# Defaults redis database index for queue data (1 is default).
REDIS_QUEUE_DB = 1

# -------------------------------------------------------
# S3 (object storage — optional locally)
# -------------------------------------------------------
# Access key and secret for S3-compatible storage (e.g. AWS, MinIO).
S3_ACCESS_KEY =
# Secret key for S3-compatible storage (e.g. AWS, MinIO).
S3_SECRET_KEY =
# S3 region (e.g. us-east-1 for AWS, or custom for MinIO).
S3_REGION =
# Defaults to a name built from APP_ID + NODE_ENV.
S3_BUCKET = "ims-${APP_ID}-${NODE_ENV}"
# Custom endpoint (e.g. MinIO); leave empty for AWS.
S3_ENDPOINT =
# Path-style addressing (true for MinIO/self-hosted).
S3_USE_PATH_STYLE = true

# -------------------------------------------------------
# MAIL (email transport — optional locally)
# -------------------------------------------------------
# Explicit transport: smtp | resend. Empty = auto-detect
# (resend when MAIL_RESEND_API_KEY is set, else smtp when MAIL_SMTP_HOST is).
MAIL_PROVIDER =
# Envelope sender, e.g. "ERP <noreply@example.com>".
MAIL_FROM = "ERP <noreply@entragate.my.id>"
# SMTP host (empty disables SMTP transport).
MAIL_SMTP_HOST = mailpit.okifirsyah.my.id
# SMTP port.
MAIL_SMTP_PORT = 1025
# SMTP username and password (optional).
MAIL_SMTP_USER = erp@entragate.my.id
MAIL_SMTP_PASSWORD =
# Implicit TLS (true for port 465, false for STARTTLS).
MAIL_SMTP_SECURE = false
# Resend API key (https://resend.com) — alternative to SMTP.
# MAIL_RESEND_API_KEY =

# -------------------------------------------------------
# CORS
# -------------------------------------------------------
# Comma-separated origins allowed for credentialed requests.
CORS_ORIGINS = "http://localhost:5173"

# -------------------------------------------------------
# AUTH BOOTSTRAP (dev-only seed admin; override in shared envs)
# -------------------------------------------------------
INITIAL_ADMIN_EMAIL = admin@example.com
INITIAL_ADMIN_USERNAME = admin
INITIAL_ADMIN_PASSWORD = change-me-in-shared-envs

# -------------------------------------------------------
# SCHEDULER (BullMQ repeat jobs)
# -------------------------------------------------------
# Master switch. Off by default so tests and one-off scripts never open a
# repeatable-job connection; turn it on to run the retention sweeps.
SCHEDULER_ENABLED = false
# Notification retention (ERP-0047): read notifications are hard-deleted this
# many days after `read_at`. The cron runs daily at 04:00.
SCHEDULER_NOTIFICATION_RETENTION_CRON = "0 4 * * *"
NOTIFICATION_RETENTION_DAYS = 90

# -------------------------------------------------------
# PAYMENT GATEWAY (ERP-0020, ADR-0021 — optional)
# -------------------------------------------------------
# Where new invoice checkouts are opened: xendit | singapay | fake.
# Empty = online payment off. `fake` is refused in production.
PAYMENT_GATEWAY_PROVIDER =
# Checkout lifetime at the provider, in hours.
PAYMENT_GATEWAY_EXPIRY_HOURS = 24
# Where the provider sends the customer after paying (optional).
PAYMENT_GATEWAY_SUCCESS_URL =
# Xendit: secret API key, and the dashboard webhook verification token
# (sent back as x-callback-token). Webhook URL: <api>/payments/gateway/xendit/webhook
XENDIT_SECRET_KEY =
XENDIT_CALLBACK_TOKEN =
# XENDIT_BASE_URL = https://api.xendit.co
# SingaPay: API key (X-PARTNER-ID), client id/secret, the receiving account
# (ULID), and the webhook path exactly as configured at SingaPay (it is signed).
# Webhook URL: <api>/payments/gateway/singapay/webhook
SINGAPAY_BASE_URL = https://sandbox-payment-b2b.singapay.id
SINGAPAY_PARTNER_ID =
SINGAPAY_CLIENT_ID =
SINGAPAY_CLIENT_SECRET =
SINGAPAY_ACCOUNT_ID =
# SINGAPAY_WEBHOOK_PATH = /payments/gateway/singapay/webhook
# Local only: HMAC secret (min 16 chars) of the fake provider's webhook.
PAYMENT_GATEWAY_FAKE_SECRET =
