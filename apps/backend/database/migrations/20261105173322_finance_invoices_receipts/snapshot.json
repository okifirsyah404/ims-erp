        "name": "invoices_status_check",
        "value": "\"status\" IN ('draft', 'issued', 'partially_paid', 'paid', 'void')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "finance",
        "table": "invoices",
        "name": "invoices_vat_rate_check",
        "value": "\"vat_rate_bps\" >= 0 AND \"vat_rate_bps\" <= 10000",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "finance",
        "table": "invoices",
        "name": "invoices_amounts_check",
        "value": "\"subtotal\" >= 0 AND \"discount_total\" >= 0 AND \"tax_total\" >= 0 AND \"grand_total\" > 0 AND \"paid_total\" >= 0 AND \"paid_total\" <= \"grand_total\" AND \"outstanding_total\" >= 0",
        "entityType": "checks"
      }
    },
