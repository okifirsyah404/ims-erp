---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import Button from "../ui/Button.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import VisitorDashboardMockup from "./VisitorDashboardMockup.astro";
import SoftwarePreview from "./SoftwarePreview.astro";
import { routes } from "../../data/site";
import { solutions } from "../../data/home";
import { platforms } from "../../data/solutions";
import { icons } from "../../lib/icons";

/**
 * 01.01 Home · Software Showcase (desktop Bp2Tu / mobile PWiQ4).
 *
 * Desktop: the section pins (CSS sticky) while the visitor scrolls through six stages;
 * scroll progress picks the active software and its dashboard (crossfade). Clicking an
 * item scrolls to its stage; clicking the active item opens its solution page. Mobile:
 * tapping an item switches the preview, tapping it again opens the page. Without JS the
 * items are plain links and the first stage is shown.
 */
const href = (slug: string) => `${routes.solutions}/${slug}`;
const platformFor = (slug: string) => platforms.find((p) => p.slug === slug)!;
const panel = "transition-opacity duration-500 ease-out motion-reduce:transition-none [grid-area:1/1] data-[hidden]:pointer-events-none data-[hidden]:opacity-0";
---

<section class="bg-navy-900" aria-labelledby="software-heading">
  <!-- Desktop -->
  <div class="hidden xl:block" data-software="scroll">
    <div data-software-track>
      <div
        class="bg-navy-900 bg-[radial-gradient(ellipse_60%_60%_at_80%_10%,#1F5BFF40_0%,#0A1A3F00_100%)] data-[pinned]:sticky data-[pinned]:top-[75px] data-[pinned]:flex data-[pinned]:h-[calc(100dvh-75px)] data-[pinned]:items-center"
        data-software-pin
      >
        <div class="container-page flex flex-col gap-14 py-28 in-data-[pinned]:py-0" data-software-content>
          <div class="flex items-end justify-between">
            <SectionHeading
              class="w-[680px]"
              tone="dark"
              eyebrow="Software Solutions"
              title="Hardware that thinks. Software that connects it all."
              id="software-heading"
            />
            <Button href={routes.solutions} icon={ArrowRight}>Explore all solutions</Button>
          </div>
          <div class="flex items-center gap-12">
            <ul class="flex w-[420px] shrink-0 flex-col gap-1.5">
              {
                solutions.map((solution, index) => {
                  const Icon = icons[solution.icon];
                  return (
                    <li>
                      <a
                        href={href(solution.slug)}
                        data-software-item={index}
                        data-active={index === 0 ? "" : undefined}
                        aria-current={index === 0 ? "true" : undefined}
                        class="group flex items-center gap-4 rounded-control px-[18px] py-4 transition-colors duration-300 hover:bg-white/4 data-[active]:bg-white/6 data-[active]:ring-1 data-[active]:ring-white/12 data-[active]:ring-inset"
                      >
                        <span class="flex size-11 shrink-0 items-center justify-center rounded-md bg-white/5 text-fg-on-dark-muted transition-colors duration-300 group-data-[active]:bg-blue-600 group-data-[active]:text-white">
                          <Icon size={20} aria-hidden="true" />
                        </span>
                        <span class="flex flex-1 flex-col gap-[3px]">
                          <span class="text-[16px] font-semibold text-fg-on-dark-soft transition-colors duration-300 group-data-[active]:text-white">{solution.name}</span>
                          <span class="text-[13px] text-fg-on-dark-muted">{solution.description}</span>
                        </span>
                        <ArrowRight size={18} class="invisible text-cyan-400 group-data-[active]:visible" aria-hidden="true" />
                      </a>
                    </li>
                  );
                })
              }
            </ul>
            <div class="grid min-w-0 flex-1" aria-live="polite">
              {
                solutions.map((solution, index) =>
                  index === 0 ? (
                    <div class={panel} data-software-panel={index}>
                      <VisitorDashboardMockup />
                    </div>
                  ) : (
                    <div class={panel} data-software-panel={index} data-hidden>
                      <SoftwarePreview platform={platformFor(solution.slug)} />
                    </div>
                  ),
                )
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile & tablet -->
  <div
    class="container-page flex flex-col gap-7 bg-[radial-gradient(ellipse_80%_40%_at_100%_0%,#1F5BFF59_0%,#0A1A3F00_100%)] py-14 xl:hidden"
    data-software="tap"
  >
    <SectionHeading tone="dark" eyebrow="Software Solutions" title="Hardware that thinks. Software that connects it all." />
    <div class="grid">
      {
        solutions.map((solution, index) =>
          index === 0 ? (
            <div class={panel} data-software-panel={index}>
              <VisitorDashboardMockup variant="mini" class="h-full" />
            </div>
          ) : (
            <div class={panel} data-software-panel={index} data-hidden>
              <SoftwarePreview platform={platformFor(solution.slug)} variant="mini" class="h-full" />
            </div>
          ),
        )
      }
    </div>
    <ul class="flex flex-col gap-1">
      {
        solutions.map((solution, index) => {
          const Icon = icons[solution.icon];
          return (
            <li>
              <a
                href={href(solution.slug)}
                data-software-item={index}
                data-active={index === 0 ? "" : undefined}
                aria-current={index === 0 ? "true" : undefined}
                class="group flex items-center gap-3.5 rounded-md px-3.5 py-3 transition-colors duration-300 data-[active]:bg-white/8"
              >
                <span class="flex size-[38px] shrink-0 items-center justify-center rounded-md bg-white/5 text-fg-on-dark-muted transition-colors duration-300 group-data-[active]:bg-blue-600 group-data-[active]:text-white">
                  <Icon size={18} aria-hidden="true" />
                </span>
                <span class="flex-1 text-[15px] font-semibold text-fg-on-dark-soft transition-colors duration-300 group-data-[active]:text-white">
                  {"mobileName" in solution ? solution.mobileName : solution.name}
                </span>
                <ChevronRight size={16} class="text-[#5B6B92] group-data-[active]:text-cyan-400" aria-hidden="true" />
              </a>
            </li>
          );
        })
      }
    </ul>
    <Button href={routes.solutions} size="lg" block icon={ArrowRight}>Explore all solutions</Button>
  </div>
</section>

<script>
  import { initSoftwareShowcase } from "../../scripts/software-showcase";

  initSoftwareShowcase();
</script>
