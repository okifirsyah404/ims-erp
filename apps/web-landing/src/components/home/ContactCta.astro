---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import MessageCircle from "@lucide/astro/icons/message-circle";
import Phone from "@lucide/astro/icons/phone";
import Mail from "@lucide/astro/icons/mail";
import MapPin from "@lucide/astro/icons/map-pin";
import Button from "../ui/Button.astro";
import { routes } from "../../data/site";
// ERP-0071: identity and menus come from the ERP (or the built-in defaults).
const { company } = Astro.locals.site;

/** Contact CTA (01.01 desktop O9GQU3 / mobile sGCK0) — reused on other public pages. */
const contacts = [
  { icon: Phone, label: "Sales hotline", value: company.phone, href: company.phoneHref },
  { icon: Mail, label: "Email", value: company.email, href: `mailto:${company.email}` },
  { icon: MapPin, label: "Showroom", value: company.showroom, href: routes.contact },
];
---

<section class="bg-white">
  <div class="container-page pb-14 xl:pb-28">
    <!-- Desktop -->
    <div
      class="hidden items-center gap-16 overflow-hidden rounded-sheet bg-navy-900 bg-[radial-gradient(ellipse_40%_70%_at_0%_100%,#22D3EE33_0%,#0A1A3F00_100%),radial-gradient(ellipse_70%_100%_at_100%_0%,#1F5BFFB3_0%,#0A1A3F00_100%)] p-[72px] xl:flex"
    >
      <div class="flex flex-1 flex-col gap-5">
        <h2 class="font-heading text-[48px] font-extrabold tracking-[-1.6px] text-white">Let's build a smarter entrance.</h2>
        <p class="max-w-[560px] text-[18px] leading-[29px] text-fg-on-dark-muted">
          Tell us about your site. Our engineers will recommend the right hardware and software — with a detailed
          quotation within 24 hours.
        </p>
        <div class="flex gap-3 pt-2">
          <Button href={routes.quote} size="lg" icon={ArrowRight}>Get a Free Quote</Button>
          <Button href={company.whatsappHref} size="lg" variant="glass" icon={MessageCircle} target="_blank" rel="noopener noreferrer">
            Chat on WhatsApp
          </Button>
        </div>
      </div>
      <ul class="flex w-[400px] shrink-0 flex-col gap-3">
        {
          contacts.map(({ icon: Icon, label, value, href }) => (
            <li>
              <a
                href={href}
                class="flex items-center gap-4 rounded-control bg-white/5 p-[18px] ring-1 ring-white/10 ring-inset transition-colors hover:bg-white/8"
              >
                <span class="flex size-11 items-center justify-center rounded-md bg-white/8 text-cyan-400">
                  <Icon size={20} aria-hidden="true" />
                </span>
                <span class="flex flex-col gap-0.5">
                  <span class="text-[12px] font-medium text-fg-on-dark-muted">{label}</span>
                  <span class="text-[16px] font-semibold text-white">{value}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Mobile -->
    <div
      class="flex flex-col gap-[18px] overflow-hidden rounded-xl bg-navy-900 bg-[radial-gradient(ellipse_90%_70%_at_100%_0%,#1F5BFFB3_0%,#0A1A3F00_100%)] p-7 xl:hidden"
    >
      <h2 class="font-heading text-[28px] leading-8 font-extrabold tracking-[-0.8px] text-white">
        Let's build a smarter entrance.
      </h2>
      <p class="text-[15px] leading-6 text-fg-on-dark-muted">Get a detailed quotation from our engineers within 24 hours.</p>
      <Button href={routes.quote} size="lg" block icon={ArrowRight}>Get a Free Quote</Button>
      <Button href={company.whatsappHref} size="lg" variant="glass" block icon={MessageCircle} target="_blank" rel="noopener noreferrer">
        Chat on WhatsApp
      </Button>
    </div>
  </div>
</section>
