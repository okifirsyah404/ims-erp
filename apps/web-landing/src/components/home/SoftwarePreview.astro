---
import Lock from "@lucide/astro/icons/lock";
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard";
import ChartColumn from "@lucide/astro/icons/chart-column";
import Settings from "@lucide/astro/icons/settings";
import LogoMark from "../brand/LogoMark.astro";
import GymMockup from "../solutions/mockups/GymMockup.astro";
import TicketsMockup from "../solutions/mockups/TicketsMockup.astro";
import LibraryMockup from "../solutions/mockups/LibraryMockup.astro";
import ParkingMockup from "../solutions/mockups/ParkingMockup.astro";
import AccessMockup from "../solutions/mockups/AccessMockup.astro";
import VisitorMockup from "../solutions/mockups/VisitorMockup.astro";
import type { Platform } from "../../data/solutions";
import { icons } from "../../lib/icons";

/**
 * Dashboard preview for the Software Showcase stages 2–6. Same browser frame and size as
 * the approved Visitor dashboard (VisitorDashboardMockup), filled with the platform's
 * 02.04 window body so each stage swaps in place without layout shift.
 */
interface Props {
  platform: Platform;
  variant?: "full" | "mini";
  class?: string;
}

const { platform, variant = "full", class: className } = Astro.props;
const Icon = icons[platform.icon];
const mockups = { gym: GymMockup, tickets: TicketsMockup, visitor: VisitorMockup, library: LibraryMockup, parking: ParkingMockup, access: AccessMockup };
const Mockup = mockups[platform.key];
const host = { gym: "gym", tickets: "tickets", visitor: "vms", library: "library", parking: "parking", access: "access" }[platform.key];
---

{
  variant === "full" ? (
    <div
      aria-hidden="true"
      class:list={[
        "flex flex-col overflow-hidden rounded-lg bg-white shadow-[0_40px_80px_#00000066] outline-6 -outline-offset-3 outline-white/20",
        className,
      ]}
    >
      <div class="flex h-[46px] items-center gap-2 border-b border-border bg-surface px-4">
        <span class="size-2.5 rounded-full bg-[#FF5F57]" />
        <span class="size-2.5 rounded-full bg-[#FEBC2E]" />
        <span class="size-2.5 rounded-full bg-[#28C840]" />
        <span class="ml-2 flex items-center gap-1.5 rounded-sm bg-white px-3 py-[5px] text-[11px] font-medium text-fg-secondary ring-1 ring-border ring-inset">
          <Lock size={11} />
          {host}.entragate.cloud/dashboard
        </span>
      </div>
      <div class="flex h-[440px]">
        <div class="flex w-16 shrink-0 flex-col items-center gap-2.5 bg-navy-900 py-[18px]">
          <LogoMark size={28} />
          {[LayoutDashboard, Icon, ChartColumn, Settings].map((SideIcon, index) => (
            <span class:list={["flex size-10 items-center justify-center rounded-md", index === 1 ? "bg-white/10 text-white" : "text-fg-on-dark-muted"]}>
              <SideIcon size={18} />
            </span>
          ))}
        </div>
        <div class="flex min-w-0 flex-1 flex-col gap-3 overflow-hidden bg-surface-subtle p-5">
          <div class="flex items-center justify-between">
            <span class="font-heading text-[17px] font-bold text-fg">{platform.windowTitle}</span>
            <span class="flex items-center gap-1.5 rounded-pill bg-success-bg px-2.5 py-1 text-[11px] font-semibold text-success">
              <span class="size-1.5 rounded-full bg-success" />
              Live
            </span>
          </div>
          <Mockup variant="desktop" />
        </div>
      </div>
    </div>
  ) : (
    <div aria-hidden="true" class:list={["flex flex-col gap-3 overflow-hidden rounded-lg bg-white p-4 outline-4 -outline-offset-2 outline-white/20", className]}>
      <div class="flex items-center justify-between">
        <span class="flex items-center gap-1.5 font-heading text-[15px] font-bold text-fg">
          <Icon size={15} class="text-blue-600" />
          {platform.windowTitle}
        </span>
        <span class="flex items-center gap-1.5 rounded-pill bg-success-bg px-2 py-[3px] text-[11px] font-semibold text-success">
          <span class="size-1.5 rounded-full bg-success" />
          Live
        </span>
      </div>
      <div class="flex min-h-0 flex-1 flex-col gap-2">
        <Mockup variant="mobile" />
      </div>
    </div>
  )
}
