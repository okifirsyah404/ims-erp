---
import Media from "../ui/Media.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import type { HomeContent } from "../../lib/server/content/home";
import { icons } from "../../lib/icons";

/** 01.01 Home · Industries (desktop ar8Cc / mobile HVcS6). */
interface Props {
  content: HomeContent;
}
const { industries, industriesHeading } = Astro.props.content;
---

<section class="bg-white">
  <!-- Desktop -->
  <div class="container-page hidden flex-col gap-10 pb-28 xl:flex">
    <div class="flex items-end justify-between gap-8">
      <SectionHeading class="w-[640px]" eyebrow={industriesHeading.eyebrow} title={industriesHeading.title} />
      {industriesHeading.description && <p class="max-w-[420px] text-[16px] leading-[26px] text-fg-secondary">{industriesHeading.description}</p>}
    </div>
    <ul class="flex gap-4">
      {
        industries.map((industry, index) => {
          const Icon = icons[industry.icon] ?? icons.layers;
          return (
            <li
              class:list={[
                "relative isolate flex h-[460px] flex-col justify-between overflow-hidden rounded-card p-6",
                index === 0 ? "w-[360px] shrink-0" : "min-w-0 flex-1",
              ]}
            >
              <Media src={industry.image} alt="" class="absolute inset-0 -z-10 size-full" />
              <span class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0A1A3F00_35%,#0A1A3FE6_100%)]" />
              <span class="flex size-11 items-center justify-center rounded-md bg-white/15 text-white ring-1 ring-white/25 ring-inset backdrop-blur-[6px]">
                <Icon size={20} aria-hidden="true" />
              </span>
              <span class="flex flex-col gap-1">
                <h3 class="font-heading text-[20px] font-bold text-white">{industry.name}</h3>
                <span class="text-[14px] text-fg-on-dark-soft">{industry.description}</span>
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>

  <!-- Mobile -->
  <div class="container-page flex flex-col gap-6 pb-14 xl:hidden">
    <SectionHeading eyebrow={industriesHeading.eyebrow} title={industriesHeading.mobileTitle ?? industriesHeading.title} />
    <ul
      class="scrollbar-none -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-3 overflow-x-auto px-5 md:-mx-8 md:scroll-px-8 md:px-8"
    >
      {
        industries.map((industry) => {
          const Icon = icons[industry.icon] ?? icons.layers;
          return (
            <li class="relative isolate flex h-[300px] w-[230px] shrink-0 snap-start flex-col justify-end gap-1 overflow-hidden rounded-lg p-[18px]">
              <Media src={industry.image} alt="" class="absolute inset-0 -z-10 size-full" />
              <span class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0A1A3F00_40%,#0A1A3FE6_100%)]" />
              <Icon size={20} class="text-cyan-400" aria-hidden="true" />
              <h3 class="font-heading text-[18px] font-bold text-white">{industry.name}</h3>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
