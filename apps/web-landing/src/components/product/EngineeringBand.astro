---
import Media from "../ui/Media.astro";
import type { ProductDetail } from "../../types/catalog";

/** Engineering Band (02.02, desktop only): copy + key stats over a product photo. */
interface Props {
  band: NonNullable<ProductDetail["band"]>;
}

const { band } = Astro.props;
---

<section class="hidden bg-white xl:block">
  <div class="container-page pb-24">
    <div class="relative isolate flex h-[440px] flex-col justify-between overflow-hidden rounded-sheet p-14">
      <Media src={band.image} alt="" class="absolute inset-0 -z-10 size-full" />
      <span
        class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#0A1A3FF7_0%,#0A1A3FCC_50%,#0A1A3F33_100%)]"
        aria-hidden="true"></span>
      <div class="flex w-[560px] flex-col gap-3.5">
        <p class="text-[13px] font-bold tracking-[1.6px] text-cyan-400 uppercase">{band.eyebrow}</p>
        <h2 class="font-heading text-[38px] leading-[44px] font-extrabold tracking-[-1.2px] text-white">{band.title}</h2>
      </div>
      <dl class="flex gap-14">
        {
          band.stats.map((stat) => (
            <div class="flex flex-col-reverse gap-1">
              <dt class="text-[13px] text-fg-on-dark-muted">{stat.label}</dt>
              <dd class="font-heading text-[36px] font-extrabold tracking-[-1px] text-white">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
