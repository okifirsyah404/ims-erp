---
import Heart from "@lucide/astro/icons/heart";
import Share2 from "@lucide/astro/icons/share-2";
import Maximize2 from "@lucide/astro/icons/maximize-2";
import Rotate3d from "@lucide/astro/icons/rotate-3d";
import ChevronLeft from "@lucide/astro/icons/chevron-left";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import Play from "@lucide/astro/icons/play";
import X from "@lucide/astro/icons/x";
import { routes } from "../../data/site";
import Media from "../ui/Media.astro";
import { stockBadges } from "./stock";
import type { ProductSummary } from "../../types/catalog";

/** Gallery (02.02 · Gallery): main image, overlay controls and thumbnails. */
interface Props {
  product: ProductSummary;
  images: (string | undefined)[];
  stockLabel: string;
  bestSeller?: boolean;
  hasVideo?: boolean;
  class?: string;
}

const { product, images, stockLabel, bestSeller, hasVideo, class: className } = Astro.props;
const badge = stockBadges[product.stock];
const slides = images.length ? images : [product.image];
const glassButton = "flex items-center justify-center bg-white/90 text-fg ring-1 ring-white ring-inset hover:bg-white";
---

<div class:list={["flex flex-col gap-3 xl:gap-3.5", className]} data-gallery aria-roledescription="carousel" aria-label={`${product.name} images`}>
  <div class="relative isolate flex h-[360px] touch-pan-y flex-col justify-between overflow-hidden rounded-card p-3.5 xl:h-[620px] xl:rounded-xl xl:p-5" tabindex="0" data-gallery-stage>
    {
      slides.map((src, index) => (
        <Media
          src={src}
          alt={index === 0 ? product.name : `${product.name} — view ${index + 1}`}
          loading={index === 0 ? "eager" : "lazy"}
          class:list={["absolute inset-0 -z-10 size-full", index !== 0 && "hidden"]}
          data-gallery-slide={index}
        />
      ))
    }
    <div class="flex items-start justify-between">
      <div class="flex gap-2">
        <span class="flex items-center gap-1.5 rounded-pill bg-white/90 px-2.5 py-[5px]">
          <span class:list={["size-1.5 rounded-full", badge.dot]}></span>
          <span class:list={["text-[12px] font-semibold", badge.text]}>
            <span class="xl:hidden">{badge.label}</span>
            <span class="hidden xl:inline">{stockLabel}</span>
          </span>
        </span>
        {
          bestSeller && (
            <span class="hidden items-center gap-1.5 rounded-pill bg-navy-900 px-2.5 py-[5px] text-[12px] font-semibold text-white xl:flex">
              <span class="size-1.5 rounded-full bg-cyan-400" />
              Best Seller
            </span>
          )
        }
      </div>
      <div class="flex gap-2">
        <button type="button" class:list={[glassButton, "size-9 rounded-pill xl:size-[42px] xl:rounded-md aria-pressed:text-danger [&[aria-pressed=true]_svg]:fill-current"]} aria-label={`Save ${product.name} to wishlist`} aria-pressed="false" data-wishlist={product.slug}>
          <Heart size={17} class="size-4 xl:size-[17px]" aria-hidden="true" />
        </button>
        <button
          type="button"
          class:list={[glassButton, "size-9 rounded-pill xl:size-[42px] xl:rounded-md"]}
          aria-label="Share product"
          data-share
        >
          <Share2 size={17} class="size-4 xl:size-[17px]" aria-hidden="true" />
        </button>
        <button type="button" class:list={[glassButton, "hidden size-[42px] rounded-md xl:flex"]} aria-label="View fullscreen" data-gallery-fullscreen>
          <Maximize2 size={17} aria-hidden="true" />
        </button>
      </div>
    </div>
    <div class="hidden items-center justify-between xl:flex">
      <span class="flex items-center gap-2 rounded-pill bg-navy-900/80 px-3.5 py-2 text-[13px] font-semibold text-white backdrop-blur-[6px]">
        <Rotate3d size={15} aria-hidden="true" />
        View in 360°
      </span>
      <div class="flex gap-2">
        <button type="button" class:list={[glassButton, "size-[42px] rounded-pill"]} aria-label="Previous image" data-gallery-prev>
          <ChevronLeft size={18} aria-hidden="true" />
        </button>
        <button type="button" class:list={[glassButton, "size-[42px] rounded-pill"]} aria-label="Next image" data-gallery-next>
          <ChevronRight size={18} aria-hidden="true" />
        </button>
      </div>
    </div>
    <div class="flex justify-center xl:hidden" aria-hidden="true">
      <span class="flex gap-[5px] rounded-pill bg-navy-900/60 px-2.5 py-1.5">
        {
          [...slides, ...(hasVideo ? [null] : [])].map((_, index) => (
            <span
              class:list={["h-1.5 rounded-pill transition-all", index === 0 ? "w-4 bg-white" : "w-1.5 bg-white/50"]}
              data-gallery-dot={index}
            />
          ))
        }
      </span>
    </div>
  </div>

  <ul class="flex gap-2 xl:gap-3">
    {
      slides.map((src, index) => (
        <li class="flex-1">
          <button
            type="button"
            class:list={[
              "block h-16 w-full overflow-hidden rounded-md xl:h-[120px] xl:rounded-control",
              index === 0 ? "ring-2 ring-blue-600" : "xl:ring-1 xl:ring-border",
            ]}
            aria-label={`Show image ${index + 1}`}
            aria-pressed={index === 0 ? "true" : "false"}
            data-gallery-thumb={index}
          >
            <Media src={src} alt="" class="size-full" />
          </button>
        </li>
      ))
    }
    {
      hasVideo && (
        <li class="flex-1">
          <a
            href={routes.videos}
            class="flex h-16 w-full flex-col items-center justify-center gap-2 rounded-md bg-navy-900 text-white xl:h-[120px] xl:rounded-control"
            aria-label="Watch installation and product video guides"
          >
            <Play size={18} class="xl:hidden" aria-hidden="true" />
            <span class="hidden size-10 items-center justify-center rounded-pill bg-white text-navy-900 xl:flex">
              <Play size={16} aria-hidden="true" />
            </span>
            <span class="hidden text-[12px] font-semibold xl:block">Demo video</span>
          </a>
        </li>
      )
    }
  </ul>

  <dialog
    class="m-auto h-[min(88dvh,900px)] w-[min(92vw,1200px)] max-w-none overflow-hidden rounded-xl bg-navy-950 p-0 backdrop:bg-navy-950/80 open:flex open:flex-col"
    aria-label={`${product.name} — full screen`}
    data-gallery-lightbox
  >
    <div class="flex items-center justify-between px-5 py-3 text-white">
      <span class="text-[14px] font-semibold" data-lightbox-caption>{product.name}</span>
      <form method="dialog"><button class="flex size-10 items-center justify-center rounded-pill bg-white/10 hover:bg-white/20" aria-label="Close full screen"><X size={18} aria-hidden="true" /></button></form>
    </div>
    <div class="relative flex min-h-0 flex-1 items-center justify-center px-16 pb-6">
      <img alt="" class="max-h-full max-w-full rounded-lg object-contain" data-lightbox-image hidden />
      <div class="size-full rounded-lg bg-[linear-gradient(135deg,var(--eg-navy-800)_0%,var(--eg-navy-900)_100%)]" data-lightbox-placeholder hidden></div>
      <button type="button" class="absolute left-4 flex size-11 items-center justify-center rounded-pill bg-white/90 text-fg hover:bg-white" aria-label="Previous image" data-lightbox-prev>
        <ChevronLeft size={20} aria-hidden="true" />
      </button>
      <button type="button" class="absolute right-4 flex size-11 items-center justify-center rounded-pill bg-white/90 text-fg hover:bg-white" aria-label="Next image" data-lightbox-next>
        <ChevronRight size={20} aria-hidden="true" />
      </button>
    </div>
  </dialog>
</div>

<script>
  import { toast } from "../../scripts/site";

  for (const gallery of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const slides = [...gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]")];
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")];
    const dots = [...gallery.querySelectorAll<HTMLElement>("[data-gallery-dot]")];
    let current = 0;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle("hidden", i !== current));
      thumbs.forEach((thumb, i) => {
        const on = i === current;
        thumb.setAttribute("aria-pressed", String(on));
        thumb.classList.toggle("ring-2", on);
        thumb.classList.toggle("ring-blue-600", on);
        thumb.classList.toggle("xl:ring-1", !on);
        thumb.classList.toggle("xl:ring-border", !on);
      });
      dots.forEach((dot, i) => {
        const on = i === current;
        dot.classList.toggle("w-4", on);
        dot.classList.toggle("bg-white", on);
        dot.classList.toggle("w-1.5", !on);
        dot.classList.toggle("bg-white/50", !on);
      });
    };

    thumbs.forEach((thumb, i) => thumb.addEventListener("click", () => show(i)));

    // Keyboard (← →) on the focused stage and horizontal swipe on touch screens.
    const stage = gallery.querySelector<HTMLElement>("[data-gallery-stage]");
    stage?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });
    let startX = 0;
    stage?.addEventListener("pointerdown", (event) => (startX = event.clientX));
    stage?.addEventListener("pointerup", (event) => {
      const delta = event.clientX - startX;
      if (event.pointerType !== "mouse" && Math.abs(delta) > 40) show(current + (delta < 0 ? 1 : -1));
    });

    // Full-screen viewer.
    const lightbox = gallery.querySelector<HTMLDialogElement>("[data-gallery-lightbox]");
    const renderLightbox = () => {
      if (!lightbox) return;
      const slide = slides[current];
      const image = lightbox.querySelector<HTMLImageElement>("[data-lightbox-image]")!;
      const placeholder = lightbox.querySelector<HTMLElement>("[data-lightbox-placeholder]")!;
      const src = slide instanceof HTMLImageElement ? slide.currentSrc || slide.src : "";
      image.hidden = !src;
      placeholder.hidden = Boolean(src);
      if (src) {
        image.src = src;
        image.alt = slide.getAttribute("alt") ?? "";
      }
      lightbox.querySelector("[data-lightbox-caption]")!.textContent = `${slide.getAttribute("alt") ?? slide.getAttribute("aria-label") ?? ""} · ${current + 1} / ${slides.length}`;
    };
    gallery.querySelector("[data-gallery-fullscreen]")?.addEventListener("click", () => {
      renderLightbox();
      lightbox?.showModal();
    });
    lightbox?.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => (show(current - 1), renderLightbox()));
    lightbox?.querySelector("[data-lightbox-next]")?.addEventListener("click", () => (show(current + 1), renderLightbox()));
    lightbox?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") (show(current - 1), renderLightbox());
      if (event.key === "ArrowRight") (show(current + 1), renderLightbox());
    });
    lightbox?.addEventListener("click", (event) => {
      if (event.target === lightbox) lightbox.close();
    });
    gallery.querySelector("[data-gallery-prev]")?.addEventListener("click", () => show(current - 1));
    gallery.querySelector("[data-gallery-next]")?.addEventListener("click", () => show(current + 1));
    gallery.querySelector("[data-share]")?.addEventListener("click", async () => {
      const data = { title: document.title, url: location.href };
      if (navigator.share) await navigator.share(data).catch(() => {});
      else {
        await navigator.clipboard?.writeText(location.href);
        toast("Product link copied", { tone: "info" });
      }
    });
  }
</script>
