---
import Media from "../ui/Media.astro";
import type { TeamMember } from "../../data/about";

/** Profile card in Meet Our Team (09.01). */
interface Props {
  member: TeamMember;
  /** Portrait height on desktop: leadership 340px, department rows 260px. */
  size: "lead" | "member";
  class?: string;
}

const { member, size, class: className } = Astro.props;
---

<article class:list={["flex flex-col gap-3 xl:gap-4", className]}>
  <Media
    src={member.portrait}
    alt={`Portrait of ${member.name}`}
    class:list={["h-[270px] w-full rounded-lg", size === "lead" ? "xl:h-[340px]" : "xl:h-[260px]"]}
  />
  <div class="flex flex-col gap-1 xl:gap-1.5">
    <h4
      class="font-heading text-[16px] leading-[18px] font-bold tracking-[-0.2px] text-navy-900 xl:text-[19px] xl:leading-[21px] xl:tracking-[-0.3px]"
    >
      {member.name}
    </h4>
    <p class="text-[12.5px] font-semibold text-blue-600 xl:text-[13.5px]">{member.title}</p>
    <p class="text-[13px] leading-5 text-fg-secondary xl:text-[14px] xl:leading-[22px]">{member.bio}</p>
  </div>
</article>
