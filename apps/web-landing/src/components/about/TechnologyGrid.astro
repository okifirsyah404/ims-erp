---
import { technologies } from "../../data/about";
import { icons } from "../../lib/icons";

/** 09.01 · Technology Solutions: 3×2 grid on desktop, stacked list on mobile. */
---

<section class="bg-surface" aria-labelledby="technology-title">
  <div class="container-page flex flex-col gap-5 py-12 xl:gap-14 xl:py-28">
    <div class="flex flex-col gap-2.5 xl:items-center xl:gap-3.5 xl:text-center">
      <p class="text-[12px] font-bold tracking-[1.4px] text-blue-600 uppercase xl:text-[13px] xl:tracking-[1.6px]">Technology solutions</p>
      <h2
        id="technology-title"
        class="font-heading text-[28px] leading-8 font-bold tracking-[-0.7px] text-navy-900 xl:w-[720px] xl:text-[44px] xl:leading-[48px] xl:tracking-[-1.2px]"
      >
        <span class="xl:hidden">The technology inside every installation</span>
        <span class="hidden xl:inline">The technology inside every Entragate installation</span>
      </h2>
    </div>
    <ul class="grid overflow-hidden rounded-lg bg-white ring-1 ring-border ring-inset xl:grid-cols-3 xl:rounded-card">
      {
        technologies.map((tech, index) => {
          const Icon = icons[tech.icon];
          return (
            <li
              class:list={[
                "flex gap-3.5 p-4 xl:flex-col xl:p-9",
                index > 0 && "border-t border-border",
                "xl:border-t-0",
                index % 3 !== 0 && "xl:border-l xl:border-border",
                index >= 3 && "xl:border-t xl:border-border",
              ]}
            >
              <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-blue-50 text-blue-600 xl:size-12">
                <Icon size={22} class="size-[19px] xl:size-[22px]" aria-hidden="true" />
              </span>
              <span class="flex flex-1 flex-col gap-0.5 xl:gap-3.5">
                <h3 class="text-[15px] font-bold text-navy-900 xl:font-heading xl:text-[19px]">{tech.title}</h3>
                <p class="text-[13px] text-fg-secondary xl:text-[14px] xl:leading-[22px]">
                  <span class="xl:hidden">{tech.mobileDescription}</span>
                  <span class="hidden xl:inline">{tech.description}</span>
                </p>
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
