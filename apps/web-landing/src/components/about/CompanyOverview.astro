---
import { getAbout } from "../../lib/server/content/pages";

// ERP-0071 stage 4: the about page's content comes from the ERP (or the built-in copy).
const { companyFacts } = await getAbout();

/** 09.01 · Company Overview: positioning, history and key facts. */
const pairs = [companyFacts.slice(0, 2), companyFacts.slice(2, 4), companyFacts.slice(4, 6)];
---

<section class="bg-surface xl:bg-white" aria-labelledby="overview-title">
  <div class="container-page flex flex-col gap-4 pt-10 pb-12 xl:flex-row xl:gap-24 xl:py-28">
    <div class="flex flex-col gap-4 xl:w-[400px] xl:shrink-0">
      <p class="text-[12px] font-bold tracking-[1.4px] text-blue-600 uppercase xl:text-[13px] xl:tracking-[1.6px]">Company overview</p>
      <h2
        id="overview-title"
        class="font-heading text-[28px] leading-8 font-bold tracking-[-0.7px] text-navy-900 xl:text-[36px] xl:leading-[41px] xl:tracking-[-0.9px]"
      >
        A trusted integrator for buildings, venues and institutions.
      </h2>
    </div>

    <p class="text-[15px] leading-[26px] text-fg-secondary xl:hidden">
      Founded in Jakarta in 2012, IMS began as a turnstile supplier for office towers. Today we design, manufacture, install
      and maintain complete access ecosystems for gyms, campuses, stadiums, hospitals and government offices — one
      accountable partner with local support across Indonesia.
    </p>
    <dl class="flex flex-col rounded-control bg-white px-4 ring-1 ring-border ring-inset xl:hidden">
      {
        companyFacts.map((fact, index) => (
          <div class:list={["flex justify-between gap-4 py-3.5 text-[13px]", index > 0 && "border-t border-border"]}>
            <dt class="text-fg-muted">{fact.label}</dt>
            <dd class="text-right font-semibold text-fg">{fact.mobileValue ?? fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="hidden flex-1 flex-col gap-10 xl:flex">
      <div class="flex gap-10 text-[16px] leading-[27px] text-fg-secondary">
        <p class="flex-1">
          Founded in Jakarta in 2012, IMS began as a supplier of turnstiles for office towers. Today we design, manufacture,
          install and maintain complete access ecosystems for gyms, campuses, stadiums, hospitals, government offices and
          commercial real estate.
        </p>
        <p class="flex-1">
          Our in-house engineering and software teams build every layer — from motor controllers to cloud dashboards — so
          clients receive one accountable partner, local spare parts and support teams across Indonesia.
        </p>
      </div>
      <dl class="flex flex-col border-t border-border">
        {
          pairs.map((pair) => (
            <div class="flex gap-10 border-b border-border py-5 text-[14px]">
              {pair.map((fact) => (
                <div class="flex flex-1 justify-between gap-4">
                  <dt class="text-fg-muted">{fact.label}</dt>
                  <dd class="text-right font-semibold text-fg">{fact.value}</dd>
                </div>
              ))}
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
