---
import Route from "@lucide/astro/icons/route";
import Headset from "@lucide/astro/icons/headset";
import CalendarClock from "@lucide/astro/icons/calendar-clock";
import FileText from "@lucide/astro/icons/file-text";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import Smartphone from "@lucide/astro/icons/smartphone";
import X from "@lucide/astro/icons/x";
import LogoMark from "../brand/LogoMark.astro";
import { authRoutes, customerPortal, routes } from "../../data/site";
import { getCustomer } from "../../lib/server/auth";

/**
 * 01.06 Header → Customer Portal menu (desktop dropdown, qRUzr) and Portal Entry Sheet
 * (mobile, HJ3YL). `variant="panel"` renders inside the header; `variant="sheet"` is a
 * <dialog> bottom sheet. Without JS the header triggers stay plain links to the portal.
 */
interface Props {
  variant: "panel" | "sheet";
}

const { variant } = Astro.props;
// Sign-in goes through the website hand-off and comes back to this page (signed in here too).
const here = `${Astro.url.pathname}${Astro.url.search}`;
const customer = await getCustomer(Astro.session);
const links = [
  { icon: Route, tone: "bg-blue-50 text-blue-600", title: "Track an order", text: "Order no. or AWB — no sign-in needed", mobileText: "No sign-in needed", href: routes.track },
  { icon: Headset, tone: "bg-success-bg text-success", title: "Get support", text: "Open a ticket or chat on WhatsApp", mobileText: "Ticket, WhatsApp or call", href: customerPortal.newTicket },
  { icon: CalendarClock, tone: "bg-warning-bg text-warning", title: "Book a service visit", text: "Maintenance, repair & inspection", mobileText: "Maintenance & repair", href: `${routes.contact}?topic=support&subject=${encodeURIComponent("Service visit")}` },
  { icon: FileText, tone: "bg-blue-50 text-blue-600", title: "Request a quotation", text: "Business pricing within 1 working day", href: routes.quote, desktopOnly: true },
];
---

{
  variant === "panel" ? (
    <div
      id="portal-menu"
      class="absolute top-[calc(100%+10px)] right-0 z-50 w-[312px] overflow-hidden rounded-card bg-white shadow-[0_24px_60px_#0A1A3F33] ring-1 ring-border"
      hidden
      data-pop
      data-portal-panel
    >
      <div class="flex flex-col gap-3.5 bg-navy-900 bg-[radial-gradient(ellipse_80%_100%_at_100%_100%,#1F5BFF80_0%,#0A1A3F00_100%)] p-4">
        <div class="flex items-center gap-3">
          <span class="flex size-9 items-center justify-center rounded-md bg-white"><LogoMark size={22} /></span>
          <span class="flex flex-col">
            <span class="text-[14px] font-bold text-white">Entragate Customer App</span>
            <span class="text-[12px] text-fg-on-dark-muted">Orders, projects, quotations &amp; support</span>
          </span>
        </div>
        {customer ? (
          <div class="flex flex-col gap-2">
            <p class="text-[13px] text-fg-on-dark-muted">Signed in as <span class="font-bold text-white">{customer.name}</span></p>
            <div class="flex gap-2">
              <a href={customerPortal.home} class="flex flex-1 items-center justify-center rounded-md bg-white py-2.5 text-[13px] font-bold text-navy-900 hover:bg-surface">Open portal</a>
              <form method="post" action={authRoutes.logout} class="flex flex-1">
                <input type="hidden" name="next" value={here} />
                <button type="submit" class="flex flex-1 items-center justify-center rounded-md bg-blue-600 py-2.5 text-[13px] font-bold text-white ring-1 ring-white/20 ring-inset hover:bg-blue-700">Sign out</button>
              </form>
            </div>
          </div>
        ) : (
          <div class="flex gap-2">
            <a href={authRoutes.login(here)} class="flex flex-1 items-center justify-center rounded-md bg-white py-2.5 text-[13px] font-bold text-navy-900 hover:bg-surface">Sign in</a>
            <a href={authRoutes.register(here)} class="flex flex-1 items-center justify-center rounded-md bg-blue-600 py-2.5 text-[13px] font-bold text-white ring-1 ring-white/20 ring-inset hover:bg-blue-700">Create account</a>
          </div>
        )}
      </div>
      <ul class="flex flex-col p-2">
        {links.map(({ icon: Icon, tone, title, text, href }) => (
          <li>
            <a href={href} class="flex items-center gap-3 rounded-md p-2.5 hover:bg-surface">
              <span class:list={["flex size-9 shrink-0 items-center justify-center rounded-md", tone]}><Icon size={17} aria-hidden="true" /></span>
              <span class="flex flex-1 flex-col"><span class="text-[13.5px] font-semibold text-fg">{title}</span><span class="text-[12px] text-fg-muted">{text}</span></span>
              <ChevronRight size={15} class="text-fg-muted" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
      <p class="flex items-center gap-2 border-t border-border bg-surface px-4 py-3 text-[12px] text-fg-secondary">
        <Smartphone size={14} class="text-blue-600" aria-hidden="true" />Best on mobile — add Entragate to your home screen
      </p>
    </div>
  ) : (
    <dialog
      id="portal-sheet"
      aria-labelledby="portal-sheet-title"
      class="m-0 mt-auto w-full max-w-none rounded-t-[28px] bg-white p-0 backdrop:bg-navy-950/50 open:flex open:flex-col"
      data-portal-sheet
    >
      <div class="flex justify-center pt-2.5"><span class="h-[5px] w-10 rounded-pill bg-border-strong" aria-hidden="true" /></div>
      <div class="flex flex-col gap-4 px-5 pt-3 pb-[max(20px,env(safe-area-inset-bottom))]">
        <div class="flex items-start gap-3">
          <LogoMark size={28} />
          <div class="flex flex-1 flex-col">
            <h2 id="portal-sheet-title" class="text-[16px] font-bold text-fg">Your Entragate account</h2>
            <p class="text-[12.5px] text-fg-muted">Track orders, approve quotes, get support</p>
          </div>
          <form method="dialog"><button class="flex size-8 items-center justify-center rounded-pill bg-surface text-fg" aria-label="Close"><X size={16} aria-hidden="true" /></button></form>
        </div>
        {customer ? (
          <>
            <p class="text-[13px] text-fg-secondary">Signed in as <span class="font-bold text-fg">{customer.name}</span></p>
            <a href={customerPortal.home} class="flex items-center justify-center rounded-md bg-blue-600 py-3.5 text-[15px] font-semibold text-white shadow-cta">Open portal</a>
            <form method="post" action={authRoutes.logout}>
              <input type="hidden" name="next" value={here} />
              <button type="submit" class="flex w-full items-center justify-center rounded-md bg-white py-3 text-[14px] font-semibold text-fg ring-1 ring-border ring-inset">Sign out</button>
            </form>
          </>
        ) : (
          <>
            <a href={authRoutes.login(here)} class="flex items-center justify-center rounded-md bg-blue-600 py-3.5 text-[15px] font-semibold text-white shadow-cta">Sign in</a>
            <a href={authRoutes.register(here)} class="flex items-center justify-center rounded-md bg-white py-3 text-[14px] font-semibold text-fg ring-1 ring-border ring-inset">Create account · Individual or Business</a>
          </>
        )}
        <ul class="flex flex-col divide-y divide-border rounded-lg ring-1 ring-border ring-inset">
          {links.filter((l) => !l.desktopOnly).map(({ icon: Icon, tone, title, mobileText, href }) => (
            <li>
              <a href={href} class="flex items-center gap-3 p-3">
                <span class:list={["flex size-9 shrink-0 items-center justify-center rounded-md", tone]}><Icon size={17} aria-hidden="true" /></span>
                <span class="flex flex-1 flex-col"><span class="text-[13.5px] font-semibold text-fg">{title}</span><span class="text-[12px] text-fg-muted">{mobileText}</span></span>
                <ChevronRight size={15} class="text-fg-muted" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </dialog>
  )
}
