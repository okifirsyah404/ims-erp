---
import Search from "@lucide/astro/icons/search";
import X from "@lucide/astro/icons/x";
import CornerDownLeft from "@lucide/astro/icons/corner-down-left";
import ArrowUpDown from "@lucide/astro/icons/arrow-up-down";
import { routes } from "../../data/site";

/**
 * Global search / command palette (⌘K · Ctrl+K, or the header search button). Not a
 * separate .pen frame: it reuses the /search field (56px, 16px radius, focus ring) and
 * result rows, inside a dialog. Results come from /api/search.json; without JS the
 * header buttons are plain links to /search.
 */
const popular = ["Swing barrier", "Face recognition", "Parking", "Visitor management", "Warranty", "Datasheet"];
---

<dialog
  class="m-0 h-dvh max-h-none w-full max-w-none bg-white p-0 backdrop:bg-navy-950/50 backdrop:backdrop-blur-[2px] open:flex open:flex-col md:mx-auto md:mt-[10vh] md:h-auto md:max-h-[72vh] md:w-[640px] md:rounded-card md:shadow-[0_24px_60px_#0A1A3F40] md:ring-1 md:ring-border"
  aria-label="Search Entragate"
  data-command-palette
>
  <form method="get" action={routes.search} role="search" class="shrink-0 border-b border-border p-3 md:p-4" data-palette-form>
    <div class="flex items-center gap-2">
      <label class="flex h-14 min-w-0 flex-1 items-center gap-3 rounded-control bg-white pr-2 pl-[18px] ring-1 ring-border ring-inset focus-within:ring-2 focus-within:ring-blue-600">
        <Search size={18} class="shrink-0 text-fg-muted" aria-hidden="true" />
        <span class="sr-only">Search products, categories and software</span>
        <input
          type="search"
          name="q"
          maxlength="100"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          placeholder="Products, categories, software…"
          class="min-w-0 flex-1 bg-transparent text-[16px] text-fg outline-none placeholder:text-fg-muted"
          role="combobox"
          aria-expanded="true"
          aria-controls="palette-results"
          aria-autocomplete="list"
          data-palette-input
        />
        <kbd class="hidden rounded-sm bg-surface px-2 py-1 text-[12px] font-semibold text-fg-muted ring-1 ring-border ring-inset md:block">Esc</kbd>
      </label>
      <button type="button" class="flex size-12 shrink-0 items-center justify-center rounded-md bg-surface text-fg md:hidden" aria-label="Close search" data-palette-close>
        <X size={20} aria-hidden="true" />
      </button>
    </div>
  </form>

  <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain p-2 md:p-3" data-palette-body>
    <div data-palette-idle>
      <p class="px-3 pt-2 pb-2.5 text-[11px] font-bold tracking-[1.2px] text-fg-muted uppercase">Popular searches</p>
      <div class="flex flex-wrap gap-2 px-3 pb-3">
        {popular.map((term) => <button type="button" class="rounded-pill bg-white px-3 py-1.5 text-[13px] font-medium text-fg ring-1 ring-border ring-inset hover:bg-surface" data-palette-term={term}>{term}</button>)}
      </div>
    </div>
    <ul id="palette-results" role="listbox" aria-label="Search results" class="flex flex-col" data-palette-results></ul>
    <p class="sr-only" role="status" aria-live="polite" data-palette-status></p>
  </div>

  <div class="hidden shrink-0 items-center justify-between gap-3 border-t border-border bg-surface px-4 py-2.5 text-[12px] text-fg-muted md:flex">
    <span class="flex items-center gap-3">
      <span class="flex items-center gap-1"><ArrowUpDown size={13} aria-hidden="true" /> navigate</span>
      <span class="flex items-center gap-1"><CornerDownLeft size={13} aria-hidden="true" /> open</span>
      <span>Esc close</span>
    </span>
    <a href={routes.search} class="font-semibold text-blue-600 hover:underline" data-palette-all>All results</a>
  </div>
</dialog>

<script>
  import { initCommandPalette } from "../../scripts/command-palette";

  initCommandPalette();
</script>
