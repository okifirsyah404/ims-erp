---
import { icons, type IconName } from "../../lib/icons";

/** Service perks band below the catalog grid (02.01 · Project Band, desktop only). */
const perks: { icon: IconName; title: string; description: string }[] = [
  { icon: "truck", title: "Free delivery in Jabodetabek", description: "On orders above Rp 25.000.000" },
  { icon: "wrench", title: "Professional installation", description: "Certified technicians nationwide" },
  { icon: "shield-check", title: "Up to 3-year warranty", description: "Genuine spare parts in stock" },
  { icon: "receipt", title: "B2B invoicing & PO", description: "Tax invoice (Faktur Pajak) ready" },
];
---

<section class="hidden xl:block" aria-label="Why buy from Entragate">
  <div class="container-page pb-24">
    <ul class="flex items-center gap-10 rounded-xl bg-blue-50 px-12 py-10 ring-1 ring-blue-100 ring-inset">
      {
        perks.map((perk) => {
          const Icon = icons[perk.icon];
          return (
            <li class="flex flex-1 items-center gap-3.5">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-md bg-white text-blue-600">
                <Icon size={22} aria-hidden="true" />
              </span>
              <span class="flex flex-1 flex-col gap-[3px]">
                <span class="text-[15px] font-bold text-fg">{perk.title}</span>
                <span class="text-[13px] text-fg-secondary">{perk.description}</span>
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
