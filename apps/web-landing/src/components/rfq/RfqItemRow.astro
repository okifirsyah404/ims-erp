---
import Minus from "@lucide/astro/icons/minus";
import Plus from "@lucide/astro/icons/plus";
import Trash from "@lucide/astro/icons/trash";
import Media from "../ui/Media.astro";
import { formatRupiah } from "../../lib/format";
import type { ProductSummary } from "../../types/catalog";

/**
 * One line in "Items to quote" (03.02). Rendered on the server for the initial item and
 * inside a <template> (without `product`) that the form script clones for each line.
 */
interface Props {
  product?: ProductSummary;
  quantity?: number;
  options?: Record<string, string>;
}

const { product, quantity = 1, options } = Astro.props;
const eyebrow = product ? `${product.category} · ${product.specs.split("·")[0]?.trim()}` : "";
const unitPrice = product ? (product.price === null ? "Project pricing" : formatRupiah(product.price)) : "";
---

<li
  class="flex items-center gap-3 rounded-lg p-3 ring-1 ring-border ring-inset xl:gap-4 xl:rounded-none xl:p-0 xl:py-5 xl:ring-0 xl:first:pt-0 xl:last:pb-0"
  data-rfq-item={product?.slug ?? ""}
>
  <input type="hidden" name="item" value={product?.slug ?? ""} data-field="slug" />
  <input type="hidden" name="item_options" value={options ? JSON.stringify(options) : ""} data-field="options" />
  <Media src={product?.image} alt="" class="size-14 shrink-0 rounded-md bg-surface xl:size-16" />
  <div class="flex min-w-0 flex-1 flex-col gap-[3px]">
    <p class="hidden truncate text-[11px] font-semibold tracking-[1px] text-blue-600 uppercase xl:block" data-field="eyebrow">
      {eyebrow}
    </p>
    <p class="text-[14.5px] font-bold text-fg xl:text-[16px]" data-field="name">{product?.name}</p>
    <p class="text-[12.5px] text-fg-muted xl:text-[13px]">
      <span class="hidden xl:inline">List price </span><span data-field="price">{unitPrice}</span><span data-field="unit">{product?.price === null ? "" : " / unit"}</span>
    </p>
  </div>
  <div
    class="flex items-center gap-3 rounded-md bg-surface px-2.5 py-1.5 xl:gap-4 xl:bg-white xl:px-3 xl:py-2 xl:ring-1 xl:ring-border xl:ring-inset"
  >
    <button type="button" class="text-fg-secondary" aria-label="Decrease quantity" data-qty-step="-1">
      <Minus size={16} class="size-3.5 xl:size-4" aria-hidden="true" />
    </button>
    <input
      type="number"
      name="qty"
      min="1"
      max="999"
      value={quantity}
      inputmode="numeric"
      class="w-[2.5ch] appearance-none bg-transparent text-center text-[14px] font-bold text-fg outline-none [-moz-appearance:textfield] xl:text-[15px] [&::-webkit-inner-spin-button]:appearance-none"
      aria-label="Quantity"
      data-field="qty"
    />
    <button type="button" class="text-blue-600" aria-label="Increase quantity" data-qty-step="1">
      <Plus size={16} class="size-3.5 xl:size-4" aria-hidden="true" />
    </button>
  </div>
  <button type="button" class="hidden text-fg-muted hover:text-danger xl:block" aria-label="Remove item" data-remove-item>
    <Trash size={18} aria-hidden="true" />
  </button>
</li>
