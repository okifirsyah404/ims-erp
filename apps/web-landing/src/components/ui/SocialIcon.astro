---
import MessageCircle from "@lucide/astro/icons/message-circle";
import type { SocialKey } from "../../data/site";

/**
 * Brand glyphs were removed from Lucide v1; these paths reproduce the Lucide
 * originals used in the design (instagram, linkedin, youtube).
 */
interface Props {
  name: SocialKey;
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

{
  name === "whatsapp" ? (
    <MessageCircle size={size} aria-hidden="true" />
  ) : name === "facebook" || name === "tiktok" || name === "x" ? (
    // No brand glyph in the design for these networks: their initial (ERP-0071).
    <span aria-hidden="true" class="text-[0.8em] leading-none font-bold">{name === "x" ? "X" : name === "facebook" ? "f" : "T"}</span>
  ) : (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {name === "instagram" && (
        <>
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
        </>
      )}
      {name === "linkedin" && (
        <>
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
          <rect width="4" height="12" x="2" y="9" />
          <circle cx="4" cy="4" r="2" />
        </>
      )}
      {name === "youtube" && (
        <>
          <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17" />
          <path d="m10 15 5-3-5-3z" />
        </>
      )}
    </svg>
  )
}
