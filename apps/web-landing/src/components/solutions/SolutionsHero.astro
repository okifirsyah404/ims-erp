---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import Cloud from "@lucide/astro/icons/cloud";
import Languages from "@lucide/astro/icons/languages";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Button from "../ui/Button.astro";
import SuiteDashboard from "./SuiteDashboard.astro";

/** 02.04 Software Solutions · Hero. */
interface Props {
  demoHref: string;
}

const { demoHref } = Astro.props;
const trust = [
  { icon: Cloud, label: "Cloud & on-premise" },
  { icon: Languages, label: "Bahasa & English" },
  { icon: ShieldCheck, label: "ISO 27001 hosting" },
];
---

<section
  class="bg-white bg-[radial-gradient(ellipse_80%_60%_at_90%_10%,#EEF3FFFF_0%,#FFFFFF00_100%)] xl:bg-[radial-gradient(ellipse_60%_70%_at_85%_20%,#EEF3FFFF_0%,#FFFFFF00_100%)]"
>
  <div class="container-page flex flex-col gap-6 pt-9 pb-12 xl:flex-row xl:items-center xl:gap-16 xl:pt-[88px] xl:pb-[104px]">
    <div class="flex flex-col gap-6 xl:w-[560px] xl:shrink-0 xl:gap-7">
      <p
        class="flex w-fit items-center gap-2 rounded-pill bg-white py-1.5 pr-3 pl-1.5 text-[12px] font-semibold text-fg-secondary ring-1 ring-border ring-inset xl:py-[7px] xl:pr-3.5 xl:pl-2 xl:text-[13px]"
      >
        <span class="rounded-pill bg-blue-600 px-2 py-[3px] text-[10px] font-bold tracking-[0.8px] text-white">NEW</span>
        Entragate Software Suite 4.0
      </p>
      <h1
        class="font-heading text-[36px] leading-10 font-bold tracking-[-1px] text-navy-900 xl:text-[60px] xl:leading-[63px] xl:tracking-[-1.8px]"
      >
        Software that runs every gate, guest and member.
      </h1>
      <p class="text-[16px] leading-[26px] text-fg-secondary xl:text-[18px] xl:leading-[29px]">
        <span class="xl:hidden">
          Six platforms natively integrated with Entragate barrier gates, turnstiles and face recognition — one login,
          real-time control.
        </span>
        <span class="hidden xl:inline">
          Six purpose-built platforms — from gym memberships to smart parking — natively integrated with Entragate barrier
          gates, turnstiles and face recognition terminals. One login, one database, real-time control.
        </span>
      </p>
      <div class="flex flex-col gap-2.5 md:flex-row xl:gap-3">
        <Button href={demoHref} icon={ArrowRight} size="adaptive" class="w-full md:w-auto">
          <span class="xl:hidden">Book a Live Demo</span>
          <span class="hidden xl:inline">Request Demo</span>
        </Button>
        <Button href="#solutions" variant="secondary" icon={ArrowDown} size="adaptive" class="w-full md:w-auto">
          View All Solutions
        </Button>
      </div>
      <ul class="hidden gap-6 pt-2 xl:flex">
        {
          trust.map(({ icon: Icon, label }) => (
            <li class="flex items-center gap-2 text-[13px] font-medium text-fg-secondary">
              <Icon size={16} class="text-blue-600" aria-hidden="true" />
              {label}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hidden min-w-0 flex-1 xl:flex"><SuiteDashboard variant="desktop" /></div>
    <div class="xl:hidden"><SuiteDashboard variant="mobile" /></div>
  </div>
</section>
