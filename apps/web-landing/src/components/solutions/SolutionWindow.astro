---
import GymMockup from "./mockups/GymMockup.astro";
import TicketsMockup from "./mockups/TicketsMockup.astro";
import VisitorMockup from "./mockups/VisitorMockup.astro";
import LibraryMockup from "./mockups/LibraryMockup.astro";
import ParkingMockup from "./mockups/ParkingMockup.astro";
import AccessMockup from "./mockups/AccessMockup.astro";
import type { Platform } from "../../data/solutions";
import { icons } from "../../lib/icons";

/** Product-UI preview window from the 02.04 solution cards (also the solution-page hero). */
interface Props {
  platform: Platform;
  class?: string;
}

const { platform, class: className } = Astro.props;
const Icon = icons[platform.icon];
const mockups = { gym: GymMockup, tickets: TicketsMockup, visitor: VisitorMockup, library: LibraryMockup, parking: ParkingMockup, access: AccessMockup };
const Mockup = mockups[platform.key];
---

  <div class:list={["flex flex-col overflow-hidden px-5 pt-5 xl:px-8 xl:pt-8", className]} aria-hidden="true">
    <div
      class="flex flex-1 flex-col rounded-t-md border border-b-0 border-border bg-surface-subtle drop-shadow-[0_10px_12px_#0A1A3F14] xl:bg-white xl:drop-shadow-[0_12px_16px_#0A1A3F14]"
    >
      <div class="flex items-center justify-between border-b border-border bg-white px-3 py-[9px] xl:rounded-t-md xl:px-4 xl:py-3">
        <span class="flex items-center gap-1.5 text-[10px] font-semibold text-fg xl:gap-2 xl:text-[11px]">
          <Icon size={13} class="size-[11px] text-blue-600 xl:size-[13px]" />
          {platform.windowTitle}
        </span>
        <span class="hidden gap-[5px] xl:flex">
          <span class="size-[7px] rounded-full bg-border"></span>
          <span class="size-[7px] rounded-full bg-border"></span>
          <span class="size-[7px] rounded-full bg-border"></span>
        </span>
      </div>
      <div class="flex min-h-0 flex-1 flex-col gap-2 p-2.5 xl:hidden">
        <Mockup variant="mobile" />
      </div>
      <div class="hidden min-h-0 flex-1 flex-col gap-3 bg-surface-subtle p-4 xl:flex">
        <Mockup variant="desktop" />
      </div>
    </div>
  </div>

