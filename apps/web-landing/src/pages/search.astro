---
import Search from "@lucide/astro/icons/search";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import PublicLayout from "../layouts/PublicLayout.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import Media from "../components/ui/Media.astro";
import { routes } from "../data/site";
import { searchSite } from "../lib/search";

/** Site search (header search button). Searches the catalog, solutions, projects, help, documents and news. */
export const prerender = false;

const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 100);
const { groups, total, catalogAvailable } = await searchSite(q, 50);
const suggestions = ["Swing barrier", "Face recognition", "Parking", "Visitor management", "Warranty", "Datasheet"];
---

<PublicLayout title={q ? `Search: ${q} | Entragate` : "Search | Entragate"} description="Search Entragate products, software, projects and support content.">
  <section class="border-b border-border bg-surface bg-[radial-gradient(ellipse_45%_100%_at_90%_0%,#DCE6FFCC_0%,#F5F7FB00_100%)]">
    <div class="container-page flex flex-col gap-5 py-6 xl:gap-7 xl:py-12">
      <Breadcrumb items={[{ label: "Home", href: routes.home }, { label: "Search" }]} />
      <h1 class="font-heading text-[30px] font-extrabold tracking-[-1px] text-navy-900 xl:text-[44px] xl:tracking-[-1.4px]">{q ? `Results for “${q}”` : "Search Entragate"}</h1>
      <form method="get" action={routes.search} role="search" class="xl:w-[720px]">
        <label class="flex h-14 items-center gap-3 rounded-control bg-white pr-2 pl-[18px] shadow-[0_4px_14px_#0A1A3F0A] ring-1 ring-border ring-inset focus-within:ring-2 focus-within:ring-blue-600">
          <Search size={18} class="text-fg-muted" aria-hidden="true" />
          <span class="sr-only">Search</span>
          <input type="search" name="q" value={q} maxlength="100" autofocus placeholder="Products, software, projects, help…" class="min-w-0 flex-1 bg-transparent text-[16px] text-fg outline-none placeholder:text-fg-muted" />
          <button type="submit" class="rounded-md bg-blue-600 px-4 py-2.5 text-[14px] font-semibold text-white hover:bg-blue-700">Search</button>
        </label>
      </form>
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[13px] font-medium text-fg-muted">Popular:</span>
        {suggestions.map((s) => <a href={`${routes.search}?q=${encodeURIComponent(s)}`} class="rounded-pill bg-white px-3 py-1.5 text-[13px] font-medium text-fg ring-1 ring-border ring-inset hover:bg-surface">{s}</a>)}
      </div>
    </div>
  </section>

  <div class="container-page flex flex-col gap-10 py-10 xl:py-16">
    {q && <p class="text-[14px] text-fg-secondary" role="status">{total} result{total === 1 ? "" : "s"}</p>}
    {q && !catalogAvailable && <p class="rounded-md bg-warning-bg px-4 py-3 text-[14px] text-fg-secondary" role="alert">Product results are temporarily unavailable — showing site content only.</p>}
    {
      q && total === 0 && (
        <EmptyState title="No results found" description="Try a product name, a model number like S200, or a topic such as warranty.">
          <a href={routes.contact} class="font-semibold text-blue-600 hover:underline">Ask our team instead</a>
        </EmptyState>
      )
    }
    {
      groups.map((group) => (
        <section class="flex flex-col gap-4" aria-label={group.title}>
          <h2 class="font-heading text-[20px] font-bold text-navy-900">{group.title} <span class="text-[15px] font-medium text-fg-muted">{group.items.length}</span></h2>
          <ul class="flex flex-col divide-y divide-border rounded-card bg-white ring-1 ring-border ring-inset">
            {group.items.map((item) => (
              <li>
                <a href={item.href} class="flex items-center gap-4 p-4 hover:bg-surface xl:px-6">
                  {item.image && <Media src={item.image} alt="" class="size-14 shrink-0 rounded-md bg-surface" />}
                  <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                    <span class="text-[15px] font-semibold text-fg">{item.title}</span>
                    <span class="truncate text-[13px] text-fg-muted">{item.meta}</span>
                  </span>
                  <ChevronRight size={18} class="text-fg-muted" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</PublicLayout>
