---
import Compass from "@lucide/astro/icons/compass";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import PublicLayout from "../layouts/PublicLayout.astro";
import Button from "../components/ui/Button.astro";
import EmptyState from "../components/ui/EmptyState.astro";

/** Not found — composed from the Empty State component (no dedicated frame in the design). */
// On demand so dynamic routes can `Astro.rewrite("/404")`.
export const prerender = false;
---

<PublicLayout title="Page not found — Entragate" noindex>
  <section class="bg-surface">
    <div class="container-page flex justify-center py-20 xl:py-28">
      <EmptyState
        icon={Compass}
        title="We couldn't find that page"
        description="The page may have moved or is still being built. Browse the catalog or get in touch with our team."
        class="w-full max-w-[520px]"
      >
        <div class="flex flex-wrap justify-center gap-3">
          <Button href="/products" icon={ArrowRight}>Browse products</Button>
          <Button href="/" variant="secondary">Back to home</Button>
        </div>
      </EmptyState>
    </div>
  </section>
</PublicLayout>
