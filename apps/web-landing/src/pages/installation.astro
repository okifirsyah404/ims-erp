---
import Ruler from "@lucide/astro/icons/ruler";
import HardHat from "@lucide/astro/icons/hard-hat";
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import CalendarClock from "@lucide/astro/icons/calendar-clock";
import MapPin from "@lucide/astro/icons/map-pin";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import PublicLayout from "../layouts/PublicLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import Media from "../components/ui/Media.astro";
import ContactCta from "../components/home/ContactCta.astro";
import { routes } from "../data/site";
import { images } from "../lib/images";

/** Installation & services (footer · Support → Installation). */
const services = [
  { icon: Ruler, title: "Site survey", text: "Free in Jabodetabek. Our engineer measures lanes, power, network and cable routes, then updates your quotation.", time: "1–2 hours per entrance" },
  { icon: HardHat, title: "Installation & commissioning", text: "Certified IMS technicians anchor, wire and commission every lane, then integrate it with your software.", time: "1–3 days per entrance group" },
  { icon: GraduationCap, title: "Operator training", text: "Hands-on training for security, reception and admins — plus recorded guides in the Customer Portal.", time: "Half-day on site" },
  { icon: CalendarClock, title: "Maintenance contracts", text: "Scheduled preventive visits, priority response and discounted spare parts.", time: "Quarterly or bi-annual" },
];
const process = [
  { title: "Survey", text: "We visit your site and confirm the bill of materials." },
  { title: "Prepare", text: "You complete power and network points from our readiness checklist." },
  { title: "Install", text: "Lanes are anchored, wired and tested — usually outside your peak hours." },
  { title: "Handover", text: "Training, documentation and warranty activation." },
];
const cities = ["Jakarta & Jabodetabek", "Surabaya", "Medan", "Makassar", "Bandung", "Semarang", "Denpasar", "Balikpapan"];
---

<PublicLayout title="Installation & services | Entragate" description="Site surveys, professional installation, training and maintenance by certified IMS technicians.">
  <PageHero
    title="Installation & services"
    description="From site survey to handover, certified IMS technicians install and commission every Entragate system — and keep it running with maintenance contracts."
    mobileDescription="Surveys, installation, training and maintenance."
    breadcrumb={[{ label: "Home", href: routes.home }, { label: "Support", href: routes.help }, { label: "Installation" }]}
  >
    <div slot="aside" class="flex flex-col gap-3 sm:flex-row">
      <Button href={`${routes.contact}?topic=sales&subject=${encodeURIComponent("Site survey")}`} icon={ArrowRight}>Book a site survey</Button>
      <Button href={`${routes.help}/articles/installation-checklist`} variant="secondary">Readiness checklist</Button>
    </div>
  </PageHero>

  <section class="container-page grid gap-4 py-12 md:grid-cols-2 xl:gap-6 xl:py-24" aria-label="Services">
    {
      services.map(({ icon: Icon, title, text, time }) => (
        <article class="flex flex-col gap-3.5 rounded-card bg-white p-6 ring-1 ring-border ring-inset xl:p-8">
          <span class="flex size-12 items-center justify-center rounded-md bg-blue-50 text-blue-600"><Icon size={22} aria-hidden="true" /></span>
          <h2 class="font-heading text-[20px] font-bold text-navy-900">{title}</h2>
          <p class="text-[15px] leading-6 text-fg-secondary">{text}</p>
          <p class="mt-auto text-[13px] font-semibold text-blue-600">{time}</p>
        </article>
      ))
    }
  </section>

  <section class="bg-surface" aria-labelledby="process-title">
    <div class="container-page grid gap-8 py-12 xl:grid-cols-2 xl:items-center xl:gap-16 xl:py-24">
      <div class="flex flex-col gap-8">
        <SectionHeading eyebrow="How it works" title="From survey to handover" />
        <ol class="flex flex-col">
          {
            process.map((step, index) => (
              <li class="flex gap-5 border-t border-border py-5">
                <span class="font-heading text-[15px] font-bold text-blue-600">0{index + 1}</span>
                <span class="flex flex-col gap-1">
                  <span class="font-heading text-[18px] font-bold text-navy-900">{step.title}</span>
                  <span class="text-[14.5px] leading-[22px] text-fg-secondary">{step.text}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <Media src={images.officeReception} alt="Entragate gates installed in an office reception" class="h-[260px] w-full rounded-card md:h-[420px] xl:h-[520px] xl:rounded-xl" />
    </div>
  </section>

  <section class="container-page flex flex-col gap-6 py-12 xl:py-20" aria-labelledby="coverage-title">
    <h2 id="coverage-title" class="font-heading text-[24px] font-bold tracking-[-0.6px] text-navy-900 xl:text-[32px]">Installation teams across Indonesia</h2>
    <ul class="flex flex-wrap gap-2.5">
      {cities.map((city) => <li class="flex items-center gap-1.5 rounded-pill bg-surface px-3.5 py-2 text-[14px] font-medium text-fg"><MapPin size={14} class="text-blue-600" aria-hidden="true" />{city}</li>)}
    </ul>
    <p class="text-[14px] text-fg-secondary">Other provinces are served by our travelling teams — travel costs are quoted with your project.</p>
  </section>

  <ContactCta />
</PublicLayout>
