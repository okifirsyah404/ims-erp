---
import BaseLayout, { type Props as BaseProps } from "./BaseLayout.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import ArrowUp from "@lucide/astro/icons/arrow-up";

type Props = BaseProps & {
  /** Hide the mobile footer (e.g. pages with a sticky mobile action bar). */
  mobileFooter?: boolean;
};

const { mobileFooter = true, ...props } = Astro.props;
---

<BaseLayout {...props}>
  <a
    href="#main"
    class="sr-only z-50 rounded-md bg-navy-900 px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
  >
    Skip to content
  </a>
  <SiteHeader />
  <main id="main" tabindex="-1" class="outline-none">
    <slot />
  </main>
  <SiteFooter mobile={mobileFooter} />
  <div class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2 px-4 md:right-6 md:left-auto md:items-end" data-toast-region aria-live="polite"></div>
  <button
    type="button"
    hidden
    class="fixed right-4 bottom-4 z-30 flex size-11 items-center justify-center rounded-pill bg-white text-navy-900 shadow-card ring-1 ring-border transition-transform ring-inset hover:-translate-y-0.5 md:right-6 md:bottom-6"
    aria-label="Back to top"
    data-back-to-top
  >
    <ArrowUp size={18} aria-hidden="true" />
  </button>
</BaseLayout>

<script>
  import "../scripts/site";
</script>
