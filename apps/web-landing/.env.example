# Website (apps/web-landing). Copy to `.env` for local runs; never commit `.env`.
#
# Two kinds of variables:
#   - PUBLIC_*  (context: client) are inlined into the bundle at BUILD time. In Docker
#               they are build args (see the Dockerfile), not runtime env.
#   - the rest  (context: server) are read at RUNTIME on the server.

# ---- Build-time (client) ----
# Production origins. Unset in development: http://localhost:4321 (web) and
# http://localhost:4322 (portal). Unset in production: the live domains.
PUBLIC_WEB_URL=https://entragate.com
PUBLIC_CUSTOMER_URL=https://customer.entragate.com
# International format without "+", e.g. 6281280002020 (the contact number).
PUBLIC_WHATSAPP_NUMBER=6281280002020

# ---- Runtime (server) ----
# ERP backend root, server-to-server only. The browser never calls the ERP.
ERP_API_BASE_URL=http://localhost:3001
# Service token for server-to-server ERP calls. Secret: never commit a value.
ERP_API_TOKEN=
# "demo" = local sample data and accepted form submissions;
# "erp"  = live ERP. Defaults to demo in development, erp in production.
WEB_DATA_SOURCE=demo
# Request timeout to the ERP, in ms (1000-60000).
ERP_API_TIMEOUT_MS=15000
# "data" unwraps the backend envelope { requestId, status, message, timestamp, data }.
ERP_RESPONSE_ENVELOPE=data
# Path of the ERP RFQ endpoint, relative to ERP_API_BASE_URL. Unset until the
# ERP contract is published.
ERP_RFQ_PATH=
# Portal URL for the server-to-server sign-in exchange (internal network).
# Defaults to PUBLIC_CUSTOMER_URL when unset.
CUSTOMER_INTERNAL_URL=
# Shared secret for the checkout sign-in hand-off. Must equal the portal's
# WEB_HANDOFF_SECRET. Secret: required in production.
WEB_HANDOFF_SECRET=
