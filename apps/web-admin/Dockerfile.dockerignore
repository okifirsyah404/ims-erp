# Per-Dockerfile ignore (BuildKit): applies to builds using apps/web-admin/Dockerfile.
# Everything is excluded except what the web-admin build needs.
**
!package.json
!bun.lock
!bunfig.toml
!packages/common/**
!packages/ui/**
!apps/web-admin/**
apps/web-admin/node_modules
apps/web-admin/dist
apps/web-admin/.turbo
apps/web-admin/.tanstack
