// ---------------------------------------------------------------------------
// MODULE: Ticket  (schema: ticket; absorbs the aftersales service tickets).
// Customer-facing issue tickets: the customer portal creates them, staff work
// them, the customer tracks progress. A ticket may escalate into a warranty
// service by logical reference. Company-wide.
// ---------------------------------------------------------------------------

Table ticket.tickets {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Number from the numbering service (TKT). Unique among live rows."]
  ticket_type text [not null, default: 'other', note: "installation | repair | maintenance | warranty_service | inspection | other."]
  parent_ticket_id uuid [note: "The parent ticket when this is a sub-ticket (ADR-0024 Q29)."]
  ticket_template_id uuid [note: "The template that spawned this ticket, if any."]
  customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  company_id uuid [note: "Logical reference to customer.companies.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  customer_name text [not null, note: "Snapshot of the customer name."]
  project_id uuid [note: "Logical reference to project.projects.id. Cross-module FK intentionally omitted. Validated through the Project module contract; must belong to the customer."]
  warranty_id uuid [note: "Logical reference to project.warranties.id. Cross-module FK intentionally omitted. Validated through the Project module contract."]
  item_serial_id uuid [note: "Logical reference to inventory.item_serials.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  serial_number varchar(100)
  device_description varchar(300)
  channel text [not null, default: 'phone']
  reporter_name varchar(200) [not null]
  reporter_contact varchar(200)
  complaint text [not null]
  priority text [not null, default: 'normal']
  reported_at bigint [not null]
  in_warranty boolean [not null, default: false, note: "Warranty check at the report time (serial -> shipped delivery note -> project -> warranty certificate)."]
  warranty_ends_on date
  warranty_code varchar(80)
  status text [not null, default: 'new']
  assignee_user_id text [note: "Logical reference to auth.users.id. Must hold ticket:update."]
  resolution text
  service_cost bigint [not null, default: 0, note: "IDR minor units."]
  resolved_by text [note: "Logical reference to auth.users.id."]
  resolved_at bigint
  confirmed_by_name varchar(200) [note: "The customer who confirmed the fix (required to close)."]
  confirmation_channel text
  confirmed_at bigint
  closed_by text [note: "Logical reference to auth.users.id."]
  closed_at bigint
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Service ticket (tiket servis), company-wide. Was aftersales.service_tickets (ADR-0024 Q13), reshaped with ticket_type, parent_ticket_id, company_id, warranty_id, item_serial_id and the template columns. Stores the warranty check made when it is reported; closed only with the customer's confirmation. A parent closes only when its children are closed (Q29)."
  Indexes {
    customer_id [name: 'tickets_customer_id_idx']
    company_id [name: 'tickets_company_id_idx']
    project_id [name: 'tickets_project_id_idx']
    parent_ticket_id [name: 'tickets_parent_ticket_id_idx']
    assignee_user_id [name: 'tickets_assignee_user_id_idx']
    status [name: 'tickets_status_idx']
    serial_number [name: 'tickets_serial_number_idx']
  }
  Checks {
    `ticket_type IN ('installation', 'repair', 'maintenance', 'warranty_service', 'inspection', 'other')`
    `status IN ('new', 'in_progress', 'resolved', 'closed')`
    `priority IN ('low', 'normal', 'high', 'urgent')`
    `channel IN ('phone', 'whatsapp', 'email', 'web', 'onsite', 'portal', 'other')`
    `confirmation_channel IS NULL OR confirmation_channel IN ('phone', 'whatsapp', 'email', 'web', 'onsite', 'portal', 'other')`
    `service_cost >= 0`
  }
}

Table ticket.ticket_messages {
  id uuid [pk, default: `uuidv7()`]
  ticket_id uuid [not null]
  author_type text [not null, default: 'staff']
  author_user_id text [note: "Logical reference to auth.users.id. A staff member, or the customer's portal login when author_type = 'customer'."]
  author_name varchar(200) [not null, note: "Snapshot of the author's name."]
  body text [not null]
  visibility text [not null, default: 'internal']
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Message thread of a ticket, company-wide like the ticket. Was aftersales.service_ticket_comments. Staff write internal notes or customer-visible replies; a customer writes from the portal (always customer-visible). Only customer-visible messages reach the portal."
  Indexes {
    (ticket_id, created_at) [name: 'ticket_messages_ticket_created_idx']
  }
  Checks {
    `visibility IN ('internal', 'customer')`
    `author_type IN ('staff', 'customer')`
    `author_type = 'staff' OR visibility = 'customer'`
  }
}

Table ticket.ticket_templates {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  ticket_type text [not null, default: 'other']
  default_priority text [not null, default: 'normal']
  sla_hours integer
  checklist jsonb [note: "Checklist lines applied to the spawned tickets."]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Ticket template: creating a ticket from it spawns one child ticket per sub_ticket_templates row in the same transaction."
  Indexes {
    (organization_id, code) [unique, name: 'ticket_templates_org_code_uq']
  }
  Checks {
    `ticket_type IN ('installation', 'repair', 'maintenance', 'warranty_service', 'inspection', 'other')`
    `default_priority IN ('low', 'normal', 'high', 'urgent')`
    `sla_hours IS NULL OR sla_hours > 0`
  }
}

Table ticket.sub_ticket_templates {
  id uuid [pk, default: `uuidv7()`]
  ticket_template_id uuid [not null]
  title varchar(200) [not null]
  sort_order integer [not null, default: 0]
  default_assignee_role text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. One child ticket definition inside a ticket template."
  Indexes {
    (ticket_template_id, sort_order) [unique, name: 'sub_ticket_templates_order_uq']
  }
}

Table ticket.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  description text
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Ticket module configuration key value store."
  Indexes {
    (setting_group, setting_key) [unique, name: 'ticket_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Table ticket.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "ticket."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the ticket module (ADR-0024 Q6)."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: ticket.tickets.parent_ticket_id > ticket.tickets.id [delete: set null]
Ref: ticket.tickets.ticket_template_id > ticket.ticket_templates.id [delete: set null]
Ref: ticket.ticket_messages.ticket_id > ticket.tickets.id [delete: cascade]
Ref: ticket.sub_ticket_templates.ticket_template_id > ticket.ticket_templates.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Human Resource  (schema: human_resource, was hr). Employees, their
// records, salary data (Q39: salary stays here) and the per-employee work
// schedule. The organization structure columns are gone with the organization
// schema (ADR-0024 Q4). Money is bigint IDR minor units.
// ---------------------------------------------------------------------------

Table human_resource.employees {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. NULL is a valid company-level employee."]
  user_id text [note: "Logical reference to auth.users.id. Set only by the invite-first creation flow; a user is linked to at most one alive employee."]
  employee_code varchar(32) [not null, note: "Issued from the numbering authority (EMP-00001), editable."]
  full_name text [not null]
  nickname text
  national_id varchar(32) [note: "National identity number (NIK)."]
  tax_id varchar(32) [note: "NPWP (ERP-0138). Optional; missing NIK and NPWP blocks the BP21 export."]
  ptkp_status varchar(5) [note: "PTKP status (TK/0..K/3). Optional; payroll treats NULL as TK/0."]
  bpjs_health_number varchar(32) [note: "BPJS Kesehatan participant number. Optional."]
  bpjs_employment_number varchar(32) [note: "BPJS Ketenagakerjaan participant number. Optional."]
  email varchar(320)
  phone varchar(100)
  photo_object_key text
  employment_status text [not null, default: 'active']
  employment_type text [not null, default: 'permanent']
  work_type text [not null, default: 'onsite']
  hire_date bigint [note: "Unix milliseconds, not a business date. Shipped that way in ERP-0034."]
  termination_date bigint [note: "Unix milliseconds, not a business date."]
  manager_employee_id uuid
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Employee master. department_id / position_id / branch_id / cost_center_id are removed with the organization schema (ADR-0024 Q4). An employee may have a portal login: the link is user_id and it is not a foreign key."
  Indexes {
    (organization_id, employee_code) [unique, name: 'employees_org_code_uq']
    user_id [unique, name: 'employees_user_uq', note: 'WHERE user_id IS NOT NULL AND deleted_at IS NULL']
    manager_employee_id [name: 'employees_manager_employee_id_idx']
    employment_status [name: 'employees_status_idx']
    national_id [name: 'employees_national_id_idx']
    (organization_id, full_name) [name: 'employees_org_name_idx']
  }
  Checks {
    `ptkp_status IS NULL OR ptkp_status IN ('TK/0', 'TK/1', 'TK/2', 'TK/3', 'K/0', 'K/1', 'K/2', 'K/3')`
    `employment_status IN ('active', 'inactive', 'terminated')`
    `employment_type IN ('permanent', 'contract', 'probation', 'internship', 'outsourced')`
    `work_type IN ('onsite', 'remote', 'hybrid')`
    `termination_date IS NULL OR hire_date IS NULL OR termination_date >= hire_date`
  }
}

Table human_resource.employee_addresses {
  id uuid [pk, default: `uuidv7()`]
  employee_id uuid [not null]
  kind text [not null, default: 'residence']
  address_line text [not null]
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated by ExportedLocationService.assertVillage on write; district, regency and province are derived through ExportedLocationService.resolveVillagePath (ADR-0024 Q10)."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Address of an employee, reshaped to the Q10 address contract (only village_id is stored). The residence address is entered by the employee on the invitation claim form (ERP-0121); one live primary address per employee."
  Indexes {
    employee_id [name: 'employee_addresses_employee_id_idx']
    employee_id [unique, name: 'employee_addresses_primary_uq', note: 'WHERE is_primary AND deleted_at IS NULL']
  }
  Checks {
    `kind IN ('residence', 'current', 'birth', 'other')`
  }
}

Table human_resource.attendances {
  id uuid [pk, default: `uuidv7()`]
  employee_id uuid [not null]
  attendance_date date [not null, note: "Business date (Asia/Jakarta)."]
  status text [not null]
  check_in_at bigint [note: "Unix ms (UTC)."]
  check_out_at bigint
  source text [not null, default: 'manual', note: "manual, import, or leave (written by an approved leave request)."]
  leave_request_id uuid
  notes text
  recorded_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "One attendance row per employee per day (was hr.attendance_records), entered by HR/admin or imported. Unique (employee_id, attendance_date) among live rows."
  Indexes {
    (employee_id, attendance_date) [unique, name: 'attendances_day_uq', note: 'WHERE deleted_at IS NULL']
    attendance_date [name: 'attendances_date_idx']
    leave_request_id [name: 'attendances_leave_request_id_idx']
  }
  Checks {
    `status IN ('present', 'permit', 'sick', 'leave', 'absent', 'holiday')`
    `source IN ('manual', 'import', 'leave')`
    `check_out_at IS NULL OR check_in_at IS NULL OR check_out_at >= check_in_at`
  }
}

Table human_resource.leave_types {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Unique among live rows."]
  name text [not null]
  attendance_status text [not null, default: 'leave', note: "Attendance status written for the approved days."]
  uses_quota boolean [not null, default: false]
  annual_quota_days integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Leave type, company-wide. Seeded: annual leave (12 days, quota), sick, permit."
  Checks {
    `attendance_status IN ('leave', 'sick', 'permit')`
    `annual_quota_days >= 0`
  }
}

Table human_resource.leave_requests {
  id uuid [pk, default: `uuidv7()`]
  employee_id uuid [not null]
  leave_type_id uuid [not null]
  start_date date [not null]
  end_date date [not null]
  days integer [not null, note: "Working days in the range (Sundays excluded), counted by the service."]
  reason text
  status text [not null, default: 'submitted']
  recorded_by text [note: "Logical reference to auth.users.id. HR records the request for the employee."]
  decided_by text [note: "Logical reference to auth.users.id. Never the recorder."]
  decided_at bigint
  decision_note text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Leave request recorded by HR, company-wide. Approval writes attendance rows; cancelling an approved request removes them."
  Indexes {
    employee_id [name: 'leave_requests_employee_id_idx']
    status [name: 'leave_requests_status_idx']
  }
  Checks {
    `status IN ('submitted', 'approved', 'rejected', 'cancelled')`
    `end_date >= start_date`
    `days > 0`
  }
}

Table human_resource.overtime_requests {
  id uuid [pk, default: `uuidv7()`]
  employee_id uuid [not null]
  work_date date [not null]
  hours numeric(5,2) [not null]
  reason text
  status text [not null, default: 'submitted']
  recorded_by text [note: "Logical reference to auth.users.id."]
  decided_by text [note: "Logical reference to auth.users.id. Never the recorder."]
  decided_at bigint
  decision_note text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Overtime recorded by HR and approved, company-wide; approved hours feed the salary record."
  Indexes {
    employee_id [name: 'overtime_requests_employee_id_idx']
    work_date [name: 'overtime_requests_work_date_idx']
  }
  Checks {
    `status IN ('submitted', 'approved', 'rejected', 'cancelled')`
    `hours > 0 AND hours <= 24`
  }
}

Table human_resource.employee_tasks {
  id uuid [pk, default: `uuidv7()`]
  employee_id uuid [not null]
  title varchar(200) [not null]
  description text
  due_date date
  status text [not null, default: 'open']
  done_at bigint
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Simple task assigned to an employee outside projects; project tasks live in project.tasks."
  Indexes {
    employee_id [name: 'employee_tasks_employee_id_idx']
    status [name: 'employee_tasks_status_idx']
  }
  Checks {
    `status IN ('open', 'done', 'cancelled')`
  }
}

Table human_resource.employee_salaries {
  id uuid [pk, default: `uuidv7()`]
  employee_id uuid [not null]
  base_salary bigint [not null, default: 0, note: "IDR minor units."]
  fixed_allowances bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  effective_from date [not null]
  effective_to date
  is_active boolean [not null, default: true]
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Effective dated salary agreement of an employee (ADR-0024 Q39): base salary and fixed allowances. A new period closes the previous one (effective_to = start - 1 day, is_active false); only the active period is edited, only the latest is deleted (reopening the previous). The salary bank account lives in finance.cash_bank_accounts (employee_id) since ERP-0119."
  Indexes {
    (employee_id, effective_from) [unique, name: 'employee_salaries_period_uq', note: 'WHERE deleted_at IS NULL']
    employee_id [name: 'employee_salaries_employee_id_idx']
  }
  Checks {
    `base_salary >= 0`
    `fixed_allowances >= 0`
    `effective_to IS NULL OR effective_to >= effective_from`
  }
}

Table human_resource.employee_salary_records {
  id uuid [pk, default: `uuidv7()`]
  period varchar(7) [not null, note: "YYYY-MM."]
  employee_id uuid [not null]
  employee_name text [not null, note: "Snapshot."]
  base_salary bigint [not null, default: 0]
  allowances bigint [not null, default: 0]
  overtime_pay bigint [not null, default: 0]
  bonus bigint [not null, default: 0]
  deductions bigint [not null, default: 0]
  pph21_amount bigint [not null, default: 0, note: "PPh 21 withheld (ERP-0138). Negative only in the last tax month when the annual reconciliation refunds."]
  bpjs_employee_amount bigint [not null, default: 0, note: "Employee BPJS share: Kesehatan 1% plus JHT 2% and JP 1%."]
  bpjs_company_amount bigint [not null, default: 0, note: "Company BPJS share: Kesehatan 4%, JHT 3.7%, JP 2%, JKK, JKM."]
  pension_employee_amount bigint [not null, default: 0, note: "Employee JHT + JP, the deductible pension part of bpjs_employee_amount."]
  taxable_gross bigint [not null, default: 0, note: "TER base: pay plus the taxable company benefits (JKK, JKM, BPJS Kesehatan company share)."]
  ptkp_status varchar(5) [note: "Snapshot of the employee's PTKP status used (NULL employee status = TK/0)."]
  ter_rate numeric(7,4) [note: "TER rate applied; NULL in the last tax month or when PPh 21 is off."]
  tax_method text [note: "ter or annual; NULL when PPh 21 is off."]
  journal_entry_id uuid [note: "Logical reference to finance.journal_entries.id. Cross-module FK intentionally omitted. The payroll journal posted when the period was approved (ERP-0138)."]
  net_pay bigint [not null]
  notes text
  status text [not null, default: 'draft']
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Monthly salary record per employee (was hr.salary_summaries, ADR-0024 Q39), entered or imported by HR/finance and approved by the owner; approved rows are locked. Unique (period, employee_id) among live rows. Payment allocates against it (payable_type employee_salary_record). ERP-0138: PPh 21 (TER monthly, annual Pasal 17 in the last tax month) and BPJS are calculated on every draft write when switched on; approval posts one payroll journal per approval and stamps journal_entry_id."
  Indexes {
    (period, employee_id) [unique, name: 'employee_salary_records_period_uq', note: 'WHERE deleted_at IS NULL']
    period [name: 'employee_salary_records_period_idx']
    employee_id [name: 'employee_salary_records_employee_id_idx']
  }
  Checks {
    `status IN ('draft', 'approved')`
    `base_salary >= 0 AND allowances >= 0 AND overtime_pay >= 0 AND bonus >= 0 AND deductions >= 0`
    `net_pay = base_salary + allowances + overtime_pay + bonus - deductions - pph21_amount - bpjs_employee_amount`
    `bpjs_employee_amount >= 0 AND bpjs_company_amount >= 0 AND pension_employee_amount >= 0 AND taxable_gross >= 0`
    `tax_method IS NULL OR tax_method IN ('ter', 'annual')`
  }
}

Table human_resource.schedules {
  id uuid [pk, default: `uuidv7()`]
  employee_id uuid [not null]
  work_date date [not null, note: "Business date (Asia/Jakarta)."]
  shift_start varchar(5) [note: "HH:MM in Asia/Jakarta. NULL on a day off."]
  shift_end varchar(5) [note: "HH:MM in Asia/Jakarta; earlier than shift_start means an overnight shift."]
  shift_label text
  is_day_off boolean [not null, default: false]
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Work shift of one employee on one date (ADR-0024 Q20), entered per cell or filled from a weekly pattern by HR (ERP-0118). One live row per employee and date. Attendance does not compare against it yet."
  Indexes {
    (employee_id, work_date) [unique, name: 'schedules_employee_date_uq', note: 'WHERE deleted_at IS NULL']
    work_date [name: 'schedules_work_date_idx']
  }
  Checks {
    `(is_day_off AND shift_start IS NULL AND shift_end IS NULL) OR (NOT is_day_off AND shift_start IS NOT NULL AND shift_end IS NOT NULL)`
  }
}

Table human_resource.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  description text
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Human resource module configuration key value store."
  Indexes {
    (setting_group, setting_key) [unique, name: 'human_resource_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Table human_resource.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "employee."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the human resource module (ADR-0024 Q6)."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: human_resource.employees.manager_employee_id > human_resource.employees.id [delete: set null]
Ref: human_resource.employee_addresses.employee_id > human_resource.employees.id [delete: restrict]
Ref: human_resource.attendances.employee_id > human_resource.employees.id [delete: restrict]
Ref: human_resource.attendances.leave_request_id > human_resource.leave_requests.id [delete: restrict]
Ref: human_resource.leave_requests.leave_type_id > human_resource.leave_types.id [delete: restrict]
Ref: human_resource.leave_requests.employee_id > human_resource.employees.id [delete: restrict]
Ref: human_resource.overtime_requests.employee_id > human_resource.employees.id [delete: restrict]
Ref: human_resource.employee_tasks.employee_id > human_resource.employees.id [delete: restrict]
Ref: human_resource.employee_salaries.employee_id > human_resource.employees.id [delete: cascade]
Ref: human_resource.employee_salary_records.employee_id > human_resource.employees.id [delete: restrict]
Ref: human_resource.schedules.employee_id > human_resource.employees.id [delete: restrict]

// ---------------------------------------------------------------------------
// MODULE: Document  (schema: document). Registry + issuance: business documents
// stay in their owning module's tables; this module owns the issued copy, its
// files and signatures. `organization_id` is nullable: NULL = company-wide.
// Gains `settings` and `code_numberings` (ADR-0024 Q32).
// ---------------------------------------------------------------------------

Table document.templates {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide template. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  document_type text [not null]
  module text
  version integer [not null, default: 1]
  content_template text
  numbering_pattern text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Reusable document template. A new version is a new row; an issued document keeps pointing at the version it used. numbering_pattern here is display-only; the numbering authority is <schema>.code_numberings."
  Indexes {
    (organization_id, code, version) [unique, name: 'templates_code_version_uq']
  }
  Checks {
    `version > 0`
  }
}

Table document.documents {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide document. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  document_type text [not null]
  title text [not null]
  template_id uuid
  module text [note: "Owning module of the source document: sale, project, ticket, finance, human_resource, ..."]
  source_type text
  source_id text
  status text [not null, default: 'draft']
  issued_on date
  issued_by_user_id text [note: "Logical reference to auth.users.id."]
  approved_by_user_id text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  version integer [not null, default: 1]
  is_current boolean [not null, default: true]
  supersedes_document_id uuid
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Document master (registry + issuance). A document is never hard deleted, a new version supersedes the old one."
  Indexes {
    (organization_id, code) [unique, name: 'documents_org_code_uq']
    template_id [name: 'documents_template_id_idx']
    (module, source_type, source_id) [name: 'documents_source_idx']
    status [name: 'documents_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'issued', 'void', 'expired', 'archived')`
    `version > 0`
  }
}

Table document.files {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Validated through the Identity module contract."]
  document_id uuid [not null]
  file_name text [not null]
  storage_key text [not null]
  mime_type text
  size_bytes bigint [not null, default: 0]
  checksum text
  uploaded_by_user_id text [note: "Logical reference to auth.users.id."]
  uploaded_at bigint [not null]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Binary attachment of a document. The storage key never contains a public URL."
  Indexes {
    document_id [name: 'files_document_id_idx']
    storage_key [unique, name: 'files_storage_key_uq']
  }
  Checks {
    `size_bytes >= 0`
  }
}

Table document.signatures {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Validated through the Identity module contract."]
  document_id uuid [not null]
  signer_type text [not null]
  signer_user_id text [note: "Logical reference to auth.users.id."]
  signer_name text [not null]
  signed_at bigint [not null]
  signature_method text [not null, default: 'electronic']
  ip_address text
  certificate_serial text
  signature_image_key text [note: "Object-storage key of the signature image used at signing time. Snapshot, not a live lookup."]
  source_file_id uuid [note: "PDF the signature was placed on; one of this document's files."]
  signed_file_key text [note: "Object-storage key of the signed PDF artifact. Once set the placement is final."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Signature evidence of a document. source_file_id and signed_file_key stay NULL for a signature that was only recorded (no PDF placement)."
  Indexes {
    document_id [name: 'signatures_document_id_idx']
    source_file_id [name: 'signatures_source_file_id_idx']
  }
  Checks {
    `signer_type IN ('internal', 'customer', 'partner')`
    `signature_method IN ('electronic', 'wet_ink', 'stamp')`
  }
}

Table document.signature_requests {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Validated through the Identity module contract."]
  document_id uuid [not null]
  requested_by_user_id text [note: "Logical reference to auth.users.id."]
  signer_user_id text [note: "Logical reference to auth.users.id."]
  signer_name text [not null, note: "Signer display name snapshot at request time."]
  status text [not null, default: 'pending']
  note text
  decline_reason text
  expires_at bigint
  responded_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Workflow state of a signature request. The immutable evidence lives in document.signatures. Expiry is evaluated at read time; no job flips the status. One live pending request per document and signer (partial unique index)."
  Indexes {
    document_id [name: 'signature_requests_document_id_idx']
    (signer_user_id, status) [name: 'signature_requests_signer_status_idx']
    requested_by_user_id [name: 'signature_requests_requested_by_idx']
    (document_id, signer_user_id) [unique, name: 'signature_requests_pending_uq', note: "WHERE status = 'pending' AND deleted_at IS NULL"]
  }
  Checks {
    `status IN ('pending', 'signed', 'declined', 'expired', 'cancelled')`
  }
}

Table document.user_signatures {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Validated through the Identity module contract."]
  user_id text [note: "Logical reference to auth.users.id."]
  object_key text [not null, note: "Object-storage key of the WebP signature/stamp image; never a public URL."]
  uploaded_at bigint [not null]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Signature image a user uploads for themselves. One live image per user (partial unique index). Not rendered into any document layout yet."
  Indexes {
    user_id [unique, name: 'user_signatures_user_id_uq']
  }
}

Table document.access_logs {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Validated through the Identity module contract."]
  document_id uuid [not null]
  accessed_by_user_id text [note: "Logical reference to auth.users.id."]
  action text [not null]
  accessed_at bigint [not null]
  ip_address text
  user_agent text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Access trail of a document. Audit reads are never cached and never skipped."
  Indexes {
    document_id [name: 'access_logs_document_id_idx']
    accessed_at [name: 'access_logs_accessed_at_idx']
  }
  Checks {
    `action IN ('view', 'download', 'print', 'share', 'delete', 'pdf_sign')`
  }
}

Table document.shares {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Validated through the Identity module contract."]
  document_id uuid [not null]
  share_type text [not null]
  token uuid [note: "Opaque public-link token, never the row id. Unique across every tenant because the public route resolves it without a session."]
  shared_with_type text
  shared_with_id text
  shared_by_user_id text [note: "Logical reference to auth.users.id."]
  shared_at bigint [not null]
  expires_at bigint
  is_revoked boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "External sharing of a document, for example a portal share with a customer."
  Indexes {
    document_id [name: 'shares_document_id_idx']
    (share_type, shared_with_type, shared_with_id) [name: 'shares_target_idx']
    token [unique, name: 'shares_token_uq']
    (token, expires_at) [name: 'shares_token_live_idx']
  }
  Checks {
    `share_type IN ('internal', 'customer', 'portal', 'public_link')`
  }
}

Table document.tags {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide tag. Validated through the Identity module contract."]
  tag text [not null]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Free form tag applied to documents."
  Indexes {
    (organization_id, tag) [unique, name: 'tags_org_tag_uq']
  }
}

Table document.tag_links {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Validated through the Identity module contract."]
  document_id uuid [not null]
  document_tag_id uuid [not null]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Link between a document and a tag."
  Indexes {
    (document_id, document_tag_id) [unique, name: 'tag_links_uq']
    document_tag_id [name: 'tag_links_tag_id_idx']
  }
}

Table document.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  description text
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Document module configuration key value store (ADR-0024 Q32)."
  Indexes {
    (setting_group, setting_key) [unique, name: 'document_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Table document.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "document."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the document module (ADR-0024 Q6/Q32)."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: document.documents.template_id > document.templates.id [delete: set null]
Ref: document.documents.supersedes_document_id > document.documents.id [delete: set null]
Ref: document.files.document_id > document.documents.id [delete: cascade]
Ref: document.signatures.document_id > document.documents.id [delete: cascade]
Ref: document.signatures.source_file_id > document.files.id [delete: set null]
Ref: document.signature_requests.document_id > document.documents.id [delete: cascade]
Ref: document.access_logs.document_id > document.documents.id [delete: cascade]
Ref: document.shares.document_id > document.documents.id [delete: cascade]
Ref: document.tag_links.document_id > document.documents.id [delete: cascade]
Ref: document.tag_links.document_tag_id > document.tags.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Notification  (schema: notification). In-app notifications and their
// templates. App-scope, not tenant scope: a notification belongs to one user
// and is readable from every organization, so there is no organization_id
// column and the organization context travels as a tag (ADR-0016). Renamed to
// push_* per ADR-0024 Q32.
// ---------------------------------------------------------------------------

Table notification.push_notification_templates {
  id uuid [pk, default: `uuidv7()`]
  code varchar(64) [not null]
  name text [not null]
  channel text [not null, default: 'in_app']
  subject_template text
  body_template text [not null]
  variables jsonb [note: "Declared variable names of the template, e.g. [\"organizationName\",\"role\"]."]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Copy of one notification event, keyed by a `module.event` code (org.member_added). App-scope: one template serves every organization. Was notification.notification_templates. The client renders it from code + variables through i18n; the server renders the English body as a fallback."
  Indexes {
    code [unique, name: 'push_notification_templates_code_uq']
    channel [name: 'push_notification_templates_channel_idx']
  }
  Checks {
    `channel IN ('email', 'whatsapp', 'in_app', 'webhook')`
  }
}

Table notification.push_notifications {
  id uuid [pk, default: `uuidv7()`]
  notification_template_id uuid
  user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  template_code varchar(64) [not null, note: "Denormalized `module.event` code of the template at send time, so a later template edit never rewrites history."]
  title text [not null]
  body text
  tags jsonb [not null, default: `'[]'::jsonb`, note: "Free-form labels shown as chips, e.g. [\"Entragate org\"]. The organization name is the tag for organization events; there is no organization_id column."]
  variables jsonb [note: "Interpolation values for the template."]
  metadata jsonb [note: "Producer-supplied extras (navigation target, deep-link params). Never used for authorization."]
  channel text [not null, default: 'in_app']
  status text [not null, default: 'sent']
  sent_at bigint
  read_at bigint
  source_type text
  source_id text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "One in-app notification for one user (was notification.notifications). App-scope (no organization_id): the list is per user across every organization. Created as `sent` by the worker, which then pushes it over the realtime socket; `read` is set by the recipient."
  Indexes {
    user_id [name: 'push_notifications_user_id_idx']
    (user_id, status) [name: 'push_notifications_user_status_idx']
    status [name: 'push_notifications_status_idx']
    created_at [name: 'push_notifications_created_at_idx']
    notification_template_id [name: 'push_notifications_template_id_idx']
  }
  Checks {
    `channel IN ('email', 'whatsapp', 'in_app', 'webhook')`
    `status IN ('queued', 'sending', 'sent', 'delivered', 'read', 'failed', 'cancelled')`
  }
}

Ref: notification.push_notifications.notification_template_id > notification.push_notification_templates.id [delete: set null]

// ---------------------------------------------------------------------------
// MODULE: Audit  (schema: audit). ERP-owned append-only trail. Insert-only by
// contract: no updates, no soft delete (exempt from the deleted_at rule as an
// append-only ledger). The actor is a logical reference so a deleted user does
// not erase the trail.
// ---------------------------------------------------------------------------

Table audit.audit_logs {
  id text [pk]
  actor_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  actor_email text [note: "Denormalized actor display for readability without joins."]
  action text [not null, note: "Vocabulary guarded by application code (AUDIT_ACTIONS)."]
  target_type text [not null, note: "'invitation' | 'user' | 'role' | 'member' | 'organization' | 'item' | 'warehouse' | ..."]
  target_id text [not null]
  organization_id text [note: "Tenant scope; null for global (app-admin) actions. Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  meta jsonb [note: "Action-specific payload (before/after, emails, role names)."]
  ip_address text
  user_agent text
  created_at bigint [not null]
  Note: "Append-only audit trail. Insert-only ledger, exempt from soft delete."
  Indexes {
    created_at [name: 'audit_logs_created_at_idx']
    organization_id [name: 'audit_logs_organization_id_idx']
    actor_user_id [name: 'audit_logs_actor_user_id_idx']
    action [name: 'audit_logs_action_idx']
    (target_type, target_id) [name: 'audit_logs_target_idx']
  }
}

// ---------------------------------------------------------------------------
// MODULE: Automation  (schema: automation). The transactional outbox delivered
// to n8n and the WhatsApp assistant. Company-wide (ADR-0012). The target-only
// integration/workflow/scheduled-job tables are removed (ADR-0024 Q22).
// ---------------------------------------------------------------------------

Table automation.outbox_messages {
  id uuid [pk, default: `uuidv7()`, note: "Also the event id n8n dedupes on."]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted (ADR-0014). Nullable: the publishers publish company-wide events. Validated through the Identity module contract."]
  topic varchar(64) [not null, note: "lead.created, invoice.issued, receipt.recorded, license.due, service_ticket.updated, whatsapp.handoff."]
  aggregate_type varchar(64) [note: "Re-pointed to the new module names: project.lead, ticket.ticket, sale.invoice, ..."]
  aggregate_id text
  payload jsonb [not null, note: "The event body POSTed to n8n."]
  status text [not null, default: 'pending']
  attempts smallint [not null, default: 0]
  last_attempt_at bigint
  published_at bigint
  response_status smallint [note: "HTTP status of the last delivery attempt."]
  error_message varchar(500)
  dedupe_key varchar(200) [note: "Once-per-fact events (license.due:<contract>:<end>:<threshold>); a repeat publish is skipped. Unique when set."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Transactional outbox. The event is recorded with the business change, then delivered to the n8n webhook by a background queue that retries; a queue or webhook outage never fails the business action."
  Indexes {
    status [name: 'outbox_messages_status_idx']
    topic [name: 'outbox_messages_topic_idx']
    (aggregate_type, aggregate_id) [name: 'outbox_messages_aggregate_idx']
    dedupe_key [unique, name: 'outbox_messages_dedupe_key_key']
  }
  Checks {
    `status IN ('pending', 'published', 'failed')`
    `attempts >= 0`
  }
}

Table automation.faq_entries {
  id uuid [pk, default: `uuidv7()`]
  question varchar(300) [not null]
  answer text [not null]
  keywords varchar(500) [note: "Comma-separated words that also match this entry."]
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  created_by text [note: "Logical reference to auth.users.id."]
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Approved answers the WhatsApp assistant may use. Company-wide."
  Indexes {
    is_active [name: 'faq_entries_is_active_idx']
  }
}

Table automation.whatsapp_conversations {
  id uuid [pk, default: `uuidv7()`]
  chat_id varchar(128) [not null, note: "WAHA chat id, e.g. 628123456789@c.us; replies go here. Unique among live rows."]
  phone varchar(32) [not null]
  contact_name varchar(200)
  status text [not null, default: 'assistant']
  handoff_reason text [note: "no_provider, not_found, human_requested, restricted, error."]
  handoff_at bigint
  assigned_user_id text [note: "Logical reference to auth.users.id."]
  lead_id uuid [note: "Logical reference to project.leads.id. Cross-module FK intentionally omitted. Set when an admin turns the chat into a lead."]
  last_message_at bigint [not null]
  last_inbound_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "One WhatsApp chat with the company number. Company-wide."
  Indexes {
    chat_id [unique, name: 'whatsapp_conversations_chat_id_key']
    (status, last_message_at) [name: 'whatsapp_conversations_status_idx']
  }
  Checks {
    `status IN ('assistant', 'handoff', 'closed')`
    `handoff_reason IS NULL OR handoff_reason IN ('no_provider', 'not_found', 'human_requested', 'restricted', 'error')`
  }
}

Table automation.whatsapp_messages {
  id uuid [pk, default: `uuidv7()`]
  conversation_id uuid [not null]
  direction text [not null]
  author text [not null]
  external_id varchar(128) [note: "WhatsApp message id; inbound webhooks are deduped on (direction, external_id)."]
  body text [not null]
  status text [not null]
  faq_entry_id uuid [note: "Answer used by the assistant, when the reply came from the FAQ."]
  sent_by text [note: "Logical reference to auth.users.id."]
  error_message varchar(500)
  attempts smallint [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Every WhatsApp message of a conversation (log). Company-wide."
  Indexes {
    (conversation_id, created_at) [name: 'whatsapp_messages_conversation_idx']
    (direction, external_id) [unique, name: 'whatsapp_messages_direction_external_id_key']
    status [name: 'whatsapp_messages_status_idx']
  }
  Checks {
    `direction IN ('inbound', 'outbound')`
    `author IN ('customer', 'assistant', 'admin', 'system')`
    `status IN ('received', 'processed', 'pending', 'sent', 'failed')`
    `attempts >= 0`
  }
}

Ref: automation.whatsapp_messages.conversation_id > automation.whatsapp_conversations.id [delete: restrict]
Ref: automation.whatsapp_messages.faq_entry_id > automation.faq_entries.id [delete: set null]
