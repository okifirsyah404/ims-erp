// ---------------------------------------------------------------------------
// MODULE: Sales  (schema: sales)
// Quotation to order flow, contracts, targets, status history, returns and
// delivery notes. Tenant scoped, except the quotation, sales order and
// delivery note tables, which are company-wide (ADR-0011).
// The scaffold sales.quotations created by migration
// 20261029044823_dear_living_lightning was replaced, not altered, by the
// recreation migration of ADR-0011 step 3c (implementation-phases.md S3).
// The transitional sales.payments table is documented in the Legacy group at
// the end of this file.
// ---------------------------------------------------------------------------

Table sales.quotations {
  id uuid [pk, default: `uuidv7()`]
  code varchar(40) [not null, note: "Base number from the numbering service, plus -R<n> for revision n >= 1. Unique among live rows (partial index in the Drizzle schema)."]
  base_code varchar(32) [not null, note: "Number shared by every revision of the same SPH."]
  revision integer [not null, default: 0, note: "0 = original, 1..n = revisions."]
  previous_revision_id uuid [note: "The revision this one replaced (now superseded)."]
  title text [not null, note: "Subject (Perihal)."]
  heading varchar(120) [note: "Title in the coloured bar of the printed SPH, e.g. QUOTATION SYSTEM AKSES KONTROL; null prints QUOTATION."]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  customer_contact_id uuid [note: "Logical reference to crm.customer_contacts.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  customer_snapshot jsonb [not null, note: "Customer code, name, type, contacts, NPWP and address frozen at the last edit; printed instead of the live customer."]
  lead_id uuid [note: "Logical reference to crm.leads.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  attention varchar(200) [note: "Attention person (Up)."]
  status text [not null, default: 'draft']
  quotation_date date [not null]
  valid_until date [note: "Valid through the end of this Jakarta day. Expiry is shown, never a status."]
  payment_terms varchar(300) [note: "Printed payment line, e.g. DP 50% - 50% BAST."]
  payment_schedule jsonb [note: "Planned billing terms [{label, percentBps}], shares summing to 10000. Null = billed in one term."]
  guarantee varchar(300)
  vat_enabled boolean [not null, default: true, note: "VAT is decided per document (owner decision)."]
  vat_rate_bps integer [not null, default: 0, note: "VAT rate snapshot in basis points (1100 = 11%); 0 when VAT is off."]
  subtotal bigint [not null, default: 0]
  discount_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  notes text
  terms text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  rejected_reason text
  sent_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  sent_at bigint
  closed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  closed_at bigint [note: "When the outcome was recorded (won via its sales order, or lost)."]
  lost_reason text
  lost_note text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Quotation header (SPH), company-wide (ADR-0011): no organization_id. draft -> submitted -> approved or rejected; approved -> sent; any open status -> lost; won only by creating its sales order; revising marks the row superseded and creates the next revision. Self approval is rejected by the service layer. Totals are a cache of the items, recomputed by the service on every write."
  Indexes {
    base_code [name: 'quotations_base_code_idx']
    customer_id [name: 'quotations_customer_id_idx']
    status [name: 'quotations_status_idx']
    created_by [name: 'quotations_created_by_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'sent', 'superseded', 'won', 'lost')`
    `lost_reason IS NULL OR lost_reason IN ('price', 'competitor', 'project_cancelled', 'no_response', 'other')`
    `revision >= 0`
    `vat_rate_bps >= 0 AND vat_rate_bps <= 10000`
    `subtotal >= 0`
    `discount_total >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
  }
}

Table sales.quotation_items {
  id uuid [pk, default: `uuidv7()`]
  quotation_id uuid [not null]
  item_id uuid [note: "Logical reference to inventory.items.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract. Null = custom line."]
  sku varchar(64)
  name text [not null, note: "Item name snapshot (printed bold)."]
  specification text [note: "Multi-line specification printed under the name."]
  image_object_key text [note: "Snapshot of the item's document photo when the line was priced (keys are never overwritten)."]
  unit varchar(32) [not null, note: "One of the fixed item units."]
  quantity numeric(18,3) [not null, default: 1]
  unit_price bigint [not null, default: 0]
  discount_amount bigint [not null, default: 0]
  line_total bigint [not null, default: 0, note: "round(quantity x unit_price) - discount_amount."]
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a quotation, company-wide like its header. Prices and names are snapshots; line total is derived, never trusted from the client. Replaced as a whole while the quotation is a draft. VAT is per document, not per line."
  Indexes {
    (quotation_id, sort_order) [name: 'quotation_items_quotation_sort_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `discount_amount >= 0`
    `line_total >= 0`
  }
}

Table sales.discount_requests {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  quotation_id uuid
  sales_order_id uuid
  discount_type text [not null]
  discount_value numeric(18,4) [not null]
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  reason text
  status text [not null, default: 'requested']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  requested_at bigint [not null]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  rejected_reason text
  Note: "Discount request on a quotation or on a sales order. Exactly one parent is set."
  Indexes {
    quotation_id [name: 'discount_requests_quotation_id_idx']
    sales_order_id [name: 'discount_requests_sales_order_id_idx']
    status [name: 'discount_requests_status_idx']
  }
  Checks {
    `discount_type IN ('percentage', 'fixed')`
    `status IN ('requested', 'approved', 'rejected', 'cancelled')`
    `discount_value >= 0`
    `amount >= 0`
    `(quotation_id IS NOT NULL AND sales_order_id IS NULL) OR (quotation_id IS NULL AND sales_order_id IS NOT NULL)`
  }
}

Table sales.sales_orders {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Unique among live rows (partial index in the Drizzle schema)."]
  quotation_id uuid [not null, note: "The SPH this order closed as Deal; one live order per SPH (partial unique index)."]
  quotation_code varchar(40) [not null, note: "Number of that SPH revision, printed on later documents."]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  customer_snapshot jsonb [not null, note: "Customer data copied from the SPH."]
  customer_po_number varchar(100) [note: "The customer's purchase order number, when they issued one."]
  title text [not null]
  attention varchar(200)
  status text [not null, default: 'confirmed']
  order_date date [not null]
  delivery_date date
  payment_terms varchar(300)
  payment_schedule jsonb [note: "Planned billing terms copied from the SPH; null = one term."]
  guarantee varchar(300)
  vat_enabled boolean [not null]
  vat_rate_bps integer [not null, default: 0]
  subtotal bigint [not null, default: 0]
  discount_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  sales_person_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  notes text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cancelled_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cancelled_at bigint
  cancellation_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Confirmed customer order, company-wide (ADR-0011): no organization_id. Created only from an approved or sent quotation, which becomes won in the same transaction; cancelling it reopens the quotation. in_progress, delivered and completed are reserved for fulfilment. Stock commitment is done by the Inventory module through a logical reservation."
  Indexes {
    quotation_id [name: 'sales_orders_quotation_id_idx']
    customer_id [name: 'sales_orders_customer_id_idx']
    status [name: 'sales_orders_status_idx']
    sales_person_user_id [name: 'sales_orders_sales_person_idx']
  }
  Checks {
    `status IN ('confirmed', 'in_progress', 'delivered', 'completed', 'cancelled')`
    `vat_rate_bps >= 0 AND vat_rate_bps <= 10000`
    `subtotal >= 0`
    `discount_total >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
  }
}

Table sales.sales_order_items {
  id uuid [pk, default: `uuidv7()`]
  sales_order_id uuid [not null]
  quotation_item_id uuid [note: "The SPH line it was copied from."]
  item_id uuid [note: "Logical reference to inventory.items.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract. Null = custom line."]
  sku varchar(64)
  name text [not null]
  specification text
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null, default: 1]
  unit_price bigint [not null, default: 0]
  discount_amount bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  quantity_delivered numeric(18,3) [not null, default: 0]
  fulfillment_status text [not null, default: 'pending']
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a sales order, copied from its quotation line. Company-wide like its header."
  Indexes {
    (sales_order_id, sort_order) [name: 'sales_order_items_order_sort_idx']
    fulfillment_status [name: 'sales_order_items_fulfillment_status_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `discount_amount >= 0`
    `line_total >= 0`
    `quantity_delivered >= 0`
    `fulfillment_status IN ('pending', 'reserved', 'partial', 'fulfilled', 'cancelled')`
  }
}

Table sales.contracts {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  sales_order_id uuid
  status text [not null, default: 'draft']
  contract_value bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  start_date date
  end_date date
  signed_on date
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Commercial contract with a customer, the legal basis of the order and of the project."
  Indexes {
    (organization_id, code) [unique, name: 'contracts_org_code_uq']
    sales_order_id [name: 'contracts_sales_order_id_idx']
    customer_id [name: 'contracts_customer_id_idx']
  }
  Checks {
    `status IN ('draft', 'active', 'expired', 'terminated')`
    `contract_value >= 0`
    `end_date IS NULL OR end_date >= start_date`
  }
}

Table sales.sales_targets {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  sales_user_id text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  period_year integer [not null]
  period_month integer
  target_amount bigint [not null, default: 0]
  achieved_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'active']
  assigned_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Sales target of a salesperson for a month or for a year."
  Indexes {
    (organization_id, sales_user_id, period_year, period_month) [unique, name: 'sales_targets_scope_uq']
  }
  Checks {
    `period_month IS NULL OR period_month BETWEEN 1 AND 12`
    `target_amount >= 0`
    `achieved_amount >= 0`
    `status IN ('active', 'closed', 'cancelled')`
  }
}

Table sales.quotation_status_history {
  id uuid [pk, default: `uuidv7()`]
  quotation_id uuid [not null]
  from_status text
  to_status text [not null]
  changed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  changed_at bigint [not null]
  note text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Append only status history of a quotation, company-wide. Written in the same transaction as the transition."
  Indexes {
    quotation_id [name: 'quotation_status_history_quotation_id_idx']
  }
}

Table sales.order_status_history {
  id uuid [pk, default: `uuidv7()`]
  sales_order_id uuid [not null]
  from_status text
  to_status text [not null]
  changed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  changed_at bigint [not null]
  note text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Append only status history of a sales order, company-wide."
  Indexes {
    sales_order_id [name: 'order_status_history_sales_order_id_idx']
  }
}

Table sales.sales_returns {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  sales_order_id uuid [not null]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  status text [not null, default: 'requested']
  return_date date
  reason text
  total_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Goods return request against a sales order. Stock is returned by the Inventory module."
  Indexes {
    (organization_id, code) [unique, name: 'sales_returns_org_code_uq']
    sales_order_id [name: 'sales_returns_sales_order_id_idx']
    status [name: 'sales_returns_status_idx']
  }
  Checks {
    `status IN ('requested', 'approved', 'rejected', 'received', 'cancelled')`
    `total_amount >= 0`
  }
}

Table sales.delivery_notes {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Assigned on creation (SJ). Unique among live rows (partial index in the Drizzle schema)."]
  sales_order_id uuid [not null]
  warehouse_id uuid [not null, note: "Logical reference to inventory.warehouses.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  bin_id uuid [note: "Logical reference to inventory.warehouse_storages.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  status text [not null, default: 'prepared']
  delivery_date date [not null, note: "Jakarta business date printed as Tanggal."]
  project_name text [note: "Nama Proyek; defaults to the order title."]
  project_location text [note: "Lokasi Proyek."]
  recipient_name text [not null, note: "Nama Perusahaan / Penerima; defaults to the order's customer."]
  recipient_address text [note: "Alamat Proyek."]
  recipient_pic varchar(200) [note: "PIC / Kontak."]
  recipient_contact varchar(200) [note: "Telp/Email of the recipient."]
  driver_name varchar(200) [note: "Printed under Tertanda Supir."]
  vehicle_number varchar(32)
  notes text [note: "Catatan box of the print."]
  shipped_at bigint
  shipped_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  received_at bigint
  receiver_name text [note: "Who signed as Penerima."]
  cancelled_at bigint
  cancelled_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cancellation_reason text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Delivery note (surat jalan), company-wide (ADR-0011). Shipping posts one stock issue movement per stock-tracked line at the moving-average cost and marks the listed serial units sold, in one transaction through the Inventory module contract. Shipped notes are final; returns are sales_returns."
  Indexes {
    sales_order_id [name: 'delivery_notes_sales_order_id_idx']
    status [name: 'delivery_notes_status_idx']
  }
  Checks {
    `status IN ('prepared', 'shipped', 'delivered', 'cancelled')`
  }
}

Table sales.delivery_note_items {
  id uuid [pk, default: `uuidv7()`]
  delivery_note_id uuid [not null]
  sales_order_item_id uuid [not null]
  item_id uuid [note: "Logical reference to inventory.items.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract. Null for a custom order line."]
  sku varchar(64)
  name text [not null]
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null]
  unit_price bigint [not null, default: 0, note: "Order unit price, printed as Harga (IDR minor units)."]
  unit_cost bigint [note: "Moving-average cost the issue movement took (IDR minor units); null until shipped or for non-stock lines."]
  serial_numbers jsonb [note: "One serial per unit for serialized items."]
  remarks text [note: "Keterangan."]
  stock_movement_id uuid [note: "Logical reference to inventory.stock_movements.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a delivery note, copied from a sales order line."
  Indexes {
    delivery_note_id [name: 'delivery_note_items_delivery_note_id_idx']
    sales_order_item_id [name: 'delivery_note_items_sales_order_item_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
  }
}

Table sales.invoices {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [note: "Allocated from the numbering authority (INV-<YYYYMM>-<#5>). Nullable: a draft may exist without a code. Unique per organization."]
  invoice_type text [not null, default: 'sales']
  term_kind text [note: "down_payment = first live invoice of its order that does not settle it; settlement = the one that settles it; installment otherwise. Null when the invoice is not billed against an order term."]
  customer_id uuid [note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  customer_snapshot jsonb [note: "Customer data copied from the sales order. Null when the invoice has no order."]
  sales_order_id uuid [note: "Plain id of a row in sales.sales_orders (same module). Nullable: proforma and recurring invoices may have no order."]
  sales_order_code varchar(32)
  quotation_code varchar(40) [note: "The SPH number printed as No. Ref."]
  title text [note: "Subject (Perihal), from the order."]
  description text [note: "Term label, e.g. DP 30% or Pelunasan."]
  percentage_bps integer [note: "Share of the order tax base when billed by percentage."]
  payment_term_id uuid [note: "Logical reference to finance.payment_terms.id. Cross-module FK intentionally omitted. Validated through the Finance module contract."]
  issue_date date
  due_date date
  vat_enabled boolean [not null, default: true]
  vat_rate_bps integer [not null, default: 0]
  subtotal bigint [not null, default: 0, note: "Tax base (DPP) of this term."]
  discount_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  paid_total bigint [not null, default: 0]
  outstanding_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  terms text [note: "Terms and conditions printed on the invoice, copied from the company profile."]
  notes text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  issued_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  issued_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  voided_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  voided_at bigint
  void_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Customer invoice (faktur) for one billing term, company-wide per ADR-0012: organization_id is the issuing organization. Free terms: the invoices of an order never exceed its total and the settling term takes the exact remainder. draft -> issued -> partially_paid -> paid; unpaid draft or issued -> void; draft -> cancelled. Overdue is shown from due_date, never stored. Voiding is an append only mark, the invoice is never deleted. Finance mirrors AR open items in finance.ar_open_items."
  Indexes {
    (organization_id, code) [unique, name: 'invoices_org_code_uq']
    customer_id [name: 'invoices_customer_id_idx']
    sales_order_id [name: 'invoices_sales_order_id_idx']
    status [name: 'invoices_status_idx']
    due_date [name: 'invoices_due_date_idx']
    term_kind [name: 'invoices_term_kind_idx']
  }
  Checks {
    `invoice_type IN ('sales', 'proforma', 'recurring')`
    `term_kind IS NULL OR term_kind IN ('down_payment', 'installment', 'settlement')`
    `status IN ('draft', 'issued', 'partially_paid', 'paid', 'void', 'cancelled')`
    `vat_rate_bps >= 0 AND vat_rate_bps <= 10000`
    `subtotal >= 0`
    `discount_total >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
    `paid_total >= 0 AND paid_total <= grand_total`
    `outstanding_total >= 0`
    `due_date IS NULL OR issue_date IS NULL OR due_date >= issue_date`
  }
}

Table sales.invoice_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  invoice_id uuid [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  item_variant_id uuid [note: "Logical reference to catalog.item_variants.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  unit_id uuid [note: "Logical reference to catalog.units.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  description text
  quantity numeric(18,4) [not null, default: 0]
  unit_price bigint [not null, default: 0]
  discount_amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  sort_order integer [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  created_at bigint [not null]
  Note: "Line of a sales invoice."
  Indexes {
    invoice_id [name: 'invoice_items_invoice_id_idx']
    item_id [name: 'invoice_items_item_id_idx']
  }
  Checks {
    `quantity >= 0`
    `unit_price >= 0`
    `discount_amount >= 0`
    `tax_amount >= 0`
    `line_total >= 0`
  }
}

Table sales.receipts {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  sales_invoice_id uuid [not null, note: "Plain id of a row in sales.invoices (same module)."]
  payment_id uuid [note: "Logical reference to finance.payments.id. Cross-module FK intentionally omitted. Validated through the Finance module contract."]
  received_date date
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  method text [not null, default: 'bank_transfer']
  reference varchar(100) [note: "Transfer reference or similar."]
  notes text
  status text [not null, default: 'draft']
  received_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  posted_at bigint
  reversed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  reversed_at bigint
  reversal_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Cash receipt register, kwitansi. It is the customer facing proof of a payment, the money movement stays in finance.payments. Owned by Sales (moved from finance.receipts, 2026-11-08). Issued against a sales invoice; never more than the invoice's outstanding amount."
  Indexes {
    (organization_id, code) [unique, name: 'receipts_org_code_uq']
    sales_invoice_id [name: 'receipts_sales_invoice_id_idx']
    payment_id [name: 'receipts_payment_id_idx']
    status [name: 'receipts_status_idx']
  }
  Checks {
    `status IN ('draft', 'verified', 'posted', 'reversed', 'void')`
    `amount > 0`
    `method IN ('bank_transfer', 'cash', 'card', 'e_wallet', 'cheque')`
  }
}

// ---------------------------------------------------------------------------
// MODULE: Procurement  (schema: procurement)
// Supplier master, purchase requests, purchase orders, goods receipts and
// purchase returns. Tenant scoped, except suppliers, purchase orders and goods
// receipts, which are company-wide (ADR-0011).
// ---------------------------------------------------------------------------

Table procurement.suppliers {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Upper-case letters and digits; the {SUPPLIER} token of PO numbers. Unique among live rows (partial index in the Drizzle schema)."]
  name text [not null]
  legal_name text
  supplier_type text [not null, default: 'company']
  tax_id varchar(16) [note: "NPWP digits only, 15 or 16."]
  email text
  phone varchar(30)
  whatsapp varchar(30)
  website varchar(200)
  address_line text [note: "Address printed on purchase orders."]
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  postal_code varchar(10)
  pic_name varchar(120) [note: "Supplier-side person in charge, printed on purchase orders."]
  pic_title varchar(100)
  pic_phone varchar(30)
  pic_email text
  payment_terms_days integer [not null, default: 0]
  payment_term_note varchar(300) [note: "Default payment line of new purchase orders."]
  bank_name text
  bank_account_number text
  bank_account_holder text
  status text [not null, default: 'active']
  notes text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Supplier master, company-wide (ADR-0011): no organization_id. Bank details are restricted and never returned to the client without supplier:read_bank. Inactive suppliers cannot be used on new purchase orders."
  Indexes {
    name [name: 'suppliers_name_idx']
    status [name: 'suppliers_status_idx']
    tax_id [name: 'suppliers_tax_id_idx']
  }
  Checks {
    `supplier_type IN ('company', 'individual', 'government')`
    `status IN ('active', 'inactive')`
    `payment_terms_days >= 0`
  }
}

Table procurement.supplier_contacts {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  supplier_id uuid [not null]
  name text [not null]
  position text
  email text
  phone text
  whatsapp text
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Contact person of a supplier."
  Indexes {
    supplier_id [name: 'supplier_contacts_supplier_id_idx']
  }
}

Table procurement.supplier_addresses {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  supplier_id uuid [not null]
  kind text [not null, default: 'office']
  label text
  contact_name text
  contact_phone text
  address_line text
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  district_id uuid [note: "Logical reference to location.districts.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  regency_id uuid [note: "Logical reference to location.regencies.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  province_id uuid [note: "Logical reference to location.provinces.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Structured Indonesian address of a supplier."
  Indexes {
    supplier_id [name: 'supplier_addresses_supplier_id_idx']
  }
  Checks {
    `kind IN ('office', 'factory', 'warehouse', 'billing', 'other')`
  }
}

Table procurement.purchase_requests {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  requested_by text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  department_id uuid [note: "Logical reference to organization.departments.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  project_id uuid [note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted. Validated through the Projects module contract."]
  status text [not null, default: 'draft']
  request_date date
  needed_by date
  justification text
  estimated_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  rejected_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Purchase request, the approval gate before a purchase order exists."
  Indexes {
    (organization_id, code) [unique, name: 'purchase_requests_org_code_uq']
    status [name: 'purchase_requests_status_idx']
    requested_by [name: 'purchase_requests_requested_by_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'cancelled', 'ordered')`
    `estimated_total >= 0`
  }
}

Table procurement.purchase_request_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  purchase_request_id uuid [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  description text
  quantity numeric(18,3) [not null, default: 1]
  unit_id uuid [note: "Logical reference to catalog.units.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  estimated_unit_price bigint [not null, default: 0]
  estimated_total bigint [not null, default: 0]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a purchase request."
  Indexes {
    purchase_request_id [name: 'purchase_request_items_purchase_request_id_idx']
  }
  Checks {
    `quantity > 0`
    `estimated_unit_price >= 0`
    `estimated_total >= 0`
  }
}

Table procurement.purchase_orders {
  id uuid [pk, default: `uuidv7()`]
  code varchar(40) [note: "Assigned on approval, e.g. PO/IMS-HIT/HW/1026/001; null before. Unique among live rows (partial index in the Drizzle schema)."]
  supplier_id uuid [not null]
  supplier_snapshot jsonb [not null, note: "Supplier name, address, NPWP and PIC printed on the PO."]
  category text [not null, note: "{CATEGORY} token of the number: hardware HW, software SW, service JS, other LN."]
  subject varchar(200) [not null, note: "Perihal."]
  status text [not null, default: 'draft']
  order_date date [not null]
  expected_delivery_date date
  supplier_quote_ref varchar(100) [note: "The supplier's quotation number (Ref. Penawaran)."]
  supplier_quote_date date
  project_name varchar(200)
  buyer_pic_name varchar(120)
  vat_mode text [not null, default: 'none', note: "none, included (prices contain VAT) or added (VAT on top)."]
  vat_rate_bps integer [not null, default: 0]
  subtotal bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  payment_terms varchar(500) [note: "Printed as the first purchase term (Pembayaran)."]
  terms text [note: "Further purchase terms, one per line."]
  notes text
  rejection_reason text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  sent_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  sent_at bigint
  cancelled_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cancelled_at bigint
  cancelled_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Purchase order to a supplier, company-wide (ADR-0011). draft -> submitted -> approved -> sent -> partially_received -> received; rejection returns to draft; cancelled while nothing was received. One-level approval, never by the creator. The supplier bill and its payment stay in the Finance module."
  Indexes {
    supplier_id [name: 'purchase_orders_supplier_id_idx']
    status [name: 'purchase_orders_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'sent', 'partially_received', 'received', 'cancelled')`
    `category IN ('hardware', 'software', 'service', 'other')`
    `vat_mode IN ('none', 'included', 'added')`
    `vat_rate_bps >= 0 AND vat_rate_bps <= 10000`
    `subtotal >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
  }
}

Table procurement.purchase_order_items {
  id uuid [pk, default: `uuidv7()`]
  purchase_order_id uuid [not null]
  item_id uuid [not null, note: "Logical reference to inventory.items.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  sku varchar(64) [not null]
  name text [not null]
  specification text
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null, default: 1]
  unit_price bigint [not null, default: 0]
  line_total bigint [not null, default: 0, note: "round(quantity x unit_price)."]
  quantity_received numeric(18,3) [not null, default: 0]
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a purchase order, company-wide like its header. VAT is per purchase order."
  Indexes {
    (purchase_order_id, sort_order) [name: 'purchase_order_items_order_sort_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `line_total >= 0`
    `quantity_received >= 0`
  }
}

Table procurement.goods_receipts {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Assigned on creation (BPB). Unique among live rows (partial index in the Drizzle schema)."]
  purchase_order_id uuid [not null]
  warehouse_id uuid [not null, note: "Logical reference to inventory.warehouses.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  bin_id uuid [note: "Logical reference to inventory.warehouse_storages.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  status text [not null, default: 'posted']
  receipt_date date [not null]
  supplier_delivery_ref varchar(100) [note: "The supplier's delivery note number."]
  received_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Goods receipt note, company-wide (ADR-0011). Posted on creation: the stock receipt movements (with unit cost) and serial units are written in the same transaction through the Inventory module contract. Immutable; corrections go through stock adjustments."
  Indexes {
    purchase_order_id [name: 'goods_receipts_purchase_order_id_idx']
    warehouse_id [name: 'goods_receipts_warehouse_id_idx']
  }
  Checks {
    `status IN ('posted')`
  }
}

Table procurement.goods_receipt_items {
  id uuid [pk, default: `uuidv7()`]
  goods_receipt_id uuid [not null]
  purchase_order_item_id uuid [not null]
  item_id uuid [not null, note: "Logical reference to inventory.items.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  sku varchar(64) [not null]
  name text [not null]
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null]
  unit_cost bigint [not null, default: 0, note: "Ex-VAT unit price booked into stock (IDR minor units)."]
  serial_numbers jsonb [note: "One serial per unit for serialized items."]
  stock_movement_id uuid [note: "Logical reference to inventory.stock_movements.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a goods receipt; its quantity became the stock receipt movement."
  Indexes {
    goods_receipt_id [name: 'goods_receipt_items_goods_receipt_id_idx']
    purchase_order_item_id [name: 'goods_receipt_items_purchase_order_item_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_cost >= 0`
  }
}

Table procurement.purchase_returns {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  purchase_order_id uuid [not null]
  supplier_id uuid [not null]
  status text [not null, default: 'requested']
  return_date date
  reason text
  total_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Return of purchased goods to a supplier."
  Indexes {
    (organization_id, code) [unique, name: 'purchase_returns_org_code_uq']
    purchase_order_id [name: 'purchase_returns_purchase_order_id_idx']
    status [name: 'purchase_returns_status_idx']
  }
  Checks {
    `status IN ('requested', 'approved', 'rejected', 'shipped', 'completed')`
    `total_amount >= 0`
  }
}

Table procurement.purchase_return_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  purchase_return_id uuid [not null]
  purchase_order_item_id uuid
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  quantity numeric(18,3) [not null, default: 0]
  unit_price bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a purchase return."
  Indexes {
    purchase_return_id [name: 'purchase_return_items_purchase_return_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `line_total >= 0`
  }
}

Ref: sales.quotation_items.quotation_id > sales.quotations.id [delete: cascade]
Ref: sales.quotations.previous_revision_id > sales.quotations.id [delete: restrict]
