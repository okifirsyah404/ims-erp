    status [name: 'supplier_bills_status_idx']
    due_date [name: 'supplier_bills_due_date_idx']
  }
  Checks {
    `status IN ('draft', 'approved', 'partially_paid', 'paid', 'overdue', 'void')`
    `subtotal >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
    `paid_total >= 0`
    `outstanding_total >= 0`
  }
}

Table finance.payment_terms {
  id uuid [pk, default: `uuidv7()`]
