// ---------------------------------------------------------------------------
// MODULE: Approval  (schema: approval)
// Approval policies with immutable versions, approval requests, stages,
// decisions, delegations and amount thresholds. Tenant scoped.
// The module owns the decision record, it never owns the business document.
// ---------------------------------------------------------------------------

Table approval.approval_policies {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  module text [not null]
  document_type text [not null]
  description text
  current_version integer [not null, default: 1]
  is_active boolean [not null, default: true]
  created_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Approval policy header. The rules live in approval_policy_versions and are never edited in place, a change creates a new version."
  Indexes {
    (organization_id, code) [unique, name: 'approval_policies_org_code_uq']
    (module, document_type) [name: 'approval_policies_scope_idx']
  }
  Checks {
    `current_version > 0`
  }
}

Table approval.approval_policy_versions {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approval_policy_id uuid [not null]
  version integer [not null]
  conditions text
  amount_limit_min bigint
  amount_limit_max bigint
  required_role text
  required_approver_count smallint [not null, default: 1]
  no_self_approval boolean [not null, default: true]
  stage_order smallint [not null, default: 1]
  effective_from date [not null]
  effective_to date
  change_reason text
  created_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  Note: "Immutable version of an approval policy. An approval request always points at the version that was in force."
  Indexes {
    (approval_policy_id, version) [unique, name: 'approval_policy_versions_policy_version_uq']
    effective_from [name: 'approval_policy_versions_effective_from_idx']
  }
  Checks {
    `version > 0`
    `required_approver_count > 0`
    `stage_order > 0`
    `amount_limit_min IS NULL OR amount_limit_min >= 0`
    `amount_limit_max IS NULL OR amount_limit_max >= 0`
    `effective_to IS NULL OR effective_to >= effective_from`
  }
}

Table approval.approval_requests {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  approval_policy_id uuid [not null]
  approval_policy_version_id uuid [not null]
  module text [not null]
  document_type text [not null]
  source_table text [not null]
  source_id text [not null]
  title text
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  source_version integer [not null, default: 1]
  status text [not null, default: 'pending']
  current_stage smallint [not null, default: 1]
  requested_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  requested_at bigint [not null]
  completed_at bigint
  invalidated_at bigint
  invalidation_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Approval request against a business document. source_version detects a change of the source document and invalidates the request."
  Indexes {
    (organization_id, code) [unique, name: 'approval_requests_org_code_uq']
    approval_policy_id [name: 'approval_requests_policy_id_idx']
    (source_table, source_id) [name: 'approval_requests_source_idx']
    status [name: 'approval_requests_status_idx']
  }
  Checks {
    `status IN ('pending', 'in_progress', 'approved', 'rejected', 'returned', 'cancelled', 'invalidated')`
    `amount >= 0`
    `current_stage >= 1`
    `source_version > 0`
  }
}

Table approval.approval_stages {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approval_request_id uuid [not null]
  stage_order smallint [not null]
  stage_name text [not null]
  required_role text
  required_approver_count smallint [not null, default: 1]
  min_amount bigint
  max_amount bigint
  status text [not null, default: 'waiting']
  started_at bigint
  completed_at bigint
  Note: "Ordered stage of an approval request. A stage opens only when the previous one is finished."
  Indexes {
    (approval_request_id, stage_order) [unique, name: 'approval_stages_request_order_uq']
  }
  Checks {
    `status IN ('waiting', 'active', 'approved', 'rejected', 'skipped')`
    `required_approver_count > 0`
    `stage_order > 0`
  }
}

Table approval.approval_decisions {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approval_request_id uuid [not null]
  approval_stage_id uuid [not null]
  stage_order smallint [not null]
  decision text [not null]
  approver_user_id text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  decided_at bigint [not null]
  comment text
  request_status_before text
  request_status_after text
  Note: "Append only decision log. A duplicate decision on the same stage is rejected by the service layer."
  Indexes {
    approval_request_id [name: 'approval_decisions_request_id_idx']
    approval_stage_id [name: 'approval_decisions_stage_id_idx']
    (approval_stage_id, approver_user_id) [name: 'approval_decisions_approver_uq']
  }
  Checks {
    `decision IN ('approve', 'reject', 'return', 'skip')`
  }
}

Table approval.approval_delegations {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approval_request_id uuid [not null]
  from_user_id text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  to_user_id text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  reason text
  starts_at bigint [not null]
  ends_at bigint
  is_active boolean [not null, default: true]
  created_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  Note: "Delegation of an approval right for one request. A delegate still cannot approve their own request."
  Indexes {
    approval_request_id [name: 'approval_delegations_request_id_idx']
    to_user_id [name: 'approval_delegations_to_user_id_idx']
  }
  Checks {
    `ends_at IS NULL OR ends_at > starts_at`
    `from_user_id <> to_user_id`
  }
}

Table approval.approval_thresholds {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  module text [not null]
  document_type text
  currency_code varchar(3) [not null, default: 'IDR']
  min_amount bigint
  max_amount bigint
  required_role text
  required_approver_count smallint [not null, default: 1]
  effective_from date [not null]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Amount band that decides which approver level applies to a document."
  Indexes {
    (organization_id, module, document_type, min_amount) [unique, name: 'approval_thresholds_band_uq']
  }
  Checks {
    `required_approver_count > 0`
    `min_amount IS NULL OR min_amount >= 0`
    `max_amount IS NULL OR max_amount >= 0`
  }
}

Ref: approval.approval_policy_versions.approval_policy_id > approval.approval_policies.id [delete: cascade]
Ref: approval.approval_requests.approval_policy_id > approval.approval_policies.id [delete: restrict]
Ref: approval.approval_requests.approval_policy_version_id > approval.approval_policy_versions.id [delete: restrict]
Ref: approval.approval_stages.approval_request_id > approval.approval_requests.id [delete: cascade]
Ref: approval.approval_decisions.approval_request_id > approval.approval_requests.id [delete: cascade]
Ref: approval.approval_decisions.approval_stage_id > approval.approval_stages.id [delete: cascade]
Ref: approval.approval_delegations.approval_request_id > approval.approval_requests.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Budgeting  (schema: budgeting)
// Budget periods, budgets and lines, revisions, executions, cash flow plans
// and lines. Tenant scoped.
// ---------------------------------------------------------------------------

Table budgeting.budget_periods {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  period_year integer [not null]
  period_month integer
  start_date date [not null]
  end_date date [not null]
  budget_type text [not null, default: 'operating']
  status text [not null, default: 'open']
  is_locked boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Budget period, monthly or annual."
  Indexes {
    (organization_id, code) [unique, name: 'budget_periods_org_code_uq']
    (organization_id, period_year, period_month) [unique, name: 'budget_periods_period_uq']
  }
  Checks {
    `period_month IS NULL OR period_month BETWEEN 1 AND 12`
    `budget_type IN ('operating', 'capital', 'project', 'annual')`
    `status IN ('open', 'submitted', 'approved', 'closed')`
    `end_date >= start_date`
  }
}

Table budgeting.budgets {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  budget_period_id uuid [not null]
  name text [not null]
  department_id uuid [note: "Logical reference to organization.departments.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  branch_id uuid [note: "Logical reference to organization.branches.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  project_id uuid [note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted. Validated through the Projects module contract."]
  total_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  submitted_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Budget header of a period for a department, a branch or a project."
  Indexes {
    (organization_id, code) [unique, name: 'budgets_org_code_uq']
    budget_period_id [name: 'budgets_period_id_idx']
    status [name: 'budgets_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'revised', 'active', 'closed', 'cancelled')`
    `total_amount >= 0`
  }
}

Table budgeting.budget_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  budget_id uuid [not null]
  chart_of_account_id uuid [note: "Logical reference to accounting.chart_of_accounts.id. Cross-module FK intentionally omitted. Validated through the Accounting module contract."]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  category_code text
  description text
  planned_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a budget."
  Indexes {
    budget_id [name: 'budget_items_budget_id_idx']
  }
  Checks {
    `planned_amount >= 0`
  }
}

Table budgeting.budget_revisions {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  budget_id uuid [not null]
  revision_number smallint [not null]
  previous_total bigint [not null, default: 0]
  new_total bigint [not null, default: 0]
  reason text
  status text [not null, default: 'draft']
  requested_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Revision of an approved budget. The previous lines stay readable, the revision writes the delta."
  Indexes {
    (organization_id, code) [unique, name: 'budget_revisions_org_code_uq']
    (budget_id, revision_number) [unique, name: 'budget_revisions_budget_number_uq']
    status [name: 'budget_revisions_status_idx']
  }
  Checks {
    `revision_number > 0`
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'applied')`
    `previous_total >= 0`
    `new_total >= 0`
  }
}

Table budgeting.budget_revision_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  budget_revision_id uuid [not null]
  budget_item_id uuid [not null]
  previous_amount bigint [not null, default: 0]
  new_amount bigint [not null, default: 0]
  note text
  created_at bigint [not null]
  Note: "Line of a budget revision."
  Indexes {
    budget_revision_id [name: 'budget_revision_items_revision_id_idx']
    budget_item_id [name: 'budget_revision_items_item_id_idx']
    (budget_revision_id, budget_item_id) [unique, name: 'budget_revision_items_uq']
  }
  Checks {
    `previous_amount >= 0`
    `new_amount >= 0`
  }
}

Table budgeting.budget_executions {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  budget_id uuid [not null]
  budget_item_id uuid
  transaction_date date [not null]
  actual_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  source_type text
  source_id text
  note text
  created_at bigint [not null]
  Note: "Actual spending recorded against a budget line."
  Indexes {
    budget_id [name: 'budget_executions_budget_id_idx']
    budget_item_id [name: 'budget_executions_item_id_idx']
    transaction_date [name: 'budget_executions_date_idx']
  }
  Checks {
    `actual_amount >= 0`
  }
}

Table budgeting.cash_flow_plans {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  plan_year integer [not null]
  plan_month integer
  opening_balance bigint [not null, default: 0]
  inflow_total bigint [not null, default: 0]
  outflow_total bigint [not null, default: 0]
  closing_balance bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Cash flow plan of a month or of a year."
  Indexes {
    (organization_id, code) [unique, name: 'cash_flow_plans_org_code_uq']
    (organization_id, plan_year, plan_month) [unique, name: 'cash_flow_plans_period_uq']
  }
  Checks {
    `plan_month IS NULL OR plan_month BETWEEN 1 AND 12`
    `status IN ('draft', 'submitted', 'approved', 'active', 'closed')`
    `closing_balance = opening_balance + inflow_total - outflow_total`
  }
}

Table budgeting.cash_flow_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cash_flow_plan_id uuid [not null]
  direction text [not null]
  category_code text
  description text
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  expected_date date
  source_type text
  source_id text
  created_at bigint [not null]
  Note: "Line of a cash flow plan."
  Indexes {
    cash_flow_plan_id [name: 'cash_flow_items_plan_id_idx']
  }
  Checks {
    `direction IN ('in', 'out')`
    `amount >= 0`
  }
}

Ref: budgeting.budgets.budget_period_id > budgeting.budget_periods.id [delete: restrict]
Ref: budgeting.budget_items.budget_id > budgeting.budgets.id [delete: cascade]
Ref: budgeting.budget_revisions.budget_id > budgeting.budgets.id [delete: cascade]
Ref: budgeting.budget_revision_items.budget_revision_id > budgeting.budget_revisions.id [delete: cascade]
Ref: budgeting.budget_revision_items.budget_item_id > budgeting.budget_items.id [delete: cascade]
Ref: budgeting.budget_executions.budget_id > budgeting.budgets.id [delete: cascade]
Ref: budgeting.budget_executions.budget_item_id > budgeting.budget_items.id [delete: set null]
Ref: budgeting.cash_flow_items.cash_flow_plan_id > budgeting.cash_flow_plans.id [delete: cascade]


// ---------------------------------------------------------------------------
// MODULE: Investor  (schema: investor)
// Investor master, capital commitments and deposits, fund allocations, profit
// sharing scheme and runs, investor reports and meetings. Tenant scoped.
// ---------------------------------------------------------------------------

Table investor.investors {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  legal_name text
  investor_type text [not null, default: 'individual']
  tax_id text
  email text
  phone text
  whatsapp text
  address_line text
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  district_id uuid [note: "Logical reference to location.districts.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  regency_id uuid [note: "Logical reference to location.regencies.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  province_id uuid [note: "Logical reference to location.provinces.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  postal_code varchar(10)
  bank_name text
  bank_account_number text
  bank_account_holder text
  portal_identity_id uuid [note: "Logical reference to auth.portal_identities.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  status text [not null, default: 'active']
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Investor master, the investor back office. Bank details are restricted."
  Indexes {
    (organization_id, code) [unique, name: 'investors_org_code_uq']
    status [name: 'investors_status_idx']
    tax_id [name: 'investors_tax_id_idx']
  }
  Checks {
    `investor_type IN ('individual', 'institution', 'fund')`
    `status IN ('active', 'inactive', 'exited')`
  }
}

Table investor.investor_addresses {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  investor_id uuid [not null]
  kind text [not null, default: 'residence']
  label text
  address_line text
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  district_id uuid [note: "Logical reference to location.districts.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  regency_id uuid [note: "Logical reference to location.regencies.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  province_id uuid [note: "Logical reference to location.provinces.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Address of an investor."
  Indexes {
    investor_id [name: 'investor_addresses_investor_id_idx']
  }
  Checks {
    `kind IN ('residence', 'office', 'billing', 'other')`
  }
}

Table investor.capital_commitments {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  investor_id uuid [not null]
  commitment_date date
  committed_amount bigint [not null, default: 0]
  received_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  term_months integer
  rate_percent numeric(9,4)
  status text [not null, default: 'draft']
  notes text
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Commitment of an investor, the basis of the capital deposits."
  Indexes {
    (organization_id, code) [unique, name: 'capital_commitments_org_code_uq']
    investor_id [name: 'capital_commitments_investor_id_idx']
    status [name: 'capital_commitments_status_idx']
  }
  Checks {
    `status IN ('draft', 'approved', 'active', 'settled', 'cancelled')`
    `committed_amount >= 0`
    `received_amount >= 0`
    `received_amount <= committed_amount`
    `term_months IS NULL OR term_months > 0`
    `rate_percent IS NULL OR rate_percent >= 0`
  }
}

Table investor.capital_deposits {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  capital_commitment_id uuid
  investor_id uuid [not null]
  deposit_date date
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  payment_method text [not null, default: 'bank_transfer']
  status text [not null, default: 'draft']
  verified_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  verified_at bigint
  posted_at bigint
  cash_bank_transaction_id uuid [note: "Logical reference to finance.cash_bank_transactions.id. Cross-module FK intentionally omitted. Validated through the Finance module contract."]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Money received from an investor. The bank movement is a Finance module transaction."
  Indexes {
    (organization_id, code) [unique, name: 'capital_deposits_org_code_uq']
    investor_id [name: 'capital_deposits_investor_id_idx']
    capital_commitment_id [name: 'capital_deposits_commitment_id_idx']
    status [name: 'capital_deposits_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'verified', 'posted', 'rejected', 'cancelled')`
    `amount > 0`
    `payment_method IN ('bank_transfer', 'cash', 'offset')`
  }
}

Table investor.fund_allocations {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  capital_deposit_id uuid
  investor_id uuid [not null]
  allocation_date date
  purpose text
  target_module text
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  submitted_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Allocation of deposited capital to a business purpose."
  Indexes {
    (organization_id, code) [unique, name: 'fund_allocations_org_code_uq']
    investor_id [name: 'fund_allocations_investor_id_idx']
    status [name: 'fund_allocations_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'disbursed')`
    `amount > 0`
  }
}

Table investor.profit_share_schemes {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  effective_from date [not null]
  effective_to date
  status text [not null, default: 'draft']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "The one agreed profit sharing scheme, versioned by effective date."
  Indexes {
    (organization_id, code) [unique, name: 'profit_share_schemes_org_code_uq']
    effective_from [name: 'profit_share_schemes_effective_from_idx']
  }
  Checks {
    `status IN ('draft', 'approved', 'active', 'expired', 'cancelled')`
    `effective_to IS NULL OR effective_to >= effective_from`
  }
}

Table investor.profit_share_scheme_entries {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  profit_share_scheme_id uuid [not null]
  investor_id uuid [not null]
  share_percent numeric(9,4) [not null]
  tier_order smallint [not null, default: 1]
  effective_from date
  created_at bigint [not null]
  Note: "Share of one investor inside a profit sharing scheme."
  Indexes {
    (profit_share_scheme_id, investor_id) [unique, name: 'profit_share_scheme_entries_uq']
    investor_id [name: 'profit_share_scheme_entries_investor_id_idx']
  }
  Checks {
    `share_percent >= 0`
    `share_percent <= 100`
    `tier_order > 0`
  }
}

Table investor.profit_distribution_runs {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  period_year integer [not null]
  period_month integer
  distribution_date date
  total_profit bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  calculated_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  calculated_at bigint
  submitted_at bigint
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Profit distribution run of a period. The per investor shares live in investor.profit_shares."
  Indexes {
    (organization_id, code) [unique, name: 'profit_distribution_runs_org_code_uq']
    (organization_id, period_year, period_month) [unique, name: 'profit_distribution_runs_period_uq']
  }
  Checks {
    `period_month IS NULL OR period_month BETWEEN 1 AND 12`
    `status IN ('draft', 'calculated', 'submitted', 'approved', 'paid', 'cancelled')`
    `total_profit >= 0`
  }
}

Table investor.profit_shares {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  profit_distribution_run_id uuid [not null]
  investor_id uuid [not null]
  share_percent numeric(9,4) [not null, default: 0]
  gross_amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  net_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  paid_at bigint
  payment_id uuid [note: "Logical reference to finance.payments.id. Cross-module FK intentionally omitted. Validated through the Finance module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Share of one investor inside a profit distribution run. The payment is a Finance module row."
  Indexes {
    (profit_distribution_run_id, investor_id) [unique, name: 'profit_shares_run_investor_uq']
    investor_id [name: 'profit_shares_investor_id_idx']
  }
  Checks {
    `share_percent >= 0`
    `share_percent <= 100`
    `gross_amount >= 0`
    `tax_amount >= 0`
    `net_amount >= 0`
    `net_amount = gross_amount - tax_amount`
  }
}

Table investor.investor_reports {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  title text [not null]
  report_type text [not null, default: 'periodic']
  period_year integer
  period_month integer
  generated_on date
  content_summary text
  status text [not null, default: 'draft']
  published_at bigint
  published_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  document_id uuid [note: "Logical reference to documents.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Investor report, the artefact shared with the investor portal."
  Indexes {
    (organization_id, code) [unique, name: 'investor_reports_org_code_uq']
    status [name: 'investor_reports_status_idx']
  }
  Checks {
    `report_type IN ('periodic', 'capital', 'profit_distribution', 'annual')`
    `status IN ('draft', 'published', 'archived')`
  }
}

Table investor.investor_meetings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  meeting_date date [not null]
  title text [not null]
  location text
  agenda text
  attendees text
  minutes text
  status text [not null, default: 'scheduled']
  document_id uuid [note: "Logical reference to documents.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Investor meeting record with its minutes."
  Indexes {
    (organization_id, code) [unique, name: 'investor_meetings_org_code_uq']
    meeting_date [name: 'investor_meetings_date_idx']
  }
  Checks {
    `status IN ('scheduled', 'held', 'postponed', 'cancelled')`
  }
}

Ref: investor.investor_addresses.investor_id > investor.investors.id [delete: cascade]
Ref: investor.capital_commitments.investor_id > investor.investors.id [delete: restrict]
Ref: investor.capital_deposits.investor_id > investor.investors.id [delete: restrict]
Ref: investor.capital_deposits.capital_commitment_id > investor.capital_commitments.id [delete: set null]
Ref: investor.fund_allocations.investor_id > investor.investors.id [delete: restrict]
Ref: investor.fund_allocations.capital_deposit_id > investor.capital_deposits.id [delete: set null]
Ref: investor.profit_share_scheme_entries.profit_share_scheme_id > investor.profit_share_schemes.id [delete: cascade]
Ref: investor.profit_share_scheme_entries.investor_id > investor.investors.id [delete: restrict]
Ref: investor.profit_shares.profit_distribution_run_id > investor.profit_distribution_runs.id [delete: cascade]
Ref: investor.profit_shares.investor_id > investor.investors.id [delete: restrict]

// ---------------------------------------------------------------------------
// MODULE: Commerce  (schema: commerce)
// Public website content, menus, catalog publications, promotions and the
// web shop orders. Tenant scoped.
// ---------------------------------------------------------------------------

Table commerce.web_pages {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  slug varchar(128) [not null]
  title text [not null]
  page_type text [not null, default: 'content']
  body text
  status text [not null, default: 'draft']
  published_at bigint
  seo_title text
  seo_description text
  version integer [not null, default: 1]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Public website page."
  Indexes {
    (organization_id, slug) [unique, name: 'web_pages_org_slug_uq']
    status [name: 'web_pages_status_idx']
  }
  Checks {
    `page_type IN ('content', 'landing', 'about', 'contact', 'legal', 'faq')`
    `status IN ('draft', 'published', 'archived')`
    `version > 0`
  }
}

Table commerce.web_menus {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  parent_menu_id uuid
  position integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Navigation menu of the public website."
  Indexes {
    (organization_id, code) [unique, name: 'web_menus_org_code_uq']
    parent_menu_id [name: 'web_menus_parent_menu_id_idx']
  }
}

Table commerce.web_menu_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  web_menu_id uuid [not null]
  label text [not null]
  url text
  web_page_id uuid
  position integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Entry of a navigation menu."
  Indexes {
    web_menu_id [name: 'web_menu_items_menu_id_idx']
    web_page_id [name: 'web_menu_items_page_id_idx']
  }
}

Table commerce.catalog_publications {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  status text [not null, default: 'draft']
  item_count integer [not null, default: 0]
  published_at bigint
  published_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Published catalog of the public website."
  Indexes {
    (organization_id, code) [unique, name: 'catalog_publications_org_code_uq']
    status [name: 'catalog_publications_status_idx']
  }
  Checks {
    `status IN ('draft', 'published', 'archived')`
    `item_count >= 0`
  }
}

Table commerce.catalog_publication_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  catalog_publication_id uuid [not null]
  item_id uuid [not null, note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  display_order integer [not null, default: 0]
  override_price bigint
  currency_code varchar(3) [not null, default: 'IDR']
  is_featured boolean [not null, default: false]
  created_at bigint [not null]
  Note: "Item inside a published catalog."
  Indexes {
    (catalog_publication_id, item_id) [unique, name: 'catalog_publication_items_uq']
  }
  Checks {
    `override_price IS NULL OR override_price >= 0`
  }
}

Table commerce.promotions {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  promotion_type text [not null, default: 'percentage']
  start_at bigint
  end_at bigint
  discount_value numeric(18,4) [not null, default: 0]
  min_purchase_amount bigint [not null, default: 0]
  usage_limit integer
  used_count integer [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  created_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Promotion of the public shop."
  Indexes {
    (organization_id, code) [unique, name: 'promotions_org_code_uq']
    status [name: 'promotions_status_idx']
  }
  Checks {
    `promotion_type IN ('percentage', 'fixed', 'free_shipping', 'bundle')`
    `status IN ('draft', 'scheduled', 'active', 'expired', 'cancelled')`
    `discount_value >= 0`
    `min_purchase_amount >= 0`
    `usage_limit IS NULL OR usage_limit > 0`
    `used_count >= 0`
    `end_at IS NULL OR start_at IS NULL OR end_at > start_at`
  }
}

Table commerce.promotion_rules {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  promotion_id uuid [not null]
  rule_type text [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  item_category_id uuid [note: "Logical reference to catalog.item_categories.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  min_quantity numeric(18,3)
  discount_amount bigint [not null, default: 0]
  discount_percent numeric(9,4)
  currency_code varchar(3) [not null, default: 'IDR']
  created_at bigint [not null]
  Note: "Condition of a promotion, for example a minimum quantity of an item."
  Indexes {
    promotion_id [name: 'promotion_rules_promotion_id_idx']
  }
  Checks {
    `rule_type IN ('item', 'category', 'minimum_quantity', 'minimum_amount')`
    `discount_amount >= 0`
    `discount_percent IS NULL OR (discount_percent >= 0 AND discount_percent <= 100)`
  }
}

Table commerce.commerce_orders {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  customer_id uuid [note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  customer_email text
  customer_name text
  status text [not null, default: 'pending']
  order_date date
  subtotal bigint [not null, default: 0]
  discount_total bigint [not null, default: 0]
  shipping_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  payment_method text
  payment_status text [not null, default: 'unpaid']
  shipping_address text
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Order placed on the public shop. It is not a sales order, the Sales module owns the confirmed order."
  Indexes {
    (organization_id, code) [unique, name: 'commerce_orders_org_code_uq']
    status [name: 'commerce_orders_status_idx']
    customer_email [name: 'commerce_orders_customer_email_idx']
  }
  Checks {
    `status IN ('pending', 'confirmed', 'processing', 'shipped', 'completed', 'cancelled')`
    `payment_status IN ('unpaid', 'pending', 'paid', 'refunded', 'failed')`
    `subtotal >= 0`
    `discount_total >= 0`
    `shipping_total >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
  }
}

Table commerce.commerce_order_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  commerce_order_id uuid [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  description text
  quantity numeric(18,3) [not null, default: 1]
  unit_price bigint [not null, default: 0]
  discount_amount bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  fulfillment_status text [not null, default: 'pending']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a public shop order."
  Indexes {
    commerce_order_id [name: 'commerce_order_items_order_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `discount_amount >= 0`
    `line_total >= 0`
    `fulfillment_status IN ('pending', 'allocated', 'shipped', 'cancelled')`
  }
}

Ref: commerce.web_menus.parent_menu_id > commerce.web_menus.id [delete: set null]
Ref: commerce.web_menu_items.web_menu_id > commerce.web_menus.id [delete: cascade]
Ref: commerce.web_menu_items.web_page_id > commerce.web_pages.id [delete: set null]
Ref: commerce.catalog_publication_items.catalog_publication_id > commerce.catalog_publications.id [delete: cascade]
Ref: commerce.promotion_rules.promotion_id > commerce.promotions.id [delete: cascade]
Ref: commerce.commerce_order_items.commerce_order_id > commerce.commerce_orders.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Automation  (schema: automation)
// Integrations and encrypted credentials, workflows and steps, workflow runs,
// scheduled jobs and executions, outbox, notification templates and
// notifications. Tenant scoped. Secrets are never stored in clear text.
// ---------------------------------------------------------------------------

Table automation.integrations {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  integration_type text [not null]
  provider text
  base_url text
  config text
  status text [not null, default: 'inactive']
  is_active boolean [not null, default: true]
  last_health_check_at bigint
  created_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "External system binding. The secrets live in integration_credentials, never here."
  Indexes {
    (organization_id, code) [unique, name: 'integrations_org_code_uq']
    status [name: 'integrations_status_idx']
  }
  Checks {
    `integration_type IN ('payment_gateway', 'whatsapp', 'email', 'erp_sync', 'webhook', 'other')`
    `status IN ('active', 'inactive', 'error', 'disabled')`
  }
}

Table automation.integration_credentials {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  integration_id uuid [not null]
  credential_key text [not null]
  secret_value_encrypted text
  key_version smallint [not null, default: 1]
  rotated_at bigint
  rotation_due_on date
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Encrypted credential of an integration. The plain value is never returned by any read endpoint."
  Indexes {
    (integration_id, credential_key) [unique, name: 'integration_credentials_uq']
  }
  Checks {
    `key_version > 0`
  }
}

Table automation.workflows {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  trigger_type text [not null]
  trigger_config text
  version integer [not null, default: 1]
  is_active boolean [not null, default: false]
  created_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Workflow definition. The steps are ordered and versioned with the workflow."
  Indexes {
    (organization_id, code) [unique, name: 'workflows_org_code_uq']
    trigger_type [name: 'workflows_trigger_type_idx']
  }
  Checks {
    `trigger_type IN ('record_created', 'record_updated', 'scheduled', 'webhook', 'manual')`
    `version > 0`
  }
}

Table automation.workflow_steps {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  workflow_id uuid [not null]
  step_order smallint [not null]
  step_name text [not null]
  action_type text [not null]
  action_config text
  retry_count smallint [not null, default: 0]
  timeout_seconds integer
  on_failure text [not null, default: 'stop']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Step of a workflow."
  Indexes {
    (workflow_id, step_order) [unique, name: 'workflow_steps_workflow_order_uq']
  }
  Checks {
    `step_order > 0`
    `on_failure IN ('stop', 'continue', 'retry')`
    `retry_count >= 0`
  }
}

Table automation.workflow_runs {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  workflow_id uuid [not null]
  trigger_type text [not null]
  trigger_reference text
  status text [not null, default: 'running']
  started_at bigint [not null]
  finished_at bigint
  duration_ms integer
  error_message text
  initiated_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  Note: "Execution of a workflow."
  Indexes {
    (organization_id, code) [unique, name: 'workflow_runs_org_code_uq']
    workflow_id [name: 'workflow_runs_workflow_id_idx']
    status [name: 'workflow_runs_status_idx']
    started_at [name: 'workflow_runs_started_at_idx']
  }
  Checks {
    `status IN ('running', 'completed', 'failed', 'cancelled')`
  }
}

Table automation.workflow_step_runs {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  workflow_run_id uuid [not null]
  workflow_step_id uuid
  step_order smallint [not null]
  status text [not null, default: 'running']
  started_at bigint [not null]
  finished_at bigint
  output text
  error_message text
  Note: "Execution of one step of a workflow run."
  Indexes {
    workflow_run_id [name: 'workflow_step_runs_run_id_idx']
    workflow_step_id [name: 'workflow_step_runs_step_id_idx']
  }
  Checks {
    `status IN ('running', 'completed', 'failed', 'skipped')`
  }
}

Table automation.scheduled_jobs {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  job_type text [not null]
  schedule_cron text
  next_run_at bigint
  last_run_at bigint
  payload text
  status text [not null, default: 'active']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Database driven recurring job. Long running queues stay in the Redis worker, this table is the schedule."
  Indexes {
    (organization_id, code) [unique, name: 'scheduled_jobs_org_code_uq']
    next_run_at [name: 'scheduled_jobs_next_run_at_idx']
  }
  Checks {
    `job_type IN ('reminder', 'recurring_posting', 'expiry_check', 'sync', 'cleanup')`
    `status IN ('active', 'paused', 'failed', 'completed')`
  }
}

Table automation.job_executions {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  scheduled_job_id uuid
  job_code text [not null]
  status text [not null, default: 'running']
  started_at bigint [not null]
  finished_at bigint
  payload text
  result text
  error_message text
  triggered_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  Note: "Execution log of a scheduled job."
  Indexes {
    scheduled_job_id [name: 'job_executions_scheduled_job_id_idx']
    job_code [name: 'job_executions_job_code_idx']
    started_at [name: 'job_executions_started_at_idx']
  }
  Checks {
    `status IN ('running', 'completed', 'failed', 'skipped')`
  }
}

Table automation.outbox_messages {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  topic text [not null]
  aggregate_type text
  aggregate_id text
  payload text
  status text [not null, default: 'pending']
  attempts smallint [not null, default: 0]
  available_at bigint
  published_at bigint
  error_message text
  created_at bigint [not null]
  Note: "Transactional outbox. The event is written in the same transaction as the business change, then published after the commit."
  Indexes {
    status [name: 'outbox_messages_status_idx']
    available_at [name: 'outbox_messages_available_at_idx']
    (aggregate_type, aggregate_id) [name: 'outbox_messages_aggregate_idx']
  }
  Checks {
    `status IN ('pending', 'published', 'failed', 'dead')`
    `attempts >= 0`
  }
}

Table automation.notification_templates {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  channel text [not null]
  subject_template text
  body_template text
  variables text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Template of a customer facing notification."
  Indexes {
    (organization_id, code) [unique, name: 'notification_templates_org_code_uq']
    channel [name: 'notification_templates_channel_idx']
  }
  Checks {
    `channel IN ('email', 'whatsapp', 'in_app', 'webhook')`
  }
}

Table automation.notifications {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  notification_template_id uuid
  recipient_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  recipient_type text [not null]
  recipient_value text [not null]
  channel text [not null]
  subject text
  body text
  status text [not null, default: 'queued']
  scheduled_at bigint
  sent_at bigint
  read_at bigint
  error_message text
  source_type text
  source_id text
  created_at bigint [not null]
  Note: "One notification sent or queued for one recipient."
  Indexes {
    notification_template_id [name: 'notifications_template_id_idx']
    recipient_user_id [name: 'notifications_recipient_user_id_idx']
    status [name: 'notifications_status_idx']
    scheduled_at [name: 'notifications_scheduled_at_idx']
  }
  Checks {
    `recipient_type IN ('user', 'customer', 'investor', 'supplier', 'employee', 'phone', 'email')`
    `channel IN ('email', 'whatsapp', 'in_app', 'webhook')`
    `status IN ('queued', 'sending', 'sent', 'delivered', 'read', 'failed', 'cancelled')`
  }
}

Ref: automation.integration_credentials.integration_id > automation.integrations.id [delete: cascade]
Ref: automation.workflow_steps.workflow_id > automation.workflows.id [delete: cascade]
Ref: automation.workflow_runs.workflow_id > automation.workflows.id [delete: restrict]
Ref: automation.workflow_step_runs.workflow_run_id > automation.workflow_runs.id [delete: cascade]
Ref: automation.workflow_step_runs.workflow_step_id > automation.workflow_steps.id [delete: set null]
Ref: automation.job_executions.scheduled_job_id > automation.scheduled_jobs.id [delete: set null]
Ref: automation.notifications.notification_template_id > automation.notification_templates.id [delete: set null]

// ---------------------------------------------------------------------------
// MODULE: Licensing  (schema: licensing)
// Licensed applications, packages, contracts, keys, activations, entitlements
// and usages, subscription schedules and events. Tenant scoped.
// ---------------------------------------------------------------------------

Table licensing.licensable_applications {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  vendor text
  license_model text [not null, default: 'perpetual']
  status text [not null, default: 'active']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Application that can be licensed. One integrated pilot application at the moment."
  Indexes {
    (organization_id, code) [unique, name: 'licensable_applications_org_code_uq']
  }
  Checks {
    `license_model IN ('perpetual', 'subscription', 'trial', 'usage')`
    `status IN ('active', 'retired')`
  }
}

Table licensing.license_packages {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  licensable_application_id uuid [not null]
  code varchar(32) [not null]
  name text [not null]
  description text
  duration_months integer
  price bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  features text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Sellable package of a licensed application."
  Indexes {
    (organization_id, code) [unique, name: 'license_packages_org_code_uq']
    licensable_application_id [name: 'license_packages_application_id_idx']
  }
  Checks {
    `price >= 0`
    `duration_months IS NULL OR duration_months > 0`
  }
}

Table licensing.license_contracts {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  license_package_id uuid [not null]
  start_date date
  end_date date
  billing_cycle text [not null, default: 'monthly']
  contract_value bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  auto_renew boolean [not null, default: false]
  status text [not null, default: 'draft']
  renewed_from_contract_id uuid
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Licensing contract with a customer, the source of the license keys."
  Indexes {
    (organization_id, code) [unique, name: 'license_contracts_org_code_uq']
    customer_id [name: 'license_contracts_customer_id_idx']
    license_package_id [name: 'license_contracts_package_id_idx']
    status [name: 'license_contracts_status_idx']
  }
  Checks {
    `billing_cycle IN ('monthly', 'quarterly', 'semi_annual', 'annual', 'one_time')`
    `status IN ('draft', 'active', 'expired', 'suspended', 'terminated', 'renewed')`
    `contract_value >= 0`
    `end_date IS NULL OR start_date IS NULL OR end_date >= start_date`
  }
}

Table licensing.license_keys {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  license_key text [not null]
  license_package_id uuid [not null]
  license_contract_id uuid
  issued_on date
  expires_on date
  status text [not null, default: 'issued']
  max_activations integer [not null, default: 1]
  activation_count integer [not null, default: 0]
  is_transferable boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "License key issued under a contract. The key value is stored hashed for the customer facing read path."
  Indexes {
    (organization_id, license_key) [unique, name: 'license_keys_key_uq']
    license_contract_id [name: 'license_keys_contract_id_idx']
    status [name: 'license_keys_status_idx']
    expires_on [name: 'license_keys_expires_on_idx']
  }
  Checks {
    `status IN ('issued', 'active', 'suspended', 'expired', 'revoked')`
    `max_activations > 0`
    `activation_count >= 0`
    `activation_count <= max_activations`
    `expires_on IS NULL OR issued_on IS NULL OR expires_on > issued_on`
  }
}

Table licensing.license_activations {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  license_key_id uuid [not null]
  activation_code text [not null]
  device_fingerprint text
  activated_on date [not null]
  expires_on date
  last_seen_at bigint
  ip_address text
  status text [not null, default: 'active']
  deactivated_at bigint
  Note: "Activation of a license key on one device."
  Indexes {
    license_key_id [name: 'license_activations_key_id_idx']
    (license_key_id, device_fingerprint) [unique, name: 'license_activations_device_uq']
    status [name: 'license_activations_status_idx']
  }
  Checks {
    `status IN ('active', 'expired', 'deactivated', 'revoked')`
  }
}

Table licensing.license_entitlements {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  license_package_id uuid [not null]
  entitlement_code text [not null]
  name text [not null]
  description text
  limit_value numeric(18,3)
  unit text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Right granted by a package, for example a maximum number of cameras."
  Indexes {
    (license_package_id, entitlement_code) [unique, name: 'license_entitlements_uq']
  }
  Checks {
    `limit_value IS NULL OR limit_value >= 0`
  }
}

Table licensing.license_entitlement_usages {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  license_entitlement_id uuid [not null]
  license_key_id uuid [not null]
  used_value numeric(18,3) [not null, default: 0]
  period_year integer
  period_month integer
  used_at bigint [not null]
  Note: "Consumption of an entitlement, checked against the limit before an activation is allowed."
  Indexes {
    license_entitlement_id [name: 'license_entitlement_usages_entitlement_id_idx']
    license_key_id [name: 'license_entitlement_usages_key_id_idx']
  }
  Checks {
    `used_value >= 0`
  }
}

Table licensing.subscription_schedules {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  license_contract_id uuid [not null]
  next_invoice_date date
  next_billing_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  auto_generate_invoice boolean [not null, default: true]
  last_invoiced_at bigint
  status text [not null, default: 'active']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Renewal schedule of a licensing contract. The invoice itself is created by the Finance module."
  Indexes {
    license_contract_id [unique, name: 'subscription_schedules_contract_id_uq']
    next_invoice_date [name: 'subscription_schedules_next_invoice_date_idx']
  }
  Checks {
    `status IN ('active', 'paused', 'completed', 'cancelled')`
    `next_billing_amount >= 0`
  }
}

Table licensing.license_events {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  license_key_id uuid [not null]
  event_type text [not null]
  event_at bigint [not null]
  payload text
  description text
  actor_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  Note: "Append only event log of a license key."
  Indexes {
    license_key_id [name: 'license_events_key_id_idx']
    event_at [name: 'license_events_event_at_idx']
  }
  Checks {
    `event_type IN ('issued', 'activated', 'deactivated', 'suspended', 'revoked', 'expired', 'renewed')`
  }
}

Ref: licensing.license_packages.licensable_application_id > licensing.licensable_applications.id [delete: restrict]
Ref: licensing.license_contracts.license_package_id > licensing.license_packages.id [delete: restrict]
Ref: licensing.license_contracts.renewed_from_contract_id > licensing.license_contracts.id [delete: set null]
Ref: licensing.license_keys.license_package_id > licensing.license_packages.id [delete: restrict]
Ref: licensing.license_keys.license_contract_id > licensing.license_contracts.id [delete: set null]
Ref: licensing.license_activations.license_key_id > licensing.license_keys.id [delete: cascade]
Ref: licensing.license_entitlements.license_package_id > licensing.license_packages.id [delete: cascade]
Ref: licensing.license_entitlement_usages.license_entitlement_id > licensing.license_entitlements.id [delete: cascade]
Ref: licensing.license_entitlement_usages.license_key_id > licensing.license_keys.id [delete: cascade]
Ref: licensing.subscription_schedules.license_contract_id > licensing.license_contracts.id [delete: cascade]
Ref: licensing.license_events.license_key_id > licensing.license_keys.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Ticketing  (schema: ticket)
// Customer-facing issue tickets: the customer portal creates tickets, staff
// work them, the customer tracks progress. Distinct from the internal
// after-sales service tickets, which are warranty/equipment driven; a ticket
// may escalate into a service ticket by logical reference. Tenant scoped.
// ---------------------------------------------------------------------------

Table ticket.ticket_categories {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Customer-configurable ticket categories per organization."
  Indexes {
    (organization_id, code) [unique, name: 'ticket_categories_org_code_uq']
  }
}

Table ticket.tickets {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  category_id uuid
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  contact_id uuid [note: "Logical reference to crm.customer_contacts.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  subject varchar(255) [not null]
  description text
  priority text [not null, default: 'normal']
  status text [not null, default: 'open']
  assignee_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  sla_due_at bigint
  first_response_at bigint
  resolved_at bigint
  closed_at bigint
  escalated_service_ticket_id uuid [note: "Logical reference to aftersales.service_tickets.id. Cross-module FK intentionally omitted. Validated through the After-Sales module contract."]
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Customer issue ticket. The customer portal identity (auth.portal_identities) links the auth user to the customer; a portal user may list and read only tickets of its own linked customer in its own organization, enforced server-side. Numbering via organization.document_sequences."
  Indexes {
    (organization_id, code) [unique, name: 'tickets_org_code_uq']
    (organization_id, customer_id) [name: 'tickets_org_customer_idx']
    (organization_id, status) [name: 'tickets_org_status_idx']
    assignee_user_id [name: 'tickets_assignee_idx']
    category_id [name: 'tickets_category_idx']
  }
  Checks {
    `priority IN ('low', 'normal', 'high', 'urgent')`
    `status IN ('open', 'in_progress', 'waiting_customer', 'escalated', 'resolved', 'closed', 'cancelled')`
    `(status = 'resolved' AND resolved_at IS NOT NULL) OR (status <> 'resolved' AND resolved_at IS NULL)`
    `(status = 'closed' AND closed_at IS NOT NULL) OR (status <> 'closed' AND closed_at IS NULL)`
  }
}

Table ticket.ticket_messages {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  ticket_id uuid [not null]
  author_type text [not null]
  author_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null when author_type = 'system'."]
  author_contact_id uuid [note: "Logical reference to crm.customer_contacts.id. Cross-module FK intentionally omitted. Validated through the CRM module contract. Set when author_type = 'customer'."]
  body text [not null]
  is_internal_note boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Message thread of a ticket. Internal notes never reach the customer portal."
  Indexes {
    (ticket_id, created_at) [name: 'ticket_messages_ticket_created_idx']
  }
  Checks {
    `author_type IN ('customer', 'staff', 'system')`
    `(author_type = 'customer' AND author_contact_id IS NOT NULL AND author_user_id IS NULL) OR (author_type = 'staff' AND author_user_id IS NOT NULL AND author_contact_id IS NULL) OR (author_type = 'system' AND author_user_id IS NULL AND author_contact_id IS NULL)`
  }
}

Table ticket.ticket_attachments {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  ticket_id uuid [not null]
  ticket_message_id uuid
  file_name text [not null]
  mime_type varchar(128) [not null]
  file_size_bytes bigint [not null]
  storage_key text [not null]
  uploaded_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Attachment metadata. Bytes live in object storage; storage_key is not a URL."
  Indexes {
    ticket_id [name: 'ticket_attachments_ticket_idx']
    ticket_message_id [name: 'ticket_attachments_message_idx']
  }
  Checks {
    `file_size_bytes >= 0`
  }
}

Table ticket.ticket_status_history {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  ticket_id uuid [not null]
  from_status text
  to_status text [not null]
  changed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null for system transitions."]
  note text
  created_at bigint [not null]
  Note: "Append-only audit of status transitions. Never updated, never deleted."
  Indexes {
    (ticket_id, created_at) [name: 'ticket_status_history_ticket_created_idx']
  }
}

Ref: ticket.tickets.category_id > ticket.ticket_categories.id [delete: set null]
Ref: ticket.ticket_messages.ticket_id > ticket.tickets.id [delete: cascade]
Ref: ticket.ticket_attachments.ticket_id > ticket.tickets.id [delete: cascade]
Ref: ticket.ticket_attachments.ticket_message_id > ticket.ticket_messages.id [delete: cascade]
Ref: ticket.ticket_status_history.ticket_id > ticket.tickets.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Audit  (schema: audit)
// Reproduced from drizzle/schemas/audit.schema.ts (user-management module).
// ERP-owned append-only trail for user-management security events.
// Insert-only by contract: no updates, no soft delete (exempt from the
// deleted_at rule as an append-only ledger). The actor is a logical
// reference so a deleted user does not erase the trail.
// ---------------------------------------------------------------------------

Table audit.audit_logs {
  id text [pk]
  actor_user_id text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  actor_email text [note: "Denormalized actor display for readability without joins."]
  action text [not null, note: "Vocabulary guarded by application code (AUDIT_ACTIONS): invitation.sent/resent/cancelled/deleted/claimed, user.precreated/deactivated/restored/deleted, role.created/updated/deleted, member.added/removed/roleChanged, org.created."]
  target_type text [not null, note: "'invitation' | 'user' | 'role' | 'member' | 'organization'."]
  target_id text [not null]
  organization_id text [note: "Tenant scope; null for global (app-admin) actions."]
  meta jsonb [note: "Action-specific payload (before/after, emails, role names)."]
  ip_address text
  user_agent text
  created_at timestamp [not null, default: `now()`]
  Note: "Append-only audit trail for user-management events. Insert-only ledger, exempt from soft delete."
  Indexes {
    created_at [name: 'audit_logs_created_at_idx']
    organization_id [name: 'audit_logs_organization_id_idx']
    actor_user_id [name: 'audit_logs_actor_user_id_idx']
    action [name: 'audit_logs_action_idx']
    (target_type, target_id) [name: 'audit_logs_target_idx']
  }
}

// ---------------------------------------------------------------------------
// LEGACY: transitional table kept for reference, scheduled for removal.
// ---------------------------------------------------------------------------

TableGroup "Legacy transitional" {
  sales.payments
}

Table sales.payments {
  deleted_at bigint
  id text [pk]
  organization_id text [not null]
  quotation_id text [not null]
  amount integer [not null]
  status text [not null, default: 'pending']
  created_by text [not null]
  approved_by text
  approved_at bigint
  executed_by text
  executed_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "TRANSITIONAL SCAFFOLD, SCHEDULED FOR REMOVAL. Shape is exactly what migration 20261029044823_dear_living_lightning created. It is superseded by finance.payments, the single payment ledger of the ERP. amount is an integer column, which overflows at about 21.4 million rupiah, this is a known defect. Removed by the step S7 of implementation-phases.md. Do not extend it."
  Indexes {
    organization_id [name: 'payments_org_idx']
    quotation_id [name: 'payments_quotation_idx']
  }
  Checks {
    `status IN ('pending', 'approved', 'executed')`
  }
}


