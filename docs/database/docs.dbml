  updated_at bigint [not null]
  deleted_at bigint
  Note: "Payment terms, for example cash on delivery or 30 days net."
  Indexes {
    (organization_id, code) [unique, name: 'payment_terms_org_code_uq']
  }
  Checks {
    `days >= 0`
    `discount_percent IS NULL OR (discount_percent >= 0 AND discount_percent <= 100)`
  }
}

Table finance.expense_claims {
