// ---------------------------------------------------------------------------
// MODULE: Assets  (schema: assets)
// Asset types, categories, the asset register, maintenance, depreciation,
// disposal, documents, condition checks, tool sets, movements and borrowing.
// Tenant scoped with a global scope: organization_id NULL means
// company-wide/global, per ADR-0008's scope rule.
// ERP-0036: the asset row IS the physical unit; borrowing is the only custody
// mechanism (asset_assignments removed); borrowing moved here from inventory.
// ---------------------------------------------------------------------------

Table assets.asset_types {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null]
  name text [not null]
  default_useful_life_months integer
  default_depreciation_method text [not null, default: 'straight_line']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Asset type lookup (ERP-0036 D10). Global reference data, NOT tenant scoped: no organization_id. `code` is the stable identity referenced by assets.asset_type / asset_categories.asset_type; `name` is the editable label. Writes are application-admin-only. A type cannot be soft deleted while an asset or category references it; is_active is the 'stop offering it' switch."
  Indexes {
    code [unique, name: 'asset_types_code_uq']
    is_active [name: 'asset_types_is_active_idx']
  }
  Checks {
    `default_depreciation_method IN ('straight_line', 'declining_balance', 'none')`
    `default_useful_life_months IS NULL OR default_useful_life_months > 0`
  }
}

Table assets.asset_categories {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null means global/company-wide (ADR-0008 scope rule)."]
  code varchar(32) [not null]
  name text [not null]
  parent_category_id uuid
  asset_type text [not null, default: 'equipment']
  default_useful_life_months integer
  default_depreciation_method text [not null, default: 'straight_line']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Asset category with the default depreciation rule of the category."
  Indexes {
    (organization_id, code) [unique, name: 'asset_categories_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'asset_categories_global_code_uq', note: 'WHERE organization_id IS NULL']
    parent_category_id [name: 'asset_categories_parent_category_id_idx']
  }
  Checks {
    `default_depreciation_method IN ('straight_line', 'declining_balance', 'none')`
  }
}

Table assets.assets {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null means global/company-wide (ADR-0008 scope rule); global rows are app-admin write, org read."]
  code varchar(32) [not null]
  name text [not null]
  description text
  category_id uuid
  asset_type text [not null, default: 'equipment']
  serial_number text
  barcode text
  acquisition_date date
  acquisition_cost bigint [not null, default: 0]
  salvage_value bigint [not null, default: 0]
  accumulated_depreciation bigint [not null, default: 0]
  book_value bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  useful_life_months integer
  depreciation_method text [not null, default: 'straight_line']
  depreciation_started_on date
  condition text [not null, default: 'good']
  status text [not null, default: 'ready']
  deactivation_reason text [note: "DEVIATION (shipped): dbml originally omitted this column and the 'inactive' status. D18 added deactivation-with-reason; enforced by assets_deactivation_reason_check (inactive ⇔ reason NOT NULL)."]
  location_description text [note: "Off-site / non-warehouse location (customer site, technician van). May be set together with warehouse_id/storage_id 'en route to site X' (D19)."]
  warehouse_id uuid [note: "Logical reference to inventory.warehouses.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract. Current warehouse of the physical unit (D2); NULL while borrowed, disposed or lost."]
  storage_id uuid [note: "Logical reference to inventory.warehouse_storages.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract. Storage (bin) inside warehouse_id; a storage id always implies its warehouse_id."]
  custodian_employee_id uuid [note: "Written denormalisation of the open borrowing's borrower, produced only by syncCustody (D8); never accepted from a request body. Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  borrowed_since bigint [note: "Renamed from assigned_at (D8). Written only by syncCustody in the same transaction as borrow issue / return / disposal / loss."]
  supplier_id uuid [note: "Logical reference to procurement.suppliers.id. Cross-module FK intentionally omitted. Validated through the Procurement module contract."]
  purchase_order_id uuid [note: "Logical reference to procurement.purchase_orders.id. Cross-module FK intentionally omitted. Validated through the Procurement module contract."]
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Asset master; ONE ROW PER PHYSICAL UNIT (D1), quantity is always 1. Costs are exact integer minor units. Master data referenced by financial records is never hard deleted. status is a denormalisation derived by reconcileStatus (D7) for unit-backed rows: open borrowing ⇒ borrowed, in-progress maintenance ⇒ maintenance, terminal writes disposed/lost, otherwise ready; inactive is asset-owned and never overwritten by reconcile. Status vocabulary (D7): in_stock→ready, in_use→borrowed, inactive retained per D18."
  Indexes {
    code [unique, name: 'assets_code_uq', note: 'Global across scopes so an org asset and a global asset can never share a code (D13); codes are allocated from the global numbering sequence.']
    (organization_id, serial_number) [unique, name: 'assets_serial_uq', note: "Expression index on (coalesce(organization_id, ''), serial_number) WHERE serial_number IS NOT NULL AND deleted_at IS NULL — organization_id alone would let every global asset repeat because NULL never conflicts."]
    asset_type [name: 'assets_asset_type_idx']
    category_id [name: 'assets_category_id_idx']
    custodian_employee_id [name: 'assets_custodian_employee_id_idx']
    status [name: 'assets_status_idx']
    warehouse_id [name: 'assets_warehouse_id_idx']
    storage_id [name: 'assets_storage_id_idx']
    serial_number [name: 'assets_serial_number_idx']
  }
  Checks {
    `status IN ('ready', 'borrowed', 'maintenance', 'inactive', 'disposed', 'lost')`
    `(status = 'inactive' AND deactivation_reason IS NOT NULL) OR (status <> 'inactive' AND deactivation_reason IS NULL)`
    `storage_id IS NULL OR warehouse_id IS NOT NULL`
    `condition IN ('new', 'good', 'fair', 'poor', 'damaged')`
    `depreciation_method IN ('straight_line', 'declining_balance', 'none')`
    `acquisition_cost >= 0`
    `salvage_value >= 0`
    `accumulated_depreciation >= 0`
    `book_value >= 0`
    `useful_life_months IS NULL OR useful_life_months > 0`
  }
}

Table assets.asset_maintenances {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null means global/company-wide (ADR-0008 scope rule)."]
  code varchar(32) [not null]
  asset_id uuid [not null]
  maintenance_type text [not null, default: 'preventive']
  scheduled_date date
  performed_date date
  performed_by_employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  vendor_name text
  cost bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  description text
  status text [not null, default: 'scheduled']
  next_service_date date
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Maintenance record of an asset. The next service date drives the maintenance schedule."
  Indexes {
(organization_id, code) [unique, name: 'asset_maintenances_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
(code) [unique, name: 'asset_maintenances_global_code_uq', note: 'WHERE organization_id IS NULL']
    asset_id [name: 'asset_maintenances_asset_id_idx']
    status [name: 'asset_maintenances_status_idx']
    next_service_date [name: 'asset_maintenances_next_service_date_idx']
  }
  Checks {
    `maintenance_type IN ('preventive', 'corrective', 'calibration', 'inspection')`
    `status IN ('scheduled', 'in_progress', 'completed', 'cancelled')`
    `cost >= 0`
  }
}

Table assets.asset_depreciations {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null means global/company-wide (ADR-0008 scope rule)."]
  asset_id uuid [not null]
  period_year integer [not null]
  period_month integer [not null]
  depreciation_method text [not null, default: 'straight_line']
  depreciation_amount bigint [not null, default: 0]
  opening_book_value bigint [not null, default: 0]
  closing_book_value bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  calculated_at bigint
  journal_entry_id uuid [note: "Logical reference to accounting.journal_entries.id. Cross-module FK intentionally omitted. Validated through the Accounting module contract."]
  created_at bigint [not null]
  Note: "Monthly depreciation run of an asset, the audit trail of the book value."
  Indexes {
    (asset_id, period_year, period_month) [unique, name: 'asset_depreciations_period_uq']
    period_year [name: 'asset_depreciations_period_year_idx']
  }
  Checks {
    `period_month BETWEEN 1 AND 12`
    `depreciation_method IN ('straight_line', 'declining_balance', 'none')`
    `depreciation_amount >= 0`
    `closing_book_value >= 0`
  }
}

Table assets.asset_disposals {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null means global/company-wide (ADR-0008 scope rule)."]
  code varchar(32) [not null]
  asset_id uuid [not null]
  disposal_date date
  disposal_method text [not null, default: 'scrap']
  proceeds_amount bigint [not null, default: 0]
  book_value_at_disposal bigint [not null, default: 0]
  gain_loss bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  buyer_name text
  status text [not null, default: 'draft']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  executed_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Disposal of an asset. The asset is soft deleted, the disposal record stays as the financial proof."
  Indexes {
(organization_id, code) [unique, name: 'asset_disposals_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
(code) [unique, name: 'asset_disposals_global_code_uq', note: 'WHERE organization_id IS NULL']
    asset_id [name: 'asset_disposals_asset_id_idx']
    status [name: 'asset_disposals_status_idx']
  }
  Checks {
    `disposal_method IN ('sale', 'scrap', 'donation', 'transfer', 'trade_in')`
    `status IN ('draft', 'submitted', 'approved', 'executed', 'cancelled')`
    `proceeds_amount >= 0`
    `book_value_at_disposal >= 0`
  }
}

Table assets.asset_documents {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null means global/company-wide (ADR-0008 scope rule)."]
  asset_id uuid [not null]
  document_id uuid [not null, note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  document_type text [not null]
  created_at bigint [not null]
  Note: "Attachment of an invoice, a manual or a certificate to an asset."
  Indexes {
    asset_id [name: 'asset_documents_asset_id_idx']
    document_id [unique, name: 'asset_documents_document_id_uq']
  }
  Checks {
    `document_type IN ('invoice', 'manual', 'certificate', 'photo', 'contract')`
  }
}

Table assets.asset_condition_checks {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null means global/company-wide (ADR-0008 scope rule)."]
  asset_id uuid [not null]
  check_date date [not null]
  condition text [not null]
  findings text
  checked_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  next_check_date date
  status text [not null, default: 'recorded']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Periodic condition check of an asset."
  Indexes {
    asset_id [name: 'asset_condition_checks_asset_id_idx']
    check_date [name: 'asset_condition_checks_check_date_idx']
  }
  Checks {
    `condition IN ('new', 'good', 'fair', 'poor', 'damaged')`
    `status IN ('recorded', 'followed_up', 'closed')`
  }
}

Table assets.tool_sets {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null means global/company-wide (ADR-0008 scope rule)."]
  code varchar(32) [not null]
  name text [not null]
  description text
  custodian_employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  status text [not null, default: 'available']
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Tool kit lent to a technician as one unit."
  Indexes {
(organization_id, code) [unique, name: 'tool_sets_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
(code) [unique, name: 'tool_sets_global_code_uq', note: 'WHERE organization_id IS NULL']
    custodian_employee_id [name: 'tool_sets_custodian_employee_id_idx']
  }
  Checks {
    `status IN ('available', 'lent', 'maintenance', 'retired')`
  }
}

Table assets.tool_set_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null means global/company-wide (ADR-0008 scope rule)."]
  tool_set_id uuid [not null]
  asset_id uuid [not null]
  quantity numeric(18,3) [not null, default: 1]
  created_at bigint [not null]
  Note: "Line of a tool set."
  Indexes {
    tool_set_id [name: 'tool_set_items_tool_set_id_idx']
    asset_id [name: 'tool_set_items_asset_id_idx']
    (tool_set_id, asset_id) [unique, name: 'tool_set_items_uq']
  }
  Checks {
    `quantity > 0`
  }
}

Table assets.asset_movements {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null means global/company-wide (ADR-0008 scope rule)."]
  asset_id uuid [not null]
  movement_type text [not null, default: 'transfer']
  from_warehouse_id uuid [note: "Logical reference to inventory.warehouses.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  from_storage_id uuid [note: "Logical reference to inventory.warehouse_storages.id. Cross-module FK intentionally omitted."]
  to_warehouse_id uuid [note: "Logical reference to inventory.warehouses.id. Cross-module FK intentionally omitted."]
  to_storage_id uuid [note: "Logical reference to inventory.warehouse_storages.id. Cross-module FK intentionally omitted."]
  from_location text [note: "Free-text off-site detail (D3); kept alongside the location ids."]
  to_location text [note: "Free-text off-site detail (D3); kept alongside the location ids."]
  moved_at bigint [not null]
  moved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  condition text
  notes text
  created_at bigint [not null]
  Note: "Movement of an asset between warehouses/storages or off-site. ERP-0036 D3 replaced the vocabulary (was transfer/loan/return/project_site). Asset borrowing does NOT write the stock ledger (D4): issue/return write rows here instead. Append-only history; one direction only — borrowing_events points at a movement, never the reverse."
  Indexes {
    asset_id [name: 'asset_movements_asset_id_idx']
    moved_at [name: 'asset_movements_moved_at_idx']
    movement_type [name: 'asset_movements_movement_type_idx']
    from_warehouse_id [name: 'asset_movements_from_warehouse_id_idx']
    to_warehouse_id [name: 'asset_movements_to_warehouse_id_idx']
  }
  Checks {
    `movement_type IN ('receipt', 'transfer', 'borrow_out', 'borrow_return', 'project_site', 'disposal', 'lost')`
  }
}

Table assets.borrowings {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008)."]
  code varchar(32) [not null]
  status text [not null, default: 'requested']
  purpose text [not null, default: 'internal_use']
  borrower_type text [not null]
  tool_set_id uuid [note: "Logical reference to assets.tool_sets.id (same module). Set when the borrowing lends a whole kit (D6); NULL for a hand-picked set of assets."]
  borrower_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  borrower_customer_id uuid [note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted."]
  guest_name text
  guest_phone text
  guest_id_type text
  guest_id_number text [note: "Guest PII. Access-restricted and expired by the retention sweep (24 months is the working default)."]
  guest_address_text text
  guest_id_document_ref text [note: "Plain text until a Documents module exists."]
  requested_by text [note: "Logical reference to auth.users.id."]
  requested_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  issued_by text [note: "Logical reference to auth.users.id."]
  issued_at bigint
  due_at bigint [not null]
  closed_by text [note: "Logical reference to auth.users.id."]
  closed_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Borrowing header, MOVED HERE FROM inventory (ERP-0036 D5) unchanged in concept. A borrower is a registered user, a registered customer, or a guest whose identity is snapshotted here because there is no row to point at (ADR-0009). Codes are `<BRW-YYYYMM-####>` allocated on doc type `asset_borrowing` (D14)."
  Indexes {
    (organization_id, code) [unique, name: 'borrowings_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'borrowings_global_code_uq', note: 'WHERE organization_id IS NULL']
    status [name: 'borrowings_status_idx']
    borrower_user_id [name: 'borrowings_borrower_user_id_idx']
    borrower_customer_id [name: 'borrowings_borrower_customer_id_idx']
    due_at [name: 'borrowings_due_at_idx']
  }
  Checks {
    `status IN ('draft', 'requested', 'approved', 'rejected', 'issued', 'partially_returned', 'returned', 'closed', 'cancelled')`
    `purpose IN ('rental', 'internal_use', 'testing', 'warranty_service')`
    `borrower_type IN ('user', 'customer', 'guest')`
    `guest_id_type IS NULL OR guest_id_type IN ('ktp', 'sim', 'passport', 'other')`
    `(borrower_type = 'user' AND borrower_user_id IS NOT NULL AND borrower_customer_id IS NULL AND guest_name IS NULL AND guest_phone IS NULL AND guest_id_number IS NULL) OR (borrower_type = 'customer' AND borrower_customer_id IS NOT NULL AND borrower_user_id IS NULL AND guest_name IS NULL AND guest_phone IS NULL AND guest_id_number IS NULL) OR (borrower_type = 'guest' AND guest_name IS NOT NULL AND guest_phone IS NOT NULL AND guest_id_number IS NOT NULL AND borrower_user_id IS NULL AND borrower_customer_id IS NULL)`
  }
}

Table assets.borrowing_lines {
  id uuid [pk, default: `uuidv7()`]
  borrowing_id uuid [not null]
  asset_id uuid [not null, note: "The physical unit borrowed (D1). Replaces inventory's serial_tracked_item_id."]
  origin_warehouse_id uuid [note: "Logical reference to inventory.warehouses.id. Cross-module FK intentionally omitted. Snapshot of where the unit left from: the asset loses its warehouse while it is out (ADR-0009)."]
  origin_storage_id uuid [note: "Logical reference to inventory.warehouse_storages.id. Cross-module FK intentionally omitted. Snapshot of the storage the unit left from, so return restores the exact bin."]
  issued_at bigint
  due_at bigint
  returned_at bigint
  returned_condition text
  marked_late_at bigint
  marked_lost_at bigint
  lost_reported_by text [note: "Logical reference to auth.users.id."]
  site_address_text text
  project_id uuid [note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted."]
  notes text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "One borrowed asset. Borrowing is serialized-only: a line always names a specific asset, never a quantity (ADR-0009)."
  Indexes {
    (borrowing_id, asset_id) [unique, name: 'borrowing_lines_borrowing_asset_uq']
    asset_id [name: 'borrowing_lines_asset_id_idx']
    due_at [name: 'borrowing_lines_open_idx', note: 'WHERE returned_at IS NULL AND marked_lost_at IS NULL']
  }
  Checks {
    `returned_condition IS NULL OR returned_condition IN ('good', 'damaged', 'incomplete')`
    `due_at IS NULL OR issued_at IS NULL OR due_at > issued_at`
    `origin_storage_id IS NULL OR origin_warehouse_id IS NOT NULL`
  }
}

Table assets.borrowing_events {
  id uuid [pk, default: `uuidv7()`]
  borrowing_id uuid [not null]
  borrowing_line_id uuid
  event_type text [not null]
  asset_movement_id uuid [note: "Logical reference to assets.asset_movements.id (same module, journal column kept FK-free so the ledger never points back). Required for the physical event types, forbidden otherwise."]
  actor_user_id text [note: "Logical reference to auth.users.id. NULL for automated sweeps."]
  occurred_at bigint [not null]
  note text
  Note: "Append-only business timeline of a borrowing. Movements never point back here: one direction only (ADR-0009). Append-only: no updated_at, no deleted_at."
  Indexes {
    (borrowing_id, occurred_at) [name: 'borrowing_events_borrowing_occurred_idx']
    borrowing_line_id [name: 'borrowing_events_line_id_idx']
  }
  Checks {
    `event_type IN ('requested', 'approved', 'rejected', 'issued', 'returned', 'marked_late', 'marked_lost', 'due_date_extended', 'cancelled', 'closed')`
    `(event_type IN ('issued', 'returned', 'marked_lost') AND asset_movement_id IS NOT NULL) OR (event_type NOT IN ('issued', 'returned', 'marked_lost') AND asset_movement_id IS NULL)`
  }
}

Ref: assets.asset_categories.parent_category_id > assets.asset_categories.id [delete: set null]
Ref: assets.asset_categories.asset_type > assets.asset_types.code [delete: restrict]
Ref: assets.assets.category_id > assets.asset_categories.id [delete: set null]
Ref: assets.assets.asset_type > assets.asset_types.code [delete: restrict]
Ref: assets.asset_maintenances.asset_id > assets.assets.id [delete: cascade]
Ref: assets.asset_depreciations.asset_id > assets.assets.id [delete: cascade]
Ref: assets.asset_disposals.asset_id > assets.assets.id [delete: restrict]
Ref: assets.asset_documents.asset_id > assets.assets.id [delete: cascade]
Ref: assets.asset_condition_checks.asset_id > assets.assets.id [delete: cascade]
Ref: assets.tool_set_items.tool_set_id > assets.tool_sets.id [delete: cascade]
Ref: assets.tool_set_items.asset_id > assets.assets.id [delete: restrict]
Ref: assets.asset_movements.asset_id > assets.assets.id [delete: cascade]
Ref: assets.borrowing_lines.borrowing_id > assets.borrowings.id [delete: cascade]
Ref: assets.borrowing_lines.asset_id > assets.assets.id [delete: restrict]
Ref: assets.borrowing_events.borrowing_id > assets.borrowings.id [delete: cascade]
Ref: assets.borrowing_events.borrowing_line_id > assets.borrowing_lines.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: After-Sales  (schema: aftersales)
// Warranty, service tickets and work orders, maintenance plans and visits,
// satisfaction surveys, spare parts, service contracts and SLA policies.
// Tenant scoped, except warranty_certificates (step 6b) and service_tickets
// (step 6c), which are company-wide (ADR-0011).
// ---------------------------------------------------------------------------

Table aftersales.warranty_policies {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  duration_months integer [not null, default: 12]
  coverage_type text [not null, default: 'warranty']
  terms text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Warranty rule of an item or of a product family."
  Indexes {
    (organization_id, code) [unique, name: 'warranty_policies_org_code_uq']
    item_id [name: 'warranty_policies_item_id_idx']
  }
  Checks {
    `coverage_type IN ('warranty', 'extended_warranty', 'service_plan', 'none')`
    `duration_months >= 0`
  }
}

Table aftersales.warranty_certificates {
  id uuid [pk, default: `uuidv7()`]
  code varchar(80) [not null, note: "Number from the numbering service (SG-GARANSI, with the customer code). Unique among live rows (partial index in the Drizzle schema)."]
  project_id uuid [not null, note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted. Validated through the Projects module contract. One live certificate per project."]
  bast_id uuid [not null, note: "Logical reference to projects.project_handover.id. Cross-module FK intentionally omitted. Validated through the Projects module contract. The warranty starts at its BAST date."]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  issue_date date [not null]
  start_date date [not null, note: "The BAST date."]
  months integer [not null, default: 12]
  end_date date [not null, note: "The day before the same date `months` later (clamped to the month end); the last covered day."]
  product_summary varchar(300) [not null]
  project_name varchar(300) [not null]
  project_location varchar(200)
  project_owner varchar(200) [not null]
  items jsonb [not null, note: "Covered devices: description, volume, remarks."]
  coverage text [not null, note: "Snapshot; one item per line, 'o ' / '- ' lines are sub-items, **…** prints bold."]
  exclusions text [not null]
  service_terms text [not null]
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Warranty certificate (Surat Keterangan Garansi) of a project, company-wide (ADR-0011 step 6b). Service tickets check serials against it."
  Indexes {
    project_id [name: 'warranty_certificates_project_id_idx']
    customer_id [name: 'warranty_certificates_customer_id_idx']
  }
  Checks {
    `months BETWEEN 1 AND 120`
    `end_date >= start_date`
  }
}

Table aftersales.warranty_claims {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  serial_number text
  invoice_id uuid [note: "Logical reference to sales.invoices.id. Cross-module FK intentionally omitted. Validated through the Sales module contract."]
  sales_order_id uuid [note: "Logical reference to sales.sales_orders.id. Cross-module FK intentionally omitted. Validated through the Sales module contract."]
  claim_type text [not null, default: 'defect']
  fault_description text
  incident_date date
  status text [not null, default: 'draft']
  claimed_amount bigint [not null, default: 0]
  approved_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  rejected_reason text
  closed_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Warranty claim of a customer. Approval decides whether the claim is covered."
  Indexes {
    (organization_id, code) [unique, name: 'warranty_claims_org_code_uq']
    customer_id [name: 'warranty_claims_customer_id_idx']
    status [name: 'warranty_claims_status_idx']
    invoice_id [name: 'warranty_claims_invoice_id_idx']
  }
  Checks {
    `claim_type IN ('defect', 'damage', 'missing_part', 'installation', 'other')`
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'in_service', 'closed', 'cancelled')`
    `claimed_amount >= 0`
    `approved_amount >= 0`
  }
}

Table aftersales.service_tickets {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Number from the numbering service (TKT). Unique among live rows (partial index in the Drizzle schema)."]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  customer_name text [not null, note: "Snapshot of the customer name."]
  project_id uuid [note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted. Validated through the Projects module contract; must belong to the customer."]
  serial_number varchar(100)
  device_description varchar(300)
  channel text [not null, default: 'phone']
  reporter_name varchar(200) [not null]
  reporter_contact varchar(200)
  complaint text [not null]
  reported_at bigint [not null]
  in_warranty boolean [not null, default: false, note: "Warranty check at the report time (serial → shipped delivery note → project → warranty certificate)."]
  warranty_ends_on date
  warranty_code varchar(80)
  status text [not null, default: 'new']
  assignee_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Must hold service_ticket:update."]
  resolution text
  service_cost bigint [not null, default: 0, note: "IDR minor units."]
  resolved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  resolved_at bigint
  confirmed_by_name varchar(200) [note: "The customer who confirmed the fix (required to close)."]
  confirmation_channel text
  confirmed_at bigint
  closed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  closed_at bigint
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Service ticket (tiket servis), company-wide (ADR-0011 step 6c). Stores the warranty check made when it is reported; closed only with the customer's confirmation."
  Indexes {
    customer_id [name: 'service_tickets_customer_id_idx']
    project_id [name: 'service_tickets_project_id_idx']
    assignee_user_id [name: 'service_tickets_assignee_user_id_idx']
    status [name: 'service_tickets_status_idx']
    serial_number [name: 'service_tickets_serial_number_idx']
  }
  Checks {
    `status IN ('new', 'in_progress', 'resolved', 'closed')`
    `channel IN ('phone', 'whatsapp', 'email', 'web', 'onsite', 'other')`
    `confirmation_channel IS NULL OR confirmation_channel IN ('phone', 'whatsapp', 'email', 'web', 'onsite', 'other')`
    `service_cost >= 0`
  }
}

Table aftersales.service_ticket_comments {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  service_ticket_id uuid [not null]
  body text [not null]
  visibility text [not null, default: 'internal']
  author_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  Note: "Comment on a service ticket. Only customer visible comments reach the portal."
  Indexes {
    service_ticket_id [name: 'service_ticket_comments_ticket_id_idx']
  }
  Checks {
    `visibility IN ('internal', 'customer')`
  }
}

Table aftersales.service_work_orders {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  service_ticket_id uuid [not null]
  assigned_to_employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  scheduled_start bigint
  scheduled_end bigint
  started_at bigint
  completed_at bigint
  status text [not null, default: 'draft']
  labor_cost bigint [not null, default: 0]
  parts_cost bigint [not null, default: 0]
  total_cost bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Work order that carries out a service ticket."
  Indexes {
    (organization_id, code) [unique, name: 'service_work_orders_org_code_uq']
    service_ticket_id [name: 'service_work_orders_ticket_id_idx']
    status [name: 'service_work_orders_status_idx']
  }
  Checks {
    `status IN ('draft', 'scheduled', 'in_progress', 'completed', 'cancelled')`
    `labor_cost >= 0`
    `parts_cost >= 0`
    `total_cost >= 0`
  }
}

Table aftersales.service_parts_usage {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  service_work_order_id uuid [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  quantity numeric(18,3) [not null, default: 0]
  unit_cost bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  created_at bigint [not null]
  Note: "Spare part consumed by a work order."
  Indexes {
    service_work_order_id [name: 'service_parts_usage_work_order_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_cost >= 0`
    `line_total >= 0`
  }
}

Table aftersales.service_technicians {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  service_ticket_id uuid [not null]
  employee_id uuid [not null, note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  role text
  assigned_at bigint [not null]
  released_at bigint
  rate_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  Note: "Technician assigned to a service ticket."
  Indexes {
    service_ticket_id [name: 'service_technicians_ticket_id_idx']
    employee_id [name: 'service_technicians_employee_id_idx']
  }
  Checks {
    `rate_amount >= 0`
    `released_at IS NULL OR released_at >= assigned_at`
  }
}

Table aftersales.sla_policies {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  priority text [not null]
  response_hours integer [not null]
  resolution_hours integer [not null]
  escalation_hours integer
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Service level agreement per priority."
  Indexes {
    (organization_id, code) [unique, name: 'sla_policies_org_code_uq']
    (organization_id, priority) [unique, name: 'sla_policies_priority_uq']
  }
  Checks {
    `priority IN ('low', 'normal', 'high', 'urgent')`
    `response_hours > 0`
    `resolution_hours > 0`
  }
}

Table aftersales.maintenance_schedules {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  service_type text [not null, default: 'maintenance']
  interval_days integer
  default_duration_hours numeric(8,2)
  default_assignee_employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  checklist_items text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Reusable maintenance schedule template."
  Indexes {
    (organization_id, code) [unique, name: 'maintenance_schedules_org_code_uq']
  }
  Checks {
    `service_type IN ('maintenance', 'inspection', 'calibration', 'installation')`
    `interval_days IS NULL OR interval_days > 0`
  }
}

Table aftersales.maintenance_plans {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  maintenance_schedule_id uuid
  asset_id uuid [note: "Logical reference to assets.assets.id. Cross-module FK intentionally omitted. Validated through the Assets module contract."]
  start_date date
  end_date date
  next_visit_date date
  frequency_type text [not null, default: 'monthly']
  status text [not null, default: 'active']
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Maintenance plan of a customer, it produces the visits."
  Indexes {
    (organization_id, code) [unique, name: 'maintenance_plans_org_code_uq']
    customer_id [name: 'maintenance_plans_customer_id_idx']
    status [name: 'maintenance_plans_status_idx']
    next_visit_date [name: 'maintenance_plans_next_visit_date_idx']
  }
  Checks {
    `frequency_type IN ('weekly', 'monthly', 'quarterly', 'semi_annual', 'annual')`
    `status IN ('active', 'paused', 'completed', 'cancelled')`
    `end_date IS NULL OR start_date IS NULL OR end_date >= start_date`
  }
}

Table aftersales.maintenance_visits {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  maintenance_plan_id uuid [not null]
  technician_employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  visit_date date [not null]
  work_done text
  status text [not null, default: 'planned']
  next_visit_date date
  signature_name text
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Realised visit of a maintenance plan."
  Indexes {
    (organization_id, code) [unique, name: 'maintenance_visits_org_code_uq']
    maintenance_plan_id [name: 'maintenance_visits_plan_id_idx']
    visit_date [name: 'maintenance_visits_visit_date_idx']
  }
  Checks {
    `status IN ('planned', 'in_progress', 'completed', 'skipped')`
  }
}

Table aftersales.maintenance_visit_tasks {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  maintenance_visit_id uuid [not null]
  task_name text [not null]
  is_completed boolean [not null, default: false]
  notes text
  created_at bigint [not null]
  Note: "Checklist line of a maintenance visit."
  Indexes {
    maintenance_visit_id [name: 'maintenance_visit_tasks_visit_id_idx']
  }
}

Table aftersales.satisfaction_surveys {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  service_ticket_id uuid [not null]
  customer_id uuid [note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  rating smallint
  nps_score smallint
  comment text
  responded_at bigint
  response_action text
  created_at bigint [not null]
  Note: "Customer satisfaction survey of a closed ticket."
  Indexes {
    service_ticket_id [unique, name: 'satisfaction_surveys_ticket_id_uq']
    customer_id [name: 'satisfaction_surveys_customer_id_idx']
  }
  Checks {
    `rating IS NULL OR rating BETWEEN 1 AND 5`
    `nps_score IS NULL OR nps_score BETWEEN -100 AND 100`
  }
}

Table aftersales.spare_parts {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  warehouse_id uuid [note: "Logical reference to inventory.warehouses.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  quantity_on_hand numeric(18,3) [not null, default: 0]
  min_quantity numeric(18,3) [not null, default: 0]
  unit_cost bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "After sales view of a spare part. The stock truth is the Inventory module, this is the reference list of service parts."
  Indexes {
    (organization_id, code) [unique, name: 'spare_parts_org_code_uq']
    item_id [name: 'spare_parts_item_id_idx']
  }
  Checks {
    `quantity_on_hand >= 0`
    `min_quantity >= 0`
    `unit_cost >= 0`
  }
}

Table aftersales.service_contracts {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  service_type text [not null, default: 'maintenance']
  start_date date
  end_date date
  service_level text
  contract_value bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  auto_renew boolean [not null, default: false]
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Recurring service contract with a customer."
  Indexes {
    (organization_id, code) [unique, name: 'service_contracts_org_code_uq']
    customer_id [name: 'service_contracts_customer_id_idx']
    status [name: 'service_contracts_status_idx']
  }
  Checks {
    `service_type IN ('maintenance', 'inspection', 'support', 'combined')`
    `status IN ('draft', 'active', 'expired', 'terminated', 'renewed')`
    `contract_value >= 0`
    `end_date IS NULL OR start_date IS NULL OR end_date >= start_date`
  }
}


// ---------------------------------------------------------------------------
// MODULE: Document  (schema: document)
// Document registry, templates, files, signatures, access log, shares, tags.
// Registry + issuance (ERP-0042): business documents stay in their owning
// module's tables; this module owns the issued copy of the document, its
// files and signatures. The file bytes live in object storage, this module
// owns the metadata and the access rules. organization_id is nullable:
// NULL means company-wide (ADR-0011 pattern of inventory and assets).
// ---------------------------------------------------------------------------

Table document.templates {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide template. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  document_type text [not null]
  module text
  version integer [not null, default: 1]
  content_template text
  numbering_pattern text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Reusable document template. A new version is a new row, an issued document keeps pointing at the version it used. The numbering_pattern here is display-only; the numbering authority is code_number.series."
  Indexes {
    (organization_id, code, version) [unique, name: 'templates_code_version_uq']
  }
  Checks {
    `version > 0`
  }
}

Table document.documents {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide document. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  document_type text [not null]
  title text [not null]
  template_id uuid
  module text
  source_type text
  source_id text
  status text [not null, default: 'draft']
  issued_on date
  issued_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  version integer [not null, default: 1]
  is_current boolean [not null, default: true]
  supersedes_document_id uuid
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Document master (registry + issuance). A document is never hard deleted, a new version supersedes the old one. The unique index on (organization_id, code) is a partial index in the Drizzle schema so a company-wide (NULL organization) row and tenant rows never collide."
  Indexes {
    (organization_id, code) [unique, name: 'documents_org_code_uq']
    template_id [name: 'documents_template_id_idx']
    (module, source_type, source_id) [name: 'documents_source_idx']
    status [name: 'documents_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'issued', 'void', 'expired', 'archived')`
    `version > 0`
  }
}

Table document.files {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  document_id uuid [not null]
  file_name text [not null]
  storage_key text [not null]
  mime_type text
  size_bytes bigint [not null, default: 0]
  checksum text
  uploaded_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  uploaded_at bigint [not null]
  Note: "Binary attachment of a document. The storage key never contains a public URL."
  Indexes {
    document_id [name: 'files_document_id_idx']
    storage_key [unique, name: 'files_storage_key_uq']
  }
  Checks {
    `size_bytes >= 0`
  }
}

Table document.signatures {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  document_id uuid [not null]
  signer_type text [not null]
  signer_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  signer_name text [not null]
  signed_at bigint [not null]
  signature_method text [not null, default: 'electronic']
  ip_address text
  certificate_serial text
  Note: "Signature evidence of a document."
  Indexes {
    document_id [name: 'signatures_document_id_idx']
  }
  Checks {
    `signer_type IN ('internal', 'customer', 'partner')`
    `signature_method IN ('electronic', 'wet_ink', 'stamp')`
  }
}

Table document.access_logs {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  document_id uuid [not null]
  accessed_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  action text [not null]
  accessed_at bigint [not null]
  ip_address text
  user_agent text
  Note: "Access trail of a document. Audit reads are never cached and never skipped."
  Indexes {
    document_id [name: 'access_logs_document_id_idx']
    accessed_at [name: 'access_logs_accessed_at_idx']
  }
  Checks {
    `action IN ('view', 'download', 'print', 'share', 'delete')`
  }
}

Table document.shares {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  document_id uuid [not null]
  share_type text [not null]
  token uuid [note: "Opaque public-link token, never the row id. Unique across every tenant because the public route resolves it without a session."]
  shared_with_type text
  shared_with_id text
  shared_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  shared_at bigint [not null]
  expires_at bigint
  is_revoked boolean [not null, default: false]
  Note: "External sharing of a document, for example a portal share with a customer."
  Indexes {
    document_id [name: 'shares_document_id_idx']
    (share_type, shared_with_type, shared_with_id) [name: 'shares_target_idx']
    token [unique, name: 'shares_token_uq']
    (token, expires_at) [name: 'shares_token_live_idx']
  }
  Checks {
    `share_type IN ('internal', 'customer', 'portal', 'public_link')`
  }
}

Table document.tags {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide tag. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  tag text [not null]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Free form tag applied to documents."
  Indexes {
    (organization_id, tag) [unique, name: 'tags_org_tag_uq']
  }
}

Table document.tag_links {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id; NULL = company-wide. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  document_id uuid [not null]
  document_tag_id uuid [not null]
  created_at bigint [not null]
  Note: "Link between a document and a tag."
  Indexes {
    (document_id, document_tag_id) [unique, name: 'tag_links_uq']
    document_tag_id [name: 'tag_links_tag_id_idx']
  }
}

Ref: document.documents.template_id > document.templates.id [delete: set null]
Ref: document.documents.supersedes_document_id > document.documents.id [delete: set null]
Ref: document.files.document_id > document.documents.id [delete: cascade]
Ref: document.signatures.document_id > document.documents.id [delete: cascade]
Ref: document.access_logs.document_id > document.documents.id [delete: cascade]
Ref: document.shares.document_id > document.documents.id [delete: cascade]
Ref: document.tag_links.document_id > document.documents.id [delete: cascade]
Ref: document.tag_links.document_tag_id > document.tags.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Approval  (schema: approval)
// Approval policies with immutable versions, approval requests, stages,
// decisions, delegations and amount thresholds. Tenant scoped.
// The module owns the decision record, it never owns the business document.
// ---------------------------------------------------------------------------

Table approval.approval_policies {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  module text [not null]
  document_type text [not null]
  description text
  current_version integer [not null, default: 1]
  is_active boolean [not null, default: true]
  created_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Approval policy header. The rules live in approval_policy_versions and are never edited in place, a change creates a new version."
  Indexes {
    (organization_id, code) [unique, name: 'approval_policies_org_code_uq']
    (module, document_type) [name: 'approval_policies_scope_idx']
  }
  Checks {
    `current_version > 0`
  }
}

Table approval.approval_policy_versions {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approval_policy_id uuid [not null]
  version integer [not null]
  conditions text
  amount_limit_min bigint
  amount_limit_max bigint
  required_role text
  required_approver_count smallint [not null, default: 1]
  no_self_approval boolean [not null, default: true]
  stage_order smallint [not null, default: 1]
  effective_from date [not null]
  effective_to date
  change_reason text
  created_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  Note: "Immutable version of an approval policy. An approval request always points at the version that was in force."
  Indexes {
    (approval_policy_id, version) [unique, name: 'approval_policy_versions_policy_version_uq']
    effective_from [name: 'approval_policy_versions_effective_from_idx']
  }
  Checks {
    `version > 0`
    `required_approver_count > 0`
    `stage_order > 0`
    `amount_limit_min IS NULL OR amount_limit_min >= 0`
    `amount_limit_max IS NULL OR amount_limit_max >= 0`
    `effective_to IS NULL OR effective_to >= effective_from`
  }
}

Table approval.approval_requests {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  approval_policy_id uuid [not null]
  approval_policy_version_id uuid [not null]
  module text [not null]
  document_type text [not null]
  source_table text [not null]
  source_id text [not null]
  title text
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  source_version integer [not null, default: 1]
  status text [not null, default: 'pending']
  current_stage smallint [not null, default: 1]
  requested_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  requested_at bigint [not null]
  completed_at bigint
  invalidated_at bigint
  invalidation_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Approval request against a business document. source_version detects a change of the source document and invalidates the request."
  Indexes {
    (organization_id, code) [unique, name: 'approval_requests_org_code_uq']
    approval_policy_id [name: 'approval_requests_policy_id_idx']
    (source_table, source_id) [name: 'approval_requests_source_idx']
    status [name: 'approval_requests_status_idx']
  }
  Checks {
    `status IN ('pending', 'in_progress', 'approved', 'rejected', 'returned', 'cancelled', 'invalidated')`
    `amount >= 0`
    `current_stage >= 1`
    `source_version > 0`
  }
}

Table approval.approval_stages {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approval_request_id uuid [not null]
  stage_order smallint [not null]
  stage_name text [not null]
  required_role text
  required_approver_count smallint [not null, default: 1]
  min_amount bigint
  max_amount bigint
  status text [not null, default: 'waiting']
  started_at bigint
  completed_at bigint
  Note: "Ordered stage of an approval request. A stage opens only when the previous one is finished."
  Indexes {
    (approval_request_id, stage_order) [unique, name: 'approval_stages_request_order_uq']
  }
  Checks {
    `status IN ('waiting', 'active', 'approved', 'rejected', 'skipped')`
    `required_approver_count > 0`
    `stage_order > 0`
  }
}

Table approval.approval_decisions {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approval_request_id uuid [not null]
  approval_stage_id uuid [not null]
  stage_order smallint [not null]
  decision text [not null]
  approver_user_id text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  decided_at bigint [not null]
  comment text
  request_status_before text
  request_status_after text
  Note: "Append only decision log. A duplicate decision on the same stage is rejected by the service layer."
  Indexes {
    approval_request_id [name: 'approval_decisions_request_id_idx']
    approval_stage_id [name: 'approval_decisions_stage_id_idx']
    (approval_stage_id, approver_user_id) [name: 'approval_decisions_approver_uq']
  }
  Checks {
    `decision IN ('approve', 'reject', 'return', 'skip')`
  }
}

Table approval.approval_delegations {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approval_request_id uuid [not null]
  from_user_id text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  to_user_id text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  reason text
  starts_at bigint [not null]
  ends_at bigint
  is_active boolean [not null, default: true]
  created_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  Note: "Delegation of an approval right for one request. A delegate still cannot approve their own request."
  Indexes {
    approval_request_id [name: 'approval_delegations_request_id_idx']
    to_user_id [name: 'approval_delegations_to_user_id_idx']
  }
  Checks {
    `ends_at IS NULL OR ends_at > starts_at`
    `from_user_id <> to_user_id`
  }
}

Table approval.approval_thresholds {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  module text [not null]
  document_type text
  currency_code varchar(3) [not null, default: 'IDR']
  min_amount bigint
  max_amount bigint
  required_role text
  required_approver_count smallint [not null, default: 1]
  effective_from date [not null]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Amount band that decides which approver level applies to a document."
  Indexes {
    (organization_id, module, document_type, min_amount) [unique, name: 'approval_thresholds_band_uq']
  }
  Checks {
    `required_approver_count > 0`
    `min_amount IS NULL OR min_amount >= 0`
    `max_amount IS NULL OR max_amount >= 0`
  }
}

Ref: approval.approval_policy_versions.approval_policy_id > approval.approval_policies.id [delete: cascade]
Ref: approval.approval_requests.approval_policy_id > approval.approval_policies.id [delete: restrict]
Ref: approval.approval_requests.approval_policy_version_id > approval.approval_policy_versions.id [delete: restrict]
Ref: approval.approval_stages.approval_request_id > approval.approval_requests.id [delete: cascade]
Ref: approval.approval_decisions.approval_request_id > approval.approval_requests.id [delete: cascade]
Ref: approval.approval_decisions.approval_stage_id > approval.approval_stages.id [delete: cascade]
Ref: approval.approval_delegations.approval_request_id > approval.approval_requests.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Budgeting  (schema: budgeting)
// Budget periods, budgets and lines, revisions, executions, cash flow plans
// and lines. Tenant scoped.
// ---------------------------------------------------------------------------

Table budgeting.budget_periods {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  period_year integer [not null]
  period_month integer
  start_date date [not null]
  end_date date [not null]
  budget_type text [not null, default: 'operating']
  status text [not null, default: 'open']
  is_locked boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Budget period, monthly or annual."
  Indexes {
    (organization_id, code) [unique, name: 'budget_periods_org_code_uq']
    (organization_id, period_year, period_month) [unique, name: 'budget_periods_period_uq']
  }
  Checks {
    `period_month IS NULL OR period_month BETWEEN 1 AND 12`
    `budget_type IN ('operating', 'capital', 'project', 'annual')`
    `status IN ('open', 'submitted', 'approved', 'closed')`
    `end_date >= start_date`
  }
}

Table budgeting.budgets {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  budget_period_id uuid [not null]
  name text [not null]
  department_id uuid [note: "Logical reference to organization.departments.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  branch_id uuid [note: "Logical reference to organization.branches.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  project_id uuid [note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted. Validated through the Projects module contract."]
  total_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  submitted_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Budget header of a period for a department, a branch or a project."
  Indexes {
    (organization_id, code) [unique, name: 'budgets_org_code_uq']
    budget_period_id [name: 'budgets_period_id_idx']
    status [name: 'budgets_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'revised', 'active', 'closed', 'cancelled')`
    `total_amount >= 0`
  }
}

Table budgeting.budget_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  budget_id uuid [not null]
  chart_of_account_id uuid [note: "Logical reference to accounting.chart_of_accounts.id. Cross-module FK intentionally omitted. Validated through the Accounting module contract."]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  category_code text
  description text
  planned_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a budget."
  Indexes {
    budget_id [name: 'budget_items_budget_id_idx']
  }
  Checks {
    `planned_amount >= 0`
  }
}

Table budgeting.budget_revisions {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  budget_id uuid [not null]
  revision_number smallint [not null]
  previous_total bigint [not null, default: 0]
  new_total bigint [not null, default: 0]
  reason text
  status text [not null, default: 'draft']
  requested_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Revision of an approved budget. The previous lines stay readable, the revision writes the delta."
  Indexes {
    (organization_id, code) [unique, name: 'budget_revisions_org_code_uq']
    (budget_id, revision_number) [unique, name: 'budget_revisions_budget_number_uq']
    status [name: 'budget_revisions_status_idx']
  }
  Checks {
    `revision_number > 0`
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'applied')`
    `previous_total >= 0`
    `new_total >= 0`
  }
}

Table budgeting.budget_revision_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  budget_revision_id uuid [not null]
  budget_item_id uuid [not null]
  previous_amount bigint [not null, default: 0]
  new_amount bigint [not null, default: 0]
  note text
  created_at bigint [not null]
  Note: "Line of a budget revision."
  Indexes {
    budget_revision_id [name: 'budget_revision_items_revision_id_idx']
    budget_item_id [name: 'budget_revision_items_item_id_idx']
    (budget_revision_id, budget_item_id) [unique, name: 'budget_revision_items_uq']
  }
  Checks {
    `previous_amount >= 0`
    `new_amount >= 0`
  }
}

Table budgeting.budget_executions {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  budget_id uuid [not null]
  budget_item_id uuid
  transaction_date date [not null]
  actual_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  source_type text
  source_id text
  note text
  created_at bigint [not null]
  Note: "Actual spending recorded against a budget line."
  Indexes {
    budget_id [name: 'budget_executions_budget_id_idx']
    budget_item_id [name: 'budget_executions_item_id_idx']
    transaction_date [name: 'budget_executions_date_idx']
  }
  Checks {
    `actual_amount >= 0`
  }
}

Table budgeting.cash_flow_plans {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  plan_year integer [not null]
  plan_month integer
  opening_balance bigint [not null, default: 0]
  inflow_total bigint [not null, default: 0]
  outflow_total bigint [not null, default: 0]
  closing_balance bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Cash flow plan of a month or of a year."
  Indexes {
    (organization_id, code) [unique, name: 'cash_flow_plans_org_code_uq']
    (organization_id, plan_year, plan_month) [unique, name: 'cash_flow_plans_period_uq']
  }
  Checks {
    `plan_month IS NULL OR plan_month BETWEEN 1 AND 12`
    `status IN ('draft', 'submitted', 'approved', 'active', 'closed')`
    `closing_balance = opening_balance + inflow_total - outflow_total`
  }
}

Table budgeting.cash_flow_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cash_flow_plan_id uuid [not null]
  direction text [not null]
  category_code text
  description text
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  expected_date date
  source_type text
  source_id text
  created_at bigint [not null]
  Note: "Line of a cash flow plan."
  Indexes {
    cash_flow_plan_id [name: 'cash_flow_items_plan_id_idx']
  }
  Checks {
    `direction IN ('in', 'out')`
    `amount >= 0`
  }
}

Ref: budgeting.budgets.budget_period_id > budgeting.budget_periods.id [delete: restrict]
Ref: budgeting.budget_items.budget_id > budgeting.budgets.id [delete: cascade]
Ref: budgeting.budget_revisions.budget_id > budgeting.budgets.id [delete: cascade]
Ref: budgeting.budget_revision_items.budget_revision_id > budgeting.budget_revisions.id [delete: cascade]
Ref: budgeting.budget_revision_items.budget_item_id > budgeting.budget_items.id [delete: cascade]
Ref: budgeting.budget_executions.budget_id > budgeting.budgets.id [delete: cascade]
Ref: budgeting.budget_executions.budget_item_id > budgeting.budget_items.id [delete: set null]
Ref: budgeting.cash_flow_items.cash_flow_plan_id > budgeting.cash_flow_plans.id [delete: cascade]


// ---------------------------------------------------------------------------
// MODULE: Investor  (schema: investor)
// Investor master, capital commitments and deposits, fund allocations, profit
// sharing scheme and runs, investor reports and meetings. Tenant scoped.
// ---------------------------------------------------------------------------

Table investor.investors {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  legal_name text
  investor_type text [not null, default: 'individual']
  tax_id text
  email text
  phone text
  whatsapp text
  address_line text
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  district_id uuid [note: "Logical reference to location.districts.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  regency_id uuid [note: "Logical reference to location.regencies.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  province_id uuid [note: "Logical reference to location.provinces.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  postal_code varchar(10)
  bank_name text
  bank_account_number text
  bank_account_holder text
  portal_identity_id uuid [note: "Logical reference to auth.portal_identities.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  status text [not null, default: 'active']
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Investor master, the investor back office. Bank details are restricted."
  Indexes {
    (organization_id, code) [unique, name: 'investors_org_code_uq']
    status [name: 'investors_status_idx']
    tax_id [name: 'investors_tax_id_idx']
  }
  Checks {
    `investor_type IN ('individual', 'institution', 'fund')`
    `status IN ('active', 'inactive', 'exited')`
  }
}

Table investor.investor_addresses {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  investor_id uuid [not null]
  kind text [not null, default: 'residence']
  label text
  address_line text
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  district_id uuid [note: "Logical reference to location.districts.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  regency_id uuid [note: "Logical reference to location.regencies.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  province_id uuid [note: "Logical reference to location.provinces.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Address of an investor."
  Indexes {
    investor_id [name: 'investor_addresses_investor_id_idx']
  }
  Checks {
    `kind IN ('residence', 'office', 'billing', 'other')`
  }
}

Table investor.capital_commitments {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  investor_id uuid [not null]
  commitment_date date
  committed_amount bigint [not null, default: 0]
  received_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  term_months integer
  rate_percent numeric(9,4)
  status text [not null, default: 'draft']
  notes text
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Commitment of an investor, the basis of the capital deposits."
  Indexes {
    (organization_id, code) [unique, name: 'capital_commitments_org_code_uq']
    investor_id [name: 'capital_commitments_investor_id_idx']
    status [name: 'capital_commitments_status_idx']
  }
  Checks {
    `status IN ('draft', 'approved', 'active', 'settled', 'cancelled')`
    `committed_amount >= 0`
    `received_amount >= 0`
    `received_amount <= committed_amount`
    `term_months IS NULL OR term_months > 0`
    `rate_percent IS NULL OR rate_percent >= 0`
  }
}

Table investor.capital_deposits {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  capital_commitment_id uuid
  investor_id uuid [not null]
  deposit_date date
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  payment_method text [not null, default: 'bank_transfer']
  status text [not null, default: 'draft']
  verified_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  verified_at bigint
  posted_at bigint
  cash_bank_transaction_id uuid [note: "Logical reference to finance.cash_bank_transactions.id. Cross-module FK intentionally omitted. Validated through the Finance module contract."]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Money received from an investor. The bank movement is a Finance module transaction."
  Indexes {
    (organization_id, code) [unique, name: 'capital_deposits_org_code_uq']
    investor_id [name: 'capital_deposits_investor_id_idx']
    capital_commitment_id [name: 'capital_deposits_commitment_id_idx']
    status [name: 'capital_deposits_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'verified', 'posted', 'rejected', 'cancelled')`
    `amount > 0`
    `payment_method IN ('bank_transfer', 'cash', 'offset')`
  }
}

Table investor.fund_allocations {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  capital_deposit_id uuid
  investor_id uuid [not null]
  allocation_date date
  purpose text
  target_module text
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  submitted_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Allocation of deposited capital to a business purpose."
  Indexes {
    (organization_id, code) [unique, name: 'fund_allocations_org_code_uq']
    investor_id [name: 'fund_allocations_investor_id_idx']
    status [name: 'fund_allocations_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'disbursed')`
    `amount > 0`
  }
}

Table investor.profit_share_schemes {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  effective_from date [not null]
  effective_to date
  status text [not null, default: 'draft']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "The one agreed profit sharing scheme, versioned by effective date."
  Indexes {
    (organization_id, code) [unique, name: 'profit_share_schemes_org_code_uq']
    effective_from [name: 'profit_share_schemes_effective_from_idx']
  }
  Checks {
    `status IN ('draft', 'approved', 'active', 'expired', 'cancelled')`
    `effective_to IS NULL OR effective_to >= effective_from`
  }
}

Table investor.profit_share_scheme_entries {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  profit_share_scheme_id uuid [not null]
  investor_id uuid [not null]
  share_percent numeric(9,4) [not null]
  tier_order smallint [not null, default: 1]
  effective_from date
  created_at bigint [not null]
  Note: "Share of one investor inside a profit sharing scheme."
  Indexes {
    (profit_share_scheme_id, investor_id) [unique, name: 'profit_share_scheme_entries_uq']
    investor_id [name: 'profit_share_scheme_entries_investor_id_idx']
  }
  Checks {
    `share_percent >= 0`
    `share_percent <= 100`
    `tier_order > 0`
  }
}

Table investor.profit_distribution_runs {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  period_year integer [not null]
  period_month integer
  distribution_date date
  total_profit bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  calculated_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  calculated_at bigint
  submitted_at bigint
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Profit distribution run of a period. The per investor shares live in investor.profit_shares."
  Indexes {
    (organization_id, code) [unique, name: 'profit_distribution_runs_org_code_uq']
    (organization_id, period_year, period_month) [unique, name: 'profit_distribution_runs_period_uq']
  }
  Checks {
    `period_month IS NULL OR period_month BETWEEN 1 AND 12`
    `status IN ('draft', 'calculated', 'submitted', 'approved', 'paid', 'cancelled')`
    `total_profit >= 0`
  }
}

Table investor.profit_shares {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  profit_distribution_run_id uuid [not null]
  investor_id uuid [not null]
  share_percent numeric(9,4) [not null, default: 0]
  gross_amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  net_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  paid_at bigint
  payment_id uuid [note: "Logical reference to finance.payments.id. Cross-module FK intentionally omitted. Validated through the Finance module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Share of one investor inside a profit distribution run. The payment is a Finance module row."
  Indexes {
    (profit_distribution_run_id, investor_id) [unique, name: 'profit_shares_run_investor_uq']
    investor_id [name: 'profit_shares_investor_id_idx']
  }
  Checks {
    `share_percent >= 0`
    `share_percent <= 100`
    `gross_amount >= 0`
    `tax_amount >= 0`
    `net_amount >= 0`
    `net_amount = gross_amount - tax_amount`
  }
}

Table investor.investor_reports {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  title text [not null]
  report_type text [not null, default: 'periodic']
  period_year integer
  period_month integer
  generated_on date
  content_summary text
  status text [not null, default: 'draft']
  published_at bigint
  published_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Investor report, the artefact shared with the investor portal."
  Indexes {
    (organization_id, code) [unique, name: 'investor_reports_org_code_uq']
    status [name: 'investor_reports_status_idx']
  }
  Checks {
    `report_type IN ('periodic', 'capital', 'profit_distribution', 'annual')`
    `status IN ('draft', 'published', 'archived')`
  }
}

Table investor.investor_meetings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  meeting_date date [not null]
  title text [not null]
  location text
  agenda text
  attendees text
  minutes text
  status text [not null, default: 'scheduled']
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Investor meeting record with its minutes."
  Indexes {
    (organization_id, code) [unique, name: 'investor_meetings_org_code_uq']
    meeting_date [name: 'investor_meetings_date_idx']
  }
  Checks {
    `status IN ('scheduled', 'held', 'postponed', 'cancelled')`
  }
}

Ref: investor.investor_addresses.investor_id > investor.investors.id [delete: cascade]
Ref: investor.capital_commitments.investor_id > investor.investors.id [delete: restrict]
Ref: investor.capital_deposits.investor_id > investor.investors.id [delete: restrict]
Ref: investor.capital_deposits.capital_commitment_id > investor.capital_commitments.id [delete: set null]
Ref: investor.fund_allocations.investor_id > investor.investors.id [delete: restrict]
Ref: investor.fund_allocations.capital_deposit_id > investor.capital_deposits.id [delete: set null]
Ref: investor.profit_share_scheme_entries.profit_share_scheme_id > investor.profit_share_schemes.id [delete: cascade]
Ref: investor.profit_share_scheme_entries.investor_id > investor.investors.id [delete: restrict]
Ref: investor.profit_shares.profit_distribution_run_id > investor.profit_distribution_runs.id [delete: cascade]
Ref: investor.profit_shares.investor_id > investor.investors.id [delete: restrict]

// ---------------------------------------------------------------------------
// MODULE: Commerce  (schema: commerce)
// Public website content, menus, catalog publications, promotions and the
// web shop orders. Tenant scoped.
// ---------------------------------------------------------------------------

Table commerce.web_pages {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  slug varchar(128) [not null]
  title text [not null]
  page_type text [not null, default: 'content']
  body text
  status text [not null, default: 'draft']
  published_at bigint
  seo_title text
  seo_description text
  version integer [not null, default: 1]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Public website page."
  Indexes {
    (organization_id, slug) [unique, name: 'web_pages_org_slug_uq']
    status [name: 'web_pages_status_idx']
  }
  Checks {
    `page_type IN ('content', 'landing', 'about', 'contact', 'legal', 'faq')`
    `status IN ('draft', 'published', 'archived')`
    `version > 0`
  }
}

Table commerce.web_menus {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  parent_menu_id uuid
  position integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Navigation menu of the public website."
  Indexes {
    (organization_id, code) [unique, name: 'web_menus_org_code_uq']
    parent_menu_id [name: 'web_menus_parent_menu_id_idx']
  }
}

Table commerce.web_menu_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  web_menu_id uuid [not null]
  label text [not null]
  url text
  web_page_id uuid
  position integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Entry of a navigation menu."
  Indexes {
    web_menu_id [name: 'web_menu_items_menu_id_idx']
    web_page_id [name: 'web_menu_items_page_id_idx']
  }
}

Table commerce.catalog_publications {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  status text [not null, default: 'draft']
  item_count integer [not null, default: 0]
  published_at bigint
  published_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Published catalog of the public website."
  Indexes {
    (organization_id, code) [unique, name: 'catalog_publications_org_code_uq']
    status [name: 'catalog_publications_status_idx']
  }
  Checks {
    `status IN ('draft', 'published', 'archived')`
    `item_count >= 0`
  }
}

Table commerce.catalog_publication_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  catalog_publication_id uuid [not null]
  item_id uuid [not null, note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  display_order integer [not null, default: 0]
  override_price bigint
  currency_code varchar(3) [not null, default: 'IDR']
  is_featured boolean [not null, default: false]
  created_at bigint [not null]
  Note: "Item inside a published catalog."
  Indexes {
    (catalog_publication_id, item_id) [unique, name: 'catalog_publication_items_uq']
  }
  Checks {
    `override_price IS NULL OR override_price >= 0`
  }
}

Table commerce.promotions {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  promotion_type text [not null, default: 'percentage']
  start_at bigint
  end_at bigint
  discount_value numeric(18,4) [not null, default: 0]
  min_purchase_amount bigint [not null, default: 0]
  usage_limit integer
  used_count integer [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  created_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Promotion of the public shop."
  Indexes {
    (organization_id, code) [unique, name: 'promotions_org_code_uq']
    status [name: 'promotions_status_idx']
  }
  Checks {
    `promotion_type IN ('percentage', 'fixed', 'free_shipping', 'bundle')`
    `status IN ('draft', 'scheduled', 'active', 'expired', 'cancelled')`
    `discount_value >= 0`
    `min_purchase_amount >= 0`
    `usage_limit IS NULL OR usage_limit > 0`
    `used_count >= 0`
    `end_at IS NULL OR start_at IS NULL OR end_at > start_at`
  }
}

Table commerce.promotion_rules {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  promotion_id uuid [not null]
  rule_type text [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  item_category_id uuid [note: "Logical reference to catalog.item_categories.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  min_quantity numeric(18,3)
  discount_amount bigint [not null, default: 0]
  discount_percent numeric(9,4)
  currency_code varchar(3) [not null, default: 'IDR']
  created_at bigint [not null]
  Note: "Condition of a promotion, for example a minimum quantity of an item."
  Indexes {
    promotion_id [name: 'promotion_rules_promotion_id_idx']
  }
  Checks {
    `rule_type IN ('item', 'category', 'minimum_quantity', 'minimum_amount')`
    `discount_amount >= 0`
    `discount_percent IS NULL OR (discount_percent >= 0 AND discount_percent <= 100)`
  }
}

Table commerce.commerce_orders {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  customer_id uuid [note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  customer_email text
  customer_name text
  status text [not null, default: 'pending']
  order_date date
  subtotal bigint [not null, default: 0]
  discount_total bigint [not null, default: 0]
  shipping_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  payment_method text
  payment_status text [not null, default: 'unpaid']
  shipping_address text
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Order placed on the public shop. It is not a sales order, the Sales module owns the confirmed order."
  Indexes {
    (organization_id, code) [unique, name: 'commerce_orders_org_code_uq']
    status [name: 'commerce_orders_status_idx']
    customer_email [name: 'commerce_orders_customer_email_idx']
  }
  Checks {
    `status IN ('pending', 'confirmed', 'processing', 'shipped', 'completed', 'cancelled')`
    `payment_status IN ('unpaid', 'pending', 'paid', 'refunded', 'failed')`
    `subtotal >= 0`
    `discount_total >= 0`
    `shipping_total >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
  }
}

Table commerce.commerce_order_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  commerce_order_id uuid [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  description text
  quantity numeric(18,3) [not null, default: 1]
  unit_price bigint [not null, default: 0]
  discount_amount bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  fulfillment_status text [not null, default: 'pending']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a public shop order."
  Indexes {
    commerce_order_id [name: 'commerce_order_items_order_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `discount_amount >= 0`
    `line_total >= 0`
    `fulfillment_status IN ('pending', 'allocated', 'shipped', 'cancelled')`
  }
}

Ref: commerce.web_menus.parent_menu_id > commerce.web_menus.id [delete: set null]
Ref: commerce.web_menu_items.web_menu_id > commerce.web_menus.id [delete: cascade]
Ref: commerce.web_menu_items.web_page_id > commerce.web_pages.id [delete: set null]
Ref: commerce.catalog_publication_items.catalog_publication_id > commerce.catalog_publications.id [delete: cascade]
