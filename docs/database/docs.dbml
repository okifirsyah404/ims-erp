// ---------------------------------------------------------------------------
// MODULE: Tax  (schema: tax, new; split out of accounting). Tax rates, the
// period recap, its signed corrections and withholding records.
// ---------------------------------------------------------------------------

Table tax.taxes {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  tax_type text [not null]
  rate numeric(9,4) [not null, default: 0]
  base_type text [not null, default: 'gross']
  is_inclusive boolean [not null, default: false]
  effective_from date [not null]
  effective_to date
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Effective dated tax rate, PPN or PPh (was accounting.tax_types). The rate is a decimal percentage, never a float amount. A rate change is a new row; ranges for the same code must not overlap (enforced in the service)."
  Indexes {
    (organization_id, code, effective_from) [unique, name: 'taxes_org_code_effective_uq', note: 'WHERE deleted_at IS NULL']
    effective_from [name: 'taxes_effective_from_idx']
  }
  Checks {
    `tax_type IN ('ppn', 'pph', 'ppn_input', 'ppn_output', 'other')`
    `base_type IN ('gross', 'net', 'specific')`
    `rate >= 0`
    `effective_to IS NULL OR effective_to >= effective_from`
  }
}

Table tax.records {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  tax_type_id uuid [not null]
  period_year integer [not null]
  period_month integer [not null]
  taxable_base bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  filing_status text [not null, default: 'draft']
  filed_on date
  verified_by text [note: "Logical reference to auth.users.id."]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Tax recap workpaper for a period (was accounting.tax_records). Filing itself stays outside the ERP. Corrections are separate rows in tax.corrections; tax_amount is never edited to reflect them."
  Indexes {
    (organization_id, code) [unique, name: 'tax_records_org_code_uq', note: 'WHERE deleted_at IS NULL']
    (organization_id, tax_type_id, period_year, period_month) [unique, name: 'tax_records_org_type_period_uq', note: 'WHERE deleted_at IS NULL']
    tax_type_id [name: 'tax_records_tax_type_id_idx']
    (organization_id, period_year, period_month) [name: 'tax_records_period_idx']
  }
  Checks {
    `period_month BETWEEN 1 AND 12`
    `taxable_base >= 0`
    `tax_amount >= 0`
    `filing_status IN ('draft', 'verified', 'filed', 'corrected')`
  }
}

Table tax.corrections {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  tax_record_id uuid [not null]
  amount bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  reason text [not null]
  evidence_document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Document module contract."]
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Signed correction against a tax recap (was accounting.tax_corrections). The original tax_amount is kept unchanged; net payable is the recap plus the sum of active corrections, computed at read time."
  Indexes {
    tax_record_id [name: 'tax_corrections_tax_record_id_idx']
    evidence_document_id [name: 'tax_corrections_evidence_document_id_idx']
  }
  Checks {
    `amount <> 0`
    `char_length(trim(reason)) > 0`
  }
}

Table tax.withholding_tax_records {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  tax_type_id uuid [not null]
  counterparty_type text
  counterparty_id text
  base_amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  transaction_date date
  period_year integer
  period_month integer
  status text [not null, default: 'recorded']
  tax_object_code varchar(20) [note: "Kode objek pajak (ERP-0140), needed by the Coretax bukti potong."]
  withholding_slip_number varchar(40) [note: "Bukti potong number once Coretax issued it (entered after upload)."]
  counterparty_tax_id varchar(32) [note: "NPWP/NIK of the party withheld from."]
  source_module text [note: "Module whose document produced the record (payment for a supplier payment withholding)."]
  source_id text
  coretax_status text [not null, default: 'not_exported']
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Withholding tax collected on a payment (was accounting.withholding_tax_records). Since ERP-0140 a supplier payment with PPh creates its row (source_module = payment)."
  Indexes {
    (organization_id, code) [unique, name: 'withholding_tax_records_org_code_uq']
    tax_type_id [name: 'withholding_tax_records_tax_type_id_idx']
    (counterparty_type, counterparty_id) [name: 'withholding_tax_records_counterparty_idx']
  }
  Checks {
    `base_amount >= 0`
    `tax_amount >= 0`
    `status IN ('recorded', 'verified', 'paid', 'reversed')`
    `coretax_status IN ('not_exported', 'exported', 'uploaded')`
  }
}

Table tax.pph21_ptkp {
  id uuid [pk, default: `uuidv7()`]
  status_code varchar(5) [not null, note: "PTKP status: TK/0..TK/3, K/0..K/3."]
  annual_amount bigint [not null, note: "Annual PTKP in IDR minor units."]
  ter_category varchar(1) [not null, note: "TER category of the status (PP 58/2023): A, B or C."]
  effective_from date [not null]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "PPh 21 non-taxable income per PTKP status and its TER category (ERP-0138). Global statutory reference data: no organization_id, like location.*. A change is a new row set with a later effective_from; the set in force on a date is the one with the latest effective_from on or before it."
  Indexes {
    (status_code, effective_from) [unique, name: 'pph21_ptkp_status_effective_uq', note: 'WHERE deleted_at IS NULL']
  }
  Checks {
    `status_code IN ('TK/0', 'TK/1', 'TK/2', 'TK/3', 'K/0', 'K/1', 'K/2', 'K/3')`
    `ter_category IN ('A', 'B', 'C')`
    `annual_amount >= 0`
  }
}

Table tax.pph21_ter_rates {
  id uuid [pk, default: `uuidv7()`]
  category varchar(1) [not null, note: "TER category: A, B or C."]
  lower_bound bigint [not null, note: "Monthly gross income in IDR minor units from which the rate applies (inclusive); the rate holds until the next row's lower_bound."]
  rate numeric(7,4) [not null, note: "Percentage, e.g. 0.2500 for 0.25%."]
  effective_from date [not null]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Monthly PPh 21 effective rates (TER, PP 58/2023) per category (ERP-0138). Global statutory reference data: no organization_id. Never seeded: finance imports the official table as CSV; an import replaces the rows of its effective_from."
  Indexes {
    (category, lower_bound, effective_from) [unique, name: 'pph21_ter_rates_category_bound_uq', note: 'WHERE deleted_at IS NULL']
  }
  Checks {
    `category IN ('A', 'B', 'C')`
    `lower_bound >= 0`
    `rate >= 0 AND rate <= 100`
  }
}

Table tax.pph21_brackets {
  id uuid [pk, default: `uuidv7()`]
  lower_bound bigint [not null, note: "Annual taxable income (PKP) in IDR minor units from which the rate applies (inclusive); the rate holds until the next row's lower_bound."]
  rate numeric(7,4) [not null, note: "Percentage."]
  effective_from date [not null]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Progressive Pasal 17 rates for the annual PPh 21 reconciliation (UU HPP, ERP-0138). Global statutory reference data: no organization_id."
  Indexes {
    (lower_bound, effective_from) [unique, name: 'pph21_brackets_bound_effective_uq', note: 'WHERE deleted_at IS NULL']
  }
  Checks {
    `lower_bound >= 0`
    `rate >= 0 AND rate <= 100`
  }
}

Table tax.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "tax_record, withholding_tax_record."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the tax module (ADR-0024 Q6)."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: tax.records.tax_type_id > tax.taxes.id [delete: restrict]
Ref: tax.corrections.tax_record_id > tax.records.id [delete: restrict]
Ref: tax.withholding_tax_records.tax_type_id > tax.taxes.id [delete: restrict]

// ---------------------------------------------------------------------------
// MODULE: Payment  (schema: payment). All money movement of the ERP: the single
// payment ledger with its allocations to any payable, plus the provider
// gateways. `payment.gateway_payments` merged into payment.payments (Q18);
// the direct sales_invoice_id / supplier_bill_id / employee_advance_id columns
// are removed because allocations carry every payable.
// ---------------------------------------------------------------------------

Table payment.payments {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  payment_type text [not null]
  direction text [not null]
  channel text [not null, default: 'manual', note: "manual = recorded by staff; gateway = an online checkout (was payment.gateway_payments)."]
  gateway_id uuid [note: "The provider configuration used for a gateway payment; null for a manual one."]
  provider text [note: "Payment gateway that holds the checkout: xendit, singapay or fake (only outside production)."]
  provider_reference varchar(100) [note: "The provider's id of the checkout. Unique per provider when set."]
  payment_url text [note: "Hosted checkout page the customer opens."]
  expires_at bigint [note: "When the provider closes the checkout."]
  paid_at bigint
  paid_amount bigint [note: "What the provider reports as paid, IDR minor units."]
  payment_channel text [note: "Provider channel, e.g. BCA, QRIS, OVO."]
  provider_transaction_id varchar(100)
  receipt_id uuid [note: "Logical reference to sale.receipts.id - the receipt (kwitansi) recorded for the payment. Cross-module FK intentionally omitted. One receipt per checkout."]
  settlement_note text [note: "Why a paid checkout was not applied to its payable."]
  last_event jsonb [note: "The last verified webhook body, kept for audit."]
  counterparty_type text
  counterparty_id text
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  payment_method text [not null, default: 'bank_transfer']
  payment_date date
  status text [not null, default: 'draft']
  requested_by text [note: "Logical reference to auth.users.id."]
  requested_at bigint
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  executed_by text [note: "Logical reference to auth.users.id."]
  executed_at bigint
  cash_bank_account_id uuid [note: "Logical reference to finance.cash_bank_accounts.id. Cross-module FK intentionally omitted. Validated through the Finance module contract."]
  reference_number text
  notes text
  voided_at bigint
  void_reason text
  withholding_tax_id uuid [note: "Logical reference to tax.taxes.id. Cross-module FK intentionally omitted. Validated through the Tax module contract. PPh withheld from a supplier payment (ERP-0140)."]
  withholding_amount bigint [not null, default: 0, note: "PPh withheld (IDR minor units): the bank pays amount - withholding_amount, the rest is owed to the state."]
  tax_object_code varchar(20) [note: "Kode objek pajak of the withholding, e.g. 24-104-14."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "THE single payment ledger of the ERP, receipts and disbursements both (merged with payment.gateway_payments per ADR-0024 Q18). A payment settles payables through payment.payment_allocations, so the direct invoice/bill/advance columns are gone. Execution requires approval and is not allowed by the requester. A paid webhook on an expired or failed gateway row still counts: money received is a fact; paid is applied once, and a replayed webhook finds receipt_id and does nothing."
  Indexes {
    (organization_id, code) [unique, name: 'payments_org_code_uq']
    status [name: 'payments_status_idx']
    (organization_id, counterparty_type, counterparty_id) [name: 'payments_counterparty_idx']
    cash_bank_account_id [name: 'payments_cash_bank_account_id_idx']
    (provider, provider_reference) [unique, name: 'payments_provider_reference_uq', note: "Partial: WHERE provider_reference IS NOT NULL."]
    receipt_id [unique, name: 'payments_receipt_id_uq', note: "Partial: WHERE receipt_id IS NOT NULL."]
  }
  Checks {
    `withholding_amount >= 0 AND withholding_amount < amount`
    `payment_type IN ('receipt', 'disbursement', 'refund', 'advance_disbursement', 'payroll', 'profit_distribution', 'investment')`
    `direction IN ('in', 'out')`
    `channel IN ('manual', 'gateway')`
    `provider IS NULL OR provider IN ('xendit', 'singapay', 'fake')`
    `status IN ('draft', 'submitted', 'approved', 'executed', 'pending', 'paid', 'expired', 'failed', 'reversed', 'void', 'cancelled')`
    `amount > 0`
    `paid_amount IS NULL OR paid_amount >= 0`
    `payment_method IN ('bank_transfer', 'cash', 'card', 'e_wallet', 'cheque', 'offset')`
  }
}

Table payment.payment_allocations {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  payment_id uuid [not null]
  payable_type text [not null, note: "sale_invoice, supplier_bill, employee_advance, expense_claim, expense_settlement, employee_salary_record (ADR-0024 Q18 polymorph rule)."]
  payable_id text [not null]
  amount bigint [not null]
  allocated_at bigint [not null]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Allocation of one payment to one payable document, for documents settled in several instalments (ADR-0024 Q18). One payment may settle several payables and one payable may receive several payments. payable_id is text because the targets mix id types; the owning service resolves it through a resolver map of exported services."
  Indexes {
    (payment_id, payable_type, payable_id) [unique, name: 'payment_allocations_uq']
    (payable_type, payable_id) [name: 'payment_allocations_payable_idx']
  }
  Checks {
    `payable_type IN ('sale_invoice', 'supplier_bill', 'employee_advance', 'expense_claim', 'expense_settlement', 'employee_salary_record')`
    `amount > 0`
  }
}

Table payment.gateways {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  provider text [not null]
  code varchar(32) [not null]
  name text [not null]
  mode text [not null, default: 'sandbox']
  config jsonb [note: "Non-secret provider configuration."]
  secret_ciphertext text [note: "AES-256-GCM ciphertext of the provider secret. The key lives in the PAYMENT_SECRET_KEY environment variable, never in the database."]
  secret_iv text
  secret_tag text
  secret_last4 varchar(4) [note: "Last four characters, so staff can recognise which secret is loaded."]
  key_version smallint [not null, default: 1]
  webhook_token_ciphertext text
  webhook_token_iv text
  webhook_token_tag text
  is_active boolean [not null, default: true]
  is_default boolean [not null, default: false]
  rotated_at bigint
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Provider configuration of a payment gateway (ADR-0024 Q18). Secrets are AES-256-GCM encrypted with a key from the environment; the API never returns ciphertext or plaintext (write-only)."
  Indexes {
    (organization_id, provider, code) [unique, name: 'gateways_org_provider_code_uq']
    provider [name: 'gateways_provider_idx']
  }
  Checks {
    `provider IN ('xendit', 'singapay', 'fake')`
    `mode IN ('sandbox', 'live')`
    `key_version > 0`
  }
}

Table payment.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  description text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Payment module configuration key value store (default gateway, rounding rules)."
  Indexes {
    (organization_id, setting_group, setting_key) [unique, name: 'payment_settings_scope_uq']
  }
}

Table payment.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "payment."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the payment module (ADR-0024 Q6)."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: payment.payment_allocations.payment_id > payment.payments.id [delete: cascade]
Ref: payment.payments.gateway_id > payment.gateways.id [delete: set null]

// ---------------------------------------------------------------------------
// MODULE: Project  (schema: project, was projects). Absorbs the leads from crm
// (Q12), the warranty certificates from aftersales (Q13) and the licensing
// tables (Q11). Company-wide (ADR-0011). Same-module references are real FKs.
// ---------------------------------------------------------------------------

Table project.projects {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Number from the numbering service (PRJ). Unique among live rows."]
  order_id uuid [note: "Logical reference to sale.orders.id. Cross-module FK intentionally omitted. Validated through the Sale module contract. One live (not cancelled) project per order (partial unique index)."]
  order_code varchar(32) [not null, note: "Snapshot of the order number."]
  quotation_code varchar(40) [note: "Snapshot of the SPH number."]
  customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  company_id uuid [note: "Logical reference to customer.companies.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  lead_id uuid [note: "Logical reference to project.leads.id, the lead that produced the deal."]
  customer_name text [not null, note: "Snapshot of the customer name."]
  title text [not null]
  site_name varchar(200)
  address_id uuid [note: "The site address; project.addresses."]
  contract_value bigint [not null, default: 0, note: "The order's grand total incl. VAT at creation (IDR minor units)."]
  pic_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Must hold project:update."]
  target_start_date date
  target_end_date date
  stage text [not null, default: 'preparation']
  status text [not null, default: 'active']
  notes text
  closed_by text [note: "Logical reference to auth.users.id."]
  closed_at bigint
  cancelled_by text [note: "Logical reference to auth.users.id."]
  cancelled_at bigint
  cancel_reason text
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Project executing a deal (sales order), company-wide. Closing needs function-test, training and signed-BAST evidence and moves the stage to warranty. type_id arrives together with project.types (ADR-0024 Q22)."
  Indexes {
    order_id [name: 'projects_order_id_idx']
    customer_id [name: 'projects_customer_id_idx']
    company_id [name: 'projects_company_id_idx']
    lead_id [name: 'projects_lead_id_idx']
    pic_user_id [name: 'projects_pic_user_id_idx']
    status [name: 'projects_status_idx']
  }
  Checks {
    `status IN ('active', 'closed', 'cancelled')`
    `stage IN ('preparation', 'delivery', 'installation', 'testing', 'training', 'handover', 'warranty')`
    `contract_value >= 0`
    `target_end_date IS NULL OR target_start_date IS NULL OR target_end_date >= target_start_date`
  }
}

Table project.tasks {
  id uuid [pk, default: `uuidv7()`]
  project_id uuid [not null, note: "Same-module reference to project.projects.id; no FK by design (module-ownership §9), validated by the Projects service."]
  position integer [not null, default: 0]
  title text [not null]
  stage text [not null]
  assignee_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Must hold task:update."]
  due_date date
  status text [not null, default: 'todo']
  done_by text [note: "Logical reference to auth.users.id."]
  done_at bigint
  created_by text [note: "Logical reference to auth.users.id."]
  deleted_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Checklist task of a project (was projects.project_tasks); a new project gets one task per stage up to handover."
  Indexes {
    (project_id, position) [name: 'tasks_project_position_idx']
    assignee_user_id [name: 'tasks_assignee_user_id_idx']
  }
  Checks {
    `status IN ('todo', 'in_progress', 'done')`
    `stage IN ('preparation', 'delivery', 'installation', 'testing', 'training', 'handover', 'warranty')`
  }
}

Table project.evidence {
  id uuid [pk, default: `uuidv7()`]
  project_id uuid [not null]
  task_id uuid [note: "Same-module reference to project.tasks.id; no FK by design."]
  kind text [not null]
  storage_key text [not null, note: "Object storage key; files are read through short-lived presigned URLs."]
  file_name varchar(200) [not null]
  content_type varchar(100) [not null, note: "Detected from the file content (JPG, PNG, WebP, PDF)."]
  size_bytes integer [not null]
  note varchar(500)
  uploaded_by text [note: "Logical reference to auth.users.id."]
  deleted_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Evidence file of a project (function test, training, signed BAST, photo). Was projects.project_evidence."
  Indexes {
    (project_id, kind) [name: 'evidence_project_kind_idx']
  }
  Checks {
    `kind IN ('testing', 'training', 'bast', 'photo', 'other')`
    `size_bytes > 0`
  }
}

Table project.costs {
  id uuid [pk, default: `uuidv7()`]
  project_id uuid [not null]
  category text [not null]
  cost_date date [not null]
  amount bigint [not null, note: "IDR minor units."]
  description varchar(300) [not null]
  receipt_storage_key text
  receipt_file_name varchar(200)
  receipt_content_type varchar(100)
  created_by text [note: "Logical reference to auth.users.id."]
  voided_by text [note: "Logical reference to auth.users.id."]
  voided_at bigint
  void_reason text
  payment_source text [not null, default: 'employee_claim', note: "Who paid (ERP-0141): employee_claim (owed to the employee, Cr claims payable), petty_cash or bank (Cr cash by method)."]
  reference varchar(100) [note: "Receipt or claim number; the UI warns on a duplicate within the project."]
  journal_entry_id uuid [note: "Logical reference to finance.journal_entries.id. Cross-module FK intentionally omitted. Validated through the Finance module contract. Dr project COGS / Cr the payment source, posted with the cost (ERP-0141)."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Direct cost of a project (was projects.project_costs); visible only with project:read_cost. Corrected by voiding, never deleted. Every cost posts to the general ledger and its void reverses the journal (ERP-0141)."
  Indexes {
    (project_id, cost_date) [name: 'costs_project_date_idx']
  }
  Checks {
    `category IN ('material', 'transport', 'accommodation', 'subcontract', 'other')`
    `amount > 0`
    `payment_source IN ('employee_claim', 'petty_cash', 'bank')`
  }
}

Table project.handover {
  id uuid [pk, default: `uuidv7()`]
  project_id uuid [not null, note: "Same-module reference to project.projects.id; no FK by design. Several BASTs per project (owner decision 2026-11-06)."]
  code varchar(32) [not null, note: "BAST number, assigned on creation by the BAST date. Unique among live rows."]
  bast_date date [not null, note: "Jakarta business date, printed in words."]
  first_party_company varchar(200) [not null, note: "PIHAK PERTAMA (the customer)."]
  first_party_name varchar(120) [not null]
  first_party_title varchar(120) [not null]
  second_party_company varchar(200) [not null, note: "PIHAK KEDUA (the company)."]
  second_party_name varchar(120) [not null]
  second_party_title varchar(120) [not null]
  contract_number varchar(120)
  work_title varchar(300) [not null]
  project_name varchar(200)
  items jsonb [not null, note: "Handed-over items: description, volume, remarks."]
  scope jsonb [not null, note: "Numbered list of the work handed over."]
  status text [not null, default: 'issued']
  created_by text [note: "Logical reference to auth.users.id."]
  cancelled_by text [note: "Logical reference to auth.users.id."]
  cancelled_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Project handover (Berita Acara Serah Terima, BAST), company-wide. Edited or cancelled only while the project is active. Was projects.project_handover."
  Indexes {
    project_id [name: 'handover_project_id_idx']
  }
  Checks {
    `status IN ('issued', 'cancelled')`
  }
}

Table project.addresses {
  id uuid [pk, default: `uuidv7()`]
  project_id uuid [not null]
  kind text [not null, default: 'site']
  label text
  address_line text [not null]
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated by ExportedLocationService.assertVillage on write; district, regency and province are derived through ExportedLocationService.resolveVillagePath (ADR-0024 Q10)."]
  postal_code varchar(10)
  latitude numeric(10,7)
  longitude numeric(10,7)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Project site address (ADR-0024 Q10: only village_id is stored)."
  Indexes {
    project_id [name: 'project_addresses_project_id_idx']
  }
  Checks {
    `kind IN ('site', 'billing', 'other')`
  }
}

Table project.leads {
  id uuid [pk, default: `uuidv7()`]
  name text [not null]
  company_name text
  company_id uuid [note: "Logical reference to customer.companies.id when the prospect is already a customer company. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  email text
  phone varchar(30)
  whatsapp varchar(30)
  source text [not null]
  status text [not null, default: 'new']
  needs text [note: "What the prospect asks for; website inquiries store a readable summary here."]
  estimated_value bigint [note: "Exact integer IDR minor units (ADR-0002)."]
  currency_code varchar(3) [not null, default: 'IDR']
  owner_user_id text [note: "Assigned salesperson. Logical reference to auth.users.id."]
  next_follow_up_at bigint
  customer_id uuid [note: "The customer the lead was converted into (status won). Logical reference to customer.customers.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  converted_at bigint
  lost_reason text
  channel text [note: "Website form that created the lead: rfq, contact or demo; null for manual leads."]
  reference varchar(40) [note: "Public reference handed back to the website visitor (document numbering web_*)."]
  submission jsonb [note: "The website payload as received, for audit."]
  idempotency_key varchar(100) [note: "Website Idempotency-Key; a replay returns the original reference."]
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Prospect before a customer record exists (was crm.leads; ADR-0024 Q12). A lead may belong to a company that is already a customer, so one customer can have many leads and many projects. Visibility: holders of lead:assign see all leads, others only leads assigned to them (service rule)."
  Indexes {
    owner_user_id [name: 'leads_owner_user_id_idx']
    company_id [name: 'leads_company_id_idx']
    status [name: 'leads_status_idx']
    next_follow_up_at [name: 'leads_next_follow_up_at_idx']
    reference [unique, name: 'leads_reference_uq', note: 'WHERE reference IS NOT NULL']
    idempotency_key [unique, name: 'leads_idempotency_key_uq', note: 'WHERE idempotency_key IS NOT NULL']
  }
  Checks {
    `source IN ('website', 'whatsapp', 'instagram', 'phone', 'referral', 'walk_in', 'other')`
    `status IN ('new', 'contacted', 'survey', 'quotation', 'won', 'lost')`
    `channel IS NULL OR channel IN ('rfq', 'contact', 'demo')`
  }
}

Table project.lead_activities {
  id uuid [pk, default: `uuidv7()`]
  lead_id uuid [not null]
  activity_type text [not null]
  notes text [not null]
  occurred_at bigint [not null]
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Follow-up log of a lead (was crm.lead_activities)."
  Indexes {
    (lead_id, occurred_at) [name: 'lead_activities_lead_id_idx']
  }
  Checks {
    `activity_type IN ('call', 'whatsapp', 'email', 'meeting', 'survey', 'note')`
  }
}

Table project.lead_attachments {
  id uuid [pk, default: `uuidv7()`]
  lead_id uuid [not null]
  file_name varchar(255) [not null]
  content_type varchar(120) [not null]
  size_bytes integer [not null]
  storage_key text [not null, note: "Object-storage key; never sent to clients (downloads use short-lived presigned URLs)."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "File sent with a website RFQ (PDF, DWG, JPG, PNG; up to 10 files of 25 MB). Was crm.lead_attachments."
  Indexes {
    lead_id [name: 'lead_attachments_lead_id_idx']
  }
}

Table project.warranties {
  id uuid [pk, default: `uuidv7()`]
  code varchar(80) [not null, note: "Number from the numbering service (SG-GARANSI, with the customer code). Unique among live rows."]
  project_id uuid [not null]
  handover_id uuid [not null, note: "The BAST whose date starts the warranty; now an intra-schema FK."]
  customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  company_id uuid [note: "Logical reference to customer.companies.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  issue_date date [not null]
  start_date date [not null, note: "The BAST date."]
  months integer [not null, default: 12]
  end_date date [not null, note: "The day before the same date months later (clamped to the month end); the last covered day."]
  product_summary varchar(300) [not null]
  project_name varchar(300) [not null]
  project_location varchar(200)
  project_owner varchar(200) [not null]
  items jsonb [not null, note: "Covered devices: description, volume, remarks."]
  coverage text [not null, note: "Snapshot; one item per line, 'o ' / '- ' lines are sub-items, **...** prints bold."]
  exclusions text [not null]
  service_terms text [not null]
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Warranty certificate (Surat Keterangan Garansi) of a project, company-wide. Was aftersales.warranty_certificates (ADR-0024 Q13). Service tickets check serials against it."
  Indexes {
    project_id [name: 'warranties_project_id_idx']
    customer_id [name: 'warranties_customer_id_idx']
    company_id [name: 'warranties_company_id_idx']
  }
  Checks {
    `months BETWEEN 1 AND 120`
    `end_date >= start_date`
  }
}

Table project.license_applications {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Unique among live rows."]
  name text [not null]
  vendor text
  source text [not null, default: 'third_party', note: "third_party: key typed in from the vendor; own: key generated by the ERP."]
  description text
  status text [not null, default: 'active']
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Software licensed to customers, company-wide. Was licensing.licensable_applications (ADR-0024 Q11)."
  Indexes {
    code [unique, name: 'license_applications_code_uq', note: 'WHERE deleted_at IS NULL']
  }
  Checks {
    `source IN ('third_party', 'own')`
    `status IN ('active', 'retired')`
  }
}

Table project.license_contracts {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Number from the numbering service (LIC). Unique among live rows."]
  customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  company_id uuid [note: "Logical reference to customer.companies.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  customer_name text [not null, note: "Snapshot of the customer name."]
  license_application_id uuid [not null]
  package_name varchar(200) [note: "Edition / plan as sold."]
  order_id uuid [note: "Logical reference to sale.orders.id. Cross-module FK intentionally omitted. Validated through the Sale module contract. Billing stays in the sales flow."]
  start_date date
  end_date date [note: "Null = perpetual. Expired and due are derived from it, never stored."]
  billing_cycle text [not null, default: 'annual']
  contract_value bigint [not null, default: 0, note: "IDR minor units."]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  renewed_from_contract_id uuid
  notes text
  created_by text [note: "Logical reference to auth.users.id."]
  activated_by text [note: "Logical reference to auth.users.id."]
  activated_at bigint
  terminated_by text [note: "Logical reference to auth.users.id."]
  terminated_at bigint
  termination_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Licensing contract with a customer, company-wide. Was licensing.license_contracts; sales_order_id renamed order_id. A renewal is a new draft contract; activating it marks the old one renewed. Grace period after end_date: 7 days, derived, never stored."
  Indexes {
    customer_id [name: 'license_contracts_customer_id_idx']
    license_application_id [name: 'license_contracts_application_id_idx']
    status [name: 'license_contracts_status_idx']
    end_date [name: 'license_contracts_end_date_idx']
  }
  Checks {
    `billing_cycle IN ('monthly', 'quarterly', 'semi_annual', 'annual', 'one_time')`
    `status IN ('draft', 'active', 'suspended', 'terminated', 'renewed')`
    `contract_value >= 0`
    `end_date IS NULL OR start_date IS NULL OR end_date >= start_date`
  }
}

Table project.license_keys {
  id uuid [pk, default: `uuidv7()`]
  license_contract_id uuid [not null]
  license_key text [not null, note: "Readable for callers with license:read_key; masked otherwise. Unique among live rows."]
  key_source text [not null, default: 'vendor']
  max_activations integer [not null, default: 1]
  expires_on date [note: "Defaults to the contract end."]
  status text [not null, default: 'active']
  notes text
  created_by text [note: "Logical reference to auth.users.id."]
  revoked_by text [note: "Logical reference to auth.users.id."]
  revoked_at bigint
  revoke_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "License key issued under a contract, company-wide. Was licensing.license_keys."
  Indexes {
    license_contract_id [name: 'license_keys_contract_id_idx']
    license_key [unique, name: 'license_keys_key_uq', note: 'WHERE deleted_at IS NULL']
  }
  Checks {
    `key_source IN ('vendor', 'generated')`
    `status IN ('active', 'revoked')`
    `max_activations > 0`
  }
}

Table project.license_activations {
  id uuid [pk, default: `uuidv7()`]
  license_key_id uuid [not null]
  instance_id varchar(200) [not null, note: "Installation / device id sent by the application."]
  device_name varchar(200)
  activated_at bigint [not null]
  last_seen_at bigint [not null]
  last_ip text
  status text [not null, default: 'active']
  deactivated_at bigint
  deactivated_by text [note: "Logical reference to auth.users.id. Null when the application released the seat."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "One seat of a license key taken by an installation, company-wide. Was licensing.license_activations. Active seats never exceed the key's max_activations."
  Indexes {
    license_key_id [name: 'license_activations_key_id_idx']
    (license_key_id, instance_id) [unique, name: 'license_activations_active_uq', note: "Live active rows only"]
  }
  Checks {
    `status IN ('active', 'deactivated')`
  }
}

Table project.license_events {
  id uuid [pk, default: `uuidv7()`]
  license_key_id uuid [note: "Null when the call named an unknown key."]
  license_contract_id uuid
  license_api_key_id uuid [note: "The application key that made the call; null for staff actions."]
  event_type text [not null]
  result text [not null, note: "ok, grace, or the rejection code (unknown, revoked, suspended, terminated, expired, not_started, seat_limit, not_activated)."]
  instance_id varchar(200)
  ip_address text
  actor_user_id text [note: "Logical reference to auth.users.id. Set for staff actions."]
  description text
  event_at bigint [not null]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Append-only log of license API calls and staff overrides, company-wide. Was licensing.license_events."
  Indexes {
    license_key_id [name: 'license_events_key_id_idx']
    license_contract_id [name: 'license_events_contract_id_idx']
    event_at [name: 'license_events_event_at_idx']
  }
  Checks {
    `event_type IN ('validated', 'activated', 'deactivated', 'renewed', 'suspended', 'reactivated', 'terminated', 'key_revoked')`
  }
}

Table project.license_api_keys {
  id uuid [pk, default: `uuidv7()`]
  license_application_id uuid [not null]
  api_key_id text [note: "Logical reference to auth.apikeys.id (config licensing, prefix elk_). Cross-module FK intentionally omitted. Validated through the Identity module contract. The secret is hashed by Better Auth and shown once."]
  name varchar(100) [not null]
  key_start varchar(20)
  status text [not null, default: 'active']
  created_by text [note: "Logical reference to auth.users.id."]
  revoked_by text [note: "Logical reference to auth.users.id."]
  revoked_at bigint
  last_used_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Machine key an own application uses to call the license API, company-wide. Was licensing.application_api_keys. It can only validate, activate and deactivate keys of its own application."
  Indexes {
    license_application_id [name: 'license_api_keys_application_id_idx']
    api_key_id [unique, name: 'license_api_keys_api_key_id_uq']
  }
  Checks {
    `status IN ('active', 'revoked')`
  }
}

Table project.types {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  default_duration_days integer
  description text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Type of project such as installation, maintenance or subscription setup (was projects.project_types). projects.type_id arrives together with this table."
  Indexes {
    (organization_id, code) [unique, name: 'project_types_org_code_uq']
  }
}

Table project.phases {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  project_id uuid [not null]
  name text [not null]
  sequence integer [not null, default: 0]
  planned_start date
  planned_end date
  actual_start date
  actual_end date
  status text [not null, default: 'pending']
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Phase of a project, used to group tasks (was projects.project_phases)."
  Indexes {
    (project_id, sequence) [unique, name: 'project_phases_sequence_uq']
  }
  Checks {
    `status IN ('pending', 'in_progress', 'done', 'skipped')`
  }
}

Table project.task_dependencies {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  task_id uuid [not null]
  depends_on_task_id uuid [not null]
  dependency_type text [not null, default: 'finish_to_start']
  lag_days integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Dependency between two tasks of the same project."
  Indexes {
    (task_id, depends_on_task_id) [unique, name: 'task_dependencies_uq']
  }
  Checks {
    `dependency_type IN ('finish_to_start', 'start_to_start', 'finish_to_finish', 'start_to_finish')`
    `task_id <> depends_on_task_id`
  }
}

Table project.milestones {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  project_id uuid [not null]
  name text [not null]
  description text
  target_date date
  actual_date date
  status text [not null, default: 'pending']
  verified_by text [note: "Logical reference to auth.users.id."]
  verified_at bigint
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Milestone of a project with an optional client verification."
  Indexes {
    project_id [name: 'milestones_project_id_idx']
    status [name: 'milestones_status_idx']
  }
  Checks {
    `status IN ('pending', 'reached', 'verified', 'missed')`
  }
}

Table project.daily_reports {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  project_id uuid [not null]
  task_id uuid
  technician_employee_id uuid [note: "Logical reference to human_resource.employees.id. Cross-module FK intentionally omitted. Validated through the Human Resource module contract."]
  report_date date [not null]
  work_description text
  hours_worked numeric(8,2) [not null, default: 0]
  progress_percent numeric(5,2) [not null, default: 0]
  weather_conditions text
  status text [not null, default: 'draft']
  submitted_at bigint
  verified_by text [note: "Logical reference to auth.users.id."]
  verified_at bigint
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Daily report of a technician. Verification is a separate step from submission."
  Indexes {
    (organization_id, code) [unique, name: 'daily_reports_org_code_uq']
    project_id [name: 'daily_reports_project_id_idx']
    status [name: 'daily_reports_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'verified', 'rejected')`
    `hours_worked >= 0`
    `progress_percent BETWEEN 0 AND 100`
  }
}

Table project.site_assignments {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  project_id uuid [not null]
  employee_id uuid [note: "Logical reference to human_resource.employees.id. Cross-module FK intentionally omitted."]
  role text
  assigned_on date
  released_on date
  rate_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Who is assigned to a project site, and from when."
  Indexes {
    project_id [name: 'site_assignments_project_id_idx']
    employee_id [name: 'site_assignments_employee_id_idx']
  }
  Checks {
    `rate_amount >= 0`
    `released_on IS NULL OR assigned_on IS NULL OR released_on >= assigned_on`
  }
}

Table project.kpi_definitions {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  metric_type text [not null, default: 'numeric']
  target_value numeric(18,4)
  unit text
  weight numeric(5,2) [not null, default: 0]
  scope_type text [not null, default: 'project']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Definition of a performance indicator."
  Indexes {
    (organization_id, code) [unique, name: 'kpi_definitions_org_code_uq']
  }
  Checks {
    `metric_type IN ('numeric', 'boolean', 'duration', 'score')`
    `scope_type IN ('project', 'employee', 'team', 'company')`
    `weight BETWEEN 0 AND 100`
  }
}

Table project.kpi_evaluations {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  kpi_definition_id uuid [not null]
  project_id uuid
  employee_id uuid [note: "Logical reference to human_resource.employees.id. Cross-module FK intentionally omitted."]
  period_year integer [not null]
  period_month integer
  actual_value numeric(18,4)
  score numeric(9,4)
  evaluated_by text [note: "Logical reference to auth.users.id."]
  evaluated_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Measured value of a KPI for a period."
  Indexes {
    (kpi_definition_id, project_id, period_year, period_month) [unique, name: 'kpi_evaluations_period_uq']
  }
  Checks {
    `period_month IS NULL OR period_month BETWEEN 1 AND 12`
  }
}

Table project.changes {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  project_id uuid [not null]
  title text [not null]
  description text
  reason text
  impact_cost bigint [not null, default: 0]
  impact_days integer [not null, default: 0]
  status text [not null, default: 'draft']
  requested_by text [note: "Logical reference to auth.users.id."]
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  effective_date date
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Change order on a project. Cost and schedule impact must be approved before it applies."
  Indexes {
    (organization_id, code) [unique, name: 'changes_org_code_uq']
    project_id [name: 'changes_project_id_idx']
    status [name: 'changes_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'applied', 'cancelled')`
    `impact_days >= 0`
  }
}

Table project.work_plans {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  period_start date
  period_end date
  owner_user_id text [note: "Logical reference to auth.users.id."]
  status text [not null, default: 'draft']
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Work plan for a period, the umbrella of the projects and the tasks inside it."
  Indexes {
    (organization_id, code) [unique, name: 'work_plans_org_code_uq']
    status [name: 'work_plans_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'active', 'closed', 'cancelled')`
    `period_end IS NULL OR period_start IS NULL OR period_end >= period_start`
  }
}

Table project.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  description text
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Project module configuration key value store."
  Indexes {
    (setting_group, setting_key) [unique, name: 'project_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Table project.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "project, bast, warranty, lead_reference, license_contract."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the project module (ADR-0024 Q6). Absorbs the projects, crm-lead, licensing and aftersales-warranty rows of code_number.series."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

