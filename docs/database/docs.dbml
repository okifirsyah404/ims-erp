// ---------------------------------------------------------------------------
// MODULE: Identity  (schema: auth - shared by the `user` and `organization`
// modules because Better Auth owns it). 9 Better Auth core tables + 2 ERP-owned
// tables. `auth:generate` is never run: the core tables are hand-maintained.
// ---------------------------------------------------------------------------

Table auth.users {
  deleted_at timestamp [note: "Better Auth owned table: the one place a soft-delete marker is a timestamp, not unix milliseconds (the adapter reads Date)."]
  id text [pk]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  role text
  banned boolean [default: false]
  ban_reason text
  ban_expires timestamp
  bio text
  username text [unique]
  display_username text
  claimed_at timestamp [note: "When an invited user claimed the invitation (status pending -> active)."]
  phone text [note: "Contact phone captured at invitation claim. Partial unique index users_phone_live_idx WHERE phone IS NOT NULL."]
  status text [note: "User lifecycle for the invitation-only flow: pending | active | deactivated."]
  gender text [note: "API contract: male | female only."]
  birth_date bigint [note: "Unix milliseconds at Asia/Jakarta midnight."]
  birth_place text
  marital_status text
  Note: "Better Auth system user. Superadmin flag for the admin plugin."
  Indexes {
    email [unique, name: 'users_email_key']
    username [unique, name: 'users_username_key']
  }
  Checks {
    `gender IS NULL OR gender IN ('male', 'female')`
    `marital_status IS NULL OR marital_status IN ('single', 'married', 'divorced', 'widowed')`
  }
}

Table auth.sessions {
  id text [pk]
  expires_at timestamp [not null]
  token text [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  ip_address text
  user_agent text
  user_id text [not null]
  impersonated_by text
  active_organization_id text
  Note: "Better Auth session. Hard deleted on revoke (no deleted_at)."
  Indexes {
    user_id [name: 'sessions_userId_idx']
    token [unique, name: 'sessions_token_key']
  }
}

Table auth.accounts {
  id text [pk]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  Note: "Better Auth credential and OAuth provider account."
  Indexes {
    user_id [name: 'accounts_userId_idx']
  }
}

Table auth.verifications {
  id text [pk]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  Note: "Better Auth one time verification token store. Consumed rows are hard deleted."
  Indexes {
    identifier [name: 'verifications_identifier_idx']
  }
}

Table auth.organizations {
  deleted_at timestamp [note: "Better Auth owned table: a timestamp, not unix milliseconds (the adapter reads Date)."]
  id text [pk]
  name text [not null]
  slug text [not null, unique]
  logo text [note: "Object-storage key of the organization profile image."]
  description text
  created_at timestamp [not null]
  metadata text
  Note: "Better Auth organization. An internal organization of the company; multiple may exist inside one company. Not a tenancy boundary - ERP master data is shared company-wide (ADR-0001, ADR-0007)."
  Indexes {
    slug [unique, name: 'organizations_slug_uidx']
  }
}

Table auth.members {
  id text [pk]
  organization_id text [not null]
  user_id text [not null]
  role text [not null, default: 'member', note: "Comma-separated closed ERP role keys (erpRoleNames in @ims-erp/common). There is no dynamic role table."]
  created_at timestamp [not null]
  Note: "Better Auth organization membership. HARD DELETED by Better Auth - no deleted_at column, so membership queries must never filter on one."
  Indexes {
    organization_id [name: 'members_organizationId_idx']
    user_id [name: 'members_userId_idx']
  }
}

Table auth.invitations {
  id text [pk]
  organization_id text [not null]
  email text [not null]
  role text
  status text [not null, default: 'pending']
  expires_at timestamp [not null]
  created_at timestamp [not null]
  inviter_id text [not null]
  Note: "Better Auth organization invitation."
  Indexes {
    organization_id [name: 'invitations_organizationId_idx']
    email [name: 'invitations_email_idx']
  }
}

Table auth.passkeys {
  id text [pk]
  name text
  public_key text [not null]
  user_id text [not null]
  credential_id text [not null]
  counter integer [not null]
  device_type text [not null]
  backed_up boolean [not null]
  transports text
  created_at timestamp
  aaguid text
  Note: "Better Auth passkey credential."
  Indexes {
    user_id [name: 'passkeys_userId_idx']
    credential_id [name: 'passkeys_credentialID_idx']
  }
}

Table auth.apikeys {
  id text [pk]
  config_id text [not null, default: 'default']
  name text
  start text
  reference_id text [not null]
  prefix text
  key text [not null]
  refill_interval integer
  refill_amount integer
  last_refill_at timestamp
  enabled boolean [default: true]
  rate_limit_enabled boolean [default: true]
  rate_limit_time_window integer [default: 86400000]
  rate_limit_max integer [default: 10]
  request_count integer [default: 0]
  remaining integer
  last_request timestamp
  expires_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  permissions text
  metadata text
  Note: "Better Auth API key. Rate limit window is milliseconds, matching the ERP cache unit convention."
  Indexes {
    config_id [name: 'apikeys_configId_idx']
    reference_id [name: 'apikeys_referenceId_idx']
    key [name: 'apikeys_key_idx']
  }
}

Table auth.user_invitations {
  deleted_at bigint
  id text [pk]
  type text [not null, default: 'app', note: "'app' = application-admin invite (no organization); 'org' = organization admin/HR invite (role + organization attached)."]
  email text [not null]
  name text [note: "App-admin path input; pre-creates the user and prefills the profile form on claim."]
  organization_id text
  org_role text [note: "Comma-joined closed ERP role keys ('admin,finance') assigned to the membership on claim. NULL on app-path invites."]
  token_hash text [not null, unique, note: "SHA-256 of the emailed single-use token; raw token never stored."]
  status text [not null, default: 'pending']
  invited_by text [not null]
  expires_at bigint [not null]
  resent_count integer [not null, default: 0]
  delivery_failed boolean [not null, default: false]
  claimed_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Unified invitation pipeline for both invite paths (ERP-owned table in the auth schema). Users are pre-created at invite time (users.status='pending'). Named user_invitations because Better Auth owns auth.invitations."
  Indexes {
    email [name: 'user_invitations_email_idx']
    organization_id [name: 'user_invitations_organizationId_idx']
    status [name: 'user_invitations_status_idx']
  }
}

Table auth.organization_settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Intra-schema."]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  is_secret boolean [not null, default: false]
  description text
  updated_by text [note: "Logical reference to auth.users.id. Intra-schema."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Organization-scoped configuration key value store. Was organization.settings; the planned organization.fiscal_settings columns became keys here (fiscal.year_start_month, fiscal.business_timezone, fiscal.default_currency_code) instead of a second table (ADR-0024 Q4). Company-wide settings live in company.settings."
  Indexes {
    (organization_id, setting_group, setting_key) [unique, name: 'organization_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Ref: auth.sessions.user_id > auth.users.id [delete: cascade]
Ref: auth.accounts.user_id > auth.users.id [delete: cascade]
Ref: auth.members.organization_id > auth.organizations.id [delete: cascade]
Ref: auth.members.user_id > auth.users.id [delete: cascade]
Ref: auth.invitations.organization_id > auth.organizations.id [delete: cascade]
Ref: auth.invitations.inviter_id > auth.users.id [delete: cascade]
Ref: auth.passkeys.user_id > auth.users.id [delete: cascade]
Ref: auth.user_invitations.organization_id > auth.organizations.id [delete: cascade]
Ref: auth.user_invitations.invited_by > auth.users.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Location  (schema: location). Global reference data, not tenant
// scoped. Address tables store only village_id; district/regency/province are
// derived through ExportedLocationService.resolveVillagePath (ADR-0024 Q10).
// ---------------------------------------------------------------------------

Table location.provinces {
  id uuid [pk, default: `uuidv7()`]
  code varchar(20) [not null, unique]
  name text [not null]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Indonesian province. Soft deleted, never hard deleted."
  Indexes {
    code [unique, name: 'province_code_idx']
    name [name: 'province_name_idx']
  }
}

Table location.regencies {
  id uuid [pk, default: `uuidv7()`]
  code varchar(20) [not null, unique]
  name text [not null]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  province_id uuid
  Note: "Indonesian regency or city."
  Indexes {
    code [unique, name: 'regency_code_idx']
    name [name: 'regency_name_idx']
    province_id [name: 'regency_province_id_idx']
  }
}

Table location.districts {
  id uuid [pk, default: `uuidv7()`]
  code varchar(20) [not null, unique]
  name text [not null]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  regency_id uuid
  Note: "Indonesian district."
  Indexes {
    code [unique, name: 'district_code_idx']
    name [name: 'district_name_idx']
    regency_id [name: 'district_regency_id_idx']
  }
}

Table location.villages {
  id uuid [pk, default: `uuidv7()`]
  code varchar(20) [not null, unique]
  name text [not null]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  district_id uuid
  Note: "Indonesian village or kelurahan."
  Indexes {
    code [unique, name: 'village_code_idx']
    name [name: 'village_name_idx']
    district_id [name: 'village_district_id_idx']
  }
}

Ref: location.regencies.province_id > location.provinces.id [delete: cascade]
Ref: location.districts.regency_id > location.regencies.id [delete: cascade]
Ref: location.villages.district_id > location.districts.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Company  (schema: company). The one legal company behind every
// organization (ADR-0011): profile, addresses, contacts, company-wide settings.
// All rows are company-wide - no organization_id column anywhere.
// `company.bank_accounts` moved to finance.cash_bank_accounts (ADR-0024 Q19).
// ---------------------------------------------------------------------------

Table company.profiles {
  id uuid [pk, default: `uuidv7()`]
  legal_name varchar(200) [not null]
  trading_name varchar(200)
  document_code varchar(16) [not null, note: "Company code in document numbers (the {COMPANY} token), upper-case letters and digits."]
  tagline varchar(300)
  tax_id varchar(32) [note: "NPWP number of the company."]
  logo_object_key text [note: "Object-storage key of the letterhead logo (WebP)."]
  signature_object_key text [note: "Object-storage key of the signature and stamp image printed above the signatory name."]
  onboarding_object_key text [note: "Object-storage key of the onboarding image shown on the login page."]
  signatory_name varchar(200)
  signatory_title varchar(100)
  default_quotation_terms text
  default_invoice_terms text
  warranty_coverage text
  warranty_exclusions text
  warranty_service_terms text
  status text [not null, default: 'active']
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Legal and display profile of the one company. One live row, enforced by the partial unique index profiles_singleton_uq ON ((true)) WHERE deleted_at IS NULL."
  Checks {
    `status IN ('active', 'inactive')`
    `document_code ~ '^[A-Z0-9]+$'`
  }
}

Table company.addresses {
  id uuid [pk, default: `uuidv7()`]
  label varchar(100) [not null, default: 'head_office']
  address_line text [not null]
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated by ExportedLocationService.assertVillage on write; district, regency and province are derived through ExportedLocationService.resolveVillagePath (ADR-0024 Q10)."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false, note: "The address printed on the letterhead; at most one live row."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Office address of the company, company-wide. Was company.head_office_addresses (ADR-0024 Q21). Only village_id is stored; the path is resolved through ExportedLocationService."
}

Table company.contacts {
  id uuid [pk, default: `uuidv7()`]
  contact_type text [not null]
  value varchar(200) [not null]
  label varchar(100)
  is_primary boolean [not null, default: false, note: "The contact shown on the letterhead per type; at most one live row per type."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Company contact channel, company-wide."
  Indexes {
    value [name: 'contacts_value_idx']
  }
  Checks {
    `contact_type IN ('phone', 'email', 'whatsapp', 'fax', 'other')`
  }
}

Table company.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  is_secret boolean [not null, default: false]
  description text
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Company-wide configuration key value store. Organization-scoped settings live in auth.organization_settings. is_secret is reserved and always false until a secret read path exists (ERP-0045)."
  Indexes {
    (setting_group, setting_key) [unique, name: 'company_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

// ---------------------------------------------------------------------------
// MODULE: Customer  (schema: customer, was crm; absorbs the portal). One
// customer company (B2B entity) with its people, plus the portal login of a
// person. Company-wide (ADR-0011): no organization_id. `crm.leads` moved to
// project (Q12); `crm.customer_contacts` merged into customer.customers (Q16);
// `auth.portal_identities` folded into customer.customers (Q5).
// ---------------------------------------------------------------------------

Table customer.companies {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Upper-case; unique among live rows (partial index in the Drizzle schema)."]
  name text [not null]
  legal_name text
  company_type text [not null, default: 'company']
  tax_id varchar(16) [note: "NPWP digits only, 15 or 16."]
  email text
  phone varchar(30) [note: "E.164 (+6281234567890), normalised by the service."]
  website varchar(200)
  status text [not null, default: 'active']
  owner_customer_id uuid [note: "The one owner of the company account: a contact person of this company (customers.company_id = companies.id, checked by the service). Intra-schema FK; unique among live rows (partial index in the Drizzle schema). Null while the company has no owner. Every other contact is staff (portal_role approver | finance | viewer) (ERP-0114)."]
  notes text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Customer company (the B2B entity), company-wide, a data record without a login of its own. Was crm.customers rows of type company/government/partner (ADR-0024 Q16). Inactive companies cannot be used on new documents. One owner (owner_customer_id) and N staff contacts (ERP-0114)."
  Indexes {
    name [name: 'customer_companies_name_idx']
    tax_id [name: 'customer_companies_tax_id_idx']
  }
  Checks {
    `company_type IN ('company', 'government', 'partner')`
    `status IN ('active', 'inactive')`
  }
}

Table customer.customers {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Upper-case; unique among live rows (partial index in the Drizzle schema)."]
  company_id uuid [note: "The company this person belongs to; null for an individual buyer. Intra-schema FK."]
  name text [not null]
  position text [note: "Job title of the person inside the company."]
  phone varchar(30) [note: "E.164 (+6281234567890), normalised by the service. The email lives on the Better Auth user (auth.users.email), never here (ERP-0114)."]
  customer_type text [not null, default: 'individual']
  status text [not null, default: 'active']
  user_id text [note: "The Better Auth account of this person: one account is exactly one customer (ERP-0114). Created with the person; kept on revoke. Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Unique among live rows (partial unique index in the Drizzle schema)."]
  portal_role text [note: "Staff role of a company contact: approver (accepts quotations), finance (invoices, payments), viewer (read only). owner is stored for an individual (their own account) and for the contact named by companies.owner_customer_id, which is the source of truth for company ownership (ERP-0114)."]
  portal_status text [note: "active | suspended | revoked. Revoking ends every session and keeps user_id (one account, one customer, ERP-0114); re-inviting reactivates the same account."]
  portal_password_change_required boolean [not null, default: false, note: "Set when the account was created with the default password; cleared by a password change or reset (enforcement in the portal is ERP-0115)."]
  portal_invited_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Null for an individual's own sign-up."]
  portal_last_login_at bigint
  notes text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "A person: an individual customer, or a contact of a customer company (its one owner or a staff member). Every person has exactly one Better Auth account (ERP-0114). Was crm.customer_contacts merged with crm.customers of type individual, plus the portal identity columns of auth.portal_identities (ADR-0024 Q5/Q16). A portal login is never an organization member, so every ERP route refuses it; only the portal routes accept an active login."
  Indexes {
    company_id [name: 'customers_company_id_idx']
    name [name: 'customers_name_idx']
  }
  Checks {
    `customer_type IN ('individual', 'contact')`
    `status IN ('active', 'inactive')`
    `portal_role IS NULL OR portal_role IN ('owner', 'approver', 'finance', 'viewer')`
    `portal_status IS NULL OR portal_status IN ('active', 'suspended', 'revoked')`
    `company_id IS NOT NULL OR customer_type = 'individual'`
  }
}

Table customer.addresses {
  id uuid [pk, default: `uuidv7()`]
  customer_id uuid [not null]
  kind text [not null, default: 'residence']
  label text
  address_line text [not null]
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated by ExportedLocationService.assertVillage on write; district, regency and province are derived through ExportedLocationService.resolveVillagePath (ADR-0024 Q10)."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Address of a person (ADR-0024 Q10: only village_id is stored)."
  Indexes {
    customer_id [name: 'customer_addresses_customer_id_idx']
  }
  Checks {
    `kind IN ('residence', 'office', 'billing', 'other')`
  }
}

Table customer.company_addresses {
  id uuid [pk, default: `uuidv7()`]
  company_id uuid [not null]
  kind text [not null, default: 'billing']
  label text
  contact_name text
  contact_phone text
  address_line text [not null]
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated by ExportedLocationService.assertVillage on write; district, regency and province are derived through ExportedLocationService.resolveVillagePath (ADR-0024 Q10)."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Structured address of a customer company. The kind discriminator replaces a separate billing and shipping table. Data moved from the crm.customers address columns (ADR-0024 Q10)."
  Indexes {
    company_id [name: 'customer_company_addresses_company_id_idx']
    (company_id, kind, is_primary) [name: 'customer_company_addresses_kind_idx']
  }
  Checks {
    `kind IN ('billing', 'shipping', 'service', 'site', 'other')`
  }
}

Table customer.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  description text
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Customer module configuration key value store."
  Indexes {
    (setting_group, setting_key) [unique, name: 'customer_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Table customer.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "Code type owned by this module, e.g. customer, customer_company."]
  pattern varchar(100) [note: "Token pattern, e.g. {SEQ:4}/{TYPE}/{COMPANY}; null = code default."]
  reset_policy text [note: "never | yearly | monthly; null = code default."]
  period_key varchar(7) [not null, note: "2026, 2026-11 or all; a new period restarts at 1."]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the customer module (ADR-0024 Q6). Allocation is one atomic INSERT ... ON CONFLICT DO UPDATE ... RETURNING. Partial unique index on code_type WHERE deleted_at IS NULL. Issues customer and customer_company codes when a create leaves code empty (default {TYPE}-{SEQ:5}, never reset); a generated code must fit the 32-character code column. Pattern tokens include {ORG}, the upper-cased slug of the issuing organization."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: customer.customers.company_id > customer.companies.id [delete: restrict]
Ref: customer.companies.owner_customer_id - customer.customers.id [delete: set null]
Ref: customer.addresses.customer_id > customer.customers.id [delete: cascade]
Ref: customer.company_addresses.company_id > customer.companies.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Supplier  (schema: supplier, new; split out of procurement). The
// supplier company (the entity the PO is issued to) and its people (PIC),
// plus addresses. Company-wide. Bank details are restricted.
// ---------------------------------------------------------------------------

Table supplier.companies {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Upper-case letters and digits; the {SUPPLIER} token of PO numbers. Unique among live rows (partial index in the Drizzle schema)."]
  name text [not null]
  legal_name text
  supplier_type text [not null, default: 'company']
  tax_id varchar(16) [note: "NPWP digits only, 15 or 16."]
  email text
  phone varchar(30)
  website varchar(200)
  bank_name text
  bank_account_number text
  bank_account_holder text
  status text [not null, default: 'active']
  notes text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Supplier company, company-wide. Was procurement.suppliers for company/government rows (ADR-0024 Q17). ERP-0116 dropped whatsapp (contacts live on the PIC and the purchase order) and payment_terms_days/payment_term_note (payment terms belong to the purchase order, ERP-0116). Bank details are restricted and never returned without supplier:read_bank. Inactive suppliers cannot be used on new purchase orders."
  Indexes {
    name [name: 'supplier_companies_name_idx']
    status [name: 'supplier_companies_status_idx']
    tax_id [name: 'supplier_companies_tax_id_idx']
  }
  Checks {
    `supplier_type IN ('company', 'government')`
    `status IN ('active', 'inactive')`
  }
}

Table supplier.suppliers {
  id uuid [pk, default: `uuidv7()`]
  company_id uuid [note: "The supplier company this person belongs to; null for an individual supplier. Intra-schema FK."]
  name text [not null]
  title varchar(100) [note: "Job title, printed on purchase orders."]
  phone varchar(30)
  email text
  is_primary boolean [not null, default: false, note: "The supplier-side person in charge printed on purchase orders; at most one live row per company."]
  status text [not null, default: 'active']
  notes text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Supplier-side person in charge (PIC), or an individual supplier when company_id is null. Was the procurement.suppliers PIC columns (ADR-0024 Q17). ERP-0116 dropped whatsapp (the PIC address block carries the phone)."
  Indexes {
    company_id [name: 'suppliers_company_id_idx']
    status [name: 'suppliers_status_idx']
  }
  Checks {
    `status IN ('active', 'inactive')`
  }
}

Table supplier.addresses {
  id uuid [pk, default: `uuidv7()`]
  supplier_id uuid [not null]
  kind text [not null, default: 'office']
  label text
  address_line text [not null]
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated by ExportedLocationService.assertVillage on write; district, regency and province are derived through ExportedLocationService.resolveVillagePath (ADR-0024 Q10)."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Address of a supplier person (ADR-0024 Q10)."
  Indexes {
    supplier_id [name: 'supplier_addresses_supplier_id_idx']
  }
  Checks {
    `kind IN ('office', 'other')`
  }
}

Table supplier.company_addresses {
  id uuid [pk, default: `uuidv7()`]
  company_id uuid [not null]
  kind text [not null, default: 'office']
  label text
  contact_name text
  contact_phone text
  address_line text [not null]
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated by ExportedLocationService.assertVillage on write; district, regency and province are derived through ExportedLocationService.resolveVillagePath (ADR-0024 Q10)."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Structured address of a supplier company. Data moved from the procurement.suppliers address columns (ADR-0024 Q10)."
  Indexes {
    company_id [name: 'supplier_company_addresses_company_id_idx']
  }
  Checks {
    `kind IN ('office', 'factory', 'warehouse', 'billing', 'other')`
  }
}

Table supplier.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  description text
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Supplier module configuration key value store."
  Indexes {
    (setting_group, setting_key) [unique, name: 'supplier_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Table supplier.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "Code type owned by this module, e.g. supplier_company."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the supplier module (ADR-0024 Q6). Issues supplier_company codes when a create leaves code empty (default {COMPANY}-{ORG}-{TYPE}-{SEQ:5}, never reset; {ORG} is the upper-cased slug of the issuing organization). A generated code must fit the 32-character code column; a typed code is kept, so a short code for the PO {SUPPLIER} token stays possible."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: supplier.suppliers.company_id > supplier.companies.id [delete: restrict]
Ref: supplier.addresses.supplier_id > supplier.suppliers.id [delete: cascade]
Ref: supplier.company_addresses.company_id > supplier.companies.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Product  (schema: product; split out of inventory by ADR-0026).
// Owns the product (SKU) master with its website listing columns, the product
// categories, the module settings and the product code series. Stock balances,
// the stock ledger and serial units stay in `inventory`, which references
// product.products through plain nullable ids (ADR-0014); product reads stock
// availability and serial counts back through ExportedInventoryService.
// ---------------------------------------------------------------------------

Table product.products {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008). Logical reference to auth.organizations.id; cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null, note: "Human reference from the numbering authority (item_product -> PRD-<company>-00001, item_material -> MAT-<company>-00001, item_component -> CMP-<company>-00001; ADR-0026). Immutable after create."]
  sku varchar(64) [not null, note: "Manufacturer/business SKU, typed by the user. Unique per tenant; immutable after create."]
  serial_number text [note: "Optional manufacturer serial of a serialized product master. Per-unit serials stay in inventory.item_serials."]
  name text [not null]
  description text
  product_kind text [not null]
  product_category_id uuid
  brand varchar(100)
  specification text [note: "Technical specification printed on quotations."]
  image_object_key text [note: "Cover photo: mirrored from the first live row of product_images by ProductImageService (printed on documents)."]
  unit_label varchar(32) [not null, default: 'pcs', note: "Fixed unit list (ADR-0011), guarded by a CHECK."]
  is_active boolean [not null, default: true, note: "Inactive products stay listed but are not offered for new documents."]
  is_serialized boolean [not null, default: false]
  is_stock_tracked boolean [not null, default: true]
  min_stock_qty numeric(18,3) [not null, default: 0]
  barcode text
  selling_price bigint [not null, default: 0, note: "Exact integer IDR minor units (ADR-0002). Never a float."]
  purchase_price bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  slug varchar(120) [note: "Website product slug (from catalog.web_listings). Unique among live rows."]
  is_published boolean [not null, default: false]
  published_at bigint
  listing_specs varchar(400) [note: "Short specification line for the product card; empty uses the product specification."]
  price_mode text [not null, default: 'list', note: "list: the selling price is shown; rfq: no price, the website asks for a quotation."]
  price_caption varchar(120)
  out_of_stock_mode text [not null, default: 'request', note: "Shown when nothing is available: out, preorder or request."]
  lead_time_label varchar(60)
  applications jsonb [not null, default: `'[]'`, note: "Use-case tags (string array)."]
  popularity integer [not null, default: 0, note: "Manual weight for the popular sort."]
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Product (SKU) master. One product master for the whole ERP; catalog.items is superseded (ADR-0008). product_kind is product|component|material only - physical tools are inventory.items and services are neither stocked nor serialized. The website listing columns were catalog.web_listings and are now a 1:1 part of the product row (ADR-0024 Q14)."
  Indexes {
    (organization_id, code) [unique, name: 'products_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'products_global_code_uq', note: 'WHERE organization_id IS NULL']
    (organization_id, sku) [unique, name: 'products_org_sku_uq', note: 'WHERE organization_id IS NOT NULL']
    (sku) [unique, name: 'products_global_sku_uq', note: 'WHERE organization_id IS NULL']
    slug [unique, name: 'products_slug_uq', note: 'WHERE deleted_at IS NULL']
    product_kind [name: 'products_kind_idx']
    (organization_id, name) [name: 'products_org_name_idx']
    barcode [name: 'products_barcode_idx']
  }
  Checks {
    `product_kind IN ('product', 'component', 'material')`
    `selling_price >= 0 AND purchase_price >= 0`
    `min_stock_qty >= 0`
    `unit_label IN ('pcs', 'unit', 'set', 'paket', 'titik', 'm', 'roll', 'kg', 'jam', 'bulan', 'tahun', 'lic', 'lot', 'pulau')`
    `price_mode IN ('list', 'rfq')`
    `out_of_stock_mode IN ('out', 'preorder', 'request')`
    `popularity >= 0`
  }
}

Table product.product_images {
  id uuid [pk, default: `uuidv7()`]
  product_id uuid [not null]
  object_key text [not null, note: "Object-storage key of the WebP image; never a public URL. Every upload gets a fresh key."]
  caption varchar(200)
  sort_order integer [not null, default: 0, note: "Gallery order, ascending. The first live row is the cover; its key is mirrored into products.image_object_key by the service."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Image gallery of a product, component or material (at most 10 live images). Soft-deleted rows keep their object so documents that snapshotted the key still print."
  Indexes {
    (product_id, sort_order) [name: 'product_images_product_id_sort_idx']
  }
}

Table product.product_components {
  id uuid [pk, default: `uuidv7()`]
  product_id uuid [not null, note: "The assembled product. Its product_kind must be 'product' (checked by the service)."]
  component_id uuid [not null, note: "The component or material it is made of. product_kind must be 'component' or 'material' and visible to the product's organization (checked by the service). Tenant scope comes from the parent product, so this table has no organization_id."]
  quantity numeric(18,3) [not null, note: "Quantity needed per one unit of the product, in the component's unit_label."]
  sort_order integer [not null, default: 0, note: "Position in the list the client sent."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Composition (bill of materials) of a product: informational only, no stock movement and no costing is derived from it. The list is replaced as a whole; replaced rows are soft-deleted."
  Indexes {
    (product_id, component_id) [unique, name: 'product_components_product_component_uq', note: 'WHERE deleted_at IS NULL']
    component_id [name: 'product_components_component_id_idx']
  }
  Checks {
    `quantity > 0`
    `product_id <> component_id`
  }
}

Table product.product_categories {
  id uuid [pk, default: `uuidv7()`]
  slug varchar(64) [not null, note: "Matches the public website's category slug."]
  name varchar(120) [not null]
  short_name varchar(60)
  sort_order integer [not null, default: 0]
  description text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Product category, one level, company-wide (ADR-0011): no organization_id. Was inventory.item_categories. A category with live products cannot be archived."
}

Table product.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  description text
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint
  Note: "Product module configuration key value store (ADR-0024 Q27)."
  Indexes {
    (setting_group, setting_key) [unique, name: 'product_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Table product.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "item_product, item_material, item_component."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the product module (ADR-0026). Default pattern {TYPE}-{COMPANY}-{SEQ:5}, never reset."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: product.products.product_category_id > product.product_categories.id [delete: restrict]
Ref: product.product_images.product_id > product.products.id [delete: cascade]
Ref: product.product_components.product_id > product.products.id [delete: cascade]
Ref: product.product_components.component_id > product.products.id [delete: restrict]

// ---------------------------------------------------------------------------
// MODULE: Warehouse  (schema: warehouse; split out of inventory by ADR-0026).
// Owns the physical estate: warehouses, their address, storages (bins), the
// person-in-charge and organization links, per-warehouse and module settings
// and the warehouse code series. Stock lives in `inventory`, which references
// warehouses and storages through plain nullable ids (ADR-0014). Warehouses are
// global (organization_id frozen at NULL, ADR-0010).
// ---------------------------------------------------------------------------

Table warehouse.warehouses {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Frozen at NULL (ADR-0010): every warehouse is global; organization access comes from warehouse_organizations. Column kept because migrations are append-only."]
  code varchar(32) [not null]
  name text [not null]
  responsible_employee_id uuid [note: "Display-only person in charge (ADR-0010); grants no access. Logical reference to human_resource.employees.id. Cross-module FK intentionally omitted. Validated through the Human Resource module contract."]
  is_default boolean [not null, default: false]
  is_active boolean [not null, default: true]
  image_url text [note: "Legacy plain URL, no longer written or read; superseded by image_object_key. Column kept because migrations are append-only."]
  image_object_key text [note: "Cover photo: mirrored from the first live row of warehouse_images; never a public URL."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Warehouse master. Address fields live in warehouse_addresses (strict 1:1). Writes are application-admin-only. Organization access is granted by warehouse_organizations links (ADR-0010)."
  Indexes {
    (organization_id, code) [unique, name: 'warehouses_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'warehouses_global_code_uq', note: 'WHERE organization_id IS NULL']
    is_default [name: 'warehouses_is_default_idx']
    is_active [name: 'warehouses_is_active_idx']
  }
}

Table warehouse.warehouse_images {
  id uuid [pk, default: `uuidv7()`]
  warehouse_id uuid [not null]
  object_key text [not null, note: "Object-storage key of the WebP image; never a public URL. Every upload gets a fresh key."]
  caption varchar(200)
  sort_order integer [not null, default: 0, note: "Gallery order, ascending. The first live row is the cover; its key is mirrored into warehouses.image_object_key by the service."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Image gallery of a warehouse (at most 10 live images). Soft-deleted rows keep their object so documents that snapshotted the key still print."
  Indexes {
    (warehouse_id, sort_order) [name: 'warehouse_images_warehouse_id_sort_idx']
  }
}

Table warehouse.warehouse_addresses {
  id uuid [pk, default: `uuidv7()`]
  warehouse_id uuid [not null]
  label text
  address_line text [not null]
  rt varchar(8)
  rw varchar(8)
  postal_code varchar(10)
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated by ExportedLocationService.assertVillage on write; district, regency and province are derived through ExportedLocationService.resolveVillagePath (ADR-0024 Q10)."]
  latitude numeric(10,7)
  longitude numeric(10,7)
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Warehouse address, strictly 1:1 with warehouses. Structured per ADR-0003/ADR-0024 Q10: free-text address_line plus a village-level logical reference."
  Indexes {
    warehouse_id [unique, name: 'warehouse_addresses_warehouse_uq']
    village_id [name: 'warehouse_addresses_village_id_idx']
  }
}

Table warehouse.warehouse_storages {
  id uuid [pk, default: `uuidv7()`]
  warehouse_id uuid [not null]
  code varchar(32) [not null]
  name text
  bin_type text
  capacity numeric(18,3)
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Storage location (bin) inside a warehouse. Storage is one level deep: warehouse -> storage, there is no zone level (ADR-0008)."
  Indexes {
    warehouse_id [name: 'warehouse_storages_warehouse_id_idx']
    (warehouse_id, code) [unique, name: 'warehouse_storages_warehouse_code_uq', note: 'WHERE deleted_at IS NULL']
  }
}

Table warehouse.warehouse_managers {
  id uuid [pk, default: `uuidv7()`]
  warehouse_id uuid [not null]
  user_id text [note: "The person in charge. Logical reference to auth.users.id; cross-module FK intentionally omitted (ADR-0014). A NULL row grants nothing."]
  assigned_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Per-user, per-warehouse person-in-charge grant (ADR-0017). It is not an organization role and grants no stock operation; create stays application-admin-only."
  Indexes {
    (warehouse_id, user_id) [unique, name: 'warehouse_managers_uq', note: 'WHERE deleted_at IS NULL']
    user_id [name: 'warehouse_managers_user_id_idx']
  }
}

Table warehouse.warehouse_organizations {
  id uuid [pk, default: `uuidv7()`]
  warehouse_id uuid [not null]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Many-to-many link granting an organization access to a global warehouse (ADR-0010). Link writes are application-admin-only and audited; unlink is rejected while the organization has open borrowings in the warehouse."
  Indexes {
    (warehouse_id, organization_id) [unique, name: 'warehouse_organizations_uq', note: 'WHERE deleted_at IS NULL']
    organization_id [name: 'warehouse_organizations_organization_id_idx']
  }
}

Table warehouse.warehouse_settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  warehouse_id uuid [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  description text
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint
  Note: "Per-warehouse configuration key value store (ADR-0024 Q27). Module-wide configuration lives in warehouse.settings."
  Indexes {
    (warehouse_id, setting_key) [unique, name: 'warehouse_settings_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Table warehouse.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  description text
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint
  Note: "Warehouse module configuration key value store (ADR-0024 Q27)."
  Indexes {
    (setting_group, setting_key) [unique, name: 'warehouse_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Table warehouse.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "warehouse."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the warehouse module (ADR-0026). Default pattern {TYPE}-{COMPANY}-{SEQ:4}, never reset."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: warehouse.warehouse_addresses.warehouse_id > warehouse.warehouses.id [delete: cascade]
Ref: warehouse.warehouse_images.warehouse_id > warehouse.warehouses.id [delete: cascade]
Ref: warehouse.warehouse_storages.warehouse_id > warehouse.warehouses.id [delete: cascade]
Ref: warehouse.warehouse_managers.warehouse_id > warehouse.warehouses.id [delete: cascade]
Ref: warehouse.warehouse_organizations.warehouse_id > warehouse.warehouses.id [delete: cascade]
Ref: warehouse.warehouse_settings.warehouse_id > warehouse.warehouses.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Inventory  (schema: inventory; absorbs `assets`; the product master
// and the warehouses moved to the `product` and `warehouse` modules, ADR-0026).
// ADR-0024 Q14/Q15/Q24-Q27:
//   item_serials    = serial units of a product (was serial_tracked_items)
//   items           = one row per physical tool/asset unit (was assets.assets)
//   movements       = the stock ledger and the asset location trail merged
//   stocks          = balance projection (was stock_balances)
// Borrowing lives here again (was assets.borrowings), split into the request
// and the issue document. `organization_id` stays nullable per table: NULL
// means global/company-wide (ADR-0008 scope rule).
// ---------------------------------------------------------------------------

Table inventory.item_serials {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008). Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract."]
  serial_number text [not null]
  is_provisional_serial boolean [not null, default: false, note: "A pre-ordered unit carries a PO-... serial until it is received. Replaced exactly once."]
  asset_tag text
  status text [not null, default: 'in_stock']
  warehouse_id uuid [note: "Logical reference to warehouse.warehouses.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract. NULL while the unit is lost."]
  bin_id uuid [note: "Logical reference to warehouse.warehouse_storages.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract."]
  acquired_on date
  warranty_expires_on date
  purchase_order_line_id uuid [note: "Logical reference to the procurement line this unit was ordered on. Cross-module FK intentionally omitted. Validated through the Procurement module contract."]
  customer_id uuid [note: "Logical reference to customer.customers.id, set when sold. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  company_id uuid [note: "Logical reference to customer.companies.id, set when sold to a company. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  movement_id uuid [note: "The last movement that touched this unit."]
  notes text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "One physical, serialized instance of a product. Was inventory.serial_tracked_items. `returned`: sent back to the supplier on a purchase return; terminal. `damaged`: back from a customer but not sellable; never picked for a delivery."
  Indexes {
    (organization_id, serial_number) [unique, name: 'item_serials_org_serial_uq', note: 'WHERE organization_id IS NOT NULL']
    (serial_number) [unique, name: 'item_serials_global_serial_uq', note: 'WHERE organization_id IS NULL']
    product_id [name: 'item_serials_product_id_idx']
    status [name: 'item_serials_status_idx']
    warehouse_id [name: 'item_serials_warehouse_id_idx']
  }
  Checks {
    `status IN ('pre_order', 'in_stock', 'lost', 'sold', 'applied_warranty', 'returned', 'damaged')`
    `is_provisional_serial = false OR status = 'pre_order'`
    `warranty_expires_on IS NULL OR acquired_on IS NULL OR warranty_expires_on >= acquired_on`
  }
}

Table inventory.items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008). Global rows are app-admin write, org read. Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null, note: "Asset code from the numbering authority; globally unique so an org item and a global item never share a code."]
  name text [not null]
  description text
  item_kind text [not null, default: 'equipment', note: "equipment | vehicle | tool | furniture | it | intangible. Absorbs assets.asset_types."]
  item_category_id uuid
  serial_number text
  barcode text
  acquisition_date date
  acquisition_cost bigint [not null, default: 0]
  salvage_value bigint [not null, default: 0]
  accumulated_depreciation bigint [not null, default: 0]
  book_value bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  useful_life_months integer
  depreciation_method text [not null, default: 'straight_line']
  depreciation_started_on date
  condition text [not null, default: 'good']
  status text [not null, default: 'ready']
  deactivation_reason text [note: "Required exactly when status = 'inactive'."]
  location_description text [note: "Off-site / non-warehouse location; may be set together with warehouse_id/storage_id."]
  warehouse_id uuid [note: "Logical reference to warehouse.warehouses.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract. Current warehouse of the physical unit; NULL while borrowed, disposed or lost."]
  storage_id uuid [note: "Logical reference to warehouse.warehouse_storages.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract. Storage (bin) inside warehouse_id; a storage id always implies its warehouse_id."]
  custodian_employee_id uuid [note: "Written denormalisation of the open borrowing's borrower, produced only by syncCustody; never accepted from a request body. Logical reference to human_resource.employees.id. Cross-module FK intentionally omitted. Validated through the Human Resource module contract."]
  borrowed_since bigint
  supplier_company_id uuid [note: "Logical reference to supplier.companies.id. Cross-module FK intentionally omitted. Validated through the Supplier module contract."]
  purchase_order_id uuid [note: "Logical reference to procurement.purchase_orders.id. Cross-module FK intentionally omitted. Validated through the Procurement module contract."]
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Document module contract."]
  image_url text [note: "Legacy plain URL, no longer written or read; superseded by image_object_key. Column kept because migrations are append-only."]
  image_object_key text [note: "Cover photo: mirrored from the first live row of item_images; never a public URL."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Asset/tool master - ONE ROW PER PHYSICAL UNIT, quantity is always 1 (was assets.assets). Master data referenced by financial records is never hard deleted. status is derived by reconcileStatus for unit-backed rows: open borrowing => borrowed, in-progress maintenance => maintenance, terminal writes disposed/lost, otherwise ready; inactive is item-owned and never overwritten."
  Indexes {
    code [unique, name: 'items_code_uq', note: 'Global across scopes, alive rows only']
    (organization_id, serial_number) [unique, name: 'items_serial_uq', note: "Expression index on (coalesce(organization_id,''), serial_number) WHERE serial_number IS NOT NULL AND deleted_at IS NULL"]
    item_kind [name: 'items_item_kind_idx']
    item_category_id [name: 'items_item_category_id_idx']
    custodian_employee_id [name: 'items_custodian_employee_id_idx']
    status [name: 'items_status_idx']
    warehouse_id [name: 'items_warehouse_id_idx']
    storage_id [name: 'items_storage_id_idx']
    serial_number [name: 'items_serial_number_idx']
  }
  Checks {
    `status IN ('ready', 'borrowed', 'maintenance', 'inactive', 'disposed', 'lost')`
    `(status = 'inactive' AND deactivation_reason IS NOT NULL) OR (status <> 'inactive' AND deactivation_reason IS NULL)`
    `storage_id IS NULL OR warehouse_id IS NOT NULL`
    `condition IN ('new', 'good', 'fair', 'poor', 'damaged')`
    `depreciation_method IN ('straight_line', 'declining_balance', 'none')`
    `acquisition_cost >= 0`
    `salvage_value >= 0`
    `accumulated_depreciation >= 0`
    `book_value >= 0`
    `useful_life_months IS NULL OR useful_life_months > 0`
  }
}

Table inventory.item_images {
  id uuid [pk, default: `uuidv7()`]
  item_id uuid [not null]
  object_key text [not null, note: "Object-storage key of the WebP image; never a public URL. Every upload gets a fresh key."]
  caption varchar(200)
  sort_order integer [not null, default: 0, note: "Gallery order, ascending. The first live row is the cover; its key is mirrored into items.image_object_key by the service."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Image gallery of a physical asset (at most 10 live images). Soft-deleted rows keep their object."
  Indexes {
    (item_id, sort_order) [name: 'item_images_item_id_sort_idx']
  }
}

Ref: inventory.item_images.item_id > inventory.items.id [delete: cascade]

Table inventory.item_categories {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008 scope rule). Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  parent_category_id uuid
  item_kind text [not null, default: 'equipment']
  default_useful_life_months integer
  default_depreciation_method text [not null, default: 'straight_line']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Asset category with its default depreciation rule. Was assets.asset_categories; the assets.asset_types lookup folded into items.item_kind (ADR-0024 Q15)."
  Indexes {
    (organization_id, code) [unique, name: 'item_categories_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'item_categories_global_code_uq', note: 'WHERE organization_id IS NULL']
    parent_category_id [name: 'item_categories_parent_category_id_idx']
  }
  Checks {
    `default_depreciation_method IN ('straight_line', 'declining_balance', 'none')`
  }
}

Table inventory.documents {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide. Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract. Exactly one of product_id / item_id is set."]
  item_id uuid [note: "Exactly one of product_id / item_id is set."]
  document_type text [not null]
  object_key text [not null, note: "Object-storage key; never a public URL."]
  file_name varchar(255) [not null]
  mime_type varchar(120) [not null]
  size_bytes bigint [not null, default: 0]
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Attachment of a product or an item: photo, manual, datasheet, certificate, invoice or contract. Merged from assets.asset_documents and the product attachment idea; the module stores its own files (ADR-0024 Q25)."
  Indexes {
    product_id [name: 'inventory_documents_product_id_idx']
    item_id [name: 'inventory_documents_item_id_idx']
    (product_id, item_id) [name: 'inventory_documents_owner_idx']
  }
  Checks {
    `document_type IN ('photo', 'manual', 'datasheet', 'certificate', 'invoice', 'contract')`
    `(product_id IS NOT NULL AND item_id IS NULL) OR (product_id IS NULL AND item_id IS NOT NULL)`
    `size_bytes >= 0`
  }
}

Table inventory.movements {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008). Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  movement_type text [not null]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract. Exactly one of product_id / item_id is set (ADR-0024 Q24)."]
  item_id uuid [note: "Exactly one of product_id / item_id is set. An item movement is always quantity 1."]
  warehouse_id uuid [note: "Logical reference to warehouse.warehouses.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract. Source warehouse (product moves) or the warehouse the item left / entered."]
  bin_id uuid [note: "Logical reference to warehouse.warehouse_storages.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract."]
  target_warehouse_id uuid [note: "Logical reference to warehouse.warehouses.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract. Transfer destination warehouse; required for transfer_in / transfer_out."]
  target_bin_id uuid [note: "Logical reference to warehouse.warehouse_storages.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract."]
  from_location text [note: "Free-text off-site detail of an item movement."]
  to_location text [note: "Free-text off-site detail of an item movement."]
  quantity numeric(18,3) [not null]
  unit_cost bigint [not null, default: 0, note: "IDR minor units the movement was valued at (moving average): the given cost for inbound moves, the balance average for outbound ones."]
  reference_type text [note: "goods_receipt | delivery_note | sale_return | purchase_return | stock_adjustment | borrowing | maintenance | disposal | manual"]
  reference_id text
  status text [not null, default: 'posted']
  occurred_at bigint [not null]
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  notes text
  created_at bigint [not null]
  Note: "Authoritative, append-only movement ledger for products AND items (ADR-0024 Q15/Q24). One row per movement, never updated after posting; a reversal is a new row. No updated_at, no deleted_at. The superseded borrowing_out / borrowing_in stock movement types are gone: borrowing writes an item movement with reference_type='borrowing'."
  Indexes {
    (organization_id, code) [unique, name: 'movements_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'movements_global_code_uq', note: 'WHERE organization_id IS NULL']
    (organization_id, product_id, warehouse_id, occurred_at) [name: 'movements_product_ledger_idx']
    (organization_id, item_id, occurred_at) [name: 'movements_item_ledger_idx']
    bin_id [name: 'movements_bin_id_idx']
    reference_type [name: 'movements_reference_type_idx']
    reference_id [name: 'movements_reference_id_idx']
  }
  Checks {
    `movement_type IN ('receipt', 'issue', 'transfer_in', 'transfer_out', 'adjustment_in', 'adjustment_out', 'return_in', 'return_out', 'consumption', 'borrow_out', 'borrow_return', 'project_site', 'disposal', 'lost')`
    `status IN ('draft', 'posted', 'reversed')`
    `quantity <> 0`
    `(product_id IS NOT NULL AND item_id IS NULL) OR (product_id IS NULL AND item_id IS NOT NULL)`
    `(movement_type IN ('transfer_in', 'transfer_out') AND target_warehouse_id IS NOT NULL) OR (movement_type NOT IN ('transfer_in', 'transfer_out'))`
    `(movement_type IN ('borrow_out', 'borrow_return', 'project_site', 'disposal', 'lost') AND item_id IS NOT NULL) OR (movement_type NOT IN ('borrow_out', 'borrow_return', 'project_site', 'disposal', 'lost'))`
  }
}

Table inventory.stocks {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008). Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract."]
  warehouse_id uuid [note: "Logical reference to warehouse.warehouses.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract."]
  bin_id uuid [note: "Logical reference to warehouse.warehouse_storages.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract."]
  quantity_on_hand numeric(18,3) [not null, default: 0]
  quantity_reserved numeric(18,3) [not null, default: 0]
  quantity_available numeric(18,3) [not null, default: 0]
  average_cost bigint [not null, default: 0, note: "Moving-average unit cost, IDR minor units. Restricted to product:read_cost."]
  total_value bigint [not null, default: 0, note: "Value of quantity_on_hand at cost; the last unit out takes the exact remainder."]
  last_movement_at bigint
  created_at bigint [not null]
  updated_at bigint
  Note: "Balance projection over inventory.movements for products only (was inventory.stock_balances). Service-maintained inside the same transaction as the movement that caused it, never by a trigger; recomputeFromLedger is the repair operation. No deleted_at (projection). Scope rule: a balance's organization_id follows the WAREHOUSE scope, not the caller - a global warehouse has ONE shared balance row."
  Indexes {
    (organization_id, warehouse_id, product_id, bin_id) [unique, name: 'stocks_org_scope_uq', note: 'NULLS NOT DISTINCT WHERE organization_id IS NOT NULL']
    (warehouse_id, product_id, bin_id) [unique, name: 'stocks_global_scope_uq', note: 'NULLS NOT DISTINCT WHERE organization_id IS NULL']
    product_id [name: 'stocks_product_id_idx']
  }
  Checks {
    `quantity_available = quantity_on_hand - quantity_reserved`
    `quantity_on_hand >= 0`
    `quantity_reserved >= 0`
  }
}

Table inventory.stock_adjustments {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  warehouse_id uuid [note: "Logical reference to warehouse.warehouses.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract."]
  adjustment_type text [not null]
  status text [not null, default: 'draft']
  reason_code text
  notes text
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  requested_at bigint [not null]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  approved_at bigint
  posted_at bigint
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Stock adjustment document with an approval chain: draft -> submitted -> approved|rejected -> posted|cancelled. Only `posted` writes movements; posting is idempotent. organization_id is nullable like the rest of inventory.* (ADR-0014); the service writes the caller's organization."
  Indexes {
    (organization_id, code) [unique, name: 'stock_adjustments_org_code_uq']
    warehouse_id [name: 'stock_adjustments_warehouse_id_idx']
    status [name: 'stock_adjustments_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'posted', 'cancelled')`
    `adjustment_type IN ('increase', 'decrease', 'recount')`
  }
}

Table inventory.stock_adjustment_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  stock_adjustment_id uuid [not null]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract."]
  bin_id uuid [note: "Logical reference to warehouse.warehouse_storages.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract."]
  quantity_before numeric(18,3) [not null, default: 0]
  quantity_after numeric(18,3) [not null, default: 0]
  unit_cost bigint [note: "Cost an increase enters stock at (IDR minor units; opening stock). Null = the current moving average. Ignored for decreases."]
  note text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Line of a stock adjustment. Stores quantity_before/quantity_after rather than a delta, so a recount is auditable; a line with no delta writes NO movement."
  Indexes {
    stock_adjustment_id [name: 'stock_adjustment_items_adjustment_id_idx']
  }
  Checks {
    `quantity_before >= 0`
    `quantity_after >= 0`
    `unit_cost IS NULL OR unit_cost >= 0`
  }
}

Table inventory.borrowing_requests {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008). Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  status text [not null, default: 'draft']
  purpose text [not null, default: 'internal_use']
  borrower_type text [not null]
  tool_set_id uuid [note: "Set when the request borrows a whole kit; its items become the request's borrowing_items."]
  borrower_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  borrower_customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  guest_name text
  guest_phone text
  guest_id_type text
  guest_id_number text [note: "Guest PII. Access-restricted and expired by the retention sweep."]
  guest_address_text text
  guest_id_document_ref text [note: "Plain text until the Documents module covers it."]
  requested_by text [note: "Logical reference to auth.users.id."]
  requested_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  due_at bigint [not null]
  notes text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Borrowing request: the request and approval half of the old assets.borrowings (ADR-0024 Q26). draft -> requested -> approved | rejected | cancelled. An approved request produces at most one inventory.borrowings row."
  Indexes {
    (organization_id, code) [unique, name: 'borrowing_requests_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'borrowing_requests_global_code_uq', note: 'WHERE organization_id IS NULL']
    status [name: 'borrowing_requests_status_idx']
    borrower_user_id [name: 'borrowing_requests_borrower_user_id_idx']
    borrower_customer_id [name: 'borrowing_requests_borrower_customer_id_idx']
    due_at [name: 'borrowing_requests_due_at_idx']
  }
  Checks {
    `status IN ('draft', 'requested', 'approved', 'rejected', 'cancelled')`
    `purpose IN ('rental', 'internal_use', 'testing', 'warranty_service')`
    `borrower_type IN ('user', 'customer', 'guest')`
    `guest_id_type IS NULL OR guest_id_type IN ('ktp', 'sim', 'passport', 'other')`
    `(borrower_type = 'user' AND borrower_user_id IS NOT NULL AND borrower_customer_id IS NULL AND guest_name IS NULL AND guest_phone IS NULL AND guest_id_number IS NULL) OR (borrower_type = 'customer' AND borrower_customer_id IS NOT NULL AND borrower_user_id IS NULL AND guest_name IS NULL AND guest_phone IS NULL AND guest_id_number IS NULL) OR (borrower_type = 'guest' AND guest_name IS NOT NULL AND guest_phone IS NOT NULL AND guest_id_number IS NOT NULL AND borrower_user_id IS NULL AND borrower_customer_id IS NULL)`
  }
}

Table inventory.borrowings {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008). Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  borrowing_request_id uuid [not null, note: "The approved request this issue document fulfils; unique (Q26)."]
  status text [not null, default: 'issued']
  issued_by text [note: "Logical reference to auth.users.id."]
  issued_at bigint
  due_at bigint [not null]
  closed_by text [note: "Logical reference to auth.users.id."]
  closed_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Borrowing issue/return document: the second half of the old assets.borrowings (ADR-0024 Q26). issued -> partially_returned -> returned | closed. The borrower snapshot is copied from its request."
  Indexes {
    (organization_id, code) [unique, name: 'borrowings_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'borrowings_global_code_uq', note: 'WHERE organization_id IS NULL']
    borrowing_request_id [unique, name: 'borrowings_request_uq']
    status [name: 'borrowings_status_idx']
    due_at [name: 'borrowings_due_at_idx']
  }
  Checks {
    `status IN ('issued', 'partially_returned', 'returned', 'closed')`
  }
}

Table inventory.borrowing_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide. Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  borrowing_request_id uuid [not null, note: "The requested unit (Q26: no separate request-lines table)."]
  borrowing_id uuid [note: "Null until the request is issued."]
  item_id uuid [not null, note: "The physical unit borrowed. Borrowing is serialized-only: a line always names a specific item, never a quantity."]
  origin_warehouse_id uuid [note: "Snapshot of where the unit left from; the item loses its warehouse while it is out."]
  origin_storage_id uuid [note: "Snapshot of the storage the unit left from, so return restores the exact bin."]
  issued_at bigint
  due_at bigint
  returned_at bigint
  returned_condition text
  marked_late_at bigint
  marked_lost_at bigint
  lost_reported_by text [note: "Logical reference to auth.users.id."]
  site_address_text text
  project_id uuid [note: "Logical reference to project.projects.id. Cross-module FK intentionally omitted. Validated through the Project module contract."]
  notes text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "One borrowed item (was assets.borrowing_lines)."
  Indexes {
    (borrowing_request_id, item_id) [unique, name: 'borrowing_items_request_item_uq']
    borrowing_id [name: 'borrowing_items_borrowing_id_idx']
    item_id [name: 'borrowing_items_item_id_idx']
    due_at [name: 'borrowing_items_open_idx', note: 'WHERE returned_at IS NULL AND marked_lost_at IS NULL']
  }
  Checks {
    `returned_condition IS NULL OR returned_condition IN ('good', 'damaged', 'incomplete')`
    `due_at IS NULL OR issued_at IS NULL OR due_at > issued_at`
    `origin_storage_id IS NULL OR origin_warehouse_id IS NOT NULL`
  }
}

Table inventory.borrowing_events {
  id uuid [pk, default: `uuidv7()`]
  borrowing_id uuid [not null]
  borrowing_item_id uuid
  event_type text [not null]
  movement_id uuid [note: "Required for the physical event types, forbidden otherwise."]
  actor_user_id text [note: "Logical reference to auth.users.id. NULL for automated sweeps."]
  occurred_at bigint [not null]
  note text
  Note: "Append-only business timeline of an issued borrowing (was assets.borrowing_events); the request half has its own timeline in borrowing_request_events. Movements never point back here: one direction only. No updated_at, no deleted_at."
  Indexes {
    (borrowing_id, occurred_at) [name: 'borrowing_events_borrowing_occurred_idx']
    borrowing_item_id [name: 'borrowing_events_item_id_idx']
  }
  Checks {
    `event_type IN ('issued', 'returned', 'marked_late', 'marked_lost', 'due_date_extended', 'closed')`
    `(event_type IN ('issued', 'returned', 'marked_lost') AND movement_id IS NOT NULL) OR (event_type NOT IN ('issued', 'returned', 'marked_lost') AND movement_id IS NULL)`
  }
}

Table inventory.borrowing_request_events {
  id uuid [pk, default: `uuidv7()`]
  borrowing_request_id uuid [not null]
  event_type text [not null]
  actor_user_id text [note: "Logical reference to auth.users.id."]
  occurred_at bigint [not null]
  note text
  Note: "Append-only timeline of a borrowing request before it is issued (ADR-0024 Q26, review 2026-11-19): requested, approved, rejected, cancelled and due-date extensions. After issue the events live in borrowing_events. No movement column: nothing physical happens before issue. No updated_at, no deleted_at."
  Indexes {
    (borrowing_request_id, occurred_at) [name: 'borrowing_request_events_request_occurred_idx']
  }
  Checks {
    `event_type IN ('requested', 'approved', 'rejected', 'cancelled', 'due_date_extended')`
  }
}

Table inventory.maintenances {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide. Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  item_id uuid [not null]
  maintenance_type text [not null, default: 'preventive']
  scheduled_date date
  performed_date date
  performed_by_employee_id uuid [note: "Logical reference to human_resource.employees.id. Cross-module FK intentionally omitted. Validated through the Human Resource module contract."]
  vendor_name text
  cost bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  description text
  status text [not null, default: 'scheduled']
  next_service_date date
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Maintenance record of an item (was assets.asset_maintenances). The next service date drives the maintenance schedule."
  Indexes {
    (organization_id, code) [unique, name: 'maintenances_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'maintenances_global_code_uq', note: 'WHERE organization_id IS NULL']
    item_id [name: 'maintenances_item_id_idx']
    status [name: 'maintenances_status_idx']
    next_service_date [name: 'maintenances_next_service_date_idx']
  }
  Checks {
    `maintenance_type IN ('preventive', 'corrective', 'calibration', 'inspection')`
    `status IN ('scheduled', 'in_progress', 'completed', 'cancelled')`
    `cost >= 0`
  }
}

Table inventory.condition_checks {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide. Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  item_id uuid [not null]
  check_date date [not null]
  condition text [not null]
  findings text
  checked_by_user_id text [note: "Logical reference to auth.users.id."]
  next_check_date date
  status text [not null, default: 'recorded']
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Periodic condition check of an item (was assets.asset_condition_checks)."
  Indexes {
    item_id [name: 'condition_checks_item_id_idx']
    check_date [name: 'condition_checks_check_date_idx']
  }
  Checks {
    `condition IN ('new', 'good', 'fair', 'poor', 'damaged')`
    `status IN ('recorded', 'followed_up', 'closed')`
  }
}

Table inventory.disposals {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide. Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  item_id uuid [not null]
  disposal_date date
  disposal_method text [not null, default: 'scrap']
  proceeds_amount bigint [not null, default: 0]
  book_value_at_disposal bigint [not null, default: 0]
  gain_loss bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  buyer_name text
  status text [not null, default: 'draft']
  requested_by text [note: "Logical reference to auth.users.id."]
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  executed_at bigint
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Disposal of an item (was assets.asset_disposals). The executing step flips the item to disposed; the disposal record stays as the financial proof."
  Indexes {
    (organization_id, code) [unique, name: 'disposals_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'disposals_global_code_uq', note: 'WHERE organization_id IS NULL']
    item_id [name: 'disposals_item_id_idx']
    status [name: 'disposals_status_idx']
  }
  Checks {
    `disposal_method IN ('sale', 'scrap', 'donation', 'transfer', 'trade_in')`
    `status IN ('draft', 'submitted', 'approved', 'executed', 'cancelled')`
    `proceeds_amount >= 0`
    `book_value_at_disposal >= 0`
  }
}

Table inventory.tool_sets {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide. Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  custodian_employee_id uuid [note: "Logical reference to human_resource.employees.id. Cross-module FK intentionally omitted. Validated through the Human Resource module contract."]
  status text [not null, default: 'available']
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Tool kit lent to a technician as one unit (was assets.tool_sets; kept per ADR-0024 Q37)."
  Indexes {
    (organization_id, code) [unique, name: 'tool_sets_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'tool_sets_global_code_uq', note: 'WHERE organization_id IS NULL']
    custodian_employee_id [name: 'tool_sets_custodian_employee_id_idx']
  }
  Checks {
    `status IN ('available', 'lent', 'maintenance', 'retired')`
  }
}

Table inventory.tool_set_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide. Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  tool_set_id uuid [not null]
  item_id uuid [not null]
  quantity numeric(18,3) [not null, default: 1]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Line of a tool set: which item unit composes the kit (was assets.tool_set_items; asset_id renamed item_id)."
  Indexes {
    tool_set_id [name: 'tool_set_items_tool_set_id_idx']
    item_id [name: 'tool_set_items_item_id_idx']
    (tool_set_id, item_id) [unique, name: 'tool_set_items_uq']
  }
  Checks {
    `quantity > 0`
  }
}

Table inventory.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  description text
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint
  Note: "Inventory module configuration key value store (ADR-0024 Q27)."
  Indexes {
    (setting_group, setting_key) [unique, name: 'inventory_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Table inventory.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "asset, stock_movement, stock_adjustment, borrowing, maintenance, disposal, tool_set."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the inventory module (ADR-0024 Q6). Absorbs the inventory and assets rows of code_number.series. Product and warehouse codes moved to product.code_numberings and warehouse.code_numberings (ADR-0026)."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: inventory.items.item_category_id > inventory.item_categories.id [delete: set null]
Ref: inventory.item_categories.parent_category_id > inventory.item_categories.id [delete: set null]
Ref: inventory.movements.item_id > inventory.items.id [delete: restrict]
Ref: inventory.stock_adjustment_items.stock_adjustment_id > inventory.stock_adjustments.id [delete: cascade]
Ref: inventory.borrowings.borrowing_request_id > inventory.borrowing_requests.id [delete: restrict]
Ref: inventory.borrowing_items.borrowing_request_id > inventory.borrowing_requests.id [delete: restrict]
Ref: inventory.borrowing_items.borrowing_id > inventory.borrowings.id [delete: cascade]
Ref: inventory.borrowing_items.item_id > inventory.items.id [delete: restrict]
Ref: inventory.borrowing_request_events.borrowing_request_id > inventory.borrowing_requests.id [delete: cascade]
Ref: inventory.borrowing_events.borrowing_id > inventory.borrowings.id [delete: cascade]
Ref: inventory.borrowing_events.borrowing_item_id > inventory.borrowing_items.id [delete: cascade]
Ref: inventory.maintenances.item_id > inventory.items.id [delete: cascade]
Ref: inventory.condition_checks.item_id > inventory.items.id [delete: cascade]
Ref: inventory.disposals.item_id > inventory.items.id [delete: restrict]
Ref: inventory.tool_set_items.tool_set_id > inventory.tool_sets.id [delete: cascade]
Ref: inventory.tool_set_items.item_id > inventory.items.id [delete: restrict]

// ---------------------------------------------------------------------------
// MODULE: Sale  (schema: sale, was sales). Quotation -> order -> delivery ->
// invoice -> receipt. Company-wide (ADR-0011): no organization_id on the
// quotation/order/delivery tables. `sales.payments` (legacy scaffold) is
// removed. Item references point at product.products; the person on a
// document is customer.customers (customer_contact_id is gone).
// ---------------------------------------------------------------------------

Table sale.quotations {
  id uuid [pk, default: `uuidv7()`]
  code varchar(40) [not null, note: "Base number from the numbering service, plus -R<n> for revision n >= 1. Unique among live rows (partial index in the Drizzle schema)."]
  base_code varchar(32) [not null, note: "Number shared by every revision of the same SPH."]
  revision integer [not null, default: 0, note: "0 = original, 1..n = revisions."]
  previous_revision_id uuid [note: "The revision this one replaced (now superseded)."]
  title text [not null, note: "Subject (Perihal)."]
  heading varchar(120) [note: "Title in the coloured bar of the printed SPH; null prints QUOTATION."]
  customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  company_id uuid [note: "Logical reference to customer.companies.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  customer_snapshot jsonb [not null, note: "Customer code, name, type, contacts, NPWP and address frozen at the last edit; printed instead of the live customer."]
  lead_id uuid [note: "Logical reference to project.leads.id. Cross-module FK intentionally omitted. Validated through the Project module contract."]
  attention varchar(200) [note: "Attention person (Up)."]
  status text [not null, default: 'draft']
  quotation_date date [not null]
  valid_until date [note: "Valid through the end of this Jakarta day. Expiry is shown, never a status."]
  payment_terms varchar(300)
  payment_schedule jsonb [note: "Planned billing terms [{label, percentBps}], shares summing to 10000. Null = billed in one term."]
  guarantee varchar(300)
  vat_enabled boolean [not null, default: true]
  vat_rate_bps integer [not null, default: 0, note: "VAT rate snapshot in basis points (1100 = 11%); 0 when VAT is off."]
  subtotal bigint [not null, default: 0]
  discount_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  notes text
  terms text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  approved_at bigint
  rejected_reason text
  sent_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  sent_at bigint
  closed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  closed_at bigint
  lost_reason text
  lost_note text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Quotation header (SPH), company-wide. draft -> submitted -> approved or rejected; approved -> sent; any open status -> lost; won only by creating its order; revising marks the row superseded and creates the next revision. Self approval is rejected by the service layer. Totals are a cache of the items."
  Indexes {
    base_code [name: 'quotations_base_code_idx']
    customer_id [name: 'quotations_customer_id_idx']
    company_id [name: 'quotations_company_id_idx']
    status [name: 'quotations_status_idx']
    created_by [name: 'quotations_created_by_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'sent', 'superseded', 'won', 'lost')`
    `lost_reason IS NULL OR lost_reason IN ('price', 'competitor', 'project_cancelled', 'no_response', 'other')`
    `revision >= 0`
    `vat_rate_bps >= 0 AND vat_rate_bps <= 10000`
    `subtotal >= 0`
    `discount_total >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
  }
}

Table sale.quotation_items {
  id uuid [pk, default: `uuidv7()`]
  quotation_id uuid [not null]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract. Null = custom line."]
  sku varchar(64)
  name text [not null, note: "Product name snapshot (printed bold)."]
  specification text [note: "Multi-line specification printed under the name."]
  image_object_key text [note: "Snapshot of the product photo when the line was priced."]
  unit varchar(32) [not null, note: "One of the fixed product units."]
  quantity numeric(18,3) [not null, default: 1]
  unit_price bigint [not null, default: 0]
  discount_amount bigint [not null, default: 0]
  line_total bigint [not null, default: 0, note: "round(quantity x unit_price) - discount_amount."]
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a quotation, company-wide like its header. Prices and names are snapshots; line total is derived, never trusted from the client."
  Indexes {
    (quotation_id, sort_order) [name: 'quotation_items_quotation_sort_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `discount_amount >= 0`
    `line_total >= 0`
  }
}

Table sale.quotation_status_history {
  id uuid [pk, default: `uuidv7()`]
  quotation_id uuid [not null]
  from_status text
  to_status text [not null]
  changed_by text [note: "Logical reference to auth.users.id."]
  changed_at bigint [not null]
  note text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Append-only status history of a quotation, company-wide. Written in the same transaction as the transition."
  Indexes {
    quotation_id [name: 'quotation_status_history_quotation_id_idx']
  }
}

Table sale.orders {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Unique among live rows (partial index in the Drizzle schema)."]
  quotation_id uuid [not null, note: "The SPH this order closed as Deal; one live order per SPH (partial unique index)."]
  quotation_code varchar(40) [not null]
  customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  company_id uuid [note: "Logical reference to customer.companies.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  lead_id uuid [note: "Logical reference to project.leads.id, copied from the SPH. Cross-module FK intentionally omitted. Validated through the Project module contract."]
  customer_snapshot jsonb [not null, note: "Customer data copied from the SPH."]
  customer_po_number varchar(100)
  title text [not null]
  attention varchar(200)
  status text [not null, default: 'confirmed']
  order_date date [not null]
  delivery_date date
  payment_terms varchar(300)
  payment_schedule jsonb [note: "Planned billing terms copied from the SPH; null = one term."]
  guarantee varchar(300)
  vat_enabled boolean [not null]
  vat_rate_bps integer [not null, default: 0]
  subtotal bigint [not null, default: 0]
  discount_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  sales_person_user_id text [note: "Logical reference to auth.users.id."]
  notes text
  created_by text [note: "Logical reference to auth.users.id."]
  cancelled_by text [note: "Logical reference to auth.users.id."]
  cancelled_at bigint
  cancellation_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Confirmed customer order (was sales.sales_orders), company-wide. Created only from an approved or sent quotation, which becomes won in the same transaction; cancelling it reopens the quotation. Stock commitment is done by Inventory through a logical reservation."
  Indexes {
    quotation_id [name: 'orders_quotation_id_idx']
    customer_id [name: 'orders_customer_id_idx']
    company_id [name: 'orders_company_id_idx']
    status [name: 'orders_status_idx']
    sales_person_user_id [name: 'orders_sales_person_idx']
  }
  Checks {
    `status IN ('confirmed', 'in_progress', 'delivered', 'completed', 'cancelled')`
    `vat_rate_bps >= 0 AND vat_rate_bps <= 10000`
    `subtotal >= 0`
    `discount_total >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
  }
}

Table sale.order_items {
  id uuid [pk, default: `uuidv7()`]
  order_id uuid [not null]
  quotation_item_id uuid [note: "The SPH line it was copied from."]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract. Null = custom line."]
  sku varchar(64)
  name text [not null]
  specification text
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null, default: 1]
  unit_price bigint [not null, default: 0]
  discount_amount bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  quantity_delivered numeric(18,3) [not null, default: 0]
  fulfillment_status text [not null, default: 'pending']
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a sales order, copied from its quotation line (was sales.sales_order_items)."
  Indexes {
    (order_id, sort_order) [name: 'order_items_order_sort_idx']
    fulfillment_status [name: 'order_items_fulfillment_status_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `discount_amount >= 0`
    `line_total >= 0`
    `quantity_delivered >= 0`
    `fulfillment_status IN ('pending', 'reserved', 'partial', 'fulfilled', 'cancelled')`
  }
}

Table sale.order_status_history {
  id uuid [pk, default: `uuidv7()`]
  order_id uuid [not null]
  from_status text
  to_status text [not null]
  changed_by text [note: "Logical reference to auth.users.id."]
  changed_at bigint [not null]
  note text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Append-only status history of a sales order, company-wide."
  Indexes {
    order_id [name: 'order_status_history_order_id_idx']
  }
}

Table sale.delivery_notes {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Assigned on creation (SJ). Unique among live rows (partial index in the Drizzle schema)."]
  order_id uuid [not null]
  warehouse_id uuid [note: "Logical reference to warehouse.warehouses.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract."]
  bin_id uuid [note: "Logical reference to warehouse.warehouse_storages.id. Cross-module FK intentionally omitted."]
  status text [not null, default: 'prepared']
  delivery_date date [not null, note: "Jakarta business date printed as Tanggal."]
  project_name text [note: "Nama Proyek; defaults to the order title."]
  project_location text
  recipient_name text [not null]
  recipient_address text
  recipient_pic varchar(200)
  recipient_contact varchar(200)
  driver_name varchar(200)
  vehicle_number varchar(32)
  notes text
  shipped_at bigint
  shipped_by text [note: "Logical reference to auth.users.id."]
  received_at bigint
  receiver_name text [note: "Who signed as Penerima."]
  cancelled_at bigint
  cancelled_by text [note: "Logical reference to auth.users.id."]
  cancellation_reason text
  created_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Delivery note (surat jalan), company-wide. Shipping posts one stock issue movement per stock-tracked line at the moving-average cost and marks the listed serial units sold, in one transaction through the Inventory module contract."
  Indexes {
    order_id [name: 'delivery_notes_order_id_idx']
    status [name: 'delivery_notes_status_idx']
  }
  Checks {
    `status IN ('prepared', 'shipped', 'delivered', 'cancelled')`
  }
}

Table sale.delivery_note_items {
  id uuid [pk, default: `uuidv7()`]
  delivery_note_id uuid [not null]
  order_item_id uuid [not null]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Null for a custom order line."]
  sku varchar(64)
  name text [not null]
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null]
  unit_price bigint [not null, default: 0, note: "Order unit price, printed as Harga (IDR minor units)."]
  unit_cost bigint [note: "Moving-average cost the issue movement took (IDR minor units); null until shipped or for non-stock lines."]
  serial_numbers jsonb [note: "One serial per unit for serialized products."]
  remarks text
  movement_id uuid [note: "Logical reference to inventory.movements.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a delivery note, copied from a sales order line."
  Indexes {
    delivery_note_id [name: 'delivery_note_items_delivery_note_id_idx']
    order_item_id [name: 'delivery_note_items_order_item_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
  }
}

Table sale.returns {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [note: "Assigned on approval, e.g. 0001/RTJ/IMS/XI/26; null before. Unique among live rows (partial index in the Drizzle schema)."]
  delivery_note_id uuid [not null, note: "The shipped delivery note the goods left on; every line returns one of its lines."]
  order_id uuid [not null, note: "The delivery note's order, copied for listing and re-opening."]
  customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  warehouse_id uuid [note: "Where the goods come back to; defaults to the delivery note's warehouse. Logical reference to warehouse.warehouses.id. Cross-module FK intentionally omitted."]
  status text [not null, default: 'draft']
  return_date date [not null]
  reason text [not null]
  notes text
  total_amount bigint [not null, default: 0, note: "Sum of the line totals at the order unit price (IDR minor units); informative, no credit memo."]
  currency_code varchar(3) [not null, default: 'IDR']
  rejection_reason text
  created_by text [note: "Logical reference to auth.users.id."]
  submitted_by text [note: "Logical reference to auth.users.id."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  received_by text [note: "Logical reference to auth.users.id."]
  received_at bigint
  cancelled_by text [note: "Logical reference to auth.users.id."]
  cancelled_at bigint
  cancelled_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Customer return for replacement (was sales.sales_returns), company-wide. draft -> submitted -> approved -> received; rejection returns to draft; cancelled before received. One-level approval, never by the creator. Receiving posts return_in stock movements at the delivery cost and puts the serial units back in stock or marks them damaged."
  Indexes {
    delivery_note_id [name: 'returns_delivery_note_id_idx']
    order_id [name: 'returns_order_id_idx']
    status [name: 'returns_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'received', 'cancelled')`
    `total_amount >= 0`
  }
}

Table sale.return_items {
  id uuid [pk, default: `uuidv7()`]
  return_id uuid [not null]
  delivery_note_item_id uuid [not null]
  order_item_id uuid [not null]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract."]
  sku varchar(64)
  name text [not null]
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null]
  unit_price bigint [not null, default: 0, note: "Order unit price (IDR minor units)."]
  unit_cost bigint [not null, default: 0, note: "The delivery line's issue cost; the return_in movement books it back."]
  line_total bigint [not null, default: 0, note: "round(quantity x unit_price)."]
  serial_numbers jsonb [note: "The returned units of a serialized product, from the delivery line."]
  condition text [note: "Set on receiving: good (sellable again) or damaged."]
  bin_id uuid [note: "Storage the line was received into. Logical reference to warehouse.warehouse_storages.id. Cross-module FK intentionally omitted."]
  movement_id uuid [note: "The return_in movement posted on receiving. Logical reference to inventory.movements.id. Cross-module FK intentionally omitted."]
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a sales return (was sales.sales_return_items). The quantity never exceeds the delivery line minus what live (not cancelled) returns already take."
  Indexes {
    return_id [name: 'return_items_return_id_idx']
    delivery_note_item_id [name: 'return_items_delivery_note_item_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `unit_cost >= 0`
    `line_total >= 0`
    `condition IS NULL OR condition IN ('good', 'damaged')`
  }
}

Table sale.invoices {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "The issuing organization. Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [note: "Allocated from the numbering authority (INV-<YYYYMM>-<#5>). Nullable: a draft may exist without a code. Unique per organization."]
  invoice_type text [not null, default: 'sales']
  term_kind text [note: "down_payment = first live invoice of its order that does not settle it; settlement = the one that settles it; installment otherwise."]
  customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  company_id uuid [note: "Logical reference to customer.companies.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  customer_snapshot jsonb [note: "Customer data copied from the sales order. Null when the invoice has no order."]
  order_id uuid [note: "Plain id of a row in sale.orders (same module). Nullable: proforma and recurring invoices may have no order."]
  project_id uuid [note: "Logical reference to project.projects.id. Cross-module FK intentionally omitted. Validated through the Project module contract. The live project of the order, stamped when the invoice is issued (ERP-0141)."]
  order_code varchar(32)
  quotation_code varchar(40) [note: "The SPH number printed as No. Ref."]
  title text [note: "Subject (Perihal), from the order."]
  description text [note: "Term label, e.g. DP 30% or Pelunasan."]
  percentage_bps integer [note: "Share of the order tax base when billed by percentage."]
  payment_term_id uuid [note: "Logical reference to finance.payment_terms.id. Cross-module FK intentionally omitted. Validated through the Finance module contract."]
  issue_date date
  due_date date
  vat_enabled boolean [not null, default: true]
  vat_rate_bps integer [not null, default: 0]
  subtotal bigint [not null, default: 0, note: "Tax base (DPP) of this term."]
  discount_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  paid_total bigint [not null, default: 0]
  outstanding_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  terms text
  notes text
  created_by text [note: "Logical reference to auth.users.id."]
  issued_by text [note: "Logical reference to auth.users.id."]
  issued_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  voided_by text [note: "Logical reference to auth.users.id."]
  voided_at bigint
  void_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Customer invoice (faktur) for one billing term, company-wide per ADR-0012: organization_id is the issuing organization. Free terms: the invoices of an order never exceed its total and the settling term takes the exact remainder. draft -> issued -> partially_paid -> paid; unpaid draft or issued -> void; draft -> cancelled. Overdue is shown from due_date, never stored. Finance mirrors AR open items in finance.ar_open_items."
  Indexes {
    (organization_id, code) [unique, name: 'invoices_org_code_uq']
    customer_id [name: 'invoices_customer_id_idx']
    company_id [name: 'invoices_company_id_idx']
    order_id [name: 'invoices_order_id_idx']
    status [name: 'invoices_status_idx']
    due_date [name: 'invoices_due_date_idx']
    term_kind [name: 'invoices_term_kind_idx']
  }
  Checks {
    `invoice_type IN ('sales', 'proforma', 'recurring')`
    `term_kind IS NULL OR term_kind IN ('down_payment', 'installment', 'settlement')`
    `status IN ('draft', 'issued', 'partially_paid', 'paid', 'written_off', 'void', 'cancelled')`
    `vat_rate_bps >= 0 AND vat_rate_bps <= 10000`
    `subtotal >= 0`
    `discount_total >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
    `paid_total >= 0 AND paid_total <= grand_total`
    `outstanding_total >= 0`
    `due_date IS NULL OR issue_date IS NULL OR due_date >= issue_date`
  }
}

Table sale.invoice_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  invoice_id uuid [not null]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract."]
  description text
  quantity numeric(18,4) [not null, default: 0]
  unit_price bigint [not null, default: 0]
  discount_amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  sort_order integer [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  service_period_start date [note: "Service period of a maintenance/subscription line (ERP-0135): when set, the line's revenue is deferred and amortised monthly over the period."]
  service_period_end date
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a sales invoice. item_variant_id and unit_id are dropped with the catalog schema (ADR-0024 Q14)."
  Indexes {
    invoice_id [name: 'invoice_items_invoice_id_idx']
    product_id [name: 'invoice_items_product_id_idx']
  }
  Checks {
    `quantity >= 0`
    `unit_price >= 0`
    `discount_amount >= 0`
    `tax_amount >= 0`
    `line_total >= 0`
    `(service_period_start IS NULL) = (service_period_end IS NULL)`
    `service_period_end IS NULL OR service_period_end >= service_period_start`
  }
}

Table sale.receipts {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  invoice_id uuid [not null, note: "Plain id of a row in sale.invoices (same module)."]
  payment_id uuid [note: "Logical reference to payment.payments.id. Cross-module FK intentionally omitted. Validated through the Payment module contract."]
  received_date date
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  method text [not null, default: 'bank_transfer']
  reference varchar(100)
  notes text
  status text [not null, default: 'draft']
  received_by text [note: "Logical reference to auth.users.id."]
  posted_at bigint
  reversed_by text [note: "Logical reference to auth.users.id."]
  reversed_at bigint
  reversal_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Cash receipt register, kwitansi. It is the customer facing proof of a payment; the money movement stays in payment.payments. Issued against a sales invoice; never more than the invoice's outstanding amount."
  Indexes {
    (organization_id, code) [unique, name: 'receipts_org_code_uq']
    invoice_id [name: 'receipts_invoice_id_idx']
    payment_id [name: 'receipts_payment_id_idx']
    status [name: 'receipts_status_idx']
  }
  Checks {
    `status IN ('draft', 'verified', 'posted', 'reversed', 'void')`
    `amount > 0`
    `method IN ('bank_transfer', 'cash', 'card', 'e_wallet', 'cheque')`
  }
}

Table sale.discount_requests {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  quotation_id uuid
  order_id uuid
  discount_type text [not null]
  discount_value numeric(18,4) [not null]
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  reason text
  status text [not null, default: 'requested']
  requested_by text [note: "Logical reference to auth.users.id."]
  requested_at bigint [not null]
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  rejected_reason text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target (ADR-0024 Q22). Discount request on a quotation or on an order. Exactly one parent is set."
  Indexes {
    quotation_id [name: 'discount_requests_quotation_id_idx']
    order_id [name: 'discount_requests_order_id_idx']
    status [name: 'discount_requests_status_idx']
  }
  Checks {
    `discount_type IN ('percentage', 'fixed')`
    `status IN ('requested', 'approved', 'rejected', 'cancelled')`
    `(quotation_id IS NOT NULL AND order_id IS NULL) OR (quotation_id IS NULL AND order_id IS NOT NULL)`
  }
}

Table sale.contracts {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted. Validated through the Customer module contract."]
  order_id uuid
  status text [not null, default: 'draft']
  contract_value bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  start_date date
  end_date date
  signed_on date
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted."]
  notes text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Commercial contract with a customer, the legal basis of the order and of the project."
  Indexes {
    (organization_id, code) [unique, name: 'contracts_org_code_uq']
    order_id [name: 'contracts_order_id_idx']
    customer_id [name: 'contracts_customer_id_idx']
  }
  Checks {
    `status IN ('draft', 'active', 'expired', 'terminated')`
    `contract_value >= 0`
  }
}

Table sale.targets {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  sales_user_id text [note: "Logical reference to auth.users.id."]
  period_year integer [not null]
  period_month integer
  target_amount bigint [not null, default: 0]
  achieved_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'active']
  assigned_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Sales target of a salesperson for a month or for a year (was sales.sales_targets)."
  Indexes {
    (organization_id, sales_user_id, period_year, period_month) [unique, name: 'targets_scope_uq']
  }
  Checks {
    `period_month IS NULL OR period_month BETWEEN 1 AND 12`
    `target_amount >= 0`
    `achieved_amount >= 0`
    `status IN ('active', 'closed', 'cancelled')`
  }
}

Table sale.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  description text
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Sale module configuration key value store."
  Indexes {
    (setting_group, setting_key) [unique, name: 'sale_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Table sale.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "quotation, order, delivery_note, invoice, receipt, return, web_rfq, web_contact, web_demo."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the sale module (ADR-0024 Q6). Absorbs the sales rows of code_number.series."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: sale.quotation_items.quotation_id > sale.quotations.id [delete: cascade]
Ref: sale.quotations.previous_revision_id > sale.quotations.id [delete: restrict]
Ref: sale.quotation_status_history.quotation_id > sale.quotations.id [delete: cascade]
Ref: sale.discount_requests.quotation_id > sale.quotations.id [delete: cascade]
Ref: sale.orders.quotation_id > sale.quotations.id [delete: restrict]
Ref: sale.order_items.order_id > sale.orders.id [delete: cascade]
Ref: sale.order_items.quotation_item_id > sale.quotation_items.id [delete: restrict]
Ref: sale.discount_requests.order_id > sale.orders.id [delete: cascade]
Ref: sale.contracts.order_id > sale.orders.id [delete: set null]
Ref: sale.order_status_history.order_id > sale.orders.id [delete: cascade]
Ref: sale.returns.order_id > sale.orders.id [delete: restrict]
Ref: sale.returns.delivery_note_id > sale.delivery_notes.id [delete: restrict]
Ref: sale.return_items.return_id > sale.returns.id [delete: cascade]
Ref: sale.return_items.delivery_note_item_id > sale.delivery_note_items.id [delete: restrict]
Ref: sale.return_items.order_item_id > sale.order_items.id [delete: restrict]
Ref: sale.delivery_notes.order_id > sale.orders.id [delete: restrict]
Ref: sale.delivery_note_items.delivery_note_id > sale.delivery_notes.id [delete: cascade]
Ref: sale.delivery_note_items.order_item_id > sale.order_items.id [delete: restrict]
Ref: sale.invoice_items.invoice_id > sale.invoices.id [delete: cascade]
Ref: sale.receipts.invoice_id > sale.invoices.id [delete: restrict]

// ---------------------------------------------------------------------------
// MODULE: Procurement  (schema: procurement). Purchase requests, orders, goods
// receipts and purchase returns. Company-wide (ADR-0011). The supplier master
// moved to the `supplier` schema (ADR-0024 Q17), so supplier columns are
// logical references there and the intra-schema supplier FK is gone.
// ---------------------------------------------------------------------------

Table procurement.purchase_requests {
  id uuid [pk, default: `uuidv7()`]
  code varchar(40) [note: "Assigned on submit from the numbering authority (e.g. 0001/PR/IMS/XI/26); null for a draft. Unique among live rows."]
  organization_id text [note: "The requester's active organization, for information only: purchase requests are company-wide. Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  requested_by text [note: "Logical reference to auth.users.id."]
  requested_by_name varchar(120)
  subject varchar(200) [not null]
  justification text
  project_name varchar(200)
  request_date date [not null]
  needed_by date
  status text [not null, default: 'draft']
  estimated_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  rejection_reason text
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  cancelled_by text [note: "Logical reference to auth.users.id."]
  cancelled_at bigint
  cancelled_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Purchase request (PR), the approval gate before a purchase order, company-wide. draft -> submitted -> approved -> ordered; rejection returns to draft with the reason. One-level approval, never by the requester."
  Indexes {
    code [unique, name: 'purchase_requests_code_uq', note: 'WHERE deleted_at IS NULL AND code IS NOT NULL']
    status [name: 'purchase_requests_status_idx']
    requested_by [name: 'purchase_requests_requested_by_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'ordered', 'cancelled')`
    `estimated_total >= 0`
    `needed_by IS NULL OR needed_by >= request_date`
  }
}

Table procurement.purchase_request_items {
  id uuid [pk, default: `uuidv7()`]
  purchase_request_id uuid [not null]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract. Null for a free-text line."]
  sku varchar(64)
  name text [not null]
  specification text
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null, default: 1]
  estimated_unit_price bigint [not null, default: 0]
  estimated_total bigint [not null, default: 0]
  notes text
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a purchase request, company-wide like its header. It is ordered when a live purchase order line references it."
  Indexes {
    (purchase_request_id, sort_order) [name: 'purchase_request_items_request_sort_idx']
  }
  Checks {
    `quantity > 0`
    `estimated_unit_price >= 0`
    `estimated_total >= 0`
  }
}

Table procurement.purchase_orders {
  id uuid [pk, default: `uuidv7()`]
  code varchar(40) [note: "Assigned on approval, e.g. PO/IMS-HIT/HW/1026/001; null before. Unique among live rows."]
  supplier_company_id uuid [note: "Logical reference to supplier.companies.id. Cross-module FK intentionally omitted. Validated through the Supplier module contract."]
  supplier_pic_id uuid [note: "Logical reference to supplier.suppliers.id. Cross-module FK intentionally omitted. Validated through the Supplier module contract."]
  supplier_snapshot jsonb [not null, note: "Supplier name, address, NPWP and PIC printed on the PO."]
  category text [not null, note: "{CATEGORY} token of the number: hardware HW, software SW, service JS, other LN."]
  subject varchar(200) [not null]
  status text [not null, default: 'draft']
  order_date date [not null]
  expected_delivery_date date
  supplier_quote_ref varchar(100)
  supplier_quote_date date
  project_name varchar(200)
  buyer_pic_name varchar(120)
  vat_mode text [not null, default: 'none', note: "none, included (prices contain VAT) or added (VAT on top)."]
  vat_rate_bps integer [not null, default: 0]
  subtotal bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  payment_terms varchar(500)
  terms text
  notes text
  rejection_reason text
  created_by text [note: "Logical reference to auth.users.id."]
  submitted_by text [note: "Logical reference to auth.users.id."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  sent_by text [note: "Logical reference to auth.users.id."]
  sent_at bigint
  cancelled_by text [note: "Logical reference to auth.users.id."]
  cancelled_at bigint
  cancelled_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Purchase order to a supplier, company-wide. draft -> submitted -> approved -> sent -> partially_received -> received; rejection returns to draft; cancelled while nothing was received. One-level approval, never by the creator. The supplier bill and its payment stay in Finance."
  Indexes {
    supplier_company_id [name: 'purchase_orders_supplier_company_id_idx']
    status [name: 'purchase_orders_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'sent', 'partially_received', 'received', 'cancelled')`
    `category IN ('hardware', 'software', 'service', 'other')`
    `vat_mode IN ('none', 'included', 'added')`
    `vat_rate_bps >= 0 AND vat_rate_bps <= 10000`
    `subtotal >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
  }
}

Table procurement.purchase_order_items {
  id uuid [pk, default: `uuidv7()`]
  purchase_order_id uuid [not null]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract."]
  sku varchar(64) [not null]
  name text [not null]
  specification text
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null, default: 1]
  unit_price bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  quantity_received numeric(18,3) [not null, default: 0]
  purchase_request_item_id uuid [note: "The purchase request line this line orders (same module). At most one live purchase order line per request line, enforced under a row lock by the service."]
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a purchase order, company-wide like its header. VAT is per purchase order."
  Indexes {
    (purchase_order_id, sort_order) [name: 'purchase_order_items_order_sort_idx']
    purchase_request_item_id [name: 'purchase_order_items_purchase_request_item_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `line_total >= 0`
    `quantity_received >= 0`
  }
}

Table procurement.goods_receipts {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Assigned on creation (BPB). Unique among live rows."]
  purchase_order_id uuid [not null]
  warehouse_id uuid [note: "Logical reference to warehouse.warehouses.id. Cross-module FK intentionally omitted. Validated through the Warehouse module contract."]
  bin_id uuid [note: "Logical reference to warehouse.warehouse_storages.id. Cross-module FK intentionally omitted."]
  status text [not null, default: 'posted']
  receipt_date date [not null]
  supplier_delivery_ref varchar(100)
  received_by text [note: "Logical reference to auth.users.id."]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Goods receipt note, company-wide. Posted on creation: the stock receipt movements (with unit cost) and serial units are written in the same transaction through the Inventory module contract. Immutable; corrections go through stock adjustments."
  Indexes {
    purchase_order_id [name: 'goods_receipts_purchase_order_id_idx']
    warehouse_id [name: 'goods_receipts_warehouse_id_idx']
  }
  Checks {
    `status IN ('posted')`
  }
}

Table procurement.goods_receipt_items {
  id uuid [pk, default: `uuidv7()`]
  goods_receipt_id uuid [not null]
  purchase_order_item_id uuid [not null]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted."]
  sku varchar(64) [not null]
  name text [not null]
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null]
  unit_cost bigint [not null, default: 0, note: "Ex-VAT unit price booked into stock (IDR minor units)."]
  serial_numbers jsonb [note: "One serial per unit for serialized products."]
  movement_id uuid [note: "Logical reference to inventory.movements.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a goods receipt; its quantity became the stock receipt movement."
  Indexes {
    goods_receipt_id [name: 'goods_receipt_items_goods_receipt_id_idx']
    purchase_order_item_id [name: 'goods_receipt_items_purchase_order_item_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_cost >= 0`
  }
}

Table procurement.purchase_returns {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [note: "Assigned on approval, e.g. 0001/RTB/IMS/XI/26; null before. Unique among live rows."]
  goods_receipt_id uuid [not null, note: "The BPB the goods came in on; every line returns one of its lines."]
  purchase_order_id uuid [not null, note: "The goods receipt's purchase order, copied for listing and re-opening."]
  supplier_company_id uuid [note: "Logical reference to supplier.companies.id. Cross-module FK intentionally omitted. Validated through the Supplier module contract."]
  warehouse_id uuid [note: "The goods receipt's warehouse; stock leaves from here. Logical reference to warehouse.warehouses.id. Cross-module FK intentionally omitted."]
  bin_id uuid [note: "The goods receipt's storage. Logical reference to warehouse.warehouse_storages.id. Cross-module FK intentionally omitted."]
  status text [not null, default: 'draft']
  return_date date [not null]
  reason text [not null]
  notes text
  total_amount bigint [not null, default: 0, note: "Sum of the line totals at receipt cost (IDR minor units); informative, no journal."]
  currency_code varchar(3) [not null, default: 'IDR']
  rejection_reason text
  created_by text [note: "Logical reference to auth.users.id."]
  submitted_by text [note: "Logical reference to auth.users.id."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  shipped_by text [note: "Logical reference to auth.users.id."]
  shipped_at bigint
  cancelled_by text [note: "Logical reference to auth.users.id."]
  cancelled_at bigint
  cancelled_reason text
  journal_entry_id uuid [note: "Logical reference to finance.journal_entries.id. Cross-module FK intentionally omitted. Validated through the Finance module contract. The Dr GR/IR / Cr inventory journal posted when the return shipped (ERP-0136)."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Return of received goods to the supplier for replacement, company-wide like goods receipts. draft -> submitted -> approved -> shipped; rejection returns to draft; cancelled before shipped. One-level approval, never by the creator. Shipping posts return_out stock movements and marks the serial units returned."
  Indexes {
    goods_receipt_id [name: 'purchase_returns_goods_receipt_id_idx']
    purchase_order_id [name: 'purchase_returns_purchase_order_id_idx']
    status [name: 'purchase_returns_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'shipped', 'cancelled')`
    `total_amount >= 0`
  }
}

Table procurement.purchase_return_items {
  id uuid [pk, default: `uuidv7()`]
  purchase_return_id uuid [not null]
  goods_receipt_item_id uuid [not null]
  purchase_order_item_id uuid [not null]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted."]
  sku varchar(64) [not null]
  name text [not null]
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null]
  unit_cost bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  serial_numbers jsonb [note: "The returned units of a serialized product, from the goods receipt line."]
  movement_id uuid [note: "The return_out movement posted on shipping. Logical reference to inventory.movements.id. Cross-module FK intentionally omitted."]
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a purchase return. The quantity never exceeds the goods receipt line minus what live (not cancelled) returns already take."
  Indexes {
    purchase_return_id [name: 'purchase_return_items_purchase_return_id_idx']
    goods_receipt_item_id [name: 'purchase_return_items_goods_receipt_item_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_cost >= 0`
    `line_total >= 0`
  }
}

Table procurement.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "purchase_request, purchase_order, goods_receipt, purchase_return."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the procurement module (ADR-0024 Q6)."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Ref: procurement.purchase_request_items.purchase_request_id > procurement.purchase_requests.id [delete: cascade]
Ref: procurement.purchase_order_items.purchase_request_item_id > procurement.purchase_request_items.id [delete: restrict]
Ref: procurement.purchase_order_items.purchase_order_id > procurement.purchase_orders.id [delete: cascade]
Ref: procurement.goods_receipts.purchase_order_id > procurement.purchase_orders.id [delete: restrict]
Ref: procurement.goods_receipt_items.goods_receipt_id > procurement.goods_receipts.id [delete: cascade]
Ref: procurement.goods_receipt_items.purchase_order_item_id > procurement.purchase_order_items.id [delete: restrict]
Ref: procurement.purchase_returns.goods_receipt_id > procurement.goods_receipts.id [delete: restrict]
Ref: procurement.purchase_returns.purchase_order_id > procurement.purchase_orders.id [delete: restrict]
Ref: procurement.purchase_return_items.purchase_return_id > procurement.purchase_returns.id [delete: cascade]
Ref: procurement.purchase_return_items.goods_receipt_item_id > procurement.goods_receipt_items.id [delete: restrict]
Ref: procurement.purchase_return_items.purchase_order_item_id > procurement.purchase_order_items.id [delete: restrict]

// ---------------------------------------------------------------------------
// MODULE: Finance  (schema: finance; absorbs `accounting`). General ledger,
// periods, cash/bank, supplier bills, AR/AP open items and asset depreciation.
// `accounting_settings` becomes finance.settings; `company.bank_accounts` is
// merged into finance.cash_bank_accounts; asset_depreciations moves here from
// the assets schema (ADR-0024 Q19). Salary stays in human_resource (Q39).
// ---------------------------------------------------------------------------

Table finance.chart_of_accounts {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  account_type text [not null]
  normal_balance text [not null, default: 'debit']
  parent_account_id uuid
  level integer [not null, default: 1]
  is_postable boolean [not null, default: true]
  is_system boolean [not null, default: false]
  is_active boolean [not null, default: true]
  cash_flow_category text [note: "Direct-method cash-flow mapping. Only set for accounts whose movement feeds the cash-flow statement."]
  description text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Chart of accounts (was accounting.chart_of_accounts). Only postable accounts accept journal lines. System accounts cannot be deleted."
  Indexes {
    (organization_id, code) [unique, name: 'chart_of_accounts_org_code_uq']
    parent_account_id [name: 'chart_of_accounts_parent_account_id_idx']
    account_type [name: 'chart_of_accounts_account_type_idx']
  }
  Checks {
    `account_type IN ('asset', 'liability', 'equity', 'revenue', 'expense')`
    `normal_balance IN ('debit', 'credit')`
    `cash_flow_category IS NULL OR cash_flow_category IN ('operating', 'investing', 'financing')`
    `level >= 1`
  }
}

Table finance.accounting_periods {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  period_year integer [not null]
  period_month integer [not null]
  start_date date [not null]
  end_date date [not null]
  status text [not null, default: 'open']
  closed_by text [note: "Logical reference to auth.users.id."]
  closed_at bigint
  reopened_by text [note: "Logical reference to auth.users.id."]
  reopened_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Accounting period (was accounting.accounting_periods). A closed period rejects new journal entries."
  Indexes {
    (organization_id, code) [unique, name: 'accounting_periods_org_code_uq']
    (organization_id, period_year, period_month) [unique, name: 'accounting_periods_period_uq']
  }
  Checks {
    `period_month BETWEEN 1 AND 12`
    `end_date >= start_date`
    `status IN ('open', 'closed', 'locked')`
  }
}

Table finance.journal_entries {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [note: "Journal number, assigned at posting (JE series). Null while a manual entry is draft/submitted/void (ERP-0129)."]
  accounting_period_id uuid [not null]
  entry_date date [not null]
  description text
  source_type text
  source_id text
  idempotency_key text [note: "Posting-service idempotency: a second posted entry with the same (organization_id, idempotency_key) is refused. Null keys skip the rule."]
  source_module text [not null, default: 'finance', note: "Producing module, guarded by the posting service. Other modules never write journal rows directly."]
  event_type text [note: "Business event that produced the entry through postBusinessEvent (e.g. sale.invoice_issued); null for manual journals and explicit-account postings (ERP-0128)."]
  is_adjusting boolean [not null, default: false, note: "Manual adjusting entry: the only kind a soft-closed period accepts (ERP-0130)."]
  status text [not null, default: 'draft']
  total_debit bigint [not null, default: 0]
  total_credit bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  prepared_by text [note: "Logical reference to auth.users.id."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  posted_by text [note: "Logical reference to auth.users.id."]
  posted_at bigint
  reversed_by_entry_id uuid
  reverses_entry_id uuid [note: "On a reversal: the original entry it mirrors (ERP-0129)."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Journal header (was accounting.journal_entries). Debit must equal credit; the posting service enforces it inside one transaction. Manual entries: draft -> submitted -> approved/posted with maker-checker; reports sum posted and reversed entries."
  Indexes {
    (organization_id, code) [unique, name: 'journal_entries_org_code_uq']
    accounting_period_id [name: 'journal_entries_period_id_idx']
    status [name: 'journal_entries_status_idx']
    entry_date [name: 'journal_entries_entry_date_idx']
    source_type [name: 'journal_entries_source_type_idx']
    source_id [name: 'journal_entries_source_id_idx']
    reverses_entry_id [name: 'journal_entries_reverses_entry_id_idx']
    (organization_id, idempotency_key) [unique, name: 'journal_entries_idempotency_uq', note: "WHERE idempotency_key IS NOT NULL AND status <> 'void'"]
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'posted', 'reversed', 'void')`
    `total_debit >= 0`
    `total_credit >= 0`
    `total_debit = total_credit`
    `source_module IN ('finance', 'sale', 'procurement', 'inventory', 'payment', 'tax', 'human_resource', 'project')`
    `code IS NOT NULL OR status IN ('draft', 'submitted', 'approved', 'void')`
    `currency_code = 'IDR'`
  }
}

Table finance.journal_lines {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  journal_entry_id uuid [not null]
  line_no integer [not null]
  account_id uuid [not null]
  debit bigint [not null, default: 0]
  credit bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  description text
  cost_center_id uuid [note: "Same-schema reference to finance.cost_centers.id (ERP-0127); the posting service rejects unknown or inactive cost centres."]
  project_id uuid [note: "Logical reference to project.projects.id. Cross-module FK intentionally omitted. Validated through the Project module contract."]
  party_type text
  party_id text
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract by the source module before it posts (ERP-0128)."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Journal line (was accounting.journal_lines). Exactly one of debit and credit is positive. Dimensions: cost centre, project, party, product."
  Indexes {
    journal_entry_id [name: 'journal_lines_entry_id_idx']
    account_id [name: 'journal_lines_account_id_idx']
    cost_center_id [name: 'journal_lines_cost_center_id_idx']
    project_id [name: 'journal_lines_project_id_idx']
    (journal_entry_id, line_no) [unique, name: 'journal_lines_line_no_uq', note: "WHERE deleted_at IS NULL (draft lines are replaced by soft delete)"]
  }
  Checks {
    `debit >= 0`
    `credit >= 0`
    `(debit > 0 AND credit = 0) OR (credit > 0 AND debit = 0)`
    `currency_code = 'IDR'`
  }
}

Table finance.opening_balances {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  account_id uuid [not null]
  as_of_date date [not null]
  debit_balance bigint [not null, default: 0]
  credit_balance bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  description text
  posted_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Opening balance of an account at the start of the system (was accounting.opening_balances)."
  Indexes {
    (account_id, as_of_date) [unique, name: 'opening_balances_account_date_uq']
  }
  Checks {
    `debit_balance >= 0`
    `credit_balance >= 0`
    `currency_code = 'IDR'`
  }
}

Table finance.account_balances {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  account_id uuid [not null]
  accounting_period_id uuid [not null]
  balance_date date [not null]
  debit_total bigint [not null, default: 0]
  credit_total bigint [not null, default: 0]
  closing_balance bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  calculated_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Balance snapshot of an account at the end of a period, derived from the posted journal entries (was accounting.account_balances)."
  Indexes {
    (account_id, accounting_period_id) [unique, name: 'account_balances_account_period_uq']
  }
  Checks {
    `debit_total >= 0`
    `credit_total >= 0`
    `currency_code = 'IDR'`
  }
}

Table finance.cost_centers {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  parent_cost_center_id uuid
  is_active boolean [not null, default: true]
  description text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Cost centre for cost accounting and management reports (ERP-0127). Finance-owned: the organization schema's departments are gone (ADR-0024 Q4)."
  Indexes {
    (organization_id, code) [unique, name: 'cost_centers_org_code_uq', note: "WHERE deleted_at IS NULL"]
    parent_cost_center_id [name: 'cost_centers_parent_id_idx']
  }
}

Table finance.posting_rules {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  event_type text [not null, default: '*', note: "Business event (e.g. sale.invoice_issued) or '*' for any event."]
  role text [not null, note: "Semantic posting role (receivable, revenue, vat_output, payable, expense, vat_input, inventory, claim_payable, ...); vocabulary guarded by POSTING_ROLES in application code."]
  discriminator_type text [not null, default: '', note: "Optional refinement; '' means none."]
  discriminator_value text [not null, default: '', note: "Id or code the discriminator matches; '' when discriminator_type is ''."]
  account_id uuid [not null]
  is_active boolean [not null, default: true]
  description text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Account determination for postBusinessEvent (ERP-0128, ADR-0030). Resolution order: event+discriminator, event, '*'+discriminator, '*'. A missing rule fails the posting."
  Indexes {
    (organization_id, event_type, role, discriminator_type, discriminator_value) [unique, name: 'posting_rules_scope_uq', note: "WHERE deleted_at IS NULL"]
    account_id [name: 'posting_rules_account_id_idx']
  }
  Checks {
    `discriminator_type IN ('', 'product_category', 'tax', 'cash_bank_account', 'expense_category', 'asset_category', 'cost_category', 'payment_method')`
    `(discriminator_type = '') = (discriminator_value = '')`
  }
}

Table finance.deferred_revenue_schedules {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  invoice_id uuid [note: "Logical reference to sale.invoices.id. Cross-module FK intentionally omitted. Validated through the Sale module contract."]
  invoice_item_id uuid [note: "Logical reference to sale.invoice_items.id. Cross-module FK intentionally omitted. Validated through the Sale module contract."]
  issue_entry_id uuid [note: "Same-schema reference to the invoice journal that credited deferred revenue."]
  discriminator_type text [not null, default: '', note: "Revenue posting-rule discriminator carried to each amortisation (e.g. product_category)."]
  discriminator_value text [not null, default: '']
  total_amount bigint [not null]
  recognized_amount bigint [not null, default: 0]
  start_date date [not null]
  end_date date [not null]
  recognized_through varchar(7) [note: "Last month (YYYY-MM) amortised; null before the first run."]
  status text [not null, default: 'active']
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Deferred revenue of one invoice line with a service period (ERP-0135). The monthly run posts Dr deferred revenue / Cr revenue straight-line per calendar month, idempotent per schedule and month; voiding the invoice cancels the schedule and reverses its amortisations."
  Indexes {
    invoice_id [name: 'deferred_revenue_schedules_invoice_id_idx']
    status [name: 'deferred_revenue_schedules_status_idx']
  }
  Checks {
    `status IN ('active', 'completed', 'cancelled')`
    `total_amount > 0`
    `recognized_amount >= 0 AND recognized_amount <= total_amount`
    `end_date >= start_date`
  }
}

Table finance.bank_account_links {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cash_bank_account_id uuid [not null, note: "Same-schema reference to finance.cash_bank_accounts.id."]
  chart_of_account_id uuid [not null]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Links a cash or bank account to its general ledger account (was accounting.bank_account_links). Both ends are in this schema now (ADR-0024 Q19)."
  Indexes {
    cash_bank_account_id [unique, name: 'bank_account_links_cash_bank_account_id_uq']
    chart_of_account_id [name: 'bank_account_links_chart_of_account_id_idx']
  }
}

Table finance.report_archives {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  period_year integer [not null]
  period_month integer [not null]
  report_type text [not null]
  payload jsonb [not null]
  generated_by text [note: "Logical reference to auth.users.id."]
  generated_at bigint [not null]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Immutable snapshot of a financial statement for a closed month (was accounting.report_archives). Append-only in practice: no update or delete route exists, and a reopened period is re-archived - the unique index keeps the write idempotent."
  Indexes {
    (organization_id, period_year, period_month, report_type) [unique, name: 'report_archives_scope_uq']
  }
  Checks {
    `period_month BETWEEN 1 AND 12`
    `report_type IN ('profit_and_loss', 'balance_sheet', 'cash_flow')`
  }
}

Table finance.payment_terms {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  days integer [not null, default: 0]
  discount_percent numeric(5,2)
  discount_days integer
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Payment terms, for example cash on delivery or 30 days net."
  Indexes {
    (organization_id, code) [unique, name: 'payment_terms_org_code_uq']
  }
  Checks {
    `days >= 0`
    `discount_percent IS NULL OR (discount_percent >= 0 AND discount_percent <= 100)`
  }
}

Table finance.cash_bank_accounts {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  account_type text [not null, default: 'bank']
  bank_name text
  bank_code varchar(20)
  branch_name varchar(100)
  account_number text
  account_holder text
  currency_code varchar(3) [not null, default: 'IDR']
  opening_balance bigint [not null, default: 0]
  current_balance bigint [not null, default: 0, note: "Denormalized running balance, maintained transactionally by the service."]
  invoice_usage text [note: "Account printed on invoices with VAT (vat) or without VAT (non_vat); null for other accounts. Came from company.bank_accounts."]
  employee_id uuid [note: "Logical reference to human_resource.employees.id. Cross-module FK intentionally omitted. Validated through the Human Resource module contract (ExportedEmployeeService.findEmployeeById). Set on an employee's salary payee account (ERP-0119); NULL on every company cash or bank account, and every treasury query filters employee_id IS NULL."]
  is_primary boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Operational cash and bank account used by the payment ledger, by reconciliation and by document printing. Merged from finance.cash_bank_accounts and company.bank_accounts (ADR-0024 Q19): the company master columns (bank_code, branch_name, invoice_usage, is_primary) live here now. A row with employee_id is an employee's salary payee account (ERP-0119): bank or ewallet, never a balance, never printed on invoices, one primary per employee."
  Indexes {
    (organization_id, code) [unique, name: 'cash_bank_accounts_org_code_uq']
    account_number [name: 'cash_bank_accounts_account_number_idx']
    employee_id [name: 'cash_bank_accounts_employee_id_idx']
    employee_id [unique, name: 'cash_bank_accounts_employee_primary_uq', note: 'WHERE is_primary AND employee_id IS NOT NULL AND deleted_at IS NULL']
  }
  Checks {
    `account_type IN ('cash', 'bank', 'ewallet', 'clearing')`
    `opening_balance >= 0`
    `invoice_usage IS NULL OR invoice_usage IN ('vat', 'non_vat')`
    `employee_id IS NULL OR (account_type IN ('bank', 'ewallet') AND opening_balance = 0 AND current_balance = 0 AND invoice_usage IS NULL)`
    `currency_code = 'IDR'`
  }
}

Table finance.cash_bank_transactions {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  cash_bank_account_id uuid [not null]
  transaction_date date [not null]
  direction text [not null]
  amount bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  source_type text
  source_id text
  description text
  reference_number text
  status text [not null, default: 'posted']
  balance_after bigint [not null, default: 0]
  posted_by text [note: "Logical reference to auth.users.id."]
  posted_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Movement on a cash or bank account, produced by a posted payment. Reconciliation works on this ledger."
  Indexes {
    (organization_id, code) [unique, name: 'cash_bank_transactions_org_code_uq']
    cash_bank_account_id [name: 'cash_bank_transactions_account_id_idx']
    transaction_date [name: 'cash_bank_transactions_date_idx']
    (source_type, source_id) [name: 'cash_bank_transactions_source_idx']
  }
  Checks {
    `direction IN ('in', 'out')`
    `status IN ('draft', 'posted', 'reversed')`
    `amount > 0`
    `currency_code = 'IDR'`
  }
}

Table finance.bank_reconciliations {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  cash_bank_account_id uuid [not null]
  reconciliation_date date [not null]
  statement_balance bigint [not null, default: 0]
  book_balance bigint [not null, default: 0]
  difference bigint [not null, default: 0]
  status text [not null, default: 'draft']
  reconciled_by text [note: "Logical reference to auth.users.id."]
  reconciled_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Reconciliation of one bank statement against the book balance."
  Indexes {
    (organization_id, code) [unique, name: 'bank_reconciliations_org_code_uq']
    cash_bank_account_id [name: 'bank_reconciliations_account_id_idx']
    reconciliation_date [name: 'bank_reconciliations_date_idx']
  }
  Checks {
    `status IN ('draft', 'in_progress', 'reconciled', 'closed')`
  }
}

Table finance.bank_reconciliation_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  bank_reconciliation_id uuid [not null]
  cash_bank_transaction_id uuid
  statement_reference text
  statement_amount bigint
  is_matched boolean [not null, default: false]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a reconciliation, matched against a book transaction."
  Indexes {
    bank_reconciliation_id [name: 'bank_reconciliation_items_reconciliation_id_idx']
    cash_bank_transaction_id [name: 'bank_reconciliation_items_transaction_id_idx']
  }
}

Table finance.supplier_bills {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  supplier_company_id uuid [note: "Logical reference to supplier.companies.id. Cross-module FK intentionally omitted. Validated through the Supplier module contract."]
  purchase_order_id uuid [note: "Logical reference to procurement.purchase_orders.id. Cross-module FK intentionally omitted. Validated through the Procurement module contract."]
  supplier_invoice_number varchar(100) [note: "The supplier's own invoice number the bill was matched to (ERP-0012)."]
  bill_date date
  due_date date
  subtotal bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  paid_total bigint [not null, default: 0]
  outstanding_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Accounts payable document of a supplier. Payments are rows of payment.payments. A bill made from a purchase order carries lines in finance.supplier_bill_items and can never bill more than was received."
  Indexes {
    (organization_id, code) [unique, name: 'supplier_bills_org_code_uq']
    supplier_company_id [name: 'supplier_bills_supplier_company_id_idx']
    purchase_order_id [name: 'supplier_bills_purchase_order_id_idx']
    status [name: 'supplier_bills_status_idx']
    due_date [name: 'supplier_bills_due_date_idx']
  }
  Checks {
    `status IN ('draft', 'approved', 'partially_paid', 'paid', 'overdue', 'void')`
    `subtotal >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
    `paid_total >= 0`
    `outstanding_total >= 0`
    `currency_code = 'IDR'`
  }
}

Table finance.supplier_bill_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  supplier_bill_id uuid [not null]
  purchase_order_item_id uuid [note: "Logical reference to procurement.purchase_order_items.id. Cross-module FK intentionally omitted."]
  product_id uuid [note: "Logical reference to product.products.id. Cross-module FK intentionally omitted. Validated through the Product module contract."]
  name text [not null]
  unit varchar(32) [not null]
  quantity numeric(18,3) [not null]
  unit_price bigint [not null, default: 0, note: "The purchase order unit price (IDR minor units), VAT as the order states it."]
  line_total bigint [not null, default: 0, note: "round(quantity x unit_price)."]
  tax_base bigint [not null, default: 0, note: "Ex-VAT part of the line total (IDR minor units); what the line debits."]
  is_stock boolean [not null, default: false, note: "Stock-tracked product: the line clears GR/IR instead of debiting expense."]
  grir_amount bigint [not null, default: 0, note: "Value the goods receipt credited to GR/IR for these units (quantity x ex-VAT receipt cost, ERP-0136); tax_base - grir_amount is the purchase price variance."]
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a supplier bill made from a purchase order (ERP-0012). Per purchase order line, live (not void) bill lines never exceed the quantity received."
  Indexes {
    supplier_bill_id [name: 'supplier_bill_items_supplier_bill_id_idx']
    purchase_order_item_id [name: 'supplier_bill_items_purchase_order_item_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `line_total >= 0`
    `tax_base >= 0`
  }
}

Table finance.ar_open_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  invoice_id uuid [note: "Logical reference to sale.invoices.id. Cross-module FK intentionally omitted. Validated through the Sale module contract."]
  customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted."]
  invoice_date date
  due_date date
  original_amount bigint [not null]
  paid_amount bigint [not null, default: 0]
  outstanding_amount bigint [not null]
  adjusted_amount bigint [not null, default: 0, note: "Credit memos and write-offs taken off the invoice amount (ERP-0135); original_amount is already net of it."]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'open']
  write_off_reason text
  write_off_requested_by text [note: "Logical reference to auth.users.id."]
  write_off_requested_at bigint
  written_off_by text [note: "Logical reference to auth.users.id. Must differ from write_off_requested_by (maker-checker)."]
  written_off_at bigint
  write_off_entry_id uuid
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Accounts receivable open-item sub-ledger. Finance's own mirror of what is still owed per issued invoice, updated through the posting flow - never computed by reading sale tables. Aging reports are built on this table. No deleted_at: the row is a running balance cleared by status (projection exemption)."
  Indexes {
    (organization_id, invoice_id) [unique, name: 'ar_open_items_org_invoice_uq']
    customer_id [name: 'ar_open_items_customer_id_idx']
    status [name: 'ar_open_items_status_idx']
    due_date [name: 'ar_open_items_due_date_idx']
  }
  Checks {
    `status IN ('open', 'partially_paid', 'paid', 'written_off', 'void')`
    `original_amount >= 0`
    `paid_amount >= 0`
    `outstanding_amount >= 0`
    `adjusted_amount >= 0`
    `outstanding_amount = original_amount - paid_amount`
    `currency_code = 'IDR'`
  }
}

Table finance.ap_open_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  supplier_bill_id uuid [not null, note: "Same-schema reference to finance.supplier_bills.id."]
  supplier_company_id uuid [note: "Logical reference to supplier.companies.id. Cross-module FK intentionally omitted."]
  bill_date date
  due_date date
  original_amount bigint [not null]
  paid_amount bigint [not null, default: 0]
  outstanding_amount bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'open']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Accounts payable open-item sub-ledger, the AP twin of finance.ar_open_items. No deleted_at: the row is a running balance cleared by status (projection exemption)."
  Indexes {
    (organization_id, supplier_bill_id) [unique, name: 'ap_open_items_org_bill_uq']
    supplier_company_id [name: 'ap_open_items_supplier_company_id_idx']
    status [name: 'ap_open_items_status_idx']
    due_date [name: 'ap_open_items_due_date_idx']
  }
  Checks {
    `status IN ('open', 'partially_paid', 'paid', 'void')`
    `original_amount >= 0`
    `paid_amount >= 0`
    `outstanding_amount >= 0`
    `outstanding_amount = original_amount - paid_amount`
    `currency_code = 'IDR'`
  }
}

Table finance.asset_depreciations {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008 scope rule). Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  item_id uuid [note: "Logical reference to inventory.items.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract. Was assets.asset_depreciations.asset_id (ADR-0024 Q15/Q19)."]
  period_year integer [not null]
  period_month integer [not null]
  depreciation_method text [not null, default: 'straight_line']
  depreciation_amount bigint [not null, default: 0]
  opening_book_value bigint [not null, default: 0]
  closing_book_value bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  calculated_at bigint
  journal_entry_id uuid [note: "Same-schema reference to finance.journal_entries.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Monthly depreciation run of an item - the audit trail of the book value. Moved here from the assets schema; items.book_value and accumulated_depreciation are written only through InventoryItemService.applyDepreciation() called by finance."
  Indexes {
    (item_id, period_year, period_month) [unique, name: 'asset_depreciations_period_uq']
    period_year [name: 'asset_depreciations_period_year_idx']
  }
  Checks {
    `period_month BETWEEN 1 AND 12`
    `depreciation_method IN ('straight_line', 'declining_balance', 'none')`
    `depreciation_amount >= 0`
    `closing_book_value >= 0`
    `currency_code = 'IDR'`
  }
}

Table finance.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  description text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Finance configuration key value store (was accounting.accounting_settings), including the period-close checklist state."
  Indexes {
    (organization_id, setting_group, setting_key) [unique, name: 'finance_settings_scope_uq']
  }
}

Table finance.code_numberings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  code_type varchar(32) [not null, note: "journal_entry, supplier_bill, cash_bank_transaction, bank_reconciliation, asset_depreciation."]
  pattern varchar(100)
  reset_policy text
  period_key varchar(7) [not null]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Code series of the finance module (ADR-0024 Q6)."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Table finance.journal_templates {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  line_definitions text
  source_type text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Template that pre fills a journal entry, for example the monthly payroll journal."
  Indexes {
    (organization_id, code) [unique, name: 'journal_templates_org_code_uq']
  }
}

Table finance.credit_memos {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  invoice_id uuid [note: "Logical reference to sale.invoices.id. Cross-module FK intentionally omitted."]
  customer_id uuid [note: "Logical reference to customer.customers.id. Cross-module FK intentionally omitted."]
  memo_date date
  amount bigint [not null, default: 0, note: "Total credited including VAT (IDR minor units)."]
  tax_amount bigint [not null, default: 0, note: "VAT part of amount, split at the invoice's VAT ratio."]
  currency_code varchar(3) [not null, default: 'IDR']
  reason text
  status text [not null, default: 'draft']
  journal_entry_id uuid
  created_by text [note: "Logical reference to auth.users.id."]
  issued_by text [note: "Logical reference to auth.users.id."]
  issued_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Credit note against an issued invoice (ERP-0135; built). draft -> applied (posting Dr sales returns + Dr VAT output / Cr receivable and lowering the invoice's open amount) -> void (a reversal). It reduces the receivable, it is not a payment; sale.returns are replacements and do not create one."
  Indexes {
    (organization_id, code) [unique, name: 'credit_memos_org_code_uq']
    invoice_id [name: 'credit_memos_invoice_id_idx']
    status [name: 'credit_memos_status_idx']
  }
  Checks {
    `status IN ('draft', 'issued', 'applied', 'void')`
    `amount > 0`
    `tax_amount >= 0 AND tax_amount <= amount`
    `currency_code = 'IDR'`
  }
}

Table finance.expense_claims {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  employee_id uuid [note: "Logical reference to human_resource.employees.id. Cross-module FK intentionally omitted. Validated through the Human Resource module contract."]
  claim_date date
  total_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  submitted_by text [note: "Logical reference to auth.users.id."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  payment_id uuid [note: "Logical reference to payment.payments.id. Cross-module FK intentionally omitted."]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Operational expense claim of an employee, settled by a payment.payments disbursement."
  Indexes {
    (organization_id, code) [unique, name: 'expense_claims_org_code_uq']
    employee_id [name: 'expense_claims_employee_id_idx']
    status [name: 'expense_claims_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'paid', 'cancelled')`
    `total_amount >= 0`
    `currency_code = 'IDR'`
  }
}

Table finance.expense_claim_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  expense_claim_id uuid [not null]
  expense_date date
  category_code text
  description text
  amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  receipt_document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of an expense claim."
  Indexes {
    expense_claim_id [name: 'expense_claim_items_claim_id_idx']
  }
  Checks {
    `amount >= 0`
    `tax_amount >= 0`
    `currency_code = 'IDR'`
  }
}

Table finance.employee_advances {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  employee_id uuid [note: "Logical reference to human_resource.employees.id. Cross-module FK intentionally omitted."]
  project_id uuid [note: "Logical reference to project.projects.id. Cross-module FK intentionally omitted."]
  amount bigint [not null, default: 0]
  settled_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  request_date date
  purpose text
  status text [not null, default: 'draft']
  requested_by text [note: "Logical reference to auth.users.id."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  disbursed_at bigint
  payment_id uuid [note: "Logical reference to payment.payments.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Cash advance to an employee. Disbursement is a payment.payments row; the advance is never a payment ledger of its own."
  Indexes {
    (organization_id, code) [unique, name: 'employee_advances_org_code_uq']
    employee_id [name: 'employee_advances_employee_id_idx']
    project_id [name: 'employee_advances_project_id_idx']
    status [name: 'employee_advances_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'disbursed', 'settled', 'cancelled')`
    `amount > 0`
    `settled_amount >= 0`
    `settled_amount <= amount`
    `currency_code = 'IDR'`
  }
}

Table finance.expense_settlements {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  employee_id uuid [note: "Logical reference to human_resource.employees.id. Cross-module FK intentionally omitted."]
  project_id uuid [note: "Logical reference to project.projects.id. Cross-module FK intentionally omitted."]
  settlement_type text [not null, default: 'expense']
  employee_advance_id uuid
  total_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  settlement_date date
  status text [not null, default: 'draft']
  submitted_by text [note: "Logical reference to auth.users.id."]
  submitted_at bigint
  verified_by text [note: "Logical reference to auth.users.id."]
  verified_at bigint
  approved_by text [note: "Logical reference to auth.users.id."]
  approved_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Settlement of a project advance and of the operational expenses of an employee. Verification and approval are separate steps."
  Indexes {
    (organization_id, code) [unique, name: 'expense_settlements_org_code_uq']
    employee_id [name: 'expense_settlements_employee_id_idx']
    employee_advance_id [name: 'expense_settlements_advance_id_idx']
    status [name: 'expense_settlements_status_idx']
  }
  Checks {
    `settlement_type IN ('expense', 'advance')`
    `status IN ('draft', 'submitted', 'verified', 'approved', 'rejected', 'paid', 'cancelled')`
    `total_amount >= 0`
    `currency_code = 'IDR'`
  }
}

Table finance.expense_settlement_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  expense_settlement_id uuid [not null]
  expense_date date
  category_code text
  description text
  amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  is_advance_offset boolean [not null, default: false]
  project_id uuid [note: "Logical reference to project.projects.id. Cross-module FK intentionally omitted."]
  receipt_document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "status: target. Line of an expense settlement."
  Indexes {
    expense_settlement_id [name: 'expense_settlement_items_settlement_id_idx']
  }
  Checks {
    `amount >= 0`
    `tax_amount >= 0`
    `currency_code = 'IDR'`
  }
}

