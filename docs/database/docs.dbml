  invoice_id uuid [not null]
  allocated_amount bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  allocated_at bigint [not null]
  created_at bigint [not null]
  Note: "Allocation of one payment to one invoice, for invoices settled in several instalments."
  Indexes {
    (payment_id, invoice_id) [unique, name: 'payment_allocations_uq']
    invoice_id [name: 'payment_allocations_invoice_id_idx']
