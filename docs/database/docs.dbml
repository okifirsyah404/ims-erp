Ref: procurement.purchase_return_items.purchase_order_item_id > procurement.purchase_order_items.id [delete: set null]


// MODULE: Inventory  (schema: inventory)
// Warehouse master: warehouses and their storages. Same module as the stock
// ledger below; the schema was folded into inventory (ADR-0008), so these
// foreign keys are ordinary intra-module references.
// Tenant scoped.
// ---------------------------------------------------------------------------

Table inventory.warehouses {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Frozen at NULL (ADR-0010): every warehouse is global; organization access comes from warehouse_organizations. Column kept because migrations are append-only. Logical reference to auth.organizations.id; cross-module FK intentionally omitted."]
  code varchar(32) [not null]
  name text [not null]
  responsible_employee_id uuid [note: "Display-only person in charge (ADR-0010); grants no access. Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  is_default boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Warehouse master. Address fields live in warehouse_addresses (strict 1:1). Writes are application-admin-only; no organization role holds warehouse:*. Organization access is granted by warehouse_organizations links (ADR-0010)."
  Indexes {
    (organization_id, code) [unique, name: 'warehouses_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'warehouses_global_code_uq', note: 'WHERE organization_id IS NULL']
    is_default [name: 'warehouses_is_default_idx']
    is_active [name: 'warehouses_is_active_idx']
  }
}

Table inventory.warehouse_addresses {
  id uuid [pk, default: `uuidv7()`]
  warehouse_id uuid [not null]
  label text
  street text [not null]
  rt varchar(8)
  rw varchar(8)
  postal_code varchar(10)
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  latitude numeric(10,7)
  longitude numeric(10,7)
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Warehouse address, strictly 1:1 with warehouses. Structured per ADR-0003: free-text street plus a village-level logical reference into location.villages."
  Indexes {
    warehouse_id [unique, name: 'warehouse_addresses_warehouse_uq']
    village_id [name: 'warehouse_addresses_village_id_idx']
  }
}

Table inventory.warehouse_storages {
  id uuid [pk, default: `uuidv7()`]
  warehouse_id uuid [not null]
  code varchar(32) [not null]
  name text
  bin_type text
  capacity numeric(18,3)
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Storage location (bin) inside a warehouse. Storage is one level deep: warehouse -> storage, there is no zone level (ADR-0008)."
  Indexes {
    warehouse_id [name: 'warehouse_storages_warehouse_id_idx']
    (warehouse_id, code) [unique, name: 'warehouse_storages_warehouse_code_uq', note: 'WHERE deleted_at IS NULL']
  }
}

Table inventory.warehouse_organizations {
  id uuid [pk, default: `uuidv7()`]
  warehouse_id uuid [not null]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Many-to-many link granting an organization (internal department) access to a global warehouse (ADR-0010). Members act through their role in the active organization; no per-member assignment. Link writes are application-admin-only and audited; unlink is rejected while the organization has open borrowings in the warehouse."
  Indexes {
    (warehouse_id, organization_id) [unique, name: 'warehouse_organizations_uq', note: 'WHERE deleted_at IS NULL']
    organization_id [name: 'warehouse_organizations_organization_id_idx']
  }
}

Table inventory.items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008). Logical reference to auth.organizations.id; cross-module FK intentionally omitted."]
  code varchar(32) [not null, note: "Human reference, allocated by the numbering authority (ERP-0043): item_product -> PRD-00001, item_material -> MAT-00001, item_component -> CMP-00001. Immutable after create."]
  sku varchar(64) [not null, note: "Manufacturer/business SKU, typed by the user. Unique per tenant; immutable after create."]
  serial_number text [note: "Optional manufacturer serial of a serialized item master (ERP-0043). Per-unit serials stay in inventory.serial_tracked_items."]
  name text [not null]
  description text
  item_kind text [not null]
  category_id uuid [note: "Same-module reference to inventory.item_categories (ADR-0011); replaces the former free-text category."]
  brand varchar(100)
  specification text [note: "Technical specification printed on quotations."]
  image_object_key text [note: "Object-storage key of the one photo printed on documents (quotation Gambar column). The website catalog gallery is separate (M04)."]
  unit_label varchar(32) [not null, default: 'pcs', note: "Fixed unit list (ADR-0011), guarded by a CHECK; replaces free text."]
  is_active boolean [not null, default: true, note: "Inactive items stay listed but are not offered for new documents. Not a status: status exists only on serialized units."]
  is_serialized boolean [not null, default: false]
  is_stock_tracked boolean [not null, default: true]
  min_stock_qty numeric(18,3) [not null, default: 0]
  barcode text
  selling_price bigint [not null, default: 0, note: "Exact integer IDR minor units (ADR-0002). Never a float."]
  purchase_price bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Item master at SKU level. One item master for the whole ERP; catalog.items is superseded by this table (ADR-0008). Status exists only on serialized units, never here. ERP-0036 D9: item_kind is product|component|material only - physical tools are assets (assets.assets) and services are neither stocked nor serialized, so the former service clause is gone. ERP-0043 added code (numbering authority) and serial_number; sku stays user-typed."
  Indexes {
    (organization_id, code) [unique, name: 'inventory_items_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'inventory_items_global_code_uq', note: 'WHERE organization_id IS NULL']
    (organization_id, sku) [unique, name: 'inventory_items_org_sku_uq', note: 'WHERE organization_id IS NOT NULL']
    (sku) [unique, name: 'inventory_items_global_sku_uq', note: 'WHERE organization_id IS NULL']
    item_kind [name: 'inventory_items_kind_idx']
    (organization_id, name) [name: 'inventory_items_org_name_idx']
    barcode [name: 'inventory_items_barcode_idx']
  }
  Checks {
    `item_kind IN ('product', 'component', 'material')`
    `selling_price >= 0 AND purchase_price >= 0`
    `min_stock_qty >= 0`
    `unit_label IN ('pcs', 'unit', 'set', 'paket', 'titik', 'm', 'roll', 'kg', 'jam', 'bulan', 'tahun', 'lic', 'lot', 'pulau')`
  }
}

Table inventory.item_categories {
  id uuid [pk, default: `uuidv7()`]
  slug varchar(64) [not null, note: "Matches the public website's category slug."]
  name varchar(120) [not null]
  short_name varchar(60)
  sort_order integer [not null, default: 0]
  description text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Item category, one level, company-wide (ADR-0011): no organization_id. Supersedes catalog.item_categories. Partial unique index on slug WHERE deleted_at IS NULL in the Drizzle schema; a category with live items cannot be archived."
}

Table inventory.stock_movements {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008)."]
  code varchar(32) [not null]
  movement_type text [not null]
  item_id uuid [not null]
  warehouse_id uuid [not null]
  bin_id uuid
  target_warehouse_id uuid
  quantity numeric(18,3) [not null]
  unit_cost bigint [not null, default: 0, note: "IDR minor units the movement was valued at (ADR-0011 moving average): the given cost for inbound moves, the balance average for outbound ones."]
  reference_type text [note: "e.g. manual_adjustment, borrowing, receipt, goods_receipt."]
  reference_id text
  status text [not null, default: 'posted']
  occurred_at bigint [not null]
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted."]
  notes text
  created_at bigint [not null]
  Note: "Authoritative, append-only stock ledger. One row per movement, never updated after posting; a reversal is a new row. No updated_at, no deleted_at. ERP-0036 D17: the borrowing_out / borrowing_in movement types and the reference_type='borrowing' clause are SUPERSEDED — nothing writes them (asset borrowing writes assets.asset_movements); they stay until the later cleanup migration."
  Indexes {
    (organization_id, code) [unique, name: 'stock_movements_org_code_uq', note: 'WHERE organization_id IS NOT NULL']
    (code) [unique, name: 'stock_movements_global_code_uq', note: 'WHERE organization_id IS NULL']
    (organization_id, item_id, warehouse_id, occurred_at) [name: 'stock_movements_ledger_idx']
    bin_id [name: 'stock_movements_bin_id_idx']
    reference_type [name: 'stock_movements_reference_type_idx']
    reference_id [name: 'stock_movements_reference_id_idx']
  }
  Checks {
    `movement_type IN ('receipt', 'issue', 'transfer_in', 'transfer_out', 'adjustment_in', 'adjustment_out', 'return_in', 'return_out', 'consumption', 'borrowing_out', 'borrowing_in')`
    `status IN ('draft', 'posted', 'reversed')`
    `quantity <> 0`
    `(movement_type IN ('transfer_in', 'transfer_out') AND target_warehouse_id IS NOT NULL) OR (movement_type NOT IN ('transfer_in', 'transfer_out'))`
    `(movement_type IN ('borrowing_out', 'borrowing_in') AND reference_type = 'borrowing') OR (movement_type NOT IN ('borrowing_out', 'borrowing_in'))`
  }
}

Table inventory.stock_balances {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008)."]
  item_id uuid [not null]
  warehouse_id uuid [not null]
  bin_id uuid
  quantity_on_hand numeric(18,3) [not null, default: 0]
  quantity_reserved numeric(18,3) [not null, default: 0]
  quantity_available numeric(18,3) [not null, default: 0]
  average_cost bigint [not null, default: 0, note: "Moving-average unit cost, IDR minor units (ADR-0011 §5). Restricted to product:read_cost."]
  total_value bigint [not null, default: 0, note: "Value of quantity_on_hand at cost; the last unit out takes the exact remainder."]
  last_movement_at bigint
  created_at bigint [not null]
  updated_at bigint
  Note: "Balance cache over stock_movements. Service-maintained inside the same transaction as the movement that caused it, never by a trigger; recomputeFromLedger is the repair operation (ADR-0008). No deleted_at. Moving-average valuation (ADR-0011 §5, supersedes OPEN-3 for the inventory value): average_cost and total_value are maintained with the quantity in the same transaction; the accounting journal still needs finance approval. Scope rule: a balance's organization_id follows the WAREHOUSE scope, not the caller — a global warehouse (organization_id IS NULL) has ONE shared balance row visible to every organization."
  Indexes {
    (organization_id, warehouse_id, item_id, bin_id) [unique, name: 'stock_balances_org_scope_uq', note: 'NULLS NOT DISTINCT WHERE organization_id IS NOT NULL (a bin-less balance is one row)']
    (warehouse_id, item_id, bin_id) [unique, name: 'stock_balances_global_scope_uq', note: 'NULLS NOT DISTINCT WHERE organization_id IS NULL']
    item_id [name: 'stock_balances_item_id_idx']
  }
  Checks {
    `quantity_available = quantity_on_hand - quantity_reserved`
  }
}

Table inventory.stock_adjustments {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  warehouse_id uuid [not null]
  adjustment_type text [not null]
  status text [not null, default: 'draft']
  reason_code text
  notes text
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  requested_at bigint [not null]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  posted_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Stock adjustment document, with an approval chain: draft -> submitted -> approved|rejected -> posted|cancelled. Only `posted` writes stock_movements; posting is idempotent (posted_at IS NOT NULL is the guard). organization_id is NOT NULL here, unlike the rest of inventory.*: an adjustment is always raised by a specific tenant, even against a global warehouse."
  Indexes {
    (organization_id, code) [unique, name: 'stock_adjustments_org_code_uq']
    warehouse_id [name: 'stock_adjustments_warehouse_id_idx']
    status [name: 'stock_adjustments_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'posted', 'cancelled')`
    `adjustment_type IN ('increase', 'decrease', 'recount')`
  }
}

Table inventory.stock_adjustment_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  stock_adjustment_id uuid [not null]
  item_id uuid [not null, note: "Logical reference to inventory.items.id."]
  bin_id uuid
  quantity_before numeric(18,3) [not null, default: 0]
  quantity_after numeric(18,3) [not null, default: 0]
  unit_cost bigint [note: "Cost an increase enters stock at (IDR minor units; opening stock, ADR-0011 §6). Null = the current moving average. Ignored for decreases."]
  note text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Line of a stock adjustment. Stores quantity_before/quantity_after rather than a delta, so a recount is auditable. Movement direction is derived from quantity_after - quantity_before; a line with no delta writes NO movement."
  Indexes {
    stock_adjustment_id [name: 'stock_adjustment_items_adjustment_id_idx']
  }
  Checks {
    `quantity_before >= 0`
    `quantity_after >= 0`
    `unit_cost IS NULL OR unit_cost >= 0`
  }
}

Table inventory.stock_transfers {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  from_warehouse_id uuid [not null]
  to_warehouse_id uuid [not null]
  status text [not null, default: 'draft']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  requested_at bigint [not null]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  shipped_at bigint
  received_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Planned, NOT YET IMPLEMENTED (deferred by ADR-0008). A transfer is modelled as two stock movements (transfer_out + transfer_in)."
  Indexes {
    (organization_id, code) [unique, name: 'stock_transfers_org_code_uq']
    from_warehouse_id [name: 'stock_transfers_from_warehouse_id_idx']
    to_warehouse_id [name: 'stock_transfers_to_warehouse_id_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'shipped', 'received', 'cancelled')`
    `from_warehouse_id <> to_warehouse_id`
  }
}

Table inventory.stock_transfer_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  stock_transfer_id uuid [not null]
  item_id uuid [not null, note: "Logical reference to inventory.items.id."]
  quantity numeric(18,3) [not null]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Planned, NOT YET IMPLEMENTED (deferred by ADR-0008). Line of a stock transfer."
  Indexes {
    stock_transfer_id [name: 'stock_transfer_items_transfer_id_idx']
  }
  Checks {
    `quantity > 0`
  }
}

Table inventory.stock_reservations {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  item_id uuid [not null, note: "Logical reference to inventory.items.id."]
  warehouse_id uuid [not null]
  bin_id uuid
  quantity numeric(18,3) [not null]
  reference_type text [not null]
  reference_id text [not null]
  expires_at bigint
  status text [not null, default: 'active']
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Planned, NOT YET IMPLEMENTED (deferred by ADR-0008). stock_balances.quantity_reserved stays 0 until this is built."
  Indexes {
    (item_id, warehouse_id) [name: 'stock_reservations_item_warehouse_idx']
    (reference_type, reference_id) [name: 'stock_reservations_reference_idx']
  }
  Checks {
    `quantity > 0`
    `status IN ('active', 'released', 'consumed', 'expired')`
  }
}

Table inventory.serial_tracked_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [note: "Null means global/company-wide (ADR-0008)."]
  item_id uuid [not null]
  serial_number text [not null]
  is_provisional_serial boolean [not null, default: false, note: "A pre-ordered unit carries a PO-... serial until it is received. Replaced exactly once (ADR-0009)."]
  asset_tag text
  status text [not null, default: 'in_stock']
  warehouse_id uuid [note: "NULL while the unit is borrowed or lost: custody has moved to the borrower (ADR-0009)."]
  bin_id uuid
  acquired_on date
  warranty_expires_on date
  purchase_order_line_id text [note: "Logical reference to the procurement line this unit was ordered on. Procurement does not exist yet, so this is unvalidated."]
  customer_id uuid [note: "Logical reference to crm.customers.id, set when sold. Cross-module FK intentionally omitted."]
  stock_movement_id uuid [note: "Logical reference to inventory.stock_movements.id (last touch)."]
  current_borrowing_line_id uuid [note: "SUPERSEDED (ERP-0036 D17): nothing writes it once borrowing moves to assets. Its FK to inventory.borrowing_lines is dropped with that table; column and index stay until the later cleanup migration."]
  notes text
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "One physical, serialized instance of an item. Serves serialized products only after ERP-0036: tools are assets and never have a unit row here."
  Indexes {
    (organization_id, serial_number) [unique, name: 'serial_tracked_items_org_serial_uq', note: 'WHERE organization_id IS NOT NULL']
    (serial_number) [unique, name: 'serial_tracked_items_global_serial_uq', note: 'WHERE organization_id IS NULL']
    item_id [name: 'serial_tracked_items_item_id_idx']
    status [name: 'serial_tracked_items_status_idx']
    warehouse_id [name: 'serial_tracked_items_warehouse_id_idx']
    asset_tag [name: 'serial_tracked_items_asset_tag_idx']
    current_borrowing_line_id [name: 'serial_tracked_items_current_borrowing_line_id_idx']
  }
  Checks {
    `status IN ('pre_order', 'in_stock', 'lost', 'sold', 'applied_warranty')`
    `is_provisional_serial = false OR status = 'pre_order'`
    `warranty_expires_on IS NULL OR acquired_on IS NULL OR warranty_expires_on >= acquired_on`
  }
}

// Intra-module FKs (Warehouse + Inventory are one module).
Ref: inventory.warehouse_addresses.warehouse_id > inventory.warehouses.id [delete: cascade]
Ref: inventory.warehouse_storages.warehouse_id > inventory.warehouses.id [delete: cascade]
Ref: inventory.warehouse_organizations.warehouse_id > inventory.warehouses.id [delete: cascade]
Ref: inventory.items.category_id > inventory.item_categories.id [delete: restrict]
Ref: inventory.stock_movements.item_id > inventory.items.id [delete: restrict]
Ref: inventory.stock_movements.warehouse_id > inventory.warehouses.id [delete: restrict]
Ref: inventory.stock_movements.bin_id > inventory.warehouse_storages.id [delete: set null]
Ref: inventory.stock_movements.target_warehouse_id > inventory.warehouses.id [delete: restrict]
Ref: inventory.stock_balances.item_id > inventory.items.id [delete: restrict]
Ref: inventory.stock_balances.warehouse_id > inventory.warehouses.id [delete: restrict]
Ref: inventory.stock_balances.bin_id > inventory.warehouse_storages.id [delete: set null]
Ref: inventory.stock_adjustments.warehouse_id > inventory.warehouses.id [delete: restrict]
Ref: inventory.stock_adjustment_items.stock_adjustment_id > inventory.stock_adjustments.id [delete: cascade]
Ref: inventory.stock_transfers.from_warehouse_id > inventory.warehouses.id [delete: restrict]
Ref: inventory.stock_transfers.to_warehouse_id > inventory.warehouses.id [delete: restrict]
Ref: inventory.stock_transfer_items.stock_transfer_id > inventory.stock_transfers.id [delete: cascade]
Ref: inventory.stock_reservations.warehouse_id > inventory.warehouses.id [delete: cascade]
Ref: inventory.serial_tracked_items.item_id > inventory.items.id [delete: restrict]
Ref: inventory.serial_tracked_items.warehouse_id > inventory.warehouses.id [delete: set null]
Ref: inventory.serial_tracked_items.bin_id > inventory.warehouse_storages.id [delete: set null]

// ---------------------------------------------------------------------------
// MODULE: Projects  (schema: projects)
// Project master, phases, tasks and dependencies, daily reports, site
// assignments, KPI, milestones, change orders, handover and work plans.
// Tenant scoped, except projects, project_tasks, project_evidence,
// project_costs (step 6a) and project_handover (BAST, step 6b), which are
// company-wide (ADR-0011).
// ---------------------------------------------------------------------------

Table projects.project_types {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  default_duration_days integer
  description text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Type of project such as installation, maintenance or subscription setup."
  Indexes {
    (organization_id, code) [unique, name: 'project_types_org_code_uq']
  }
}

Table projects.projects {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Number from the numbering service (PRJ). Unique among live rows (partial index in the Drizzle schema)."]
  sales_order_id uuid [not null, note: "Logical reference to sales.sales_orders.id. Cross-module FK intentionally omitted. Validated through the Sales module contract. One live (not cancelled) project per order (partial unique index)."]
  sales_order_code varchar(32) [not null, note: "Snapshot of the order number."]
  quotation_code varchar(40) [note: "Snapshot of the SPH number."]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  customer_name text [not null, note: "Snapshot of the customer name."]
  title text [not null]
  site_name varchar(200) [note: "Project location (Lokasi proyek)."]
  contract_value bigint [not null, default: 0, note: "The order's grand total incl. VAT at creation (IDR minor units)."]
  pic_user_id text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Must hold project:update."]
  target_start_date date [note: "Jakarta business date."]
  target_end_date date [note: "Jakarta business date."]
  stage text [not null, default: 'preparation']
  status text [not null, default: 'active']
  notes text
  closed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  closed_at bigint
  cancelled_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cancelled_at bigint
  cancel_reason text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Project executing a deal (sales order), company-wide (ADR-0011). Closing needs function-test, training and signed-BAST evidence and moves the stage to warranty."
  Indexes {
    sales_order_id [name: 'projects_sales_order_id_idx']
    customer_id [name: 'projects_customer_id_idx']
    pic_user_id [name: 'projects_pic_user_id_idx']
    status [name: 'projects_status_idx']
  }
  Checks {
    `status IN ('active', 'closed', 'cancelled')`
    `stage IN ('preparation', 'delivery', 'installation', 'testing', 'training', 'handover', 'warranty')`
    `contract_value >= 0`
    `target_end_date IS NULL OR target_start_date IS NULL OR target_end_date >= target_start_date`
  }
}

Table projects.project_phases {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  project_id uuid [not null]
  name text [not null]
  sequence integer [not null, default: 0]
  planned_start date
  planned_end date
  actual_start date
  actual_end date
  status text [not null, default: 'pending']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Phase of a project, used to group tasks."
  Indexes {
    project_id [name: 'project_phases_project_id_idx']
    (project_id, sequence) [unique, name: 'project_phases_sequence_uq']
  }
  Checks {
    `status IN ('pending', 'in_progress', 'done', 'skipped')`
  }
}

Table projects.project_tasks {
  id uuid [pk, default: `uuidv7()`]
  project_id uuid [not null, note: "Same-module reference to projects.projects.id; no FK by design (module-ownership §9), validated by the Projects service."]
  position integer [not null, default: 0]
  title text [not null]
  stage text [not null]
  assignee_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract. Must hold task:update."]
  due_date date [note: "Jakarta business date."]
  status text [not null, default: 'todo']
  done_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  done_at bigint
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  deleted_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Checklist task of a project; a new project gets one task per stage up to handover. Removed tasks are soft-deleted."
  Indexes {
    (project_id, position) [name: 'project_tasks_project_position_idx']
    assignee_user_id [name: 'project_tasks_assignee_user_id_idx']
  }
  Checks {
    `status IN ('todo', 'in_progress', 'done')`
    `stage IN ('preparation', 'delivery', 'installation', 'testing', 'training', 'handover', 'warranty')`
  }
}

Table projects.project_evidence {
  id uuid [pk, default: `uuidv7()`]
  project_id uuid [not null, note: "Same-module reference to projects.projects.id; no FK by design (module-ownership §9), validated by the Projects service."]
  task_id uuid [note: "Same-module reference to projects.project_tasks.id; no FK by design."]
  kind text [not null]
  storage_key text [not null, note: "Object storage key; files are read through short-lived presigned URLs."]
  file_name varchar(200) [not null]
  content_type varchar(100) [not null, note: "Detected from the file content (JPG, PNG, WebP, PDF)."]
  size_bytes integer [not null]
  note varchar(500)
  uploaded_by text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  deleted_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Evidence file of a project (function test, training, signed BAST, photo)."
  Indexes {
    (project_id, kind) [name: 'project_evidence_project_kind_idx']
  }
  Checks {
    `kind IN ('testing', 'training', 'bast', 'photo', 'other')`
    `size_bytes > 0`
  }
}

Table projects.project_costs {
  id uuid [pk, default: `uuidv7()`]
  project_id uuid [not null, note: "Same-module reference to projects.projects.id; no FK by design (module-ownership §9), validated by the Projects service."]
  category text [not null]
  cost_date date [not null, note: "Jakarta business date."]
  amount bigint [not null, note: "IDR minor units."]
  description varchar(300) [not null]
  receipt_storage_key text [note: "Optional receipt (nota) in object storage."]
  receipt_file_name varchar(200)
  receipt_content_type varchar(100)
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  voided_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  voided_at bigint
  void_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Direct cost of a project; visible only with project:read_cost. Corrected by voiding, never deleted."
  Indexes {
    (project_id, cost_date) [name: 'project_costs_project_date_idx']
  }
  Checks {
    `category IN ('material', 'transport', 'accommodation', 'subcontract', 'other')`
    `amount > 0`
  }
}

Table projects.project_task_dependencies {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  project_task_id uuid [not null]
  depends_on_task_id uuid [not null]
  dependency_type text [not null, default: 'finish_to_start']
  lag_days integer [not null, default: 0]
  created_at bigint [not null]
  Note: "Dependency between two tasks of the same project."
  Indexes {
    (project_task_id, depends_on_task_id) [unique, name: 'project_task_dependencies_uq']
  }
  Checks {
    `dependency_type IN ('finish_to_start', 'start_to_start', 'finish_to_finish', 'start_to_finish')`
    `project_task_id <> depends_on_task_id`
  }
}

Table projects.project_daily_reports {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  project_id uuid [not null]
  project_task_id uuid
  technician_employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  report_date date [not null]
  work_description text
  hours_worked numeric(8,2) [not null, default: 0]
  progress_percent numeric(5,2) [not null, default: 0]
  weather_conditions text
  status text [not null, default: 'draft']
  submitted_at bigint
  verified_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  verified_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Daily report of a technician. Verification is a separate step from submission."
  Indexes {
    (organization_id, code) [unique, name: 'project_daily_reports_org_code_uq']
    project_id [name: 'project_daily_reports_project_id_idx']
    project_task_id [name: 'project_daily_reports_project_task_id_idx']
    technician_employee_id [name: 'project_daily_reports_technician_id_idx']
    status [name: 'project_daily_reports_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'verified', 'rejected')`
    `hours_worked >= 0`
    `progress_percent BETWEEN 0 AND 100`
  }
}

Table projects.project_site_assignments {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  project_id uuid [not null]
  employee_id uuid [not null, note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  role text
  assigned_on date
  released_on date
  rate_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Who is assigned to a project site, and from when."
  Indexes {
    project_id [name: 'project_site_assignments_project_id_idx']
    employee_id [name: 'project_site_assignments_employee_id_idx']
  }
  Checks {
    `rate_amount >= 0`
    `released_on IS NULL OR assigned_on IS NULL OR released_on >= assigned_on`
  }
}

Table projects.project_kpi_definitions {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  metric_type text [not null, default: 'numeric']
  target_value numeric(18,4)
  unit text
  weight numeric(5,2) [not null, default: 0]
  scope_type text [not null, default: 'project']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Definition of a performance indicator."
  Indexes {
    (organization_id, code) [unique, name: 'project_kpi_definitions_org_code_uq']
  }
  Checks {
    `metric_type IN ('numeric', 'boolean', 'duration', 'score')`
    `scope_type IN ('project', 'employee', 'team', 'company')`
    `weight BETWEEN 0 AND 100`
  }
}

Table projects.project_kpi_evaluations {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  project_kpi_definition_id uuid [not null]
  project_id uuid
  employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  period_year integer [not null]
  period_month integer
  actual_value numeric(18,4)
  score numeric(9,4)
  evaluated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  evaluated_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Measured value of a KPI for a period."
  Indexes {
    project_kpi_definition_id [name: 'project_kpi_evaluations_definition_id_idx']
    project_id [name: 'project_kpi_evaluations_project_id_idx']
    (project_kpi_definition_id, project_id, period_year, period_month) [unique, name: 'project_kpi_evaluations_period_uq']
  }
  Checks {
    `period_month IS NULL OR period_month BETWEEN 1 AND 12`
  }
}

Table projects.project_milestones {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  project_id uuid [not null]
  name text [not null]
  description text
  target_date date
  actual_date date
  status text [not null, default: 'pending']
  verified_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  verified_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Milestone of a project with an optional client verification."
  Indexes {
    project_id [name: 'project_milestones_project_id_idx']
    status [name: 'project_milestones_status_idx']
  }
  Checks {
    `status IN ('pending', 'reached', 'verified', 'missed')`
  }
}

Table projects.project_changes {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  project_id uuid [not null]
  title text [not null]
  description text
  reason text
  impact_cost bigint [not null, default: 0]
  impact_days integer [not null, default: 0]
  status text [not null, default: 'draft']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  effective_date date
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Change order on a project. Cost and schedule impact must be approved before it applies."
  Indexes {
    (organization_id, code) [unique, name: 'project_changes_org_code_uq']
    project_id [name: 'project_changes_project_id_idx']
    status [name: 'project_changes_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'applied', 'cancelled')`
    `impact_days >= 0`
  }
}

Table projects.project_handover {
  id uuid [pk, default: `uuidv7()`]
  project_id uuid [not null, note: "Same-module reference to projects.projects.id; no FK by design (module-ownership §9). Several BASTs per project (owner decision 2026-11-06)."]
  code varchar(32) [not null, note: "BAST number, assigned on creation by the BAST date. Unique among live rows (partial index in the Drizzle schema)."]
  bast_date date [not null, note: "Jakarta business date, printed in words."]
  first_party_company varchar(200) [not null, note: "PIHAK PERTAMA (the customer)."]
  first_party_name varchar(120) [not null]
  first_party_title varchar(120) [not null]
  second_party_company varchar(200) [not null, note: "PIHAK KEDUA (the company)."]
  second_party_name varchar(120) [not null]
  second_party_title varchar(120) [not null]
  contract_number varchar(120)
  work_title varchar(300) [not null]
  project_name varchar(200)
  items jsonb [not null, note: "Handed-over items: description, volume, remarks."]
  scope jsonb [not null, note: "Numbered list of the work handed over."]
  status text [not null, default: 'issued']
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cancelled_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cancelled_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Project handover (Berita Acara Serah Terima, BAST), company-wide (ADR-0011 step 6b). Edited or cancelled only while the project is active."
  Indexes {
    project_id [name: 'project_handover_project_id_idx']
  }
  Checks {
    `status IN ('issued', 'cancelled')`
  }
}

Table projects.project_work_plans {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  period_start date
  period_end date
  owner_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  status text [not null, default: 'draft']
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Work plan for a period, the umbrella of the projects and the tasks inside it."
  Indexes {
    (organization_id, code) [unique, name: 'project_work_plans_org_code_uq']
    owner_user_id [name: 'project_work_plans_owner_user_id_idx']
    status [name: 'project_work_plans_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'active', 'closed', 'cancelled')`
    `period_end IS NULL OR period_start IS NULL OR period_end >= period_start`
  }
}


// ---------------------------------------------------------------------------
// MODULE: HR  (schema: hr)
// Employee master, addresses, contracts, attendance, leave, discipline,
// training, certifications, salary components, bank accounts, emergency
// contacts, documents, transfers and separation. Tenant scoped.
// ---------------------------------------------------------------------------

Table hr.employees {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  employee_code varchar(32) [not null]
  full_name text [not null]
  legal_name text
  nickname text
  national_id text
  email text
  phone text
  whatsapp text
  photo_object_key text
  employment_status text [not null, default: 'active']
  employment_type text [not null, default: 'permanent']
  work_type text [not null, default: 'onsite']
  hire_date date
  termination_date date
  department_id uuid [note: "Logical reference to organization.departments.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  position_id uuid [note: "Logical reference to organization.positions.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  branch_id uuid [note: "Logical reference to organization.branches.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  cost_center_id uuid [note: "Logical reference to organization.cost_centers.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  manager_employee_id uuid
  user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Employee master. An employee may have a portal login, the link is user_id and it is not a foreign key."
  Indexes {
    (organization_id, employee_code) [unique, name: 'employees_org_code_uq']
    manager_employee_id [name: 'employees_manager_employee_id_idx']
    employment_status [name: 'employees_status_idx']
    national_id [name: 'employees_national_id_idx']
    (organization_id, full_name) [name: 'employees_org_name_idx']
  }
  Checks {
    `employment_status IN ('active', 'on_leave', 'suspended', 'terminated')`
    `employment_type IN ('permanent', 'contract', 'freelance', 'intern')`
    `work_type IN ('onsite', 'remote', 'hybrid')`
    `termination_date IS NULL OR hire_date IS NULL OR termination_date >= hire_date`
  }
}

Table hr.employee_addresses {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  employee_id uuid [not null]
  kind text [not null, default: 'residence']
  address_line text
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  district_id uuid [note: "Logical reference to location.districts.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  regency_id uuid [note: "Logical reference to location.regencies.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  province_id uuid [note: "Logical reference to location.provinces.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Address of an employee."
  Indexes {
    employee_id [name: 'employee_addresses_employee_id_idx']
  }
  Checks {
    `kind IN ('residence', 'current', 'birth', 'other')`
  }
}

Table hr.employment_contracts {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  employee_id uuid [not null]
  contract_type text [not null, default: 'permanent']
  start_date date [not null]
  end_date date
  base_salary bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  signed_on date
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Employment contract. base_salary is exact integer minor units, never a float."
  Indexes {
    (organization_id, code) [unique, name: 'employment_contracts_org_code_uq']
    employee_id [name: 'employment_contracts_employee_id_idx']
    status [name: 'employment_contracts_status_idx']
  }
  Checks {
    `contract_type IN ('permanent', 'probation', 'contract', 'freelance')`
    `status IN ('draft', 'submitted', 'approved', 'active', 'expired', 'terminated')`
    `base_salary >= 0`
    `end_date IS NULL OR end_date >= start_date`
  }
}

Table hr.attendance_records {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  employee_id uuid [not null]
  attendance_date date [not null]
  check_in_at bigint
  check_out_at bigint
  work_minutes integer [not null, default: 0]
  overtime_minutes integer [not null, default: 0]
  late_minutes integer [not null, default: 0]
  status text [not null, default: 'present']
  source text [not null, default: 'manual']
  latitude numeric(10,7)
  longitude numeric(10,7)
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "One attendance row per employee per day. Times are unix milliseconds in UTC."
  Indexes {
    (organization_id, employee_id, attendance_date) [unique, name: 'attendance_records_day_uq']
    attendance_date [name: 'attendance_records_date_idx']
    status [name: 'attendance_records_status_idx']
  }
  Checks {
    `status IN ('present', 'absent', 'leave', 'sick', 'permit', 'holiday', 'remote')`
    `source IN ('manual', 'device', 'mobile', 'import')`
    `work_minutes >= 0`
    `overtime_minutes >= 0`
    `late_minutes >= 0`
  }
}

Table hr.attendance_corrections {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  attendance_record_id uuid [not null]
  employee_id uuid [not null]
  requested_check_in bigint
  requested_check_out bigint
  reason text
  status text [not null, default: 'requested']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  requested_at bigint [not null]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  rejected_reason text
  Note: "Correction request on an attendance record. Approval is a separate permission from the request."
  Indexes {
    attendance_record_id [name: 'attendance_corrections_record_id_idx']
    employee_id [name: 'attendance_corrections_employee_id_idx']
    status [name: 'attendance_corrections_status_idx']
  }
  Checks {
    `status IN ('requested', 'approved', 'rejected')`
  }
}

Table hr.leave_types {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  max_days_per_year numeric(8,2)
  is_paid boolean [not null, default: true]
  carry_forward boolean [not null, default: false]
  requires_approval boolean [not null, default: true]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Leave type definition."
  Indexes {
    (organization_id, code) [unique, name: 'leave_types_org_code_uq']
  }
}

Table hr.leave_requests {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  leave_type_id uuid [not null]
  employee_id uuid [not null]
  start_date date [not null]
  end_date date [not null]
  total_days numeric(8,2) [not null, default: 1]
  reason text
  status text [not null, default: 'requested']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  requested_at bigint [not null]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  rejected_reason text
  cancelled_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Leave request of an employee."
  Indexes {
    (organization_id, code) [unique, name: 'leave_requests_org_code_uq']
    employee_id [name: 'leave_requests_employee_id_idx']
    leave_type_id [name: 'leave_requests_leave_type_id_idx']
    status [name: 'leave_requests_status_idx']
  }
  Checks {
    `status IN ('requested', 'approved', 'rejected', 'cancelled', 'taken')`
    `end_date >= start_date`
    `total_days > 0`
  }
}

Table hr.disciplinary_records {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  employee_id uuid [not null]
  incident_date date
  category text
  severity text [not null, default: 'minor']
  description text
  sanction text
  status text [not null, default: 'draft']
  reported_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Disciplinary record. Sensitive, access is limited by the HR scope."
  Indexes {
    (organization_id, code) [unique, name: 'disciplinary_records_org_code_uq']
    employee_id [name: 'disciplinary_records_employee_id_idx']
    status [name: 'disciplinary_records_status_idx']
  }
  Checks {
    `severity IN ('minor', 'moderate', 'major', 'severe')`
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'closed')`
  }
}

Table hr.training_records {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  employee_id uuid [not null]
  training_name text [not null]
  provider text
  start_date date
  end_date date
  hours numeric(8,2)
  certificate_number text
  status text [not null, default: 'planned']
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Training attended by an employee."
  Indexes {
    employee_id [name: 'training_records_employee_id_idx']
    status [name: 'training_records_status_idx']
  }
  Checks {
    `status IN ('planned', 'ongoing', 'completed', 'cancelled')`
  }
}

Table hr.certifications {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  employee_id uuid [not null]
  certification_name text [not null]
  issuing_body text
  issue_date date
  expiry_date date
  certificate_number text
  status text [not null, default: 'valid']
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Certification of an employee, for example a technician licence."
  Indexes {
    employee_id [name: 'certifications_employee_id_idx']
    expiry_date [name: 'certifications_expiry_date_idx']
    status [name: 'certifications_status_idx']
  }
  Checks {
    `status IN ('valid', 'expiring', 'expired', 'revoked')`
    `expiry_date IS NULL OR issue_date IS NULL OR expiry_date > issue_date`
  }
}

Table hr.employee_salary_components {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  employee_id uuid [not null]
  salary_component_id uuid [note: "Logical reference to payroll.salary_components.id. Cross-module FK intentionally omitted. Validated through the Payroll module contract."]
  component_code text [not null]
  component_name text [not null]
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  is_taxable boolean [not null, default: true]
  effective_from date [not null]
  effective_to date
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Effective dated salary component of an employee. The component definition stays in the Payroll module."
  Indexes {
    employee_id [name: 'employee_salary_components_employee_id_idx']
    (employee_id, component_code, effective_from) [unique, name: 'employee_salary_components_period_uq']
  }
  Checks {
    `amount >= 0`
    `effective_to IS NULL OR effective_to >= effective_from`
  }
}

Table hr.bank_accounts {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  employee_id uuid [not null]
  bank_name text [not null]
  account_number text [not null]
  account_holder text [not null]
  is_primary boolean [not null, default: false]
  is_verified boolean [not null, default: false]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Bank account of an employee, used by the payroll payment batch. Restricted access."
  Indexes {
    employee_id [name: 'bank_accounts_employee_id_idx']
    account_number [name: 'bank_accounts_account_number_idx']
  }
}

Table hr.employee_emergencies {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  employee_id uuid [not null]
  name text [not null]
  relationship text
  phone text
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Emergency contact of an employee."
  Indexes {
    employee_id [name: 'employee_emergencies_employee_id_idx']
  }
}

Table hr.employee_documents {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  employee_id uuid [not null]
  document_id uuid [not null, note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  document_type text [not null]
  valid_from date
  valid_to date
  created_at bigint [not null]
  Note: "Employee file document, the file itself lives in the Documents module."
  Indexes {
    employee_id [name: 'employee_documents_employee_id_idx']
    document_id [unique, name: 'employee_documents_document_id_uq']
  }
}

Table hr.employee_transfers {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  employee_id uuid [not null]
  transfer_type text [not null, default: 'department']
  from_department_id uuid [note: "Logical reference to organization.departments.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  to_department_id uuid [note: "Logical reference to organization.departments.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  from_position_id uuid [note: "Logical reference to organization.positions.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  to_position_id uuid [note: "Logical reference to organization.positions.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  effective_date date
  status text [not null, default: 'draft']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Transfer or promotion of an employee."
  Indexes {
    (organization_id, code) [unique, name: 'employee_transfers_org_code_uq']
    employee_id [name: 'employee_transfers_employee_id_idx']
    status [name: 'employee_transfers_status_idx']
  }
  Checks {
    `transfer_type IN ('department', 'position', 'branch', 'salary', 'demotion', 'promotion')`
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'effective', 'cancelled')`
  }
}

Table hr.separation_records {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  employee_id uuid [not null]
  separation_type text [not null, default: 'resignation']
  resignation_date date
  last_working_date date
  reason text
  exit_interview_notes text
  status text [not null, default: 'draft']
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Resignation or termination of an employee. The employee row is never hard deleted."
  Indexes {
    (organization_id, code) [unique, name: 'separation_records_org_code_uq']
    employee_id [name: 'separation_records_employee_id_idx']
    status [name: 'separation_records_status_idx']
  }
  Checks {
    `separation_type IN ('resignation', 'termination', 'retirement', 'end_of_contract')`
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'completed')`
    `last_working_date IS NULL OR resignation_date IS NULL OR last_working_date >= resignation_date`
  }
}

Ref: hr.employees.manager_employee_id > hr.employees.id [delete: set null]
Ref: hr.employee_addresses.employee_id > hr.employees.id [delete: cascade]
Ref: hr.employment_contracts.employee_id > hr.employees.id [delete: cascade]
Ref: hr.attendance_records.employee_id > hr.employees.id [delete: cascade]
Ref: hr.attendance_corrections.attendance_record_id > hr.attendance_records.id [delete: cascade]
Ref: hr.attendance_corrections.employee_id > hr.employees.id [delete: cascade]
Ref: hr.leave_requests.leave_type_id > hr.leave_types.id [delete: restrict]
Ref: hr.leave_requests.employee_id > hr.employees.id [delete: cascade]
Ref: hr.disciplinary_records.employee_id > hr.employees.id [delete: cascade]
Ref: hr.training_records.employee_id > hr.employees.id [delete: cascade]
Ref: hr.certifications.employee_id > hr.employees.id [delete: cascade]
Ref: hr.employee_salary_components.employee_id > hr.employees.id [delete: cascade]
Ref: hr.bank_accounts.employee_id > hr.employees.id [delete: cascade]
Ref: hr.employee_emergencies.employee_id > hr.employees.id [delete: cascade]
Ref: hr.employee_documents.employee_id > hr.employees.id [delete: cascade]
Ref: hr.employee_transfers.employee_id > hr.employees.id [delete: cascade]
Ref: hr.separation_records.employee_id > hr.employees.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Payroll  (schema: payroll)
// Salary components, periods, runs, payslips, inputs, adjustments, payment
// batches, BPJS registration and payslip acknowledgement. Tenant scoped.
// ---------------------------------------------------------------------------

Table payroll.salary_components {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  component_type text [not null, default: 'earning']
  calculation_type text [not null, default: 'fixed']
  default_amount bigint [not null, default: 0]
  default_percentage numeric(9,4)
  is_taxable boolean [not null, default: true]
  is_employer_contribution boolean [not null, default: false]
  is_pension boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Definition of a payroll component such as base salary, transport allowance or BPJS."
  Indexes {
    (organization_id, code) [unique, name: 'salary_components_org_code_uq']
  }
  Checks {
    `component_type IN ('earning', 'deduction', 'employer_contribution')`
    `calculation_type IN ('fixed', 'percentage', 'formula')`
    `default_amount >= 0`
    `default_percentage IS NULL OR (default_percentage >= 0 AND default_percentage <= 100)`
  }
}

Table payroll.payroll_periods {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  period_year integer [not null]
  period_month integer [not null]
  start_date date [not null]
  end_date date [not null]
  payment_date date
  status text [not null, default: 'open']
  closed_at bigint
  closed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Payroll period. Once closed it can no longer receive inputs."
  Indexes {
    (organization_id, code) [unique, name: 'payroll_periods_org_code_uq']
    (organization_id, period_year, period_month) [unique, name: 'payroll_periods_period_uq']
  }
  Checks {
    `period_month BETWEEN 1 AND 12`
    `end_date >= start_date`
    `status IN ('open', 'calculating', 'closed')`
  }
}

Table payroll.payroll_runs {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  payroll_period_id uuid [not null]
  status text [not null, default: 'draft']
  employee_count integer [not null, default: 0]
  total_gross bigint [not null, default: 0]
  total_deductions bigint [not null, default: 0]
  total_employer_contributions bigint [not null, default: 0]
  total_net bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  calculated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  calculated_at bigint
  submitted_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Payroll run header. Preparation, approval and payment execution are three separate steps with three separate permissions."
  Indexes {
    (organization_id, code) [unique, name: 'payroll_runs_org_code_uq']
    payroll_period_id [name: 'payroll_runs_period_id_idx']
    status [name: 'payroll_runs_status_idx']
  }
  Checks {
    `status IN ('draft', 'calculated', 'submitted', 'approved', 'paid', 'cancelled')`
    `total_gross >= 0`
    `total_deductions >= 0`
    `total_net >= 0`
    `employee_count >= 0`
  }
}

Table payroll.payslips {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  payroll_run_id uuid [not null]
  employee_id uuid [not null, note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  code varchar(32) [not null]
  gross_pay bigint [not null, default: 0]
  total_deductions bigint [not null, default: 0]
  total_employer_contributions bigint [not null, default: 0]
  net_pay bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  payment_status text [not null, default: 'unpaid']
  payment_date date
  published_at bigint
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Payslip of one employee in one payroll run."
  Indexes {
    (organization_id, code) [unique, name: 'payslips_org_code_uq']
    payroll_run_id [name: 'payslips_run_id_idx']
    employee_id [name: 'payslips_employee_id_idx']
    payment_status [name: 'payslips_payment_status_idx']
  }
  Checks {
    `payment_status IN ('unpaid', 'scheduled', 'paid', 'failed', 'cancelled')`
    `gross_pay >= 0`
    `total_deductions >= 0`
    `net_pay >= 0`
  }
}

Table payroll.payslip_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  payslip_id uuid [not null]
  salary_component_id uuid
  component_code text [not null]
  component_name text [not null]
  amount bigint [not null, default: 0]
  is_deduction boolean [not null, default: false]
  sequence integer [not null, default: 0]
  created_at bigint [not null]
  Note: "Line of a payslip. The component snapshot is copied so a later component change never rewrites history."
  Indexes {
    payslip_id [name: 'payslip_items_payslip_id_idx']
    (payslip_id, sequence) [unique, name: 'payslip_items_sequence_uq']
  }
  Checks {
    `amount >= 0`
  }
}

Table payroll.payroll_inputs {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  employee_id uuid [not null, note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  payroll_period_id uuid [not null]
  input_type text [not null]
  source text [not null, default: 'manual']
  overtime_hours numeric(8,2) [not null, default: 0]
  bonus_amount bigint [not null, default: 0]
  absence_days numeric(8,2) [not null, default: 0]
  late_minutes integer [not null, default: 0]
  source_reference text
  note text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Approved input for the payroll calculation. Overtime and absence come from the attendance records."
  Indexes {
    (organization_id, employee_id, payroll_period_id, input_type) [unique, name: 'payroll_inputs_scope_uq']
    payroll_period_id [name: 'payroll_inputs_period_id_idx']
  }
  Checks {
    `input_type IN ('overtime', 'bonus', 'absence', 'allowance', 'deduction', 'adjustment')`
    `source IN ('manual', 'attendance', 'import', 'approval')`
    `overtime_hours >= 0`
    `bonus_amount >= 0`
    `absence_days >= 0`
    `late_minutes >= 0`
  }
}

Table payroll.payroll_adjustments {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  payroll_run_id uuid [not null]
  employee_id uuid [not null, note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  adjustment_code text [not null]
  description text
  amount bigint [not null, default: 0]
  is_deduction boolean [not null, default: false]
  status text [not null, default: 'requested']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  requested_at bigint [not null]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Adjustment on one payslip of a run, for example a correction after the run was calculated."
  Indexes {
    (organization_id, code) [unique, name: 'payroll_adjustments_org_code_uq']
    payroll_run_id [name: 'payroll_adjustments_run_id_idx']
    employee_id [name: 'payroll_adjustments_employee_id_idx']
    status [name: 'payroll_adjustments_status_idx']
  }
  Checks {
    `status IN ('requested', 'approved', 'rejected', 'applied')`
    `amount >= 0`
  }
}

Table payroll.payroll_payments {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  payroll_run_id uuid [not null]
  payment_method text [not null, default: 'bank_transfer']
  payment_date date
  total_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  executed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  executed_at bigint
  proof_document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Payment batch of a payroll run. Execution is only allowed on an approved run."
  Indexes {
    (organization_id, code) [unique, name: 'payroll_payments_org_code_uq']
    payroll_run_id [name: 'payroll_payments_run_id_idx']
    status [name: 'payroll_payments_status_idx']
  }
  Checks {
    `payment_method IN ('bank_transfer', 'cash')`
    `status IN ('draft', 'scheduled', 'executing', 'executed', 'failed', 'cancelled')`
    `total_amount >= 0`
  }
}

Table payroll.payroll_payment_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  payroll_payment_id uuid [not null]
  payslip_id uuid [not null]
  employee_id uuid [not null, note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  bank_account_id uuid [note: "Logical reference to hr.bank_accounts.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  amount bigint [not null, default: 0]
  status text [not null, default: 'pending']
  reference_number text
  paid_at bigint
  failure_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "One payment per payslip."
  Indexes {
    payroll_payment_id [name: 'payroll_payment_items_payment_id_idx']
    payslip_id [name: 'payroll_payment_items_payslip_id_idx']
    (payroll_payment_id, payslip_id) [unique, name: 'payroll_payment_items_uq']
  }
  Checks {
    `status IN ('pending', 'sent', 'paid', 'failed', 'cancelled')`
    `amount >= 0`
  }
}

Table payroll.bpjs_registrations {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  employee_id uuid [not null, note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  bpjs_number text
  bpjs_type text [not null]
  monthly_contribution bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  registered_on date
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "BPJS health and employment registration of an employee."
  Indexes {
    employee_id [name: 'bpjs_registrations_employee_id_idx']
    bpjs_number [name: 'bpjs_registrations_number_idx']
  }
  Checks {
    `bpjs_type IN ('kesehatan', 'ketenagakerjaan', 'both')`
    `monthly_contribution >= 0`
  }
}

Table payroll.payslip_acknowledgements {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  payslip_id uuid [not null]
  employee_id uuid [not null, note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  acknowledged_at bigint
  dispute_reason text
  status text [not null, default: 'pending']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Employee acknowledgement of a published payslip, with the dispute channel."
  Indexes {
    payslip_id [unique, name: 'payslip_acknowledgements_payslip_id_uq']
    employee_id [name: 'payslip_acknowledgements_employee_id_idx']
  }
  Checks {
    `status IN ('pending', 'acknowledged', 'disputed', 'resolved')`
  }
}

Ref: payroll.payroll_runs.payroll_period_id > payroll.payroll_periods.id [delete: restrict]
Ref: payroll.payslips.payroll_run_id > payroll.payroll_runs.id [delete: cascade]
Ref: payroll.payslip_items.payslip_id > payroll.payslips.id [delete: cascade]
Ref: payroll.payslip_items.salary_component_id > payroll.salary_components.id [delete: restrict]
Ref: payroll.payroll_inputs.payroll_period_id > payroll.payroll_periods.id [delete: cascade]
Ref: payroll.payroll_adjustments.payroll_run_id > payroll.payroll_runs.id [delete: cascade]
Ref: payroll.payroll_payments.payroll_run_id > payroll.payroll_runs.id [delete: restrict]
Ref: payroll.payroll_payment_items.payroll_payment_id > payroll.payroll_payments.id [delete: cascade]
Ref: payroll.payroll_payment_items.payslip_id > payroll.payslips.id [delete: restrict]
Ref: payroll.payslip_acknowledgements.payslip_id > payroll.payslips.id [delete: cascade]


// ---------------------------------------------------------------------------
// MODULE: Finance  (schema: finance)
// Single payment ledger (finance.payments), credit memos, receipts, supplier
// bills, expense claims, employee advances and expense settlements, cash and
// bank accounts, reconciliation, payment terms.
// Customer invoices moved to sales.invoices (finance plan D2).
// Tenant scoped.
// ---------------------------------------------------------------------------

// Finance plan D6: finance.expense_settlements(_items),
// finance.expense_claims(_items), finance.employee_advances and
// finance.credit_memos are DEFERRED (not built in Stage 1).

Table finance.payments {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  payment_type text [not null]
  direction text [not null]
  counterparty_type text
  counterparty_id text
  sales_invoice_id uuid [note: "Logical reference to sales.invoices.id. Cross-module FK intentionally omitted. Validated through the Sales module contract."]
  supplier_bill_id uuid
  employee_advance_id uuid
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  payment_method text [not null, default: 'bank_transfer']
  payment_date date
  status text [not null, default: 'draft']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  requested_at bigint
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  executed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  executed_at bigint
  cash_bank_account_id uuid
  reference_number text
  notes text
  voided_at bigint
  void_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "THE single payment ledger of the ERP. Receipts and disbursements both live here. A payment can settle at most one invoice, one supplier bill and one employee advance. Execution requires approval and is not allowed by the requester."
  Indexes {
    (organization_id, code) [unique, name: 'payments_org_code_uq']
    sales_invoice_id [name: 'payments_sales_invoice_id_idx']
    supplier_bill_id [name: 'payments_supplier_bill_id_idx']
    employee_advance_id [name: 'payments_employee_advance_id_idx']
    status [name: 'payments_status_idx']
    (organization_id, counterparty_type, counterparty_id) [name: 'payments_counterparty_idx']
    cash_bank_account_id [name: 'payments_cash_bank_account_id_idx']
  }
  Checks {
    `payment_type IN ('receipt', 'disbursement', 'refund', 'advance_disbursement', 'payroll', 'profit_distribution', 'investment')`
    `direction IN ('in', 'out')`
    `status IN ('draft', 'submitted', 'approved', 'executed', 'reversed', 'void', 'cancelled')`
    `amount > 0`
    `payment_method IN ('bank_transfer', 'cash', 'card', 'e_wallet', 'cheque', 'offset')`
  }
}

Table finance.expense_settlements {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  employee_id uuid [not null, note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  project_id uuid [note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted. Validated through the Projects module contract."]
  settlement_type text [not null, default: 'expense']
  employee_advance_id uuid
  total_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  settlement_date date
  status text [not null, default: 'draft']
  submitted_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  verified_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  verified_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Settlement of a project advance and of the operational expenses of an employee. Verification and approval are separate steps."
  Indexes {
    (organization_id, code) [unique, name: 'expense_settlements_org_code_uq']
    employee_id [name: 'expense_settlements_employee_id_idx']
    employee_advance_id [name: 'expense_settlements_advance_id_idx']
    status [name: 'expense_settlements_status_idx']
  }
  Checks {
    `settlement_type IN ('expense', 'advance')`
    `status IN ('draft', 'submitted', 'verified', 'approved', 'rejected', 'paid', 'cancelled')`
    `total_amount >= 0`
  }
}

Table finance.expense_settlement_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  expense_settlement_id uuid [not null]
  expense_date date
  category_code text
  description text
  amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  is_advance_offset boolean [not null, default: false]
  project_id uuid [note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted. Validated through the Projects module contract."]
  receipt_document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  Note: "Line of an expense settlement."
  Indexes {
    expense_settlement_id [name: 'expense_settlement_items_settlement_id_idx']
  }
  Checks {
    `amount >= 0`
    `tax_amount >= 0`
  }
}

Table finance.employee_advances {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  employee_id uuid [not null, note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  project_id uuid [note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted. Validated through the Projects module contract."]
  amount bigint [not null, default: 0]
  settled_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  request_date date
  purpose text
  status text [not null, default: 'draft']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  disbursed_at bigint
  payment_id uuid
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Cash advance to an employee. Disbursement is a finance.payments row, the advance is never a payment ledger of its own."
  Indexes {
    (organization_id, code) [unique, name: 'employee_advances_org_code_uq']
    employee_id [name: 'employee_advances_employee_id_idx']
    project_id [name: 'employee_advances_project_id_idx']
    status [name: 'employee_advances_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'disbursed', 'settled', 'cancelled')`
    `amount > 0`
    `settled_amount >= 0`
    `settled_amount <= amount`
  }
}

Table finance.cash_bank_accounts {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  account_type text [not null, default: 'bank']
  bank_name text
  account_number text
  account_holder text
  currency_code varchar(3) [not null, default: 'IDR']
  opening_balance bigint [not null, default: 0]
  current_balance bigint [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Operational cash and bank account used by the payment ledger and by reconciliation."
  Indexes {
    (organization_id, code) [unique, name: 'cash_bank_accounts_org_code_uq']
    account_number [name: 'cash_bank_accounts_account_number_idx']
  }
  Checks {
    `account_type IN ('cash', 'bank', 'ewallet', 'clearing')`
    `opening_balance >= 0`
  }
}

Table finance.cash_bank_transactions {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  cash_bank_account_id uuid [not null]
  transaction_date date [not null]
  direction text [not null]
  amount bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  source_type text
  source_id text
  description text
  reference_number text
  status text [not null, default: 'posted']
  balance_after bigint [not null, default: 0]
  posted_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  posted_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Movement on a cash or bank account, produced by a posted payment. Reconciliation works on this ledger."
  Indexes {
    (organization_id, code) [unique, name: 'cash_bank_transactions_org_code_uq']
    cash_bank_account_id [name: 'cash_bank_transactions_account_id_idx']
    transaction_date [name: 'cash_bank_transactions_date_idx']
    (source_type, source_id) [name: 'cash_bank_transactions_source_idx']
  }
  Checks {
    `direction IN ('in', 'out')`
    `status IN ('draft', 'posted', 'reversed')`
    `amount > 0`
  }
}

Table finance.bank_reconciliations {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  cash_bank_account_id uuid [not null]
  reconciliation_date date [not null]
  statement_balance bigint [not null, default: 0]
  book_balance bigint [not null, default: 0]
  difference bigint [not null, default: 0]
  status text [not null, default: 'draft']
  reconciled_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  reconciled_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Reconciliation of one bank statement against the book balance."
  Indexes {
    (organization_id, code) [unique, name: 'bank_reconciliations_org_code_uq']
    cash_bank_account_id [name: 'bank_reconciliations_account_id_idx']
    reconciliation_date [name: 'bank_reconciliations_date_idx']
  }
  Checks {
    `status IN ('draft', 'in_progress', 'reconciled', 'closed')`
  }
}

Table finance.bank_reconciliation_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  bank_reconciliation_id uuid [not null]
  cash_bank_transaction_id uuid
  statement_reference text
  statement_amount bigint
  is_matched boolean [not null, default: false]
  notes text
  created_at bigint [not null]
  Note: "Line of a reconciliation, matched against a book transaction."
  Indexes {
    bank_reconciliation_id [name: 'bank_reconciliation_items_reconciliation_id_idx']
    cash_bank_transaction_id [name: 'bank_reconciliation_items_transaction_id_idx']
  }
}

Table finance.supplier_bills {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  supplier_id uuid [not null, note: "Logical reference to procurement.suppliers.id. Cross-module FK intentionally omitted. Validated through the Procurement module contract."]
  purchase_order_id uuid [note: "Logical reference to procurement.purchase_orders.id. Cross-module FK intentionally omitted. Validated through the Procurement module contract."]
  bill_date date
  due_date date
  subtotal bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  paid_total bigint [not null, default: 0]
  outstanding_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Accounts payable document of a supplier. Payments are rows of finance.payments."
  Indexes {
    (organization_id, code) [unique, name: 'supplier_bills_org_code_uq']
    supplier_id [name: 'supplier_bills_supplier_id_idx']
    purchase_order_id [name: 'supplier_bills_purchase_order_id_idx']
    status [name: 'supplier_bills_status_idx']
    due_date [name: 'supplier_bills_due_date_idx']
  }
  Checks {
    `status IN ('draft', 'approved', 'partially_paid', 'paid', 'overdue', 'void')`
    `subtotal >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
    `paid_total >= 0`
    `outstanding_total >= 0`
  }
}

Table finance.payment_terms {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  days integer [not null, default: 0]
  discount_percent numeric(5,2)
  discount_days integer
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Payment terms, for example cash on delivery or 30 days net."
  Indexes {
    (organization_id, code) [unique, name: 'payment_terms_org_code_uq']
  }
  Checks {
    `days >= 0`
    `discount_percent IS NULL OR (discount_percent >= 0 AND discount_percent <= 100)`
  }
}

Table finance.expense_claims {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  employee_id uuid [not null, note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  department_id uuid [note: "Logical reference to organization.departments.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  claim_date date
  total_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'draft']
  submitted_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  payment_id uuid
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Operational expense claim of an employee, settled by a finance.payments disbursement."
  Indexes {
    (organization_id, code) [unique, name: 'expense_claims_org_code_uq']
    employee_id [name: 'expense_claims_employee_id_idx']
    status [name: 'expense_claims_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'paid', 'cancelled')`
    `total_amount >= 0`
  }
}

Table finance.expense_claim_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  expense_claim_id uuid [not null]
  expense_date date
  category_code text
  description text
  amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  receipt_document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  Note: "Line of an expense claim."
  Indexes {
    expense_claim_id [name: 'expense_claim_items_claim_id_idx']
  }
  Checks {
    `amount >= 0`
    `tax_amount >= 0`
  }
}

Table finance.payment_allocations {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  payment_id uuid [not null]
  target_type text [not null]
  sales_invoice_id uuid
  supplier_bill_id uuid
  allocated_amount bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  allocated_at bigint [not null]
  created_at bigint [not null]
  Note: "Allocation of one payment to one target document (a sales invoice or a supplier bill), for documents settled in several instalments."
  Indexes {
    (payment_id, target_type, sales_invoice_id, supplier_bill_id) [unique, name: 'payment_allocations_uq']
    sales_invoice_id [name: 'payment_allocations_sales_invoice_id_idx']
    supplier_bill_id [name: 'payment_allocations_supplier_bill_id_idx']
  }
  Checks {
    `target_type IN ('sales_invoice', 'supplier_bill')`
    `(target_type = 'sales_invoice' AND sales_invoice_id IS NOT NULL) OR (target_type = 'supplier_bill' AND supplier_bill_id IS NOT NULL)`
    `allocated_amount > 0`
  }
}

Table finance.ar_open_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  sales_invoice_id uuid [not null, note: "Logical reference to sales.invoices.id. Cross-module FK intentionally omitted. Validated through the Sales module contract."]
  customer_id uuid [note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  invoice_date date
  due_date date
  original_amount bigint [not null]
  paid_amount bigint [not null, default: 0]
  outstanding_amount bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'open']
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Accounts receivable open-item sub-ledger. Finance's own mirror of what is still owed per issued invoice, updated through the posting flow. Never computed by reading sales tables. Aging reports are built on this table."
  Indexes {
    (organization_id, sales_invoice_id) [unique, name: 'ar_open_items_org_invoice_uq']
    customer_id [name: 'ar_open_items_customer_id_idx']
    status [name: 'ar_open_items_status_idx']
    due_date [name: 'ar_open_items_due_date_idx']
  }
  Checks {
    `status IN ('open', 'partially_paid', 'paid', 'void')`
    `original_amount >= 0`
    `paid_amount >= 0`
    `outstanding_amount >= 0`
    `outstanding_amount = original_amount - paid_amount`
  }
}

Table finance.ap_open_items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  supplier_bill_id uuid [not null, note: "Logical reference to finance.supplier_bills.id."]
  supplier_id uuid [note: "Logical reference to procurement.suppliers.id. Cross-module FK intentionally omitted. Validated through the Procurement module contract."]
  bill_date date
  due_date date
  original_amount bigint [not null]
  paid_amount bigint [not null, default: 0]
  outstanding_amount bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'open']
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Accounts payable open-item sub-ledger, the AP twin of finance.ar_open_items."
  Indexes {
    (organization_id, supplier_bill_id) [unique, name: 'ap_open_items_org_bill_uq']
    supplier_id [name: 'ap_open_items_supplier_id_idx']
    status [name: 'ap_open_items_status_idx']
    due_date [name: 'ap_open_items_due_date_idx']
  }
  Checks {
    `status IN ('open', 'partially_paid', 'paid', 'void')`
    `original_amount >= 0`
    `paid_amount >= 0`
    `outstanding_amount >= 0`
    `outstanding_amount = original_amount - paid_amount`
  }
}

Table finance.credit_memos {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  sales_invoice_id uuid
  customer_id uuid [note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  memo_date date
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  reason text
  status text [not null, default: 'draft']
  issued_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  issued_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Credit note against an invoice. It reduces the receivable, it is not a payment."
  Indexes {
    (organization_id, code) [unique, name: 'credit_memos_org_code_uq']
    sales_invoice_id [name: 'credit_memos_sales_invoice_id_idx']
    status [name: 'credit_memos_status_idx']
  }
  Checks {
    `status IN ('draft', 'issued', 'applied', 'void')`
    `amount > 0`
  }
}

Ref: sales.invoice_items.invoice_id > sales.invoices.id [delete: cascade]
// finance.payments.sales_invoice_id, finance.payment_allocations.sales_invoice_id and
// finance.credit_memos.sales_invoice_id are logical references to
// sales.invoices.id — cross-module refs are intentionally FK-free.
Ref: finance.payments.supplier_bill_id > finance.supplier_bills.id [delete: restrict]
Ref: finance.payments.employee_advance_id > finance.employee_advances.id [delete: restrict]
Ref: finance.payments.cash_bank_account_id > finance.cash_bank_accounts.id [delete: restrict]
Ref: finance.expense_settlements.employee_advance_id > finance.employee_advances.id [delete: set null]
Ref: finance.expense_settlement_items.expense_settlement_id > finance.expense_settlements.id [delete: cascade]
Ref: finance.employee_advances.payment_id > finance.payments.id [delete: set null]
Ref: finance.cash_bank_transactions.cash_bank_account_id > finance.cash_bank_accounts.id [delete: restrict]
Ref: finance.bank_reconciliations.cash_bank_account_id > finance.cash_bank_accounts.id [delete: restrict]
Ref: finance.bank_reconciliation_items.bank_reconciliation_id > finance.bank_reconciliations.id [delete: cascade]
Ref: finance.bank_reconciliation_items.cash_bank_transaction_id > finance.cash_bank_transactions.id [delete: set null]
Ref: finance.expense_claims.payment_id > finance.payments.id [delete: set null]
Ref: finance.expense_claim_items.expense_claim_id > finance.expense_claims.id [delete: cascade]
Ref: finance.payment_allocations.payment_id > finance.payments.id [delete: cascade]
Ref: finance.ap_open_items.supplier_bill_id > finance.supplier_bills.id [delete: restrict]
// finance.ar_open_items.sales_invoice_id is a logical reference to
// sales.invoices.id — cross-module refs are intentionally FK-free.

// ---------------------------------------------------------------------------
// MODULE: Accounting  (schema: accounting)
// Chart of accounts, journal entries and lines, periods, tax types and
// records, opening balances, account balances, bank account links,
// withholding taxes, settings and journal templates. Tenant scoped.
// ---------------------------------------------------------------------------

Table accounting.chart_of_accounts {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  account_type text [not null]
  normal_balance text [not null, default: 'debit']
  parent_account_id uuid
  level smallint [not null, default: 1]
  is_postable boolean [not null, default: true]
  is_system boolean [not null, default: false]
  is_active boolean [not null, default: true]
  cash_flow_category text [note: "Direct-method cash-flow mapping (finance plan D11). Only set for accounts whose movement feeds the cash-flow statement."]
  description text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Chart of accounts. Only postable accounts accept journal lines. System accounts cannot be deleted."
  Indexes {
    (organization_id, code) [unique, name: 'chart_of_accounts_org_code_uq']
    parent_account_id [name: 'chart_of_accounts_parent_account_id_idx']
    account_type [name: 'chart_of_accounts_account_type_idx']
  }
  Checks {
    `account_type IN ('asset', 'liability', 'equity', 'revenue', 'expense')`
    `normal_balance IN ('debit', 'credit')`
    `cash_flow_category IS NULL OR cash_flow_category IN ('operating', 'investing', 'financing')`
    `level >= 1`
  }
}

Table accounting.accounting_periods {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  period_year integer [not null]
  period_month integer [not null]
  start_date date [not null]
  end_date date [not null]
  status text [not null, default: 'open']
  closed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  closed_at bigint
  reopened_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  reopened_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Accounting period. A closed period rejects new journal entries."
  Indexes {
    (organization_id, code) [unique, name: 'accounting_periods_org_code_uq']
    (organization_id, period_year, period_month) [unique, name: 'accounting_periods_period_uq']
  }
  Checks {
    `period_month BETWEEN 1 AND 12`
    `end_date >= start_date`
    `status IN ('open', 'closed', 'locked')`
  }
}

Table accounting.journal_entries {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  accounting_period_id uuid [not null]
  entry_date date [not null]
  description text
  source_type text
  source_id text
  idempotency_key text [note: "Posting-service idempotency: a second posted entry with the same (organization_id, idempotency_key) is refused. Null keys skip the rule."]
  source_module text [not null, default: 'accounting', note: "Producing module, guarded by the posting service. Other modules never write journal rows directly."]
  status text [not null, default: 'draft']
  total_debit bigint [not null, default: 0]
  total_credit bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  prepared_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  posted_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  posted_at bigint
  reversed_by_entry_id uuid
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Journal header. Debit must equal credit, the posting service enforces it inside one transaction."
  Indexes {
    (organization_id, code) [unique, name: 'journal_entries_org_code_uq']
    accounting_period_id [name: 'journal_entries_period_id_idx']
    status [name: 'journal_entries_status_idx']
    entry_date [name: 'journal_entries_entry_date_idx']
    source_type [name: 'journal_entries_source_type_idx']
    source_id [name: 'journal_entries_source_id_idx']
    (organization_id, idempotency_key) [unique, name: 'journal_entries_idempotency_uq', note: "WHERE idempotency_key IS NOT NULL AND status <> 'void'"]
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'posted', 'reversed', 'void')`
    `total_debit >= 0`
    `total_credit >= 0`
    `total_debit = total_credit`
    `source_module IN ('accounting', 'finance', 'sales', 'procurement', 'inventory', 'assets', 'payroll', 'organization')`
  }
}

Table accounting.journal_lines {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  journal_entry_id uuid [not null]
  line_no integer [not null]
  account_id uuid [not null]
  debit bigint [not null, default: 0]
  credit bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  description text
  cost_center_id uuid [note: "Logical reference to organization.cost_centers.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  project_id uuid [note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted. Validated through the Projects module contract."]
  party_type text
  party_id text
  created_at bigint [not null]
  Note: "Journal line. Exactly one of debit and credit is positive."
  Indexes {
    journal_entry_id [name: 'journal_lines_entry_id_idx']
    account_id [name: 'journal_lines_account_id_idx']
    (journal_entry_id, line_no) [unique, name: 'journal_lines_line_no_uq']
  }
  Checks {
    `debit >= 0`
    `credit >= 0`
    `(debit > 0 AND credit = 0) OR (credit > 0 AND debit = 0)`
  }
}

Table accounting.tax_types {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  tax_type text [not null]
  rate numeric(9,4) [not null, default: 0]
  base_type text [not null, default: 'gross']
  is_inclusive boolean [not null, default: false]
  effective_from date [not null]
  effective_to date
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Effective dated tax rate, PPN or PPh. The rate is stored as a decimal percentage, not as a float amount. A rate change is a new row with a new effective_from; ranges for the same code must not overlap (enforced in the service, not by a database constraint). Soft-deleted rows are excluded from the uniqueness rule."
  Indexes {
    (organization_id, code, effective_from) [unique, name: 'tax_types_org_code_effective_uq', note: 'WHERE deleted_at IS NULL']
    effective_from [name: 'tax_types_effective_from_idx']
  }
  Checks {
    `tax_type IN ('ppn', 'pph', 'ppn_input', 'ppn_output', 'other')`
    `base_type IN ('gross', 'net', 'specific')`
    `rate >= 0`
    `effective_to IS NULL OR effective_to >= effective_from`
  }
}

Table accounting.tax_records {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  tax_type_id uuid [not null]
  period_year integer [not null]
  period_month integer [not null]
  taxable_base bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  filing_status text [not null, default: 'draft']
  filed_on date
  verified_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Tax recap workpaper for a period. Filing itself stays outside the ERP. One recap per tax type per period. Corrections are separate rows in accounting.tax_corrections; tax_amount is never edited to reflect them."
  Indexes {
    (organization_id, code) [unique, name: 'tax_records_org_code_uq', note: 'WHERE deleted_at IS NULL']
    (organization_id, tax_type_id, period_year, period_month) [unique, name: 'tax_records_org_type_period_uq', note: 'WHERE deleted_at IS NULL']
    tax_type_id [name: 'tax_records_tax_type_id_idx']
    (organization_id, period_year, period_month) [name: 'tax_records_period_idx']
  }
  Checks {
    `period_month BETWEEN 1 AND 12`
    `taxable_base >= 0`
    `tax_amount >= 0`
    `filing_status IN ('draft', 'verified', 'filed', 'corrected')`
  }
}

Table accounting.tax_corrections {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  tax_record_id uuid [not null]
  amount bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  reason text [not null]
  evidence_document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_by text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Signed correction against a tax recap. The original tax_amount is kept unchanged. Net payable is recap plus the sum of active corrections, computed at read time."
  Indexes {
    tax_record_id [name: 'tax_corrections_tax_record_id_idx']
    evidence_document_id [name: 'tax_corrections_evidence_document_id_idx']
  }
  Checks {
    `amount <> 0`
    `char_length(trim(reason)) > 0`
  }
}

Table accounting.opening_balances {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  account_id uuid [not null]
  as_of_date date [not null]
  debit_balance bigint [not null, default: 0]
  credit_balance bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  description text
  posted_at bigint
  created_at bigint [not null]
  Note: "Opening balance of an account at the start of the system."
  Indexes {
    (account_id, as_of_date) [unique, name: 'opening_balances_account_date_uq']
  }
  Checks {
    `debit_balance >= 0`
    `credit_balance >= 0`
  }
}

Table accounting.account_balances {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  account_id uuid [not null]
  accounting_period_id uuid [not null]
  balance_date date [not null]
  debit_total bigint [not null, default: 0]
  credit_total bigint [not null, default: 0]
  closing_balance bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  calculated_at bigint
  Note: "Balance snapshot of an account at the end of a period, derived from the posted journal entries."
  Indexes {
    (account_id, accounting_period_id) [unique, name: 'account_balances_account_period_uq']
  }
  Checks {
    `debit_total >= 0`
    `credit_total >= 0`
  }
}

Table accounting.bank_account_links {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cash_bank_account_id uuid [not null, note: "Logical reference to finance.cash_bank_accounts.id. Cross-module FK intentionally omitted. Validated through the Finance module contract."]
  chart_of_account_id uuid [not null]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Links a cash or bank account to its general ledger account."
  Indexes {
    cash_bank_account_id [unique, name: 'bank_account_links_cash_bank_account_id_uq']
    chart_of_account_id [name: 'bank_account_links_chart_of_account_id_idx']
  }
}

Table accounting.withholding_tax_records {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  tax_type_id uuid [not null]
  counterparty_type text
  counterparty_id text
  base_amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  transaction_date date
  period_year integer
  period_month integer
  status text [not null, default: 'recorded']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Withholding tax collected on a payment."
  Indexes {
    (organization_id, code) [unique, name: 'withholding_tax_records_org_code_uq']
    tax_type_id [name: 'withholding_tax_records_tax_type_id_idx']
    (counterparty_type, counterparty_id) [name: 'withholding_tax_records_counterparty_idx']
  }
  Checks {
    `base_amount >= 0`
    `tax_amount >= 0`
    `status IN ('recorded', 'verified', 'paid', 'reversed')`
  }
}

Table accounting.accounting_settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  description text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Accounting configuration key value store."
  Indexes {
    (organization_id, setting_group, setting_key) [unique, name: 'accounting_settings_scope_uq']
  }
}

Table accounting.journal_templates {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  line_definitions text
  source_type text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Template that pre fills a journal entry, for example the monthly payroll journal."
  Indexes {
    (organization_id, code) [unique, name: 'journal_templates_org_code_uq']
  }
}

