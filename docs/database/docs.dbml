// ---------------------------------------------------------------------------
// MODULE: Sales  (schema: sales)
// Quotation to order flow, contracts, targets, status history, returns and
// delivery notes. Tenant scoped.
// sales.quotations is shown in its TARGET shape. The scaffold table created by
// migration 20261029044823_dear_living_lightning has a different shape and is
// replaced, not altered, by the recreation migration in implementation-phases.md.
// The transitional sales.payments table is documented in the Legacy group at
// the end of this file.
// ---------------------------------------------------------------------------

Table sales.quotations {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  title text
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  customer_contact_id uuid [note: "Logical reference to crm.customer_contacts.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  price_list_id uuid [note: "Logical reference to catalog.price_lists.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  status text [not null, default: 'draft']
  quotation_date date
  valid_until date
  subtotal bigint [not null, default: 0]
  discount_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  sent_at bigint
  rejected_reason text
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Quotation header, SPH in Indonesian practice. Approval follows draft, submitted, approved or rejected. Self approval is rejected by the service layer."
  Indexes {
    (organization_id, code) [unique, name: 'quotations_org_code_uq']
    customer_id [name: 'quotations_customer_id_idx']
    status [name: 'quotations_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'sent', 'expired', 'cancelled')`
    `subtotal >= 0`
    `discount_total >= 0`
    `tax_total >= 0`
    `grand_total >= 0`
  }
}

Table sales.quotation_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  quotation_id uuid [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  description text
  quantity numeric(18,3) [not null, default: 1]
  unit_id uuid [note: "Logical reference to catalog.units.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  unit_price bigint [not null, default: 0]
  discount_amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a quotation. Line total is derived, never trusted from the client."
  Indexes {
    quotation_id [name: 'quotation_items_quotation_id_idx']
    sort_order [name: 'quotation_items_sort_order_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `discount_amount >= 0`
    `tax_amount >= 0`
    `line_total >= 0`
  }
}

Table sales.discount_requests {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  quotation_id uuid
  sales_order_id uuid
  discount_type text [not null]
  discount_value numeric(18,4) [not null]
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  reason text
  status text [not null, default: 'requested']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  requested_at bigint [not null]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  rejected_reason text
  Note: "Discount request on a quotation or on a sales order. Exactly one parent is set."
  Indexes {
    quotation_id [name: 'discount_requests_quotation_id_idx']
    sales_order_id [name: 'discount_requests_sales_order_id_idx']
    status [name: 'discount_requests_status_idx']
  }
  Checks {
    `discount_type IN ('percentage', 'fixed')`
    `status IN ('requested', 'approved', 'rejected', 'cancelled')`
    `discount_value >= 0`
    `amount >= 0`
    `(quotation_id IS NOT NULL AND sales_order_id IS NULL) OR (quotation_id IS NULL AND sales_order_id IS NOT NULL)`
  }
}

Table sales.sales_orders {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  quotation_id uuid
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  customer_address_id uuid [note: "Logical reference to crm.customer_addresses.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  status text [not null, default: 'draft']
  order_date date
  delivery_date date
  subtotal bigint [not null, default: 0]
  discount_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  shipping_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  sales_person_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  warehouse_id uuid [note: "Logical reference to inventory.warehouses.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  cancelled_at bigint
  cancellation_reason text
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Confirmed customer order. Stock commitment is done by the Inventory module through a logical reservation."
  Indexes {
    (organization_id, code) [unique, name: 'sales_orders_org_code_uq']
    quotation_id [name: 'sales_orders_quotation_id_idx']
    customer_id [name: 'sales_orders_customer_id_idx']
    status [name: 'sales_orders_status_idx']
  }
  Checks {
    `status IN ('draft', 'confirmed', 'in_progress', 'delivered', 'completed', 'cancelled')`
    `subtotal >= 0`
    `discount_total >= 0`
    `tax_total >= 0`
    `shipping_total >= 0`
    `grand_total >= 0`
  }
}

Table sales.sales_order_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  sales_order_id uuid [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  quotation_item_id uuid
  description text
  quantity numeric(18,3) [not null, default: 1]
  unit_id uuid [note: "Logical reference to catalog.units.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  unit_price bigint [not null, default: 0]
  discount_amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  quantity_delivered numeric(18,3) [not null, default: 0]
  fulfillment_status text [not null, default: 'pending']
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a sales order."
  Indexes {
    sales_order_id [name: 'sales_order_items_sales_order_id_idx']
    fulfillment_status [name: 'sales_order_items_fulfillment_status_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `discount_amount >= 0`
    `tax_amount >= 0`
    `line_total >= 0`
    `quantity_delivered >= 0`
    `fulfillment_status IN ('pending', 'reserved', 'partial', 'fulfilled', 'cancelled')`
  }
}

Table sales.contracts {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  sales_order_id uuid
  status text [not null, default: 'draft']
  contract_value bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  start_date date
  end_date date
  signed_on date
  document_id uuid [note: "Logical reference to documents.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Commercial contract with a customer, the legal basis of the order and of the project."
  Indexes {
    (organization_id, code) [unique, name: 'contracts_org_code_uq']
    sales_order_id [name: 'contracts_sales_order_id_idx']
    customer_id [name: 'contracts_customer_id_idx']
  }
  Checks {
    `status IN ('draft', 'active', 'expired', 'terminated')`
    `contract_value >= 0`
    `end_date IS NULL OR end_date >= start_date`
  }
}

Table sales.sales_targets {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  sales_user_id text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  period_year integer [not null]
  period_month integer
  target_amount bigint [not null, default: 0]
  achieved_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  status text [not null, default: 'active']
  assigned_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Sales target of a salesperson for a month or for a year."
  Indexes {
    (organization_id, sales_user_id, period_year, period_month) [unique, name: 'sales_targets_scope_uq']
  }
  Checks {
    `period_month IS NULL OR period_month BETWEEN 1 AND 12`
    `target_amount >= 0`
    `achieved_amount >= 0`
    `status IN ('active', 'closed', 'cancelled')`
  }
}

Table sales.quotation_status_history {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  quotation_id uuid [not null]
  from_status text
  to_status text [not null]
  changed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  changed_at bigint [not null]
  note text
  Note: "Append only status history of a quotation."
  Indexes {
    quotation_id [name: 'quotation_status_history_quotation_id_idx']
  }
}

Table sales.order_status_history {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  sales_order_id uuid [not null]
  from_status text
  to_status text [not null]
  changed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  changed_at bigint [not null]
  note text
  Note: "Append only status history of a sales order."
  Indexes {
    sales_order_id [name: 'order_status_history_sales_order_id_idx']
  }
}

Table sales.sales_returns {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  sales_order_id uuid [not null]
  customer_id uuid [not null, note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  status text [not null, default: 'requested']
  return_date date
  reason text
  total_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Goods return request against a sales order. Stock is returned by the Inventory module."
  Indexes {
    (organization_id, code) [unique, name: 'sales_returns_org_code_uq']
    sales_order_id [name: 'sales_returns_sales_order_id_idx']
    status [name: 'sales_returns_status_idx']
  }
  Checks {
    `status IN ('requested', 'approved', 'rejected', 'received', 'cancelled')`
    `total_amount >= 0`
  }
}

Table sales.delivery_notes {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  sales_order_id uuid [not null]
  carrier text
  tracking_number text
  shipped_at bigint
  received_at bigint
  receiver_name text
  receiver_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  status text [not null, default: 'prepared']
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Delivery note, surat jalan. Confirms physical handover of a sales order."
  Indexes {
    (organization_id, code) [unique, name: 'delivery_notes_org_code_uq']
    sales_order_id [name: 'delivery_notes_sales_order_id_idx']
  }
  Checks {
    `status IN ('prepared', 'shipped', 'delivered', 'returned')`
  }
}

// ---------------------------------------------------------------------------
// MODULE: Procurement  (schema: procurement)
// Supplier master, purchase requests, purchase orders, goods receipts and
// purchase returns. Tenant scoped.
// ---------------------------------------------------------------------------

Table procurement.suppliers {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  legal_name text
  supplier_type text [not null, default: 'company']
  tax_id text
  email text
  phone text
  whatsapp text
  payment_terms_days integer [not null, default: 30]
  bank_name text
  bank_account_number text
  bank_account_holder text
  status text [not null, default: 'active']
  owner_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Supplier master. Bank details are restricted and never returned to the client without the supplier read permission."
  Indexes {
    (organization_id, code) [unique, name: 'suppliers_org_code_uq']
    status [name: 'suppliers_status_idx']
    tax_id [name: 'suppliers_tax_id_idx']
  }
  Checks {
    `supplier_type IN ('company', 'individual', 'government')`
    `status IN ('active', 'inactive', 'blocked')`
    `payment_terms_days >= 0`
  }
}

Table procurement.supplier_contacts {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  supplier_id uuid [not null]
  name text [not null]
  position text
  email text
  phone text
  whatsapp text
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Contact person of a supplier."
  Indexes {
    supplier_id [name: 'supplier_contacts_supplier_id_idx']
  }
}

Table procurement.supplier_addresses {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  supplier_id uuid [not null]
  kind text [not null, default: 'office']
  label text
  contact_name text
  contact_phone text
  address_line text
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  district_id uuid [note: "Logical reference to location.districts.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  regency_id uuid [note: "Logical reference to location.regencies.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  province_id uuid [note: "Logical reference to location.provinces.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Structured Indonesian address of a supplier."
  Indexes {
    supplier_id [name: 'supplier_addresses_supplier_id_idx']
  }
  Checks {
    `kind IN ('office', 'factory', 'warehouse', 'billing', 'other')`
  }
}

Table procurement.purchase_requests {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  requested_by text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  department_id uuid [note: "Logical reference to organization.departments.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  project_id uuid [note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted. Validated through the Projects module contract."]
  status text [not null, default: 'draft']
  request_date date
  needed_by date
  justification text
  estimated_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  rejected_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Purchase request, the approval gate before a purchase order exists."
  Indexes {
    (organization_id, code) [unique, name: 'purchase_requests_org_code_uq']
    status [name: 'purchase_requests_status_idx']
    requested_by [name: 'purchase_requests_requested_by_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'rejected', 'cancelled', 'ordered')`
    `estimated_total >= 0`
  }
}

Table procurement.purchase_request_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  purchase_request_id uuid [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  description text
  quantity numeric(18,3) [not null, default: 1]
  unit_id uuid [note: "Logical reference to catalog.units.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  estimated_unit_price bigint [not null, default: 0]
  estimated_total bigint [not null, default: 0]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a purchase request."
  Indexes {
    purchase_request_id [name: 'purchase_request_items_purchase_request_id_idx']
  }
  Checks {
    `quantity > 0`
    `estimated_unit_price >= 0`
    `estimated_total >= 0`
  }
}

Table procurement.purchase_orders {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  supplier_id uuid [not null]
  purchase_request_id uuid
  status text [not null, default: 'draft']
  order_date date
  expected_delivery_date date
  subtotal bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  shipping_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  payment_terms_days integer [not null, default: 30]
  ship_to_address_text text
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  sent_at bigint
  closed_at bigint
  cancelled_reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Purchase order to a supplier. The supplier bill and its payment stay in the Finance module."
  Indexes {
    (organization_id, code) [unique, name: 'purchase_orders_org_code_uq']
    supplier_id [name: 'purchase_orders_supplier_id_idx']
    purchase_request_id [name: 'purchase_orders_purchase_request_id_idx']
    status [name: 'purchase_orders_status_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'sent', 'partially_received', 'received', 'closed', 'cancelled')`
    `subtotal >= 0`
    `tax_total >= 0`
    `shipping_total >= 0`
    `grand_total >= 0`
    `payment_terms_days >= 0`
  }
}

Table procurement.purchase_order_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  purchase_order_id uuid [not null]
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  description text
  quantity numeric(18,3) [not null, default: 1]
  unit_id uuid [note: "Logical reference to catalog.units.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  unit_price bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  quantity_received numeric(18,3) [not null, default: 0]
  quantity_rejected numeric(18,3) [not null, default: 0]
  sort_order integer [not null, default: 0]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a purchase order."
  Indexes {
    purchase_order_id [name: 'purchase_order_items_purchase_order_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `tax_amount >= 0`
    `line_total >= 0`
    `quantity_received >= 0`
    `quantity_rejected >= 0`
  }
}

Table procurement.goods_receipts {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  purchase_order_id uuid [not null]
  warehouse_id uuid [not null, note: "Logical reference to inventory.warehouses.id. Cross-module FK intentionally omitted. Validated through the Inventory module contract."]
  status text [not null, default: 'draft']
  receipt_date date
  received_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  received_at bigint
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Goods receipt note. Posting creates the stock movement inside the Inventory module."
  Indexes {
    (organization_id, code) [unique, name: 'goods_receipts_org_code_uq']
    purchase_order_id [name: 'goods_receipts_purchase_order_id_idx']
    warehouse_id [name: 'goods_receipts_warehouse_id_idx']
  }
  Checks {
    `status IN ('draft', 'posted', 'cancelled')`
  }
}

Table procurement.goods_receipt_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  goods_receipt_id uuid [not null]
  purchase_order_item_id uuid
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  quantity_accepted numeric(18,3) [not null, default: 0]
  quantity_rejected numeric(18,3) [not null, default: 0]
  rejection_reason text
  unit_price bigint [not null, default: 0]
  lot_number text
  serial_numbers text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a goods receipt. Accepted quantity becomes the stock movement."
  Indexes {
    goods_receipt_id [name: 'goods_receipt_items_goods_receipt_id_idx']
    purchase_order_item_id [name: 'goods_receipt_items_purchase_order_item_id_idx']
  }
  Checks {
    `quantity_accepted >= 0`
    `quantity_rejected >= 0`
    `unit_price >= 0`
  }
}

Table procurement.purchase_returns {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  purchase_order_id uuid [not null]
  supplier_id uuid [not null]
  status text [not null, default: 'requested']
  return_date date
  reason text
  total_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Return of purchased goods to a supplier."
  Indexes {
    (organization_id, code) [unique, name: 'purchase_returns_org_code_uq']
    purchase_order_id [name: 'purchase_returns_purchase_order_id_idx']
    status [name: 'purchase_returns_status_idx']
  }
  Checks {
    `status IN ('requested', 'approved', 'rejected', 'shipped', 'completed')`
    `total_amount >= 0`
  }
}

Table procurement.purchase_return_items {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  purchase_return_id uuid [not null]
  purchase_order_item_id uuid
  item_id uuid [note: "Logical reference to catalog.items.id. Cross-module FK intentionally omitted. Validated through the Catalog module contract."]
  quantity numeric(18,3) [not null, default: 0]
  unit_price bigint [not null, default: 0]
  line_total bigint [not null, default: 0]
  reason text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Line of a purchase return."
  Indexes {
    purchase_return_id [name: 'purchase_return_items_purchase_return_id_idx']
  }
  Checks {
    `quantity > 0`
    `unit_price >= 0`
    `line_total >= 0`
  }
}

