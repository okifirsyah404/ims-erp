Ref: sales.sales_orders.quotation_id > sales.quotations.id [delete: restrict]
Ref: sales.sales_order_items.quotation_item_id > sales.quotation_items.id [delete: restrict]
Ref: sales.sales_order_items.sales_order_id > sales.sales_orders.id [delete: cascade]
Ref: sales.discount_requests.sales_order_id > sales.sales_orders.id [delete: cascade]
Ref: sales.contracts.sales_order_id > sales.sales_orders.id [delete: set null]
Ref: sales.quotation_status_history.quotation_id > sales.quotations.id [delete: cascade]
Ref: sales.order_status_history.sales_order_id > sales.sales_orders.id [delete: cascade]
Ref: sales.sales_returns.sales_order_id > sales.sales_orders.id [delete: cascade]
Ref: sales.delivery_notes.sales_order_id > sales.sales_orders.id [delete: restrict]
Ref: sales.delivery_note_items.delivery_note_id > sales.delivery_notes.id [delete: cascade]
Ref: sales.delivery_note_items.sales_order_item_id > sales.sales_order_items.id [delete: restrict]
