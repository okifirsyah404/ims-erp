    status [name: 'expense_settlements_status_idx']
  }
  Checks {
    `settlement_type IN ('expense', 'advance')`
    `status IN ('draft', 'submitted', 'verified', 'approved', 'rejected', 'paid', 'cancelled')`
    `total_amount >= 0`
  }
}

Table finance.expense_settlement_items {
