// ---------------------------------------------------------------------------
// MODULE: Identity  (schema: auth — 9 Better Auth core tables + 6 ERP-owned extension tables)
// auth.* are Better Auth owned tables. Reproduced from
// drizzle/schemas/auth.schema.ts and migration
// 20261028042701_create_auth_schema. Never edit by hand.
// ---------------------------------------------------------------------------

Table auth.users {
  deleted_at bigint
  id text [pk]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  role text
  banned boolean [default: false]
  ban_reason text
  ban_expires timestamp
  bio text
  username text [unique]
  display_username text
  status text [note: "User lifecycle for the invitation-only flow: pending (pre-created by invitation, no credentials) | active | deactivated (sessions revoked, memberships kept). ERP-owned extension column; default 'active'."]
  gender text [note: "Personal field moved from hr.employees (ERP-0034). API contract: male | female only."]
  birth_date bigint [note: "Unix milliseconds at Asia/Jakarta midnight. Personal field moved from hr.employees (ERP-0034)."]
  birth_place text [note: "Personal field moved from hr.employees (ERP-0034)."]
  marital_status text [note: "Personal field moved from hr.employees (ERP-0034)."]
  Note: "Better Auth system user. Superadmin flag for the admin plugin."
  Indexes {
    email [unique, name: 'users_email_key']
    username [unique, name: 'users_username_key']
  }
  Checks {
    `gender IS NULL OR gender IN ('male', 'female')`
    `marital_status IS NULL OR marital_status IN ('single', 'married', 'divorced', 'widowed')`
  }
}

Table auth.sessions {
  id text [pk]
  expires_at timestamp [not null]
  token text [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  ip_address text
  user_agent text
  user_id text [not null]
  impersonated_by text
  active_organization_id text
  Note: "Better Auth session. Sessions are stored in Redis since the secondary storage switch; rows here are legacy. Hard deleted on revoke (no deleted_at)."
  Indexes {
    user_id [name: 'sessions_userId_idx']
    token [unique, name: 'sessions_token_key']
  }
}

Table auth.accounts {
  id text [pk]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  Note: "Better Auth credential and OAuth provider account."
  Indexes {
    user_id [name: 'accounts_userId_idx']
  }
}

Table auth.verifications {
  id text [pk]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  Note: "Better Auth one time verification token store. Consumed rows are hard deleted (no deleted_at)."
  Indexes {
    identifier [name: 'verifications_identifier_idx']
  }
}

Table auth.organizations {
  deleted_at bigint
  id text [pk]
  name text [not null]
  slug text [not null, unique]
  logo text [note: "Object-storage key of the organization profile image (`organizations/<id>/logo.webp` uploaded, or `organizations/<id>/logo-generated.webp` for the generated fallback; WebP). Presigned on read; never an expiring URL."]
  description text [note: "Optional free-text organization description. Validated at the HTTP boundary (trimmed, max 2000 chars); no DB length limit."]
  created_at timestamp [not null]
  metadata text
  Note: "Better Auth organization. An internal organization of the company; multiple may exist inside one company. Not a tenancy boundary - ERP master data is shared company-wide. See ADR-0001 and ADR-0007."
  Indexes {
    slug [unique, name: 'organizations_slug_uidx']
  }
}

Table auth.members {
  id text [pk]
  organization_id text [not null]
  user_id text [not null]
  role text [not null, default: 'member', note: "Comma-separated ERP role keys. Resolved per validated organization against the live auth.roles rows and unioned across the listed roles; the shared catalog in packages/common/src/authorization/erp-permissions.ts is only the fallback vocabulary when no live role row matches."]
  created_at timestamp [not null]
  Note: "Better Auth organization membership. HARD DELETED by Better Auth - there is no deleted_at column, so membership queries must never filter on one. Deactivating a user keeps these rows; removing a member deletes them."
  Indexes {
    organization_id [name: 'members_organizationId_idx']
    user_id [name: 'members_userId_idx']
  }
}

Table auth.invitations {
  id text [pk]
  organization_id text [not null]
  email text [not null]
  role text
  status text [not null, default: 'pending']
  expires_at timestamp [not null]
  created_at timestamp [not null]
  inviter_id text [not null]
  Note: "Better Auth organization invitation."
  Indexes {
    organization_id [name: 'invitations_organizationId_idx']
    email [name: 'invitations_email_idx']
  }
}

Table auth.passkeys {
  id text [pk]
  name text
  public_key text [not null]
  user_id text [not null]
  credential_id text [not null]
  counter integer [not null]
  device_type text [not null]
  backed_up boolean [not null]
  transports text
  created_at timestamp
  aaguid text
  Note: "Better Auth passkey credential."
  Indexes {
    user_id [name: 'passkeys_userId_idx']
    credential_id [name: 'passkeys_credentialID_idx']
  }
}

Table auth.apikeys {
  id text [pk]
  config_id text [not null, default: 'default']
  name text
  start text
  reference_id text [not null]
  prefix text
  key text [not null]
  refill_interval integer
  refill_amount integer
  last_refill_at timestamp
  enabled boolean [default: true]
  rate_limit_enabled boolean [default: true]
  rate_limit_time_window integer [default: 86400000]
  rate_limit_max integer [default: 10]
  request_count integer [default: 0]
  remaining integer
  last_request timestamp
  expires_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  permissions text
  metadata text
  Note: "Better Auth API key. Rate limit window is milliseconds, matching the ERP cache unit convention."
  Indexes {
    config_id [name: 'apikeys_configId_idx']
    reference_id [name: 'apikeys_referenceId_idx']
    key [name: 'apikeys_key_idx']
  }
}

Table auth.user_profiles {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  user_id text [not null]
  display_name text
  phone text
  whatsapp text
  avatar_object_key text
  locale text [not null, default: 'id-ID']
  timezone text [not null, default: 'Asia/Jakarta']
  employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Profile extension of a Better Auth user. One row per user."
  Indexes {
    user_id [unique, name: 'user_profiles_user_id_uq']
    employee_id [name: 'user_profiles_employee_id_idx']
  }
}

Table auth.user_role_assignments {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  user_id text [not null]
  role text [not null]
  scope_type text [not null, default: 'organization']
  scope_id text
  granted_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  granted_at bigint [not null]
  revoked_at bigint
  Note: "Extra ERP roles on top of the Better Auth organization membership role. Deny by default, additive only."
  Indexes {
    user_id [name: 'user_role_assignments_user_id_idx']
    (user_id, role, scope_type, scope_id) [name: 'user_role_assignments_scope_uq']
  }
  Checks {
    `scope_type IN ('organization', 'branch', 'department', 'project', 'self')`
  }
}

Table auth.portal_identities {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  user_id text [not null]
  portal_type text [not null]
  linked_entity_id uuid [not null]
  status text [not null, default: 'active']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Links a portal login to a business record. linked_entity_id points at the owning module master row and is never a foreign key."
  Indexes {
    user_id [name: 'portal_identities_user_id_idx']
    (portal_type, linked_entity_id) [name: 'portal_identities_entity_uq']
  }
  Checks {
    `portal_type IN ('customer', 'investor', 'partner', 'technician')`
    `status IN ('active', 'suspended', 'revoked')`
  }
}

Table auth.user_preferences {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  user_id text [not null]
  preference_key text [not null]
  preference_value text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Per user UI and behaviour preferences. Server side truth stays in the owning module."
  Indexes {
    (user_id, preference_key) [unique, name: 'user_preferences_key_uq']
  }
}

Table auth.identity_verifications {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  user_id text [not null]
  method text [not null]
  identifier text [not null]
  status text [not null, default: 'pending']
  verified_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Second factor or identity proof beyond the Better Auth credential."
  Indexes {
    user_id [name: 'identity_verifications_user_id_idx']
  }
  Checks {
    `method IN ('email', 'phone', 'whatsapp', 'nid', 'document')`
    `status IN ('pending', 'verified', 'rejected', 'expired')`
  }
}

Table auth.user_devices {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  user_id text [not null]
  device_name text
  platform text
  device_fingerprint text
  is_trusted boolean [not null, default: false]
  first_seen_at bigint [not null]
  last_seen_at bigint [not null]
  revoked_at bigint
  Note: "Known device of a user, used by license activation and by suspicious login checks."
  Indexes {
    user_id [name: 'user_devices_user_id_idx']
    (user_id, device_fingerprint) [unique, name: 'user_devices_fingerprint_uq']
  }
}

Ref: auth.sessions.user_id > auth.users.id [delete: cascade]
Ref: auth.accounts.user_id > auth.users.id [delete: cascade]
Ref: auth.members.organization_id > auth.organizations.id [delete: cascade]
Ref: auth.members.user_id > auth.users.id [delete: cascade]
Ref: auth.invitations.organization_id > auth.organizations.id [delete: cascade]
Ref: auth.invitations.inviter_id > auth.users.id [delete: cascade]
Ref: auth.passkeys.user_id > auth.users.id [delete: cascade]
Ref: auth.user_profiles.user_id > auth.users.id [delete: cascade]
Ref: auth.user_role_assignments.user_id > auth.users.id [delete: cascade]
Ref: auth.portal_identities.user_id > auth.users.id [delete: cascade]
Ref: auth.user_preferences.user_id > auth.users.id [delete: cascade]
Ref: auth.identity_verifications.user_id > auth.users.id [delete: cascade]
Ref: auth.user_devices.user_id > auth.users.id [delete: cascade]
Ref: auth.roles.organization_id > auth.organizations.id [delete: cascade]
Ref: auth.user_invitations.organization_id > auth.organizations.id [delete: cascade]
Ref: auth.user_invitations.role_id > auth.roles.id [delete: set null]
Ref: auth.user_invitations.invited_by > auth.users.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Identity (user management extension, added 2026-11-01, migration
// 20261101021221_ancient_luckman). ERP-owned tables in the auth schema for
// the invitation-only user lifecycle. Reproduced from
// drizzle/schemas/role.schema.ts. Never edit by hand.
// ---------------------------------------------------------------------------

Table auth.roles {
  deleted_at timestamp
  id text [pk]
  organization_id text [not null]
  name text [not null]
  rank integer [not null]
  permissions jsonb [not null, note: "Permission grant { resource: action[] } using the shared catalog vocabulary (@ims-erp/common erpStatements). Deny-by-default."]
  is_system boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  Note: "Per-organization dynamic role master data. Live grant source for ERP authorization: the guard resolves the caller's memberships against these rows per validated organization. rank drives the server-side escalation guard in the user-management module - SYSTEM_ROLE_RANKS in database/seeders/seed/organization-roles.seeder.ts sets owner=100, admin=80, hr=60, member=10, and every other seeded catalog role gets DEFAULT_CATALOG_RANK=50; custom roles must rank strictly below their creator. is_system rows are seeded from the shared ERP catalog and cannot be deleted. Partial unique (organization_id, name) WHERE deleted_at IS NULL."
  Indexes {
    organization_id [name: 'roles_organizationId_idx']
  }
}

Table auth.user_invitations {
  deleted_at timestamp
  id text [pk]
  type text [not null, default: 'app', note: "'app' = application-admin invite (no organization); 'org' = organization admin/HR invite (role + organization attached)."]
  email text [not null]
  name text [note: "App-admin path input; pre-creates the user and prefills the profile form on claim."]
  organization_id text
  role_id text
  org_role text [note: "Comma-joined closed ERP role keys ('admin,finance') assigned to the membership on claim. NULL on app-path invites. Was the Postgres enum organization_role before multi-role support (ERP-0041); validity is enforced by the zod closed enum at every boundary."]
  token_hash text [not null, unique, note: "SHA-256 of the emailed single-use token; raw token never stored. Replaced on resend (old token dies)."]
  status text [not null, default: 'pending', note: "pending -> accepted on claim; cancelled by admin; expired by sweeper (3-day expiry)."]
  invited_by text [not null]
  expires_at timestamp [not null]
  resent_count integer [not null, default: 0]
  delivery_failed boolean [not null, default: false, note: "Bounce flag surfaced in the admin pending list."]
  claimed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  Note: "Unified invitation pipeline for both invite paths. Users are pre-created at invite time (users.status='pending'); deleting an unclaimed invitation soft-deletes it and its pending user. Named user_invitations because Better Auth owns auth.invitations (organization plugin, untouched)."
  Indexes {
    email [name: 'user_invitations_email_idx']
    organization_id [name: 'user_invitations_organizationId_idx']
    status [name: 'user_invitations_status_idx']
  }
}


// ---------------------------------------------------------------------------
// MODULE: Location  (schema: location)
// Existing tables, reproduced from drizzle/schemas/location.schema.ts and
// migration 20261028042750_create_location_schema. Seeded from
// database/seeders/raw/location. Global reference data, not tenant scoped.
// ---------------------------------------------------------------------------

Table location.provinces {
  id uuid [pk, default: `uuidv7()`]
  code varchar(20) [not null, unique]
  name text [not null]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  Note: "Indonesian province. Soft deleted, never hard deleted."
  Indexes {
    code [unique, name: 'province_code_idx']
    name [name: 'province_name_idx']
  }
}

Table location.regencies {
  id uuid [pk, default: `uuidv7()`]
  code varchar(20) [not null, unique]
  name text [not null]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  province_id uuid
  Note: "Indonesian regency or city."
  Indexes {
    code [unique, name: 'regency_code_idx']
    name [name: 'regency_name_idx']
    province_id [name: 'regency_province_id_idx']
  }
}

Table location.districts {
  id uuid [pk, default: `uuidv7()`]
  code varchar(20) [not null, unique]
  name text [not null]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  regency_id uuid
  Note: "Indonesian district."
  Indexes {
    code [unique, name: 'district_code_idx']
    name [name: 'district_name_idx']
    regency_id [name: 'district_regency_id_idx']
  }
}

Table location.villages {
  id uuid [pk, default: `uuidv7()`]
  code varchar(20) [not null, unique]
  name text [not null]
  created_at bigint [not null]
  updated_at bigint
  deleted_at bigint
  district_id uuid
  Note: "Indonesian village or kelurahan."
  Indexes {
    code [unique, name: 'village_code_idx']
    name [name: 'village_name_idx']
    district_id [name: 'village_district_id_idx']
  }
}

Ref: location.regencies.province_id > location.provinces.id [delete: cascade]
Ref: location.districts.regency_id > location.regencies.id [delete: cascade]
Ref: location.villages.district_id > location.districts.id [delete: cascade]

// ---------------------------------------------------------------------------
// MODULE: Company  (schema: company)
// The one legal company behind every organization (ADR-0011): profile, head
// office addresses, contacts, bank accounts, company-wide settings. All rows
// are company-wide — no organization_id column anywhere in this schema.
// ---------------------------------------------------------------------------

Table company.profiles {
  id uuid [pk, default: `uuidv7()`]
  legal_name varchar(200) [not null]
  trading_name varchar(200)
  document_code varchar(16) [not null, note: "Company code in document numbers (the {COMPANY} token), upper-case letters and digits."]
  tagline varchar(300)
  tax_id varchar(32) [note: "NPWP number of the company."]
  logo_object_key text [note: "Object-storage key of the letterhead logo. Stored as WebP: the server re-encodes any accepted upload (PNG/JPG/WebP/GIF/BMP/TIFF/HEIC/AVIF, ≤ 2 MB) to WebP."]
  signature_object_key text [note: "Object-storage key of the signature and stamp image printed above the signatory name."]
  signatory_name varchar(200)
  signatory_title varchar(100)
  default_quotation_terms text
  default_invoice_terms text
  warranty_coverage text [note: "Warranty certificate section, one item per line; empty means the built-in text."]
  warranty_exclusions text
  warranty_service_terms text
  status text [not null, default: 'active']
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Legal and display profile of the one company (letterhead, signatory, default terms). Company-wide, no organization_id (ADR-0011): one company per application; organizations (tenants) sit under it and do not own it. Whether an organization is a subsidiary is out of scope. Addresses, phone numbers, email and the website moved to company.head_office_addresses and company.contacts (ERP-0042). One live row, enforced by the partial unique index profiles_singleton_uq ON ((true)) WHERE deleted_at IS NULL in the Drizzle schema."
  Checks {
    `status IN ('active', 'inactive')`
    `document_code ~ '^[A-Z0-9]+$'`
  }
}

Table company.head_office_addresses {
  id uuid [pk, default: `uuidv7()`]
  label varchar(100) [not null, default: 'head_office', note: "Free label distinguishing several office addresses."]
  address_line text [not null, note: "Free-text address as printed on the letterhead."]
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false, note: "The address printed on the letterhead; at most one live row."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Office address of the company, company-wide (ADR-0011). The primary address is what printed documents use. Partial unique index is_primary WHERE deleted_at IS NULL AND is_primary in the Drizzle schema."
}

Table company.contacts {
  id uuid [pk, default: `uuidv7()`]
  contact_type text [not null]
  value varchar(200) [not null]
  label varchar(100)
  is_primary boolean [not null, default: false, note: "The contact shown on the letterhead per type; at most one live row per type."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Company contact channel, company-wide (ADR-0011). Email/phone/website columns left company.profiles in ERP-0042. Partial unique index (contact_type, is_primary) WHERE deleted_at IS NULL AND is_primary in the Drizzle schema."
  Indexes {
    value [name: 'contacts_value_idx']
  }
  Checks {
    `contact_type IN ('phone', 'email', 'whatsapp', 'fax', 'other')`
  }
}

Table company.bank_accounts {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null]
  bank_name varchar(100) [not null]
  bank_code varchar(20)
  branch_name varchar(100)
  account_number varchar(50) [not null]
  account_holder varchar(200) [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  invoice_usage text [note: "Account printed on invoices with VAT (vat) or without VAT (non_vat); null for other accounts."]
  is_primary boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Company owned bank account, company-wide (ADR-0011). Was organization.company_bank_accounts until ERP-0042. Finance owns its own operational cash and bank accounts, this is the master reference. Partial unique indexes in the Drizzle schema: code and invoice_usage are unique among live rows."
  Indexes {
    account_number [name: 'bank_accounts_account_number_idx']
  }
  Checks {
    `invoice_usage IS NULL OR invoice_usage IN ('vat', 'non_vat')`
  }
}

Table company.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  is_secret boolean [not null, default: false]
  description text
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Company-wide configuration key value store (ERP-0042). Organization-scoped settings live in organization.settings. Secret values are never read back by the client. ERP-0045: is_secret is reserved and always false; the API neither accepts nor returns it, and no secret read path exists yet (the write-only rule applies when dynamic secrets are built)."
  Indexes {
    (setting_group, setting_key) [unique, name: 'company_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

// ---------------------------------------------------------------------------
// MODULE: Organization  (schema: organization)
// Internal departments of the one company (ADR-0007/ADR-0011): branches,
// departments, positions, cost centres, fiscal settings, per-organization
// settings. Every table is tenant scoped by organization_id (logical
// reference to auth.organizations.id).
// ---------------------------------------------------------------------------

Table organization.branches {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  parent_branch_id uuid
  address_line text
  phone text
  email text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Operational branch or office of the company."
  Indexes {
    (organization_id, code) [unique, name: 'branches_org_code_uq']
    parent_branch_id [name: 'branches_parent_branch_id_idx']
  }
}

Table organization.departments {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  branch_id uuid
  parent_department_id uuid
  manager_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  description text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Internal department. Hierarchy is self referencing."
  Indexes {
    (organization_id, code) [unique, name: 'departments_org_code_uq']
    branch_id [name: 'departments_branch_id_idx']
    parent_department_id [name: 'departments_parent_department_id_idx']
  }
}

Table organization.positions {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  department_id uuid
  job_level text
  description text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Job position definition used by HR contracts and payroll."
  Indexes {
    (organization_id, code) [unique, name: 'positions_org_code_uq']
    department_id [name: 'positions_department_id_idx']
  }
}

Table organization.cost_centers {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  branch_id uuid
  department_id uuid
  allocation_method text [not null, default: 'direct']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Cost centre used by accounting journal lines and budgets."
  Indexes {
    (organization_id, code) [unique, name: 'cost_centers_org_code_uq']
    branch_id [name: 'cost_centers_branch_id_idx']
    department_id [name: 'cost_centers_department_id_idx']
  }
  Checks {
    `allocation_method IN ('direct', 'percentage', 'headcount', 'revenue')`
  }
}

Table organization.fiscal_settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  fiscal_year_start_month smallint [not null, default: 1]
  fiscal_year_start_day smallint [not null, default: 1]
  business_timezone text [not null, default: 'Asia/Jakarta']
  operational_timezone text [not null, default: 'UTC']
  default_currency_code varchar(3) [not null, default: 'IDR']
  tax_identifier text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Single row per organization. Business dates are Asia/Jakarta, operational timestamps are UTC."
  Indexes {
    organization_id [unique, name: 'fiscal_settings_organization_id_uq']
  }
  Checks {
    `fiscal_year_start_month BETWEEN 1 AND 12`
    `fiscal_year_start_day BETWEEN 1 AND 31`
  }
}

// MODULE: CodeNumber  (schema: code_number)
// The one numbering authority (ERP-0009): one code series per code type for
// the whole company. Was organization.document_sequences until ERP-0042.
// ---------------------------------------------------------------------------

Table code_number.series {
  id uuid [pk, default: `uuidv7()`]
  module varchar(32) [not null, note: "Owning module of the code type (sales, crm, procurement, inventory, assets, projects, aftersales, licensing)."]
  code_type varchar(32) [not null]
  pattern varchar(100) [note: "Token pattern, e.g. {SEQ:4}/{TYPE}/{COMPANY}/{MM_ROMAN}/{YY}; null means the code default for the type."]
  reset_policy text [note: "null means the code default for the type."]
  period_key varchar(7) [not null, note: "Period the counter belongs to: 2026 (yearly), 2026-11 (monthly), all (never). A new period starts again at 1."]
  next_number bigint [not null, default: 1]
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "One code series per code type for the whole company (ADR-0011); the one numbering authority (ERP-0009) - main's per-organization sequences were merged into it on 2026-11-06 (migration merge_main_reconcile), inventory and asset codes keep their shape as default patterns. Was organization.document_sequences (column document_type renamed code_type) until ERP-0042. ERP-0043 added item_product/item_material/item_component (PRD/MAT/CMP, {TYPE}-{SEQ:5}, reset never) so an item code is allocated like any other. Allocation is one atomic INSERT ... ON CONFLICT DO UPDATE ... RETURNING in the owning repository. Partial unique index on code_type WHERE deleted_at IS NULL in the Drizzle schema."
  Checks {
    `reset_policy IS NULL OR reset_policy IN ('never', 'yearly', 'monthly')`
    `next_number > 0`
  }
}

Table organization.settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  value_type text [not null, default: 'string']
  is_secret boolean [not null, default: false]
  description text
  updated_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Organization-scoped configuration key value store (ERP-0042; was the planned organization.company_settings). Company-wide settings live in company.settings. Secret values are never read back by the client."
  Indexes {
    (organization_id, setting_group, setting_key) [unique, name: 'organization_settings_scope_uq']
  }
  Checks {
    `value_type IN ('string', 'number', 'boolean', 'json', 'date')`
  }
}

Ref: organization.branches.parent_branch_id > organization.branches.id [delete: set null]
Ref: organization.departments.branch_id > organization.branches.id [delete: set null]
Ref: organization.departments.parent_department_id > organization.departments.id [delete: set null]
Ref: organization.positions.department_id > organization.departments.id [delete: set null]
Ref: organization.cost_centers.branch_id > organization.branches.id [delete: set null]
Ref: organization.cost_centers.department_id > organization.departments.id [delete: set null]


// ---------------------------------------------------------------------------
// MODULE: CRM  (schema: crm)
// Customer master, groups, contacts, addresses, leads, segments, interactions,
// credit limit history. Tenant scoped, except crm.customers,
// crm.customer_contacts and the lead tables, which are company-wide
// (ADR-0011).
// ---------------------------------------------------------------------------

Table crm.customers {
  id uuid [pk, default: `uuidv7()`]
  code varchar(32) [not null, note: "Upper-case; unique among live rows (partial index in the Drizzle schema)."]
  customer_type text [not null, default: 'company']
  name text [not null]
  legal_name text
  tax_id varchar(16) [note: "NPWP digits only, 15 or 16."]
  email text
  phone varchar(30)
  whatsapp varchar(30)
  address_line text [note: "Primary address, printed on documents. crm.customer_addresses (more addresses) is not built yet."]
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  postal_code varchar(10)
  status text [not null, default: 'active']
  owner_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  portal_identity_id uuid [note: "Logical reference to auth.portal_identities.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  default_currency_code varchar(3) [not null, default: 'IDR']
  notes text
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Customer master, company-wide (ADR-0011): no organization_id. Contacts and documents reference it; documents also keep a snapshot. Inactive customers cannot be used on new documents."
  Indexes {
    name [name: 'customers_name_idx']
    tax_id [name: 'customers_tax_id_idx']
    owner_user_id [name: 'customers_owner_user_id_idx']
  }
  Checks {
    `customer_type IN ('individual', 'company', 'government', 'partner')`
    `status IN ('active', 'inactive')`
  }
}

Table crm.customer_groups {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Customer classification such as retail, corporate or government."
  Indexes {
    (organization_id, code) [unique, name: 'customer_groups_org_code_uq']
  }
}

Table crm.customer_contacts {
  id uuid [pk, default: `uuidv7()`]
  customer_id uuid [not null]
  name text [not null]
  position text
  email text
  phone varchar(30)
  whatsapp varchar(30)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Contact person of a customer, company-wide like its customer (ADR-0011). At most one primary contact per customer (kept by the repository)."
  Indexes {
    customer_id [name: 'customer_contacts_customer_id_idx']
  }
}

Table crm.customer_addresses {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  customer_id uuid [not null]
  kind text [not null, default: 'billing']
  label text
  contact_name text
  contact_phone text
  address_line text
  village_id uuid [note: "Logical reference to location.villages.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  district_id uuid [note: "Logical reference to location.districts.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  regency_id uuid [note: "Logical reference to location.regencies.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  province_id uuid [note: "Logical reference to location.provinces.id. Cross-module FK intentionally omitted. Validated through the Location module contract."]
  postal_code varchar(10)
  is_primary boolean [not null, default: false]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Structured Indonesian address of a customer. The kind discriminator replaces a separate billing and shipping table."
  Indexes {
    customer_id [name: 'customer_addresses_customer_id_idx']
    (organization_id, kind, is_primary) [name: 'customer_addresses_kind_idx']
  }
  Checks {
    `kind IN ('billing', 'shipping', 'service', 'site', 'other')`
  }
}

Table crm.leads {
  id uuid [pk, default: `uuidv7()`]
  name text [not null]
  company_name text
  email text
  phone varchar(30)
  whatsapp varchar(30)
  source text [not null]
  status text [not null, default: 'new']
  needs text [note: "What the prospect asks for; website inquiries store a readable summary here."]
  estimated_value bigint [note: "Exact integer IDR minor units (ADR-0002)."]
  currency_code varchar(3) [not null, default: 'IDR']
  owner_user_id text [note: "Assigned salesperson. Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  next_follow_up_at bigint
  customer_id uuid [note: "Customer the lead was converted into (status won)."]
  converted_at bigint
  lost_reason text
  channel text [note: "Website form that created the lead: rfq, contact or demo; null for manual leads."]
  reference varchar(40) [note: "Public reference handed back to the website visitor (document numbering web_*)."]
  submission jsonb [note: "The website payload as received, for audit."]
  idempotency_key varchar(100) [note: "Website Idempotency-Key; a replay returns the original reference."]
  created_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Prospect before a customer record exists, company-wide (ADR-0011): no organization_id. Statuses are the ones approved on the M02 branch (survey and quotation stages; won = converted). Visibility: holders of lead:assign see all leads, others only leads assigned to them (service rule). Partial unique indexes on reference and idempotency_key WHERE NOT NULL in the Drizzle schema."
  Indexes {
    owner_user_id [name: 'leads_owner_user_id_idx']
    status [name: 'leads_status_idx']
    next_follow_up_at [name: 'leads_next_follow_up_at_idx']
  }
  Checks {
    `source IN ('website', 'whatsapp', 'instagram', 'phone', 'referral', 'walk_in', 'other')`
    `status IN ('new', 'contacted', 'survey', 'quotation', 'won', 'lost')`
    `channel IS NULL OR channel IN ('rfq', 'contact', 'demo')`
  }
}

Table crm.lead_activities {
  id uuid [pk, default: `uuidv7()`]
  lead_id uuid [not null]
  activity_type text [not null]
  notes text [not null]
  occurred_at bigint [not null]
  created_by text [not null, note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Follow-up log of a lead (calls, visits, surveys), company-wide like its lead (ADR-0011)."
  Indexes {
    (lead_id, occurred_at) [name: 'lead_activities_lead_id_idx']
  }
  Checks {
    `activity_type IN ('call', 'whatsapp', 'email', 'meeting', 'survey', 'note')`
  }
}

Table crm.lead_attachments {
  id uuid [pk, default: `uuidv7()`]
  lead_id uuid [not null]
  file_name varchar(255) [not null]
  content_type varchar(120) [not null]
  size_bytes integer [not null]
  storage_key text [not null, note: "Object-storage key; never sent to clients (downloads use short-lived presigned URLs)."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "File sent with a website RFQ (PDF, DWG, JPG, PNG; up to 10 files of 25 MB)."
  Indexes {
    lead_id [name: 'lead_attachments_lead_id_idx']
  }
}

Table crm.customer_segments {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  criteria text
  is_dynamic boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Customer segment. Dynamic segments hold criteria, static segments hold members."
  Indexes {
    (organization_id, code) [unique, name: 'customer_segments_org_code_uq']
  }
}

Table crm.customer_segment_members {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  segment_id uuid [not null]
  customer_id uuid [not null]
  added_at bigint [not null]
  removed_at bigint
  added_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  Note: "Static segment membership. History is kept by nulling removed_at."
  Indexes {
    (segment_id, customer_id) [unique, name: 'customer_segment_members_uq']
    customer_id [name: 'customer_segment_members_customer_id_idx']
  }
}

Table crm.customer_interactions {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  customer_id uuid [not null]
  channel text [not null]
  direction text [not null]
  subject text
  notes text
  occurred_at bigint [not null]
  handled_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  follow_up_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Interaction log of a customer after conversion from a lead."
  Indexes {
    customer_id [name: 'customer_interactions_customer_id_idx']
    occurred_at [name: 'customer_interactions_occurred_at_idx']
  }
  Checks {
    `channel IN ('call', 'email', 'whatsapp', 'meeting', 'visit', 'web')`
    `direction IN ('inbound', 'outbound')`
  }
}

Table crm.customer_credit_limits {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  customer_id uuid [not null]
  limit_amount bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  effective_from date [not null]
  effective_to date
  approved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  note text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Effective dated credit limit. The current limit is the row with the latest effective_from."
  Indexes {
    customer_id [name: 'customer_credit_limits_customer_id_idx']
    (organization_id, customer_id, effective_from) [unique, name: 'customer_credit_limits_period_uq']
  }
  Checks {
    `limit_amount >= 0`
    `effective_to IS NULL OR effective_to >= effective_from`
  }
}

// ---------------------------------------------------------------------------
// MODULE: Catalog  (schema: catalog)
// Unified goods and service master: categories, units, items, variants,
// conversions, bundles, attributes, documents, price lists and prices.
// Tenant scoped. Item prices are exact integer minor units.
// ---------------------------------------------------------------------------

Table catalog.item_categories {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  parent_category_id uuid
  description text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "SUPERSEDED by inventory.item_categories (ADR-0011): not built, do not build against it. Item category tree. Hierarchy is self referencing."
  Indexes {
    (organization_id, code) [unique, name: 'item_categories_org_code_uq']
    parent_category_id [name: 'item_categories_parent_category_id_idx']
  }
}

Table catalog.units {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  base_unit_id uuid
  conversion_factor numeric(18,6) [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "SUPERSEDED by the fixed unit list on inventory.items.unit_label (ADR-0011): not built, do not build against it. Unit of measure such as pcs, set, month or year."
  Indexes {
    (organization_id, code) [unique, name: 'units_org_code_uq']
    base_unit_id [name: 'units_base_unit_id_idx']
  }
  Checks {
    `conversion_factor > 0`
  }
}

Table catalog.items {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  sku varchar(64) [not null]
  name text [not null]
  description text
  item_type text [not null, default: 'good']
  category_id uuid
  unit_id uuid
  selling_price bigint [not null, default: 0]
  purchase_price bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  is_stock_tracked boolean [not null, default: true]
  is_serialized boolean [not null, default: false]
  tax_code text
  min_stock_qty numeric(18,3) [not null, default: 0]
  barcode text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "SUPERSEDED by inventory.items (ADR-0008): one item master for the whole ERP. This table is not yet dropped and no code writes to it — do not build against it. catalog.item_categories and catalog.units are likewise unadopted; inventory.items carries free-text category and unit_label meanwhile."
  Indexes {
    (organization_id, sku) [unique, name: 'items_org_sku_uq']
    category_id [name: 'items_category_id_idx']
    unit_id [name: 'items_unit_id_idx']
    (organization_id, name) [name: 'items_org_name_idx']
    barcode [name: 'items_barcode_idx']
  }
  Checks {
    `item_type IN ('good', 'service', 'bundle', 'subscription')`
    `selling_price >= 0`
    `purchase_price >= 0`
    `min_stock_qty >= 0`
  }
}

Table catalog.item_variants {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  item_id uuid [not null]
  sku varchar(64) [not null]
  name text [not null]
  barcode text
  attributes text
  selling_price bigint [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Variant of an item, for example a size or colour specific SKU."
  Indexes {
    (organization_id, sku) [unique, name: 'item_variants_org_sku_uq']
    item_id [name: 'item_variants_item_id_idx']
  }
  Checks {
    `selling_price >= 0`
  }
}

Table catalog.item_uom_conversions {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  item_id uuid [not null]
  from_unit_id uuid [not null]
  to_unit_id uuid [not null]
  factor numeric(18,6) [not null]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Quantity conversion between two units of the same item."
  Indexes {
    (item_id, from_unit_id, to_unit_id) [unique, name: 'item_uom_conversions_uq']
  }
  Checks {
    `factor > 0`
    `from_unit_id <> to_unit_id`
  }
}

Table catalog.item_bundles {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  bundle_item_id uuid [not null]
  component_item_id uuid [not null]
  quantity numeric(18,3) [not null, default: 1]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Bill of materials of a bundle item."
  Indexes {
    (bundle_item_id, component_item_id) [unique, name: 'item_bundles_uq']
  }
  Checks {
    `quantity > 0`
    `bundle_item_id <> component_item_id`
  }
}

Table catalog.item_attributes {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  item_id uuid [not null]
  attribute_key text [not null]
  attribute_value text
  unit_of_measure text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Free form technical attribute of an item, for example material or warranty months."
  Indexes {
    (item_id, attribute_key) [unique, name: 'item_attributes_uq']
  }
}

Table catalog.item_documents {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  item_id uuid [not null]
  document_id uuid [note: "Logical reference to document.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  document_type text [not null]
  created_at bigint [not null]
  Note: "Attachment of a product manual, datasheet or certificate to an item."
  Indexes {
    item_id [name: 'item_documents_item_id_idx']
  }
  Checks {
    `document_type IN ('manual', 'datasheet', 'certificate', 'image', 'contract')`
  }
}

Table catalog.price_lists {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  customer_group_id uuid [note: "Logical reference to crm.customer_groups.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  is_default boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Named price list used by quotations and orders."
  Indexes {
    (organization_id, code) [unique, name: 'price_lists_org_code_uq']
  }
}

Table catalog.item_prices {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  item_id uuid [not null]
  price_list_id uuid [not null]
  price bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  valid_from date [not null]
  valid_to date
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Effective dated price of an item inside a price list."
  Indexes {
    (price_list_id, item_id, valid_from) [unique, name: 'item_prices_period_uq']
  }
  Checks {
    `price >= 0`
    `valid_to IS NULL OR valid_to >= valid_from`
  }
}

Table catalog.item_suppliers {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  item_id uuid [not null]
  supplier_id uuid [note: "Logical reference to procurement.suppliers.id. Cross-module FK intentionally omitted. Validated through the Procurement module contract."]
  supplier_sku text
  lead_time_days integer
  is_preferred boolean [not null, default: false]
  last_price bigint
  currency_code varchar(3) [not null, default: 'IDR']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Supplier offering for an item. Reference data for purchasing, the purchase order stays in the Procurement module."
  Indexes {
    (item_id, supplier_id) [unique, name: 'item_suppliers_uq']
  }
  Checks {
    `last_price IS NULL OR last_price >= 0`
  }
}

Table catalog.item_cost_histories {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  item_id uuid [not null]
  cost bigint [not null]
  currency_code varchar(3) [not null, default: 'IDR']
  effective_from date [not null]
  source_type text
  source_id text
  created_at bigint [not null]
  Note: "Effective dated cost history used by inventory valuation and margin reporting."
  Indexes {
    (item_id, effective_from) [unique, name: 'item_cost_histories_period_uq']
  }
  Checks {
    `cost >= 0`
  }
}

