}

Table finance.credit_memos {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  invoice_id uuid
  customer_id uuid [note: "Logical reference to crm.customers.id. Cross-module FK intentionally omitted. Validated through the CRM module contract."]
  memo_date date
  amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  reason text
  status text [not null, default: 'draft']
  issued_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  issued_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Credit note against an invoice. It reduces the receivable, it is not a payment."
  Indexes {
    (organization_id, code) [unique, name: 'credit_memos_org_code_uq']
    invoice_id [name: 'credit_memos_invoice_id_idx']
    status [name: 'credit_memos_status_idx']
  }
  Checks {
    `status IN ('draft', 'issued', 'applied', 'void')`
    `amount > 0`
  }
}

Ref: finance.invoice_items.invoice_id > finance.invoices.id [delete: cascade]
Ref: finance.payments.invoice_id > finance.invoices.id [delete: restrict]
Ref: finance.payments.supplier_bill_id > finance.supplier_bills.id [delete: restrict]
Ref: finance.payments.employee_advance_id > finance.employee_advances.id [delete: restrict]
Ref: finance.payments.cash_bank_account_id > finance.cash_bank_accounts.id [delete: restrict]
Ref: finance.receipts.invoice_id > finance.invoices.id [delete: set null]
Ref: finance.receipts.payment_id > finance.payments.id [delete: set null]
Ref: finance.expense_settlements.employee_advance_id > finance.employee_advances.id [delete: set null]
Ref: finance.expense_settlement_items.expense_settlement_id > finance.expense_settlements.id [delete: cascade]
Ref: finance.employee_advances.payment_id > finance.payments.id [delete: set null]
Ref: finance.cash_bank_transactions.cash_bank_account_id > finance.cash_bank_accounts.id [delete: restrict]
Ref: finance.bank_reconciliations.cash_bank_account_id > finance.cash_bank_accounts.id [delete: restrict]
Ref: finance.bank_reconciliation_items.bank_reconciliation_id > finance.bank_reconciliations.id [delete: cascade]
Ref: finance.bank_reconciliation_items.cash_bank_transaction_id > finance.cash_bank_transactions.id [delete: set null]
Ref: finance.expense_claims.payment_id > finance.payments.id [delete: set null]
Ref: finance.expense_claim_items.expense_claim_id > finance.expense_claims.id [delete: cascade]
Ref: finance.payment_allocations.payment_id > finance.payments.id [delete: cascade]
Ref: finance.payment_allocations.invoice_id > finance.invoices.id [delete: cascade]
Ref: finance.credit_memos.invoice_id > finance.invoices.id [delete: set null]

// ---------------------------------------------------------------------------
// MODULE: Accounting  (schema: accounting)
// Chart of accounts, journal entries and lines, periods, tax types and
// records, opening balances, account balances, bank account links,
// withholding taxes, settings and journal templates. Tenant scoped.
// ---------------------------------------------------------------------------

Table accounting.chart_of_accounts {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  account_type text [not null]
  normal_balance text [not null, default: 'debit']
  parent_account_id uuid
  level smallint [not null, default: 1]
  is_postable boolean [not null, default: true]
  is_system boolean [not null, default: false]
  is_active boolean [not null, default: true]
  description text
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Chart of accounts. Only postable accounts accept journal lines. System accounts cannot be deleted."
  Indexes {
    (organization_id, code) [unique, name: 'chart_of_accounts_org_code_uq']
    parent_account_id [name: 'chart_of_accounts_parent_account_id_idx']
    account_type [name: 'chart_of_accounts_account_type_idx']
  }
  Checks {
    `account_type IN ('asset', 'liability', 'equity', 'revenue', 'expense')`
    `normal_balance IN ('debit', 'credit')`
    `level >= 1`
  }
}

Table accounting.accounting_periods {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  period_year integer [not null]
  period_month integer [not null]
  start_date date [not null]
  end_date date [not null]
  status text [not null, default: 'open']
  closed_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  closed_at bigint
  reopened_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  reopened_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Accounting period. A closed period rejects new journal entries."
  Indexes {
    (organization_id, code) [unique, name: 'accounting_periods_org_code_uq']
    (organization_id, period_year, period_month) [unique, name: 'accounting_periods_period_uq']
  }
  Checks {
    `period_month BETWEEN 1 AND 12`
    `end_date >= start_date`
    `status IN ('open', 'closed', 'locked')`
  }
}

Table accounting.journal_entries {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  accounting_period_id uuid [not null]
  entry_date date [not null]
  description text
  source_type text
  source_id text
  status text [not null, default: 'draft']
  total_debit bigint [not null, default: 0]
  total_credit bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  prepared_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  submitted_at bigint
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  posted_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  posted_at bigint
  reversed_by_entry_id uuid
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Journal header. Debit must equal credit, the posting service enforces it inside one transaction."
  Indexes {
    (organization_id, code) [unique, name: 'journal_entries_org_code_uq']
    accounting_period_id [name: 'journal_entries_period_id_idx']
    status [name: 'journal_entries_status_idx']
    entry_date [name: 'journal_entries_entry_date_idx']
    source_type [name: 'journal_entries_source_type_idx']
    source_id [name: 'journal_entries_source_id_idx']
  }
  Checks {
    `status IN ('draft', 'submitted', 'approved', 'posted', 'reversed', 'void')`
    `total_debit >= 0`
    `total_credit >= 0`
    `total_debit = total_credit`
  }
}

Table accounting.journal_lines {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  journal_entry_id uuid [not null]
  line_no integer [not null]
  account_id uuid [not null]
  debit bigint [not null, default: 0]
  credit bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  description text
  cost_center_id uuid [note: "Logical reference to organization.cost_centers.id. Cross-module FK intentionally omitted. Validated through the Organization module contract."]
  project_id uuid [note: "Logical reference to projects.projects.id. Cross-module FK intentionally omitted. Validated through the Projects module contract."]
  party_type text
  party_id text
  created_at bigint [not null]
  Note: "Journal line. Exactly one of debit and credit is positive."
  Indexes {
    journal_entry_id [name: 'journal_lines_entry_id_idx']
    account_id [name: 'journal_lines_account_id_idx']
    (journal_entry_id, line_no) [unique, name: 'journal_lines_line_no_uq']
  }
  Checks {
    `debit >= 0`
    `credit >= 0`
    `(debit > 0 AND credit = 0) OR (credit > 0 AND debit = 0)`
  }
}

Table accounting.tax_types {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  tax_type text [not null]
  rate numeric(9,4) [not null, default: 0]
  base_type text [not null, default: 'gross']
  is_inclusive boolean [not null, default: false]
  effective_from date [not null]
  effective_to date
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Effective dated tax rate, PPN or PPh. The rate is stored as a decimal percentage, not as a float amount."
  Indexes {
    (organization_id, code) [unique, name: 'tax_types_org_code_uq']
    effective_from [name: 'tax_types_effective_from_idx']
  }
  Checks {
    `tax_type IN ('ppn', 'pph', 'ppn_input', 'ppn_output', 'other')`
    `base_type IN ('gross', 'net', 'specific')`
    `rate >= 0`
    `effective_to IS NULL OR effective_to >= effective_from`
  }
}

Table accounting.tax_records {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  tax_type_id uuid [not null]
  period_year integer [not null]
  period_month integer [not null]
  taxable_base bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  filing_status text [not null, default: 'draft']
  filed_on date
  verified_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Tax recap workpaper for a period. Filing itself stays outside the ERP."
  Indexes {
    (organization_id, code) [unique, name: 'tax_records_org_code_uq']
    tax_type_id [name: 'tax_records_tax_type_id_idx']
    (organization_id, period_year, period_month) [name: 'tax_records_period_idx']
  }
  Checks {
    `period_month BETWEEN 1 AND 12`
    `taxable_base >= 0`
    `tax_amount >= 0`
    `filing_status IN ('draft', 'verified', 'filed', 'corrected')`
  }
}

Table accounting.opening_balances {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  account_id uuid [not null]
  as_of_date date [not null]
  debit_balance bigint [not null, default: 0]
  credit_balance bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  description text
  posted_at bigint
  created_at bigint [not null]
  Note: "Opening balance of an account at the start of the system."
  Indexes {
    (account_id, as_of_date) [unique, name: 'opening_balances_account_date_uq']
  }
  Checks {
    `debit_balance >= 0`
    `credit_balance >= 0`
  }
}

Table accounting.account_balances {
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  account_id uuid [not null]
  accounting_period_id uuid [not null]
  balance_date date [not null]
  debit_total bigint [not null, default: 0]
  credit_total bigint [not null, default: 0]
  closing_balance bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  calculated_at bigint
  Note: "Balance snapshot of an account at the end of a period, derived from the posted journal entries."
  Indexes {
    (account_id, accounting_period_id) [unique, name: 'account_balances_account_period_uq']
  }
  Checks {
    `debit_total >= 0`
    `credit_total >= 0`
  }
}

Table accounting.bank_account_links {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  cash_bank_account_id uuid [not null, note: "Logical reference to finance.cash_bank_accounts.id. Cross-module FK intentionally omitted. Validated through the Finance module contract."]
  chart_of_account_id uuid [not null]
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Links a cash or bank account to its general ledger account."
  Indexes {
    cash_bank_account_id [unique, name: 'bank_account_links_cash_bank_account_id_uq']
    chart_of_account_id [name: 'bank_account_links_chart_of_account_id_idx']
  }
}

Table accounting.withholding_tax_records {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  tax_type_id uuid [not null]
  counterparty_type text
  counterparty_id text
  base_amount bigint [not null, default: 0]
  tax_amount bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  transaction_date date
  period_year integer
  period_month integer
  status text [not null, default: 'recorded']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Withholding tax collected on a payment."
  Indexes {
    (organization_id, code) [unique, name: 'withholding_tax_records_org_code_uq']
    tax_type_id [name: 'withholding_tax_records_tax_type_id_idx']
    (counterparty_type, counterparty_id) [name: 'withholding_tax_records_counterparty_idx']
  }
  Checks {
    `base_amount >= 0`
    `tax_amount >= 0`
    `status IN ('recorded', 'verified', 'paid', 'reversed')`
  }
}

Table accounting.accounting_settings {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  setting_group text [not null]
  setting_key text [not null]
  setting_value text
  description text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Accounting configuration key value store."
  Indexes {
    (organization_id, setting_group, setting_key) [unique, name: 'accounting_settings_scope_uq']
  }
}

Table accounting.journal_templates {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  line_definitions text
  source_type text
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Template that pre fills a journal entry, for example the monthly payroll journal."
  Indexes {
    (organization_id, code) [unique, name: 'journal_templates_org_code_uq']
  }
}

Ref: accounting.chart_of_accounts.parent_account_id > accounting.chart_of_accounts.id [delete: restrict]
Ref: accounting.journal_entries.accounting_period_id > accounting.accounting_periods.id [delete: restrict]
Ref: accounting.journal_entries.reversed_by_entry_id > accounting.journal_entries.id [delete: set null]
Ref: accounting.journal_lines.journal_entry_id > accounting.journal_entries.id [delete: cascade]
Ref: accounting.journal_lines.account_id > accounting.chart_of_accounts.id [delete: restrict]
Ref: accounting.tax_records.tax_type_id > accounting.tax_types.id [delete: restrict]
Ref: accounting.opening_balances.account_id > accounting.chart_of_accounts.id [delete: cascade]
Ref: accounting.account_balances.account_id > accounting.chart_of_accounts.id [delete: cascade]
Ref: accounting.account_balances.accounting_period_id > accounting.accounting_periods.id [delete: cascade]
Ref: accounting.bank_account_links.chart_of_account_id > accounting.chart_of_accounts.id [delete: restrict]
Ref: accounting.withholding_tax_records.tax_type_id > accounting.tax_types.id [delete: restrict]


// ---------------------------------------------------------------------------
// MODULE: Assets  (schema: assets)
// Asset master and categories, assignments, maintenance, depreciation,
// disposal, documents, condition checks, tool sets and movements.
// Tenant scoped.
// ---------------------------------------------------------------------------

Table assets.asset_categories {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  parent_category_id uuid
  asset_type text [not null, default: 'equipment']
  default_useful_life_months integer
  default_depreciation_method text [not null, default: 'straight_line']
  is_active boolean [not null, default: true]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Asset category with the default depreciation rule of the category."
  Indexes {
    (organization_id, code) [unique, name: 'asset_categories_org_code_uq']
    parent_category_id [name: 'asset_categories_parent_category_id_idx']
  }
  Checks {
    `asset_type IN ('equipment', 'vehicle', 'tool', 'furniture', 'it', 'intangible')`
    `default_depreciation_method IN ('straight_line', 'declining_balance', 'none')`
  }
}

Table assets.assets {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  category_id uuid
  asset_type text [not null, default: 'equipment']
  serial_number text
  barcode text
  acquisition_date date
  acquisition_cost bigint [not null, default: 0]
  salvage_value bigint [not null, default: 0]
  accumulated_depreciation bigint [not null, default: 0]
  book_value bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  useful_life_months integer
  depreciation_method text [not null, default: 'straight_line']
  depreciation_started_on date
  condition text [not null, default: 'good']
  status text [not null, default: 'in_stock']
  location_description text
  custodian_employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  assigned_at bigint
  supplier_id uuid [note: "Logical reference to procurement.suppliers.id. Cross-module FK intentionally omitted. Validated through the Procurement module contract."]
  purchase_order_id uuid [note: "Logical reference to procurement.purchase_orders.id. Cross-module FK intentionally omitted. Validated through the Procurement module contract."]
  document_id uuid [note: "Logical reference to documents.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Asset master. Costs are exact integer minor units. Master data referenced by financial records is never hard deleted."
  Indexes {
    (organization_id, code) [unique, name: 'assets_org_code_uq']
    category_id [name: 'assets_category_id_idx']
    custodian_employee_id [name: 'assets_custodian_employee_id_idx']
    status [name: 'assets_status_idx']
    serial_number [name: 'assets_serial_number_idx']
  }
  Checks {
    `asset_type IN ('equipment', 'vehicle', 'tool', 'furniture', 'it', 'intangible')`
    `status IN ('in_stock', 'in_use', 'maintenance', 'disposed', 'lost')`
    `condition IN ('new', 'good', 'fair', 'poor', 'damaged')`
    `depreciation_method IN ('straight_line', 'declining_balance', 'none')`
    `acquisition_cost >= 0`
    `salvage_value >= 0`
    `accumulated_depreciation >= 0`
    `book_value >= 0`
    `useful_life_months IS NULL OR useful_life_months > 0`
  }
}

Table assets.asset_assignments {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  asset_id uuid [not null]
  assigned_to_employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  assigned_to_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  assigned_at bigint [not null]
  returned_at bigint
  condition_on_assign text
  condition_on_return text
  notes text
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Custody of an asset. An open assignment keeps the asset in use."
  Indexes {
    asset_id [name: 'asset_assignments_asset_id_idx']
    assigned_to_employee_id [name: 'asset_assignments_employee_id_idx']
  }
  Checks {
    `returned_at IS NULL OR returned_at >= assigned_at`
  }
}

Table assets.asset_maintenances {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  asset_id uuid [not null]
  maintenance_type text [not null, default: 'preventive']
  scheduled_date date
  performed_date date
  performed_by_employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the HR module contract."]
  vendor_name text
  cost bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  description text
  status text [not null, default: 'scheduled']
  next_service_date date
  document_id uuid [note: "Logical reference to documents.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Maintenance record of an asset. The next service date drives the maintenance schedule."
  Indexes {
    (organization_id, code) [unique, name: 'asset_maintenances_org_code_uq']
    asset_id [name: 'asset_maintenances_asset_id_idx']
    status [name: 'asset_maintenances_status_idx']
    next_service_date [name: 'asset_maintenances_next_service_date_idx']
  }
  Checks {
    `maintenance_type IN ('preventive', 'corrective', 'calibration', 'inspection')`
    `status IN ('scheduled', 'in_progress', 'completed', 'cancelled')`
    `cost >= 0`
  }
}

Table assets.asset_depreciations {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  asset_id uuid [not null]
  period_year integer [not null]
  period_month integer [not null]
  depreciation_method text [not null, default: 'straight_line']
  depreciation_amount bigint [not null, default: 0]
  opening_book_value bigint [not null, default: 0]
  closing_book_value bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  calculated_at bigint
  journal_entry_id uuid [note: "Logical reference to accounting.journal_entries.id. Cross-module FK intentionally omitted. Validated through the Accounting module contract."]
  created_at bigint [not null]
  Note: "Monthly depreciation run of an asset, the audit trail of the book value."
  Indexes {
    (asset_id, period_year, period_month) [unique, name: 'asset_depreciations_period_uq']
    period_year [name: 'asset_depreciations_period_year_idx']
  }
  Checks {
    `period_month BETWEEN 1 AND 12`
    `depreciation_method IN ('straight_line', 'declining_balance', 'none')`
    `depreciation_amount >= 0`
    `closing_book_value >= 0`
  }
}

Table assets.asset_disposals {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  asset_id uuid [not null]
  disposal_date date
  disposal_method text [not null, default: 'scrap']
  proceeds_amount bigint [not null, default: 0]
  book_value_at_disposal bigint [not null, default: 0]
  gain_loss bigint [not null, default: 0]
  currency_code varchar(3) [not null, default: 'IDR']
  buyer_name text
  status text [not null, default: 'draft']
  requested_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_by text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  approved_at bigint
  executed_at bigint
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Disposal of an asset. The asset is soft deleted, the disposal record stays as the financial proof."
  Indexes {
    (organization_id, code) [unique, name: 'asset_disposals_org_code_uq']
    asset_id [name: 'asset_disposals_asset_id_idx']
    status [name: 'asset_disposals_status_idx']
  }
  Checks {
    `disposal_method IN ('sale', 'scrap', 'donation', 'transfer', 'trade_in')`
    `status IN ('draft', 'submitted', 'approved', 'executed', 'cancelled')`
    `proceeds_amount >= 0`
    `book_value_at_disposal >= 0`
  }
}

Table assets.asset_documents {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  asset_id uuid [not null]
  document_id uuid [not null, note: "Logical reference to documents.documents.id. Cross-module FK intentionally omitted. Validated through the Documents module contract."]
  document_type text [not null]
  created_at bigint [not null]
  Note: "Attachment of an invoice, a manual or a certificate to an asset."
  Indexes {
    asset_id [name: 'asset_documents_asset_id_idx']
    document_id [unique, name: 'asset_documents_document_id_uq']
  }
  Checks {
    `document_type IN ('invoice', 'manual', 'certificate', 'photo', 'contract')`
  }
}

Table assets.asset_condition_checks {
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  asset_id uuid [not null]
  check_date date [not null]
  condition text [not null]
  findings text
  checked_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  next_check_date date
  status text [not null, default: 'recorded']
  created_at bigint [not null]
  updated_at bigint [not null]
  Note: "Periodic condition check of an asset."
  Indexes {
    asset_id [name: 'asset_condition_checks_asset_id_idx']
    check_date [name: 'asset_condition_checks_check_date_idx']
  }
  Checks {
    `condition IN ('new', 'good', 'fair', 'poor', 'damaged')`
    `status IN ('recorded', 'followed_up', 'closed')`
  }
}

Table assets.tool_sets {
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  code varchar(32) [not null]
  name text [not null]
  description text
  custodian_employee_id uuid [note: "Logical reference to hr.employees.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  status text [not null, default: 'available']
  created_at bigint [not null]
  updated_at bigint [not null]
  deleted_at bigint
  Note: "Tool kit lent to a technician as one unit."
  Indexes {
    (organization_id, code) [unique, name: 'tool_sets_org_code_uq']
    custodian_employee_id [name: 'tool_sets_custodian_employee_id_idx']
  }
  Checks {
    `status IN ('available', 'lent', 'maintenance', 'retired')`
  }
}

Table assets.tool_set_items {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  tool_set_id uuid [not null]
  asset_id uuid [not null]
  quantity numeric(18,3) [not null, default: 1]
  created_at bigint [not null]
  Note: "Line of a tool set."
  Indexes {
    tool_set_id [name: 'tool_set_items_tool_set_id_idx']
    asset_id [name: 'tool_set_items_asset_id_idx']
    (tool_set_id, asset_id) [unique, name: 'tool_set_items_uq']
  }
  Checks {
    `quantity > 0`
  }
}

Table assets.asset_movements {
  updated_at bigint [not null]
  deleted_at bigint
  id uuid [pk, default: `uuidv7()`]
  organization_id text [not null, note: "Logical reference to auth.organizations.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  asset_id uuid [not null]
  movement_type text [not null, default: 'transfer']
  from_location text
  to_location text
  moved_at bigint [not null]
  moved_by_user_id text [note: "Logical reference to auth.users.id. Cross-module FK intentionally omitted. Validated through the Identity module contract."]
  condition text
  notes text
  created_at bigint [not null]
  Note: "Movement of an asset between locations or projects."
  Indexes {
    asset_id [name: 'asset_movements_asset_id_idx']
    moved_at [name: 'asset_movements_moved_at_idx']
  }
  Checks {
    `movement_type IN ('transfer', 'loan', 'return', 'project_site')`
  }
}

Ref: assets.asset_categories.parent_category_id > assets.asset_categories.id [delete: set null]
Ref: assets.assets.category_id > assets.asset_categories.id [delete: set null]
Ref: assets.asset_assignments.asset_id > assets.assets.id [delete: cascade]
Ref: assets.asset_maintenances.asset_id > assets.assets.id [delete: cascade]
Ref: assets.asset_depreciations.asset_id > assets.assets.id [delete: cascade]
Ref: assets.asset_disposals.asset_id > assets.assets.id [delete: restrict]
Ref: assets.asset_documents.asset_id > assets.assets.id [delete: cascade]
Ref: assets.asset_condition_checks.asset_id > assets.assets.id [delete: cascade]
