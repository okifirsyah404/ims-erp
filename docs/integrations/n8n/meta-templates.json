{
	"$comment": "WhatsApp message templates for the Meta Cloud API provider (WHATSAPP_PROVIDER=meta). Submit them with create-meta-templates.ts or by hand in WhatsApp Manager. All are UTILITY (tied to a transaction the recipient is part of), language 'id'. The n8n node '3. Compose messages' fills the {{n}} variables in this order; check-meta-templates.ts verifies the counts match.",
	"language": "id",
	"templates": [
		{
			"name": "erp_lead_baru",
			"audience": "team (sales manager)",
			"body": "Lead baru {{1}} dari {{2}}. Kontak: {{3}}. Kebutuhan: {{4}}.",
			"example": [
				"LEAD-0001",
				"Budi (PT Gym Sehat)",
				"081200000003",
				"Akses pintu 2 lantai"
			]
		},
		{
			"name": "erp_invoice_terbit",
			"audience": "customer",
			"body": "Yth. {{1}}, invoice {{2}} sebesar {{3}} telah terbit dengan jatuh tempo {{4}}. Terima kasih.",
			"example": [
				"PT Contoh Pelanggan",
				"0001/INV/IMS/XI/26",
				"Rp 11.100.000",
				"30 November 2026"
			]
		},
		{
			"name": "erp_invoice_terbit_internal",
